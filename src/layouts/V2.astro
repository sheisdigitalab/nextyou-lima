---
// Plantilla de la versión 2: cabecera, fuentes, barra de paletas, menú, pie,
// estilos comunes y scripts comunes. Cada página pone su <main> en el slot.
import { BASE, ENLACES, CTA_PRINCIPAL } from '../config';
import fraunces from '../assets/fonts/fraunces.woff2?url';
import frauncesItalica from '../assets/fonts/fraunces-italic.woff2?url';
import caveat from '../assets/fonts/caveat.woff2?url';
import archivo from '../assets/fonts/archivo.woff2?url';

interface Props {
  titulo: string;
  descripcion: string;
  actual?: 'bachillerato' | 'universidad' | 'familias';
}
const { titulo, descripcion, actual } = Astro.props;

const FAMILIAS_V2 = `${BASE}v2/familias/`;

// Menú por perfiles (comentario #2 de Sara). La home es la de bachillerato.
const menu = [
  { texto: 'Estoy en bachillerato', href: `${BASE}v2/`, actual: actual === 'bachillerato' },
  { texto: 'Estoy en la universidad', href: ENLACES.universidad, actual: actual === 'universidad' },
  { texto: 'Soy madre o padre', href: FAMILIAS_V2, actual: actual === 'familias' },
];

const pie = [
  { texto: 'Historias', href: ENLACES.historias },
  { texto: 'Profesiones', href: ENLACES.profesiones },
  { texto: 'Soy madre o padre', href: FAMILIAS_V2 },
  { texto: 'Sobre Sara', href: ENLACES.sara },
  { texto: 'Privacidad', href: ENLACES.privacidad },
  { texto: 'Datos y menores', href: ENLACES.menores },
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      document.documentElement.classList.add('js');
      (function () {
        var p = new URLSearchParams(location.search).get('paleta');
        try { p = p || localStorage.getItem('nextyou-paleta'); } catch (e) {}
        document.documentElement.dataset.paleta = /^[abcdo]$/.test(p || '') ? p : 'o';
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <!-- Vista previa de una versión alternativa: nunca se indexa -->
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#161412" />
    <link rel="icon" href={`${BASE}favicon.svg`} type="image/svg+xml" />
    <link rel="preload" href={fraunces} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={archivo} as="font" type="font/woff2" crossorigin />
    <style set:html={`
      @font-face { font-family: 'Fraunces'; font-style: normal; font-weight: 100 900; font-display: swap; src: url('${fraunces}') format('woff2-variations'); }
      @font-face { font-family: 'Fraunces'; font-style: italic; font-weight: 100 900; font-display: swap; src: url('${frauncesItalica}') format('woff2-variations'); }
      @font-face { font-family: 'Caveat'; font-style: normal; font-weight: 400; font-display: swap; src: url('${caveat}') format('woff2'); }
      @font-face { font-family: 'Archivo'; font-style: normal; font-weight: 100 900; font-stretch: 62% 125%; font-display: swap; src: url('${archivo}') format('woff2-variations'); }
    `} />
  </head>
  <body>
    <a class="saltar" href="#contenido">Saltar al contenido</a>

    <!-- Solo para la presentación: elegir paleta de color. Se quita al decidir. -->
    <aside class="paletas" aria-label="Paleta de color">
      <button type="button" data-elegir="o" aria-pressed="false"><i><b style="background:#000"></b><b style="background:#c93a22"></b><b style="background:#e3d3be"></b></i>Original (Figma)</button>
      <button type="button" data-elegir="a" aria-pressed="false"><i><b style="background:#f6f1e8"></b><b style="background:#3b5bff"></b><b style="background:#c8f53b"></b></i>A · Azul y lima</button>
      <button type="button" data-elegir="b" aria-pressed="false"><i><b style="background:#f6f1e8"></b><b style="background:#c93a22"></b></i>B · Rojo teja</button>
      <button type="button" data-elegir="c" aria-pressed="false"><i><b style="background:#161412"></b><b style="background:#6a43e0"></b></i>C · Lila</button>
      <button type="button" data-elegir="d" aria-pressed="false"><i><b style="background:#161412"></b><b style="background:#c8f53b"></b></i>D · Lima</button>
    </aside>

    <!-- ===================== Menú ===================== -->
    <header class="menu">
      <div class="menu__barra ancho">
        <a href={`${BASE}v2/`} class="logo" aria-label="NextYou, inicio">Next<em>You</em></a>
        <nav class="menu__nav" aria-label="Principal">
          <button class="menu__abrir" type="button" aria-expanded="false" aria-controls="menu-enlaces">
            <span class="solo-lector">Menú</span>
            <svg width="22" height="22" viewBox="0 0 22 22" aria-hidden="true"><path d="M3 7h16M3 15h16" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>
          </button>
          <ul id="menu-enlaces" class="menu__enlaces" role="list">
            {menu.map((e) => (
              <li>
                {e.href === '#' && <Fragment set:html="<!-- PENDIENTE: página fase posterior -->" />}
                <a href={e.href} aria-current={e.actual ? 'page' : undefined}>{e.texto}</a>
              </li>
            ))}
          </ul>
        </nav>
        <a href={CTA_PRINCIPAL.href} class="boton boton--sm menu__cta">Test gratis</a>
      </div>
    </header>

    <slot />

    <slot name="antes-del-pie" />

    <!-- ===================== Pie ===================== -->
    <footer class="pie">
      <div class="estrecho">
        <div class="pie__arriba">
          <a href={`${BASE}v2/`} class="logo logo--pie" aria-label="NextYou, inicio">Next<em>You</em></a>
          <nav aria-label="Pie">
            <ul role="list">{pie.map((e) => <li><a href={e.href}>{e.texto}</a></li>)}</ul>
          </nav>
        </div>
        <p class="pie__lema">Tu futuro no se adivina. Se explora.</p>
      </div>
    </footer>

    <script>
      // Fundido de entrada, una sola vez por bloque.
      const aparecen = document.querySelectorAll('[data-aparece]');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver((entradas) => {
          for (const e of entradas) if (e.isIntersecting) { e.target.classList.add('visible'); io.unobserve(e.target); }
        }, { rootMargin: '0px 0px -8% 0px' });
        aparecen.forEach((el) => io.observe(el));
      } else aparecen.forEach((el) => el.classList.add('visible'));

      // Barra de paletas
      const raiz = document.documentElement;
      const marcar = () => document.querySelectorAll<HTMLButtonElement>('[data-elegir]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.elegir === raiz.dataset.paleta)));
      document.querySelectorAll<HTMLButtonElement>('[data-elegir]').forEach((b) =>
        b.addEventListener('click', () => {
          raiz.dataset.paleta = b.dataset.elegir;
          try { localStorage.setItem('nextyou-paleta', b.dataset.elegir!); } catch (e) {}
          const url = new URL(location.href);
          url.searchParams.set('paleta', b.dataset.elegir!);
          history.replaceState(null, '', url);
          marcar();
        })
      );
      marcar();

      // Menú móvil
      const abrir = document.querySelector<HTMLButtonElement>('.menu__abrir');
      const lista = document.getElementById('menu-enlaces');
      if (abrir && lista) {
        abrir.addEventListener('click', () => {
          const abierto = abrir.getAttribute('aria-expanded') === 'true';
          abrir.setAttribute('aria-expanded', String(!abierto));
          lista.classList.toggle('abierto', !abierto);
        });
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && abrir.getAttribute('aria-expanded') === 'true') {
            abrir.setAttribute('aria-expanded', 'false');
            lista.classList.remove('abierto');
            abrir.focus();
          }
        });
      }
    </script>

    <style is:global>
      :root {
        /* Base común: negro cálido y crema */
        --negro: #161412;
        --negro-2: #1d1a17;  /* bandas: «Los de dentro», pie */
        --tarjeta: #24201c;
        --crema: #f6f1e8;
        --papel: #f6f1e8;
        --gris: #b8b0a3;        /* texto secundario sobre negro: 8,6:1 */
        --gris-oscuro: #574e46; /* texto secundario sobre claro */

        /* Valores de la paleta D · lima. Por defecto se abre la Original; todas en [data-paleta]. */
        --acento: #c8f53b;          /* botones y rellenos */
        --acento-txt: #161412;      /* texto encima del acento */
        --acento-texto: #c8f53b;    /* acento como texto sobre negro */
        --acento-oscuro: #161412;   /* acento como texto sobre crema */
        --logo-you: #c8f53b;        /* «You» del logo en el menú */
        --logo-you-pie: #c8f53b;    /* «You» del logo sobre negro */
        --detalle-bg: #c8f53b;      /* etiqueta de la portada */
        --detalle-txt: #161412;
        --pastilla-bg: #c8f53b;
        --pastilla-txt: #161412;
        --menu-bg: #161412;
        --menu-txt: #f6f1e8;
        --menu-suave: #b8b0a3;
        --menu-linea: rgb(246 241 232 / 0.14);
        --menu-acento: #c8f53b;
        --linea: rgb(246 241 232 / 0.1);
        --serif: 'Fraunces', Georgia, serif;
        --sans: 'Archivo', system-ui, sans-serif;
        --mano: 'Caveat', cursive;
        --margen: clamp(1.25rem, 0.8rem + 2vw, 2.5rem);
        color-scheme: dark;
      }

      /* Original · la del diseño de Figma: negro puro y rojo teja */
      [data-paleta='o'] {
        --negro: #000; --negro-2: #0f0b09; --tarjeta: #141210; --gris: #a39d94;
        --acento: #c93a22; --acento-txt: #f6f1e8; --acento-texto: #e2533a; --acento-oscuro: #a52b17;
        --logo-you: #e2533a; --logo-you-pie: #e2533a; --detalle-bg: #c93a22; --detalle-txt: #f6f1e8;
        --pastilla-bg: #e3d3be; --pastilla-txt: #000;
        --menu-bg: #0f0b09; --menu-txt: #f6f1e8; --menu-suave: #a39d94; --menu-linea: rgb(246 241 232 / 0.1); --menu-acento: #e2533a;
      }
      /* A · Crema + azul eléctrico, chispa lima */
      [data-paleta='a'] {
        --acento: #3b5bff; --acento-txt: #ffffff; --acento-texto: #c8f53b; --acento-oscuro: #3b5bff;
        --logo-you: #3b5bff; --logo-you-pie: #6f84ff; --detalle-bg: #c8f53b; --detalle-txt: #161412;
        --pastilla-bg: #e3e8ff; --pastilla-txt: #1e2f99;
        --menu-bg: #f6f1e8; --menu-txt: #161412; --menu-suave: #574e46; --menu-linea: rgb(22 20 18 / 0.14); --menu-acento: #3b5bff;
      }
      /* B · Crema + rojo teja */
      [data-paleta='b'] {
        --acento: #c93a22; --acento-txt: #ffffff; --acento-texto: #e8735a; --acento-oscuro: #b23218;
        --logo-you: #b23218; --logo-you-pie: #e8735a; --detalle-bg: #c93a22; --detalle-txt: #ffffff;
        --pastilla-bg: #f1ddd3; --pastilla-txt: #7a2312;
        --menu-bg: #f6f1e8; --menu-txt: #161412; --menu-suave: #574e46; --menu-linea: rgb(22 20 18 / 0.14); --menu-acento: #b23218;
      }
      /* C · Negro cálido + lila */
      [data-paleta='c'] {
        --acento: #6a43e0; --acento-txt: #ffffff; --acento-texto: #9b7bff; --acento-oscuro: #5b3bd1;
        --logo-you: #9b7bff; --logo-you-pie: #9b7bff; --detalle-bg: #6a43e0; --detalle-txt: #ffffff;
        --pastilla-bg: #e6deff; --pastilla-txt: #3d2596; --menu-acento: #9b7bff;
      }
      /* D · lima: sobre crema el lima no se lee como texto; va de relleno con texto negro */
      [data-paleta='d'] .que__cabecera h2 em,
      [data-paleta='d'] .logo--grande em { color: var(--negro); background: linear-gradient(transparent 58%, #c8f53b 58%, #c8f53b 94%, transparent 94%); padding-inline: 0.06em; }
      [data-paleta='d'] .demo__n { justify-self: start; padding: 0.1em 0.22em 0; border-radius: 10px; background: #c8f53b; color: var(--negro); }

      .sobre-claro em { font-style: italic; color: var(--acento-oscuro); }
      [data-paleta='d'] .sobre-claro em { color: var(--negro); background: linear-gradient(transparent 58%, #c8f53b 58%, #c8f53b 94%, transparent 94%); padding-inline: 0.06em; }

      /* Barra de presentación: cambia de paleta */
      .paletas { position: sticky; top: 0; z-index: 30; display: flex; align-items: center; gap: 0.5rem; padding: 0.5rem var(--margen); background: #ffffff; color: #161412; border-bottom: 1px solid rgb(0 0 0 / 0.1); overflow-x: auto; scrollbar-width: none; font-family: var(--sans); }
      .paletas::-webkit-scrollbar { display: none; }
      .paletas__titulo { flex-shrink: 0; font-size: 0.8125rem; font-weight: 600; color: #574e46; margin-right: 0.25rem; }
      .paletas button { flex-shrink: 0; display: inline-flex; align-items: center; gap: 0.5rem; min-height: 36px; padding: 0.25rem 0.875rem 0.25rem 0.375rem; border-radius: 999px; border: 1px solid rgb(0 0 0 / 0.14); background: #fff; color: #161412; font: 600 0.8125rem var(--sans); cursor: pointer; }
      .paletas button[aria-pressed='true'] { background: #161412; color: #fff; border-color: #161412; }
      .paletas i { display: flex; width: 26px; height: 26px; border-radius: 50%; overflow: hidden; border: 1px solid rgb(0 0 0 / 0.15); }
      .paletas i b { flex: 1; }
      .menu { top: 53px !important; }

      *, *::before, *::after { box-sizing: border-box; }
      * { margin: 0; }
      html { -webkit-text-size-adjust: 100%; scroll-behavior: smooth; }
      @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
      body {
        background: var(--negro);
        color: var(--crema);
        font-family: var(--sans);
        font-size: 1rem;
        line-height: 1.55;
        -webkit-font-smoothing: antialiased;
        overflow-x: hidden;
      }
      img { display: block; max-width: 100%; height: auto; }
      ul, ol { padding: 0; list-style: none; }
      a { color: inherit; }
      :focus-visible { outline: 2px solid var(--crema); outline-offset: 3px; }

      .ancho { width: min(100% - 2 * var(--margen), 85rem); margin-inline: auto; }
      .estrecho { width: min(100% - 2 * var(--margen), 72rem); margin-inline: auto; }
      .centro { display: grid; justify-items: center; text-align: center; }

      .saltar { position: absolute; left: 1rem; top: -100px; z-index: 100; padding: 0.75rem 1.25rem; border-radius: 999px; background: var(--crema); color: var(--negro); font-weight: 600; }
      .saltar:focus { top: 0.75rem; }
      @media (prefers-reduced-motion: no-preference) {
        .js [data-aparece] { opacity: 0; translate: 0 18px; transition: opacity 500ms ease, translate 500ms cubic-bezier(.2,.7,.2,1); }
        .js [data-aparece].visible { opacity: 1; translate: 0 0; }
      }
      .solo-lector { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

      /* Logo provisional en texto, como en Figma */
      .logo { font-family: var(--serif); font-weight: 700; font-size: clamp(1.625rem, 1.4rem + 0.8vw, 2rem); letter-spacing: -0.02em; text-decoration: none; font-variation-settings: 'opsz' 72; }
      .logo em { color: var(--logo-you-pie); font-style: italic; font-weight: 600; }
      .menu .logo em { color: var(--logo-you); }
      .logo--pie { font-size: 2.25rem; }
      .logo--grande { font-size: 1em; }
      .que .logo--grande em { color: var(--acento-oscuro); }

      /* Botones */
      .boton {
        display: inline-flex; align-items: center; justify-content: center;
        min-height: 48px; padding: 0.75rem 2.5rem; border-radius: 999px;
        background: var(--acento); color: var(--acento-txt);
        font-weight: 600; font-size: 1rem; text-decoration: none;
        transition: background 150ms ease, transform 150ms ease;
      }
      .boton:hover { filter: brightness(0.9); }
      .boton:active { transform: scale(0.98); }
      .boton--sm { min-height: 44px; padding: 0.5rem 1.25rem; font-size: 0.9375rem; }
      .boton--grande { min-height: 64px; font-size: 1.125rem; }
      .boton--contorno { background: none; color: var(--crema); border: 1.5px solid var(--crema); padding-inline: 1.5rem; }
      .boton--oscuro { background: var(--negro); color: var(--crema); }
      .boton--contorno-oscuro { background: none; color: var(--negro); border: 1.5px solid var(--negro); padding-inline: 1.5rem; }
      .boton--contorno-oscuro:hover { background: var(--negro); color: var(--crema); }
      .boton--contorno:hover { background: var(--crema); color: var(--negro); }

      /* Textos comunes */
      .antetitulo { color: var(--acento-texto); font-size: 0.8125rem; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; }
      .antetitulo--gris { color: var(--gris-oscuro); }
      .titular { font-family: var(--serif); font-weight: 600; font-size: clamp(2.125rem, 1.4rem + 3vw, 3.75rem); line-height: 1.04; letter-spacing: -0.02em; text-wrap: balance; }
      .titular--grande { font-size: clamp(2.25rem, 1.4rem + 3.4vw, 4rem); }
      .titular--ancho { max-width: 22ch; }
      .titular em { font-style: italic; color: var(--acento-texto); }
      .titular--unico { max-width: 20ch !important; }
      .titular--dentro { max-width: 20ch !important; }
      .titular--sara { font-size: clamp(2rem, 1.4rem + 2.2vw, 3rem); }
      .cabecera { display: grid; gap: 1rem; }
      .cabecera--centro { justify-items: center; text-align: center; }
      .cabecera--centro .titular { max-width: 16ch; }
      .cabecera__sub { color: var(--gris); max-width: 34rem; }
      .seccion { padding-block: clamp(4.5rem, 3rem + 5vw, 8rem); }

      .etiqueta-marco { display: inline-block; padding: 0.25rem 0.5rem; background: rgb(0 0 0 / 0.35); border: 1px solid var(--acento-texto); border-radius: 3px; color: var(--acento-texto); font-size: 0.875rem; line-height: 1.3; }
      .etiqueta-marco--grande { font-size: 0.9375rem; }

      .pastilla { display: inline-block; padding: 0.3rem 0.75rem; border-radius: 999px; background: var(--pastilla-bg); color: var(--pastilla-txt); font-size: 0.875rem; font-weight: 500; white-space: nowrap; }

      /* ---------- Menú ---------- */
      .menu { position: sticky; top: 0; z-index: 20; background: var(--menu-bg); color: var(--menu-txt); border-bottom: 1px solid var(--menu-linea); }
      .menu__barra { position: relative; display: flex; align-items: center; gap: 0.75rem; min-height: 72px; }
      .menu__nav { order: 3; }
      .menu__abrir { display: grid; place-items: center; width: 44px; height: 44px; border: 1px solid var(--menu-linea); border-radius: 999px; background: none; color: var(--menu-txt); cursor: pointer; }
      .menu__enlaces { display: none; }
      .menu__enlaces.abierto { display: grid; position: absolute; top: 100%; left: 0; right: 0; padding: 0.5rem; border-radius: 0 0 14px 14px; background: var(--menu-bg); border-top: 1px solid var(--menu-linea); }
      .menu__enlaces a { display: flex; align-items: center; min-height: 52px; padding-inline: 1rem; color: var(--menu-txt); text-decoration: none; font-family: var(--serif); font-weight: 600; font-size: 1.25rem; }
      .menu__enlaces a[aria-current='page'] { color: var(--menu-acento); }
      .menu__cta { margin-left: auto; }
      @media (min-width: 60rem) {
        .menu__nav { order: 0; margin-left: auto; }
        .menu__abrir { display: none; }
        .menu__enlaces, .menu__enlaces.abierto { display: flex; position: static; padding: 0; background: none; border: 0; }
        .menu__enlaces a { min-height: 44px; padding-inline: 0.875rem; font-family: var(--sans); font-weight: 500; font-size: 0.9375rem; color: var(--menu-suave); border-radius: 999px; }
        .menu__enlaces a:hover { color: var(--menu-txt); }
        .menu__enlaces a[aria-current='page'] { color: var(--menu-txt); box-shadow: inset 0 0 0 1px var(--menu-suave); }
        .menu__cta { margin-left: 0.5rem; }
      }

      /* ---------- Pie ---------- */
      .pie { background: var(--negro-2); padding-block: 4rem 5rem; }
      .pie__arriba { display: grid; gap: 1.5rem; padding-bottom: 2.5rem; border-bottom: 1px solid var(--linea); }
      .pie ul { display: flex; flex-wrap: wrap; gap: 0.25rem 2rem; }
      .pie ul a { color: var(--gris); font-size: 0.875rem; text-decoration: none; display: inline-block; padding-block: 0.6rem; }
      .pie ul a:hover { color: var(--crema); }
      .pie__lema { font-family: var(--serif); font-weight: 600; font-size: clamp(2rem, 1.4rem + 2.6vw, 3.25rem); line-height: 1.05; letter-spacing: -0.025em; margin-top: 3rem; }
      @media (min-width: 56rem) { .pie__arriba { grid-template-columns: auto 1fr; align-items: center; } .pie nav { justify-self: end; } }
    </style>
  </body>
</html>
