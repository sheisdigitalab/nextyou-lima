---
// Fila de tarjetas de vídeo de profesionales (las mismas que el carrusel «Su camino, contado por ellos» de home-v3):
// foto, «▶ X min», nombre y edad, y su camino. Al hacer clic se abre el visor de <VisorClips />.
// En escritorio van en fila; en móvil, en carrusel horizontal deslizable.
// Variante «coach»: sin foto (perfiles de ejemplo, con la inicial), con frase gancho, nombre y rol, y sin línea de camino.
import { Image, getImage } from 'astro:assets';
import '../styles/tarjeta-profesional.css';

interface Props {
  clips: Array<Record<string, any>>;
  grupo: string;
  variante?: 'profesional' | 'coach';
}
const { clips, grupo, variante = 'profesional' } = Astro.props;
const coach = variante === 'coach';
// Póster neutro con la inicial, mientras no hay foto
const poster = (inicial: string) => `data:image/svg+xml,${encodeURIComponent(`<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 900 600"><rect width="900" height="600" fill="#24201c"/><text x="450" y="370" font-family="Arial,sans-serif" font-size="260" font-weight="700" fill="#c8f53b" text-anchor="middle">${inicial}</text></svg>`)}`;

// Mismos retoques de texto que aplica la home a estos datos
const lista = await Promise.all(
  clips.map(async (p) => ({
    ...p,
    camino: Array.isArray(p.camino) ? p.camino.map((c: string) => c.replace('Estudió Turismo', 'Empezó Turismo')) : p.camino,
    martes: typeof p.martes === 'string' ? p.martes.replace('el recorrido de un servicio', 'el camino de un servicio') : p.martes,
    grande: p.foto ? (await getImage({ src: p.foto, width: 900, format: 'webp' })).src : poster(String(p.nombre).charAt(0)),
  }))
);
---

<ul class:list={['clips', { 'clips--coach': coach }]} role="list" aria-label={coach ? 'Vídeos de los coaches' : 'Vídeos de profesionales'} data-clips={grupo} tabindex="0">
  {
    lista.map((p, i) => (
      <li class="clip" data-placeholder="true">
        {p.foto ? <Image src={p.foto} alt={p.alt} width={540} height={810} loading="lazy" quality={70} class="clip__foto" /> : <span class="clip__ini" aria-hidden="true">{String(p.nombre).charAt(0)}</span>}
        <div class="clip__pie">
          {coach && <p class="clip__gancho"><span>«{p.cita}»</span></p>}
          <p class="clip__nombre">{p.nombre}, {p.edad}</p>
          {coach ? <p class="clip__rol">{p.rol}</p> : <ol class="clip__linea" aria-label="Su camino">{p.camino.map((e: string) => <li>{e.replace(/^(Empezó|Estudió) /, '')}</li>)}</ol>}
        </div>
        <span class="clip__ver">
          <svg width="10" height="12" viewBox="0 0 12 14" aria-hidden="true"><path d="M1.5 1.2l9 5.8-9 5.8z" fill="currentColor" /></svg>
          {p.duracion}
        </span>
        <button
          type="button"
          class="clip__abrir"
          data-visor-abrir
          data-grupo={grupo}
          aria-haspopup="dialog"
          aria-label={`Ver el vídeo de ${p.nombre}, ${p.profesion ?? p.rol}, ${p.duracion}`}
          data-nombre={`${p.nombre}, ${p.edad}`}
          data-profesion={p.profesion ?? p.rol}
          data-cita={p.cita}
          data-duracion={p.duracion}
          data-img={p.grande}
          data-video={p.video ?? ''}
          data-subtitulos={p.subtitulos ?? ''}
          data-indice={i}
          data-camino={Array.isArray(p.camino) ? p.camino.join('|') : ''}
          data-estudios={p.estudios}
          data-trabajo={p.primerTrabajo}
          data-martes={p.martes}
        />
      </li>
    ))
  }
</ul>

<style is:global>
  .clips { list-style: none; margin: 0; padding: 0.25rem 0 0.75rem; display: flex; gap: 1rem; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; overscroll-behavior-x: contain; }
  .clips::-webkit-scrollbar { display: none; }
  .clip { position: relative; flex: 0 0 min(76vw, 17.5rem); aspect-ratio: 9 / 16; border-radius: 22px; overflow: hidden; scroll-snap-align: start; background: var(--tarjeta); box-shadow: 0 24px 40px -24px rgb(0 0 0 / 0.8); color: var(--crema); }
  @media (min-width: 48rem) { .clip { flex-basis: clamp(14rem, 24vw, 17.5rem); aspect-ratio: 2 / 3; } }
  .clip__foto { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: scale 600ms cubic-bezier(0.2, 0.7, 0.2, 1); }
  .clip::after { content: ''; position: absolute; inset: 0; background: linear-gradient(to bottom, transparent 40%, rgb(0 0 0 / 0.45) 58%, rgb(0 0 0 / 0.92)); }
  .clip__ver {
    position: absolute; z-index: 1; top: 1rem; left: 1rem; display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.3rem 0.75rem 0.3rem 0.6rem;
    border-radius: 999px; background: rgb(22 20 18 / 0.35); color: var(--crema); border: 1px solid rgb(246 241 232 / 0.6);
    font-size: 0.875rem; font-weight: 500; letter-spacing: 0.01em; -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px);
  }
  .clip__abrir { position: absolute; inset: 0; z-index: 3; border: 0; background: none; color: var(--crema); cursor: pointer; border-radius: inherit; }
  .clip__abrir:focus-visible { outline: 3px solid var(--acento-texto); outline-offset: -3px; }
  @media (hover: hover) { .clip:hover .clip__foto { scale: 1.06; } }
  /* Variante coach: sin foto, con la inicial; frase gancho en caja crema inclinada, nombre y rol */
  .clips--coach .clip { background: linear-gradient(160deg, #3a342c, #1c1916); }
  .clip__ini { position: absolute; top: 24%; left: 50%; translate: -50% 0; display: grid; place-items: center; width: 5.25rem; height: 5.25rem; border-radius: 50%; background: rgb(246 241 232 / 0.1); font-size: 2.125rem; font-weight: 800; color: rgb(246 241 232 / 0.4); }
  .clip__gancho { margin: 0; align-self: flex-start; text-align: left; font-family: var(--titular); font-weight: 800; font-stretch: 105%; font-size: max(0.875rem, 4.6cqw); line-height: 1.5; letter-spacing: -0.01em; rotate: -2deg; transform-origin: left bottom; }
  .clip__gancho span { padding: 0.15em 0.4em; border-radius: 6px; background: var(--crema); color: #161412; -webkit-box-decoration-break: clone; box-decoration-break: clone; }
  .clip__rol { margin: 0; font-size: max(0.875rem, 4cqw); line-height: 1.3; color: var(--gris); }
  /* Cuatro tarjetas en fila en escritorio; en pantallas menores, carrusel */
  @media (min-width: 64rem) { .clips--coach { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); overflow: visible; gap: 1rem; } .clips--coach .clip { flex: none; } }
</style>
