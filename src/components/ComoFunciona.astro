</style>

<script>
  // Paso activo: marca el texto, enseña su pantalla en el móvil fijo y las etiquetas flotantes
  const demo = document.querySelector<HTMLElement>('[data-cmo]');
  if (demo) {
    const pasos = [...demo.querySelectorAll<HTMLElement>('.cmo__paso')];
    const activar = (n: number) => {
      pasos.forEach((p, i) => p.classList.toggle('activo', i === n));
      demo.querySelectorAll<HTMLElement>('.cmo-pant').forEach((p) => p.classList.toggle('activa', Number(p.dataset.pant) === n));
      demo.querySelectorAll<HTMLElement>('.cmo__flota').forEach((f) => f.classList.toggle('on', Number(f.dataset.flota) === n));
    };
    activar(0);
    if ('IntersectionObserver' in window) {
      const ob = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) activar(Number((e.target as HTMLElement).dataset.paso)); }), { rootMargin: '-45% 0px -45% 0px' });
      pasos.forEach((p) => ob.observe(p));
    }
  }
</script>
