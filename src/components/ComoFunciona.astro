  /* ---- Escritorio: móvil fijo con perspectiva, pegado al texto ---- */
  @media (min-width: 64rem) {
    .cmo__demo { display: grid; grid-template-columns: minmax(0, 34rem) 21rem; gap: clamp(3rem, 2rem + 4vw, 6.5rem); justify-content: center; align-items: start; }
