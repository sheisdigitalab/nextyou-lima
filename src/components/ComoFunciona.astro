    .cmo__flota { position: absolute; inset: 0; pointer-events: none; opacity: 0; transition: opacity 450ms ease; }
    .cmo__flota.on { opacity: 1; }
    .cmo__flota span { position: absolute; padding: 0.55rem 1rem; border-radius: 999px; background: #fff; color: var(--ap-ink); font-weight: 700; font-size: 0.9375rem; white-space: nowrap; box-shadow: 0 18px 34px -18px rgb(0 0 0 / 0.5); }
