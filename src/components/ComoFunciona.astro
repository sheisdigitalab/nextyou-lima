---
// «Cómo funciona»: tres pasos (test → 3 caminos → gente real) y el extra del coach, con un móvil fijo a la derecha
// que cambia de pantalla al hacer scroll (en móvil, cada paso lleva su pantalla debajo).
// Personas y datos de la «app» DE MUESTRA. PENDIENTE CLIENTA: precio, duración y frecuencia de las sesiones del coach.
import Pantalla from './ComoPantalla.astro';
import { CTA_PRINCIPAL } from '../config';

const iconos = {
  metodo: '<svg viewBox="0 0 24 24"><path d="M9 3v6L4 19a2 2 0 0 0 1.8 3h12.4A2 2 0 0 0 20 19l-5-10V3M8 3h8M7.5 15h9"/></svg>',
  reloj: '<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>',
  repetir: '<svg viewBox="0 0 24 24"><path d="M4 12a8 8 0 0 1 14-5.3M20 4v4h-4M20 12a8 8 0 0 1-14 5.3M4 20v-4h4"/></svg>',
  una: '<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="8"/><circle cx="12" cy="12" r="3"/></svg>',
  puente: '<svg viewBox="0 0 24 24"><path d="M3 17c3-8 15-8 18 0M3 17h18M7 17v-3M12 17v-5M17 17v-3"/></svg>',
  salto: '<svg viewBox="0 0 24 24"><path d="M4 18c4 0 5-8 8-8s4 8 8 8M16 6l4-1-1 4"/></svg>',
  consejo: '<svg viewBox="0 0 24 24"><path d="M9 18h6M10 21h4M12 3a6 6 0 0 0-3.5 10.9c.6.5 1 1.2 1 2.1h5c0-.9.4-1.6 1-2.1A6 6 0 0 0 12 3z"/></svg>',
  video: '<svg viewBox="0 0 24 24"><rect x="3" y="6" width="13" height="12" rx="3"/><path d="M16 10l5-3v10l-5-3z"/></svg>',
  sesion: '<svg viewBox="0 0 24 24"><path d="M5 5h14v10H10l-5 4z"/></svg>',
};

const pasos = [
  {
    n: '01',
    titulo: 'Haces un test que te conoce',
    texto: 'No es un cuestionario cualquiera: detrás hay una metodología que analiza tus motivaciones, tus intereses y tus patrones. Qué te mueve, cómo trabajas y qué buscas. Son 8 minutos y solo te pedimos tu email para mandarte los resultados.',
    nota: 'Puedes repetirlo cuando quieras: lo que te encaja hoy puede cambiar con el tiempo.',
    chips: [['metodo', 'Metodología detrás'], ['reloj', '8 minutos · 12 preguntas'], ['repetir', 'Repítelo cuando quieras']],
  },
  {
    n: '02',
    titulo: 'Recibes 3 caminos profesionales',
    texto: 'Con tus respuestas te proponemos 3 posibles profesiones que van con tu forma de ser: la que más te pega, un puente hacia algo parecido y un salto hacia algo que quizá ni sabías que existía. No es un veredicto: son tres opciones para explorar y comparar.',
    nota: '',
    chips: [['una', 'La que más te pega'], ['puente', 'El puente'], ['salto', 'El salto']],
  },
  {
    n: '03',
    titulo: 'Hablas con gente que ya se dedica a ello',
    texto: 'Junto a tus 3 caminos tienes consejos y vídeos o entrevistas con personas que trabajan en esas profesiones y te cuentan de primera mano cómo son: qué estudiaron, cómo empezaron y cómo es su día a día. Así compruebas si de verdad te encajan, sin tener que decidirlo tú solo.',
    nota: '',
    chips: [['consejo', 'Consejos'], ['video', 'Vídeos y entrevistas']],
  },
];
const flota = [
  ['Motivaciones', 'Intereses', 'Cómo trabajas'],
  ['3 opciones', 'Sin ranking'],
  ['De primera mano', 'Consejos'],
  ['Online', '1 a 1'],
];
---
<section id="como-funciona" class="v7como cmo" aria-labelledby="como-titulo">
  <div class="ancho">
    <header class="cmo__cab" data-aparece>
      <p class="cmo__eti">Cómo funciona</p>
      <h2 id="como-titulo" class="cmo__tit">De no saber qué estudiar a saber qué <u>quieres probar</u></h2>
      <p class="cmo__sub">Un test con método, tres profesiones para explorar, gente real que te las cuenta y, si lo necesitas, un coach a tu lado.</p>
    </header>

    <div class="cmo__demo" data-cmo>
      <ol class="cmo__pasos" role="list" aria-label="Cómo funciona, paso a paso">
        {pasos.map((p, i) => (
          <li class:list={['cmo__paso', { activo: i === 0 }]} data-paso={i} id={`paso-${i + 1}`}>
            <div class="cmo__texto" data-aparece>
              <span class="cmo__n" aria-hidden="true">{p.n}</span>
              <h3>{p.titulo}</h3>
              <p class="cmo__p">{p.texto}</p>
              {p.nota && <p class="cmo__nota">{p.nota}</p>}
              <ul class="cmo__chips" role="list">
                {p.chips.map(([ic, t]) => <li><span class="cmo__ic" aria-hidden="true" set:html={iconos[ic as keyof typeof iconos]} />{t}</li>)}
              </ul>
            </div>
            <div class="cmo__movil" aria-hidden="true"><div class="cmo-tel"><div class="cmo-tel__pant"><Pantalla n={i as 0 | 1 | 2} /></div></div></div>
          </li>
        ))}
        <!-- PENDIENTE CLIENTA: precio, duración y frecuencia de las sesiones con el coach -->
        <li class="cmo__paso cmo__paso--premium" data-paso="3" id="paso-4">
          <div class="cmo__texto" data-aparece>
            <span class="cmo__n cmo__n--premium">+ Opción premium</span>
            <h3>Un coach te acompaña</h3>
            <p class="cmo__p">Si después de explorar sigues con dudas y necesitas una guía, puedes contratar sesiones individuales online con un coach que te acompaña y te asesora de forma personalizada.</p>
            <ul class="cmo__chips" role="list">
              <li><span class="cmo__ic" aria-hidden="true" set:html={iconos.sesion} />Sesiones individuales</li>
              <li><span class="cmo__ic" aria-hidden="true" set:html={iconos.video} />Online</li>
            </ul>
          </div>
          <div class="cmo__movil" aria-hidden="true"><div class="cmo-tel"><div class="cmo-tel__pant"><Pantalla n={3} /></div></div></div>
        </li>
      </ol>

      <!-- Móvil fijo (escritorio): cambia de pantalla con el paso activo -->
      <div class="cmo__fijo" aria-hidden="true">
        <div class="cmo__escena">
          <div class="cmo-tel cmo-tel--fijo"><div class="cmo-tel__pant">
            <Pantalla n={0} /><Pantalla n={1} /><Pantalla n={2} /><Pantalla n={3} />
          </div></div>
          {flota.map((grupo, g) => (
            <div class:list={['cmo__flota', { on: g === 0 }]} data-flota={g}>
              {grupo.map((t, k) => <span class={`cmo__flota-${k + 1}`}>{t}</span>)}
            </div>
          ))}
        </div>
      </div>
    </div>

    <div class="cmo__pie" data-aparece>
      <!-- PENDIENTE: CTA a revisar con la propuesta de Elias (comentario #14) -->
      <a href={CTA_PRINCIPAL.href} class="boton boton--grande">Haz el test gratis <span aria-hidden="true">→</span></a>
      <p class="cmo__micro">8 minutos · gratis · te mandamos tus resultados por email</p>
    </div>
  </div>
</section>

<style is:global>
  /* =========================== Cómo funciona (ComoFunciona.astro) =========================== */
  .cmo {
    --ap-ink: #141414; --ap-gris: #6b6a64; --ap-linea: #e8e6df;
    --ap-lima: #eef9d2; --ap-lila: #ece6ff; --ap-menta: #dcf4e8; --ap-melo: #ffe8da;
  }
  .cmo__cab { display: grid; justify-items: start; gap: 1.25rem; margin-bottom: clamp(3rem, 2rem + 4vw, 6rem); max-width: 60rem; }
  .cmo__eti { font-size: 0.6875rem; font-weight: 600; letter-spacing: 0.2em; text-transform: uppercase; color: var(--gris-oscuro); }
  .cmo__tit { font-family: var(--titular); font-weight: 700; font-size: var(--t-seccion, 2.25rem); line-height: 1.04; letter-spacing: -0.035em; text-wrap: balance; }
  .cmo__tit u { text-decoration: none; background: linear-gradient(var(--acento), var(--acento)) no-repeat left 92% / 100% 0.14em; padding-bottom: 0.04em; }
  .cmo__sub { max-width: 34em; font-size: var(--t2); line-height: 1.55; color: var(--gris-oscuro); }

  .cmo__pasos { display: grid; gap: clamp(4rem, 3rem + 4vw, 7rem); list-style: none; margin: 0; padding: 0; }
  .cmo__paso { display: grid; gap: 2.25rem; }
  .cmo__texto { display: grid; justify-items: start; gap: 0.9rem; max-width: 34rem; }
  .cmo__n { position: relative; font-family: var(--titular); font-weight: 800; font-size: clamp(2.25rem, 1.8rem + 1.6vw, 3.25rem); line-height: 1; color: var(--gris-oscuro); padding-bottom: 0.45rem; transition: color 400ms ease; }
  .cmo__n::after { content: ''; position: absolute; left: 0; bottom: 0; width: 100%; height: 3px; border-radius: 2px; background: var(--acento); }
  .cmo__n--premium { font-size: 0.6875rem; font-weight: 600; letter-spacing: 0.2em; text-transform: uppercase; padding-bottom: 0; }
  .cmo__n--premium::after { display: none; }
  .cmo__paso h3 { font-family: var(--titular); font-weight: 700; font-size: clamp(1.5rem, 1.2rem + 1vw, 2.25rem); line-height: 1.1; letter-spacing: -0.025em; }
  .cmo__p { font-size: var(--t2); line-height: 1.6; color: #3a342e; }
  .cmo__nota { font-size: var(--t2); line-height: 1.55; color: var(--gris-oscuro); font-style: normal; }
  .cmo__chips { display: flex; flex-wrap: wrap; gap: 0.6rem 1.25rem; list-style: none; margin: 0.35rem 0 0; padding: 0; }
  .cmo__chips li { display: inline-flex; align-items: center; gap: 0.5rem; font-size: 0.9375rem; font-weight: 600; color: var(--ap-ink); }
  .cmo__ic { display: grid; place-items: center; width: 2rem; height: 2rem; border-radius: 50%; background: var(--ap-lima); }
  .cmo__ic svg { width: 1.05rem; height: 1.05rem; fill: none; stroke: var(--ap-ink); stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
  .cmo__chips li:nth-child(2) .cmo__ic { background: var(--ap-lila); }
  .cmo__chips li:nth-child(3) .cmo__ic { background: var(--ap-menta); }
  .cmo__paso--premium .cmo__texto { padding-left: 1.5rem; border-left: 1px solid rgb(22 20 18 / 0.18); }
  .cmo__pie { display: grid; justify-items: start; gap: 1rem; margin-top: clamp(3.5rem, 3rem + 3vw, 6rem); }
  .cmo__micro { font-size: var(--t1); color: var(--gris-oscuro); }
  .cmo__fijo { display: none; }

  /* ---- Móvil (marco) ---- */
  .cmo-tel { position: relative; width: min(100%, 19rem); aspect-ratio: 71.6 / 147.6; padding: 0.55rem; border-radius: 3rem; background: #121212; box-shadow: inset 0 0 0 2px #2d2d2d, 0 0 0 1px #000; }
  .cmo-tel::after { content: ''; position: absolute; top: 1.05rem; left: 50%; width: 5.2rem; height: 1.45rem; translate: -50% 0; border-radius: 999px; background: #000; z-index: 6; }
  .cmo-tel__pant { position: relative; display: grid; height: 100%; border-radius: 2.5rem; background: #fff; overflow: hidden; color: var(--ap-ink); }
  .cmo__movil { display: grid; justify-items: start; }

  /* ---- Pantallas de la app ---- */
  .cmo-pant { grid-area: 1 / 1; position: relative; display: flex; flex-direction: column; gap: 0.7rem; padding: 2.9rem 1rem 0; font-family: var(--sans); font-size: 0.875rem; line-height: 1.3; color: var(--ap-ink); background: #fff; }
  .cmo-est { position: absolute; z-index: 5; top: 1.05rem; left: 1.7rem; right: 1.5rem; display: flex; justify-content: space-between; align-items: center; font-weight: 700; font-size: 0.875rem; }
  .cmo-est i { width: 1.35rem; height: 0.7rem; border-radius: 3px; border: 1.5px solid var(--ap-ink); position: relative; }
  .cmo-est i::after { content: ''; position: absolute; inset: 1.5px; width: 70%; border-radius: 1px; background: var(--ap-ink); }
  .cmo-ic { display: inline-grid; place-items: center; width: 1.9rem; height: 1.9rem; border-radius: 50%; background: var(--ap-lima); flex: none; }
  .cmo-ic svg { width: 1.1rem; height: 1.1rem; fill: none; stroke: var(--ap-ink); stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .cmo-chip { align-self: flex-start; padding: 0.25rem 0.7rem; border-radius: 999px; font-weight: 700; font-size: 0.875rem; }
  .cmo-chip--lima { background: var(--ap-lima); } .cmo-chip--lila { background: var(--ap-lila); } .cmo-chip--menta { background: var(--ap-menta); }
  .cmo-preg, .cmo-cab h4 { font-family: var(--titular); font-weight: 800; font-size: 1.45rem; line-height: 1.08; letter-spacing: -0.02em; margin: 0; }
  .cmo-cab { display: grid; gap: 0.2rem; }
  .cmo-cab small { color: var(--ap-gris); font-size: 0.875rem; font-weight: 600; }
  .cmo-cab p { color: var(--ap-gris); font-size: 0.875rem; margin: 0; }
  .cmo-cab em { font-style: normal; background: var(--acento); border-radius: 8px; padding: 0 0.3em; }
  .cmo-nota { color: var(--ap-gris); font-size: 0.875rem; text-align: center; margin: 0; }
  .cmo-nota--izq { text-align: left; }
  .cmo-btn { margin-top: auto; display: grid; place-items: center; min-height: 3rem; border-radius: 999px; background: var(--ap-ink); color: #fff; font-weight: 800; font-size: 1rem; margin-bottom: 0.4rem; }
  .cmo-nav { margin-top: auto; display: flex; justify-content: space-around; padding: 0.5rem 0.2rem 0.85rem; border-top: 1px solid var(--ap-linea); margin-inline: -1rem; }
  .cmo-nav > span { display: grid; justify-items: center; gap: 0.1rem; font-size: 0.875rem; font-weight: 600; color: var(--ap-gris); }
  .cmo-nav .cmo-ic { background: none; width: 1.6rem; height: 1.6rem; }
  .cmo-nav .cmo-ic svg { stroke: var(--ap-gris); }
  .cmo-nav .cmo-on { color: var(--ap-ink); }
  .cmo-nav .cmo-on .cmo-ic svg { stroke: var(--ap-ink); }
  .cmo-btn + .cmo-nav { margin-top: 0; }

  /* Pantalla 0: test (pregunta ↔ perfil, en bucle) */
  .cmo-test { display: grid; flex: 1; min-height: 0; }
  .cmo-test__a, .cmo-test__b { grid-area: 1 / 1; display: flex; flex-direction: column; gap: 0.7rem; min-height: 0; }
  .cmo-top { display: flex; align-items: center; gap: 0.6rem; }
  .cmo-x { color: var(--ap-gris); font-weight: 700; }
  .cmo-top small { font-weight: 700; font-size: 0.875rem; color: var(--ap-gris); }
  .cmo-barra { flex: 1; height: 8px; border-radius: 8px; background: var(--ap-linea); overflow: hidden; }
  .cmo-barra i { display: block; height: 100%; width: 34%; border-radius: 8px; background: var(--acento); }
  .cmo-barra--llena i { width: 100%; }
  .cmo-ops { display: grid; grid-template-columns: 1fr 1fr; gap: 0.55rem; }
  .cmo-op { display: grid; gap: 0.15rem; padding: 0.7rem; border: 2px solid var(--ap-linea); border-radius: 18px; font-weight: 800; font-size: 1rem; }
  .cmo-op small { color: var(--ap-gris); font-weight: 500; font-size: 0.875rem; }
  .cmo-op:nth-child(2) .cmo-ic { background: var(--ap-lila); } .cmo-op:nth-child(3) .cmo-ic { background: var(--ap-menta); } .cmo-op:nth-child(4) .cmo-ic { background: var(--ap-melo); }
  .cmo-rasgos { list-style: none; margin: 0.2rem 0 0; padding: 0; display: grid; gap: 0.95rem; }
  .cmo-rasgos li { display: grid; gap: 0.4rem; }
  .cmo-rasgos span { display: grid; gap: 0.05rem; color: var(--ap-gris); font-weight: 600; font-size: 0.875rem; }
  .cmo-rasgos b { color: var(--ap-ink); font-size: 1.0625rem; font-weight: 800; }
  .cmo-rasgos i { display: block; height: 10px; border-radius: 10px; background: var(--ap-linea); position: relative; overflow: hidden; }
  .cmo-rasgos i::after { content: ''; position: absolute; inset: 0 auto 0 0; width: var(--w); border-radius: 10px; background: var(--acento); }
  .cmo-rasgos li:nth-child(2) i::after { background: #cdbcff; } .cmo-rasgos li:nth-child(3) i::after { background: #9fe0c0; }
  .cmo-rep { display: flex; align-items: center; gap: 0.5rem; margin: auto 0 0.4rem; padding: 0.6rem 0.75rem; border-radius: 16px; background: var(--ap-lila); font-weight: 700; font-size: 0.9375rem; }
  .cmo-rep .cmo-ic { background: #fff; width: 1.7rem; height: 1.7rem; }

  /* Pantalla 1: caminos */
  .cmo-cam, .cmo-gen, .cmo-coa { display: flex; flex-direction: column; gap: 0.75rem; flex: 1; min-height: 0; }
  .cmo-lista { display: grid; gap: 0.6rem; }
  .cmo-cam__it { display: flex; align-items: center; gap: 0.7rem; padding: 0.5rem 0.6rem 0.5rem 0.5rem; border-radius: 20px; }
  .cmo-cam__it--1 { background: var(--ap-lima); } .cmo-cam__it--2 { background: var(--ap-lila); } .cmo-cam__it--3 { background: var(--ap-menta); }
  .cmo-cam__f { width: 3.7rem; height: 3.7rem; border-radius: 14px; object-fit: cover; flex: none; }
  .cmo-cam__tx { display: grid; gap: 0.1rem; min-width: 0; flex: 1; }
  .cmo-cam__tx b { font-size: 1.0625rem; font-weight: 800; line-height: 1.15; }
  .cmo-tag { font-size: 0.875rem; font-weight: 600; color: var(--ap-gris); }
  .cmo-fl { font-size: 1.5rem; color: var(--ap-gris); padding-right: 0.2rem; }

  /* Pantalla 2: gente real */
  .cmo-tabs { display: flex; gap: 0.4rem; padding: 0.25rem; border-radius: 999px; background: #f1efe8; }
  .cmo-tab { flex: 1; text-align: center; padding: 0.4rem 0.2rem; border-radius: 999px; font-weight: 700; color: var(--ap-gris); }
  .cmo-tab--on { background: #fff; color: var(--ap-ink); box-shadow: 0 1px 3px rgb(0 0 0 / 0.12); }
  .cmo-video { position: relative; flex: 1; min-height: 11rem; border-radius: 22px; overflow: hidden; background: #111; }
  .cmo-video__f { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 30%; }
  .cmo-video::after { content: ''; position: absolute; inset: 0; background: linear-gradient(to top, rgb(0 0 0 / 0.65), transparent 55%); }
  .cmo-play { position: absolute; z-index: 2; left: 50%; top: 45%; width: 3.2rem; height: 3.2rem; translate: -50% -50%; border-radius: 50%; background: rgb(255 255 255 / 0.92); display: grid; place-items: center; }
  .cmo-play svg { width: 1.2rem; height: 1.2rem; fill: var(--ap-ink); margin-left: 0.15rem; }
  .cmo-quien { position: absolute; z-index: 2; left: 0.8rem; bottom: 0.7rem; display: grid; color: #fff; }
  .cmo-quien b { font-size: 1.0625rem; font-weight: 800; } .cmo-quien small { font-size: 0.875rem; opacity: 0.9; }
  .cmo-dur { position: absolute; z-index: 2; left: 0.7rem; top: 0.7rem; padding: 0.2rem 0.6rem; border-radius: 999px; background: rgb(0 0 0 / 0.5); color: #fff; font-weight: 700; font-size: 0.875rem; }
  .cmo-burb { padding: 0.65rem 0.8rem; border-radius: 16px 16px 16px 4px; background: var(--ap-menta); font-weight: 600; }
  .cmo-burb p { margin: 0; }
  .cmo-chips { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-bottom: 0.4rem; }
  .cmo-chips span { padding: 0.35rem 0.75rem; border-radius: 999px; border: 1.5px solid var(--ap-linea); font-weight: 700; font-size: 0.875rem; }
  .cmo-chips .cmo-tap { background: var(--ap-ink); border-color: var(--ap-ink); color: #fff; }

  /* Pantalla 3: coach */
  .cmo-coach { display: flex; align-items: center; gap: 0.8rem; padding: 0.55rem; border-radius: 22px; background: var(--ap-menta); }
  .cmo-coach__f { width: 4.6rem; height: 4.6rem; border-radius: 16px; object-fit: cover; object-position: 50% 25%; flex: none; }
  .cmo-coach__tx { display: grid; gap: 0.15rem; }
  .cmo-coach__tx b { font-size: 1.1875rem; font-weight: 800; } .cmo-coach__tx small { color: var(--ap-gris); font-weight: 600; font-size: 0.875rem; }
  .cmo-coach .cmo-chip--menta { background: #fff; margin-top: 0.15rem; }
  .cmo-sub { margin: 0.3rem 0 0; font-weight: 800; font-size: 1.0625rem; }
  .cmo-dias, .cmo-horas { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.5rem; }
  .cmo-dias span, .cmo-horas span { display: grid; justify-items: center; padding: 0.55rem 0.2rem; border: 2px solid var(--ap-linea); border-radius: 16px; font-weight: 600; color: var(--ap-gris); }
  .cmo-dias b { font-size: 1.25rem; font-weight: 800; color: var(--ap-ink); }
  .cmo-horas span { font-weight: 800; color: var(--ap-ink); }
  .cmo-dia--on, .cmo-hora--on { background: var(--ap-lima); border-color: var(--ap-ink) !important; }

  /* ---- Animaciones de las pantallas (solo si no se pide «reducir movimiento») ---- */
  @media (prefers-reduced-motion: no-preference) {
    .cmo-test__a { animation: cmo-a 10s ease-in-out infinite; }
    .cmo-test__b { animation: cmo-b 10s ease-in-out infinite; }
    .cmo-test__a .cmo-barra i { animation: cmo-prog 10s ease-in-out infinite; }
    .cmo-op--1 { animation: cmo-sel1 10s infinite; } .cmo-op--2 { animation: cmo-sel2 10s infinite; }
    .cmo-test__b .cmo-rasgos i::after { animation: cmo-llena 10s ease-out infinite; }
    .cmo-pant.activa .cmo-cam__it { animation: cmo-sube 700ms cubic-bezier(0.2, 0.8, 0.2, 1) both; }
    .cmo-pant.activa .cmo-cam__it--2 { animation-delay: 140ms; } .cmo-pant.activa .cmo-cam__it--3 { animation-delay: 280ms; }
