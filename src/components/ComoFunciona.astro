    .cmo__paso:not(.activo) .cmo__texto { opacity: 0.38; }
    .cmo__texto { transition: opacity 400ms ease; }
    .cmo__paso.activo .cmo__n { color: var(--ap-ink); }
    .cmo__fijo { display: block; position: sticky; top: max(7.5rem, calc(50vh - 20rem)); }
    .cmo__escena { position: relative; }
    .cmo__escena::before {
      content: ''; position: absolute; z-index: -1; left: 50%; top: 50%; width: 52rem; height: 52rem; translate: -50% -50%; border-radius: 50%; pointer-events: none;
