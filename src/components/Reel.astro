---
// Tarjeta de vídeo vertical (reel) de un Insider. Se usa en la home y en /acompanamiento.
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  persona: {
    placeholder?: boolean;
    nombre: string;
    edad: number;
    profesion: string;
    cita: string;
    duracion: string;
    foto: ImageMetadata;
    alt: string;
  };
  sizes?: string;
}
const { persona: p, sizes = '(min-width: 64rem) 17rem, 72vw' } = Astro.props;
---

<figure class="reel" data-placeholder={p.placeholder ? 'true' : undefined}>
  <Picture
    src={p.foto}
    formats={['avif', 'webp']}
    widths={[320, 480, 700]}
    sizes={sizes}
    alt={p.alt}
    class="reel__foto"
  />
  <span class="reel__duracion">
    <svg width="10" height="11" viewBox="0 0 10 12" aria-hidden="true"><path d="M1.2 1.2l7.6 4.8-7.6 4.8z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" /></svg>
    <span class="solo-lector">Vídeo de </span>{p.duracion}
  </span>
  <figcaption class="reel__pie">
    <blockquote class="reel__cita"><p>«{p.cita}»</p></blockquote>
    <span class="reel__nombre">{p.nombre}, {p.edad}</span>
    <span class="reel__profesion">{p.profesion}</span>
  </figcaption>
</figure>

<style>
  /* Reel vertical, el formato que este público ve cada día. La foto ocupa
     toda la tarjeta y el texto va encima, sobre un degradado. */
  .reel {
    position: relative;
    aspect-ratio: 9 / 16;
    max-height: 34rem;
    border-radius: 18px;
    overflow: hidden;
    isolation: isolate;
    background: var(--negro-2);
  }

  .reel :global(.reel__foto),
  .reel :global(picture) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .reel :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 30%;
    transition: scale 400ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .reel::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgb(22 20 18 / 0.35) 0%, rgb(22 20 18 / 0) 22%, rgb(22 20 18 / 0) 42%, rgb(22 20 18 / 0.92) 100%);
    pointer-events: none;
  }

  /* Icono de vídeo discreto: trazo fino junto a la duración, sin tapar la imagen. */
  .reel__duracion {
    position: absolute;
    z-index: 1;
    top: 0.875rem;
    left: 0.875rem;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.3rem 0.65rem;
    border-radius: 999px;
    background: rgb(22 20 18 / 0.55);
    border: 1px solid rgb(236 232 222 / 0.35);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
    color: var(--hueso);
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1.3;
    transition: background-color 200ms ease, border-color 200ms ease, color 200ms ease;
  }

  .reel__pie {
    position: absolute;
    z-index: 1;
    left: 0;
    right: 0;
    bottom: 0;
    display: grid;
    gap: 0.25rem;
    padding: 1.125rem;
    color: var(--hueso);
  }

  .reel__cita {
    font-size: 1.1875rem;
    line-height: 1.15;
    margin-bottom: 0.5rem;
    text-wrap: balance;
  }

  .reel__nombre {
    font-weight: 800;
    font-size: 1rem;
  }

  .reel__profesion {
    font-family: var(--mano);
    font-size: 1rem;
    color: var(--lima);
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .reel:hover :global(img) {
      scale: 1.04;
    }
    .reel:hover .reel__duracion {
      background: var(--lima);
      border-color: var(--lima);
      color: var(--negro);
    }
  }

</style>
