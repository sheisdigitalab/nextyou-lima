---
// «¿Qué es NextYou?» contado como la historia de Lucía (v5).
// Referencia: exploracion/demo-producto-propuesta-v2.html · comentarios 9, 12 y 13 de Sara.
// Sustituye a los antiguos «¿Qué es NextYou?» (demo de 4 pasos) y «Lo que no va a pasar».
// Contenido en src/data/home.ts → historiaLucia. Personajes y fotos: PLACEHOLDER.
import { Image, getImage } from 'astro:assets';
import { CTA_PRINCIPAL } from '../config';
import { historiaLucia as h } from '../data/home';

const e = h.escenas;
const primero = h.pasos[0];
const poster = (await getImage({ src: e.dentro.foto, width: 640, format: 'webp' })).src;
---

<section id="como-funciona" class="historia sobre-claro" aria-labelledby="hero-titulo" data-placeholder="true">
  <Fragment set:html="<!-- PLACEHOLDER: Lucía, Laura, Iván, Dani y Marta son personajes de muestra; sustituir por personas reales -->" />
  <div class="ancho">
    <!-- h1 de la página: el texto completo para buscadores («¿No sabes qué estudiar? Haz el test gratis…») -->
    <header class="historia__intro">
      <h1 id="hero-titulo" class="historia__h1">
        <span class="historia__pregunta">¿No sabes qué estudiar?</span>
        <span class="historia__resto">Haz el test gratis y descubre <em>a qué te podrías dedicar</em>.</span>
      </h1>
      <p class="historia__entrada">{h.entrada}</p>
    </header>

    <div class="historia__bloque" style={`--gx: ${primero.brillo}`}>
      <header class="historia__cab">
        <p class="historia__etiqueta">{h.etiqueta}</p>
        <h2 id="historia-titulo" class="historia__titulo">{h.titulo} <span class="historia__mano">{h.mano}</span></h2>
      </header>

      <div class="escenario">
        <!-- Lucía: su foto, lo que piensa en cada paso y cómo lo ve -->
        <div class="lucia">
          <figure class="lucia__polaroid">
            <span class="lucia__cinta" aria-hidden="true"></span>
            <Image src={h.lucia.foto} alt={h.lucia.alt} width={560} height={640} quality={70} class="lucia__foto" />
            <figcaption>{h.lucia.nombre} <span>· {h.lucia.detalle}</span></figcaption>
          </figure>
          <p class="lucia__voz" data-voz>{primero.voz}</p>
          <!-- Solo se anuncia cuando la persona cambia de paso, nunca con el avance automático -->
          <p class="solo-lector" role="status" data-anuncio></p>
          <div class="animo" aria-hidden="true">
            <small>{h.animo.titulo}</small>
            <div class="animo__tira">
              {h.pasos.map((_, i) => <i class:list={{ on: i < primero.animo }} />)}
            </div>
            <div class="animo__ext"><span>{h.animo.desde}</span><span>{h.animo.hasta}</span></div>
          </div>
        </div>

        <!-- El móvil con las cinco escenas (ilustración: los lectores de pantalla siguen la lista de pasos) -->
        <div class="centro">
          <div class="tel" aria-hidden="true">
            <div class="tel__pantalla">
              <div class="tel__notch"></div>

              <div class="capa activa" data-capa="0">
                <p class="mini">{e.inicio.paso}</p>
                <div class="barrita"><i class="on"></i><i></i><i></i><i></i></div>
                <p class="tit">{e.inicio.pregunta}</p>
                <div class="opc">
                  {e.inicio.opciones.map((o, i) => <div class:list={{ sel: i === e.inicio.elegida }}>{o}</div>)}
                </div>
                <p class="mini capa__pie">{e.inicio.pie}</p>
              </div>

              <div class="capa" data-capa="1">
                <p class="mini">{e.misiones.paso}</p>
                <div class="barrita"><i class="on"></i><i class="on"></i><i></i><i></i></div>
                <div class="pila">
                  {e.misiones.cartas.map((c) => (
                    <div class="carta">
                      <p class="mini">¿Te apetece?</p>
                      <p class="carta__tx">{c.tarea}</p>
                      {c.foto && (
                        <div class="carta__de">
                          <Image src={c.foto} alt="" width={68} height={68} quality={60} />
                          <span>Esto lo hace <b>{c.quien}</b>{c.detalle && ` · ${c.detalle}`}</span>
                        </div>
                      )}
                    </div>
                  ))}
                </div>
                <div class="resp">
                  {e.misiones.respuestas.map((r, i) => <span class:list={{ p: i === 3 }}>{r}</span>)}
                </div>
              </div>

              <div class="capa" data-capa="2">
                <p class="mini">Tus tres caminos</p>
                <p class="tit capa__tit">{e.caminos.titulo}</p>
                <div class="caminos">
                  {e.caminos.lista.map((c) => (
                    <div class="camino">
                      {c.foto ? <Image src={c.foto} alt="" width={104} height={104} quality={60} /> : <span class="camino__ph" />}
                      <div><b>{c.tipo}</b><span>{c.profesion}</span></div>
                    </div>
                  ))}
                </div>
                <p class="capa__pie">{e.caminos.pie}</p>
              </div>

              <div class="capa capa--llena" data-capa="3">
                <div class="llamada">
                  <Image src={e.coach.foto} alt="" width={640} height={1100} quality={65} class="llamada__foto" />
                  <div class="llamada__cab"><span>{e.coach.nombre} · {e.coach.rol}</span><span>● {e.coach.hora}</span></div>
                  <div class="llamada__yo"><Image src={h.lucia.foto} alt="" width={150} height={200} quality={60} /></div>
                  <p class="llamada__sub"><b>{e.coach.nombre}</b>{e.coach.frase}</p>
                  <div class="llamada__ctrl"><i></i><i class="r"></i><i></i></div>
                </div>
              </div>

              <div class="capa capa--llena" data-capa="4">
                <div class="dani">
                  {e.dentro.video ? (
                    <video class="dani__media" src={e.dentro.video} poster={poster} muted loop playsinline preload="none" data-video />
                  ) : (
                    <Image src={e.dentro.foto} alt="" width={640} height={1100} quality={65} class="dani__media" />
                  )}
                  <p class="mini dani__top">{e.dentro.etiqueta}</p>
                  {!e.dentro.video && <div class="dani__play">▶</div>}
                  <div class="dani__pie">
                    <span class="dani__stk">{e.dentro.cita}</span>
                    <p class="dani__nombre">{e.dentro.nombre}</p>
                    <p class="dani__ruta">{e.dentro.ruta}</p>
                    <div class="dani__bt">{e.dentro.boton}</div>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <div class="puntos" role="group" aria-label="Pasos de la historia">
            {h.pasos.map((p, i) => (
              <button type="button" data-ir={i} aria-label={`Paso ${i + 1}: ${p.titulo}. ${p.pantalla}`} aria-current={i === 0 ? 'step' : undefined} class:list={{ on: i === 0 }} />
            ))}
          </div>
          <p class="ley" aria-hidden="true"><small data-ley-c>{primero.cuando}</small><b data-ley-t>{primero.titulo}</b></p>
          <button type="button" class="pausa" data-pausa>Pausar</button>
        </div>

        <!-- Línea de tiempo: también es la versión sin JavaScript -->
        <ol class="linea" aria-label="El recorrido de Lucía">
          {h.pasos.map((p, i) => (
            <li class:list={{ on: i === 0 }} data-paso={i}>
              <button type="button" data-ir={i} aria-current={i === 0 ? 'step' : undefined}>
                <span class="linea__pt" aria-hidden="true">{i + 1}</span>
                <span>
                  <span class="linea__cu">{p.cuando}{p.siQuiere && <span class="linea__si">si quiere</span>}</span>
                  <span class="linea__tt">{p.titulo}</span>
                  <span class="solo-lector">{p.pantalla}</span>
                </span>
              </button>
            </li>
          ))}
        </ol>
      </div>

      <div class="historia__pie">
        <Fragment set:html="<!-- PENDIENTE: CTA a revisar con la propuesta de Elias (comentario #14) -->" />
        <a href={CTA_PRINCIPAL.href} class="boton boton--grande">{h.boton} <span aria-hidden="true">→</span></a>
        <ul class="nopasa" role="list" aria-label="Lo que no va a pasar">
          {h.noVaAPasar.map((t) => (
            <li>
              <svg width="14" height="14" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8.5l3 3L13 4.5" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
              {t}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<script define:vars={{ pasos: h.pasos }}>
  (function () {
    var raiz = document.getElementById('como-funciona');
    if (!raiz) return;
    var bloque = raiz.querySelector('.historia__bloque');
    var capas = Array.prototype.slice.call(raiz.querySelectorAll('.capa'));
    var items = Array.prototype.slice.call(raiz.querySelectorAll('.linea li'));
    var tira = Array.prototype.slice.call(raiz.querySelectorAll('.animo__tira i'));
    var puntos = Array.prototype.slice.call(raiz.querySelectorAll('.puntos button'));
    var voz = raiz.querySelector('[data-voz]');
    var leyC = raiz.querySelector('[data-ley-c]');
    var leyT = raiz.querySelector('[data-ley-t]');
    var pausa = raiz.querySelector('[data-pausa]');
    var video = raiz.querySelector('[data-video]');
    var anuncio = raiz.querySelector('[data-anuncio]');
    var mql = window.matchMedia('(prefers-reduced-motion: reduce)');
    var quieto = mql.matches;
    var actual = 0, reloj = null, pausado = quieto, visible = false;

    function ir(i) {
      actual = i;
      capas.forEach(function (c, k) {
        c.classList.remove('activa');
        if (k === i) { void c.offsetWidth; c.classList.add('activa'); }
      });
      items.forEach(function (li, k) {
        li.classList.toggle('on', k === i);
        li.classList.toggle('hecho', k < i);
        var b = li.querySelector('button');
        if (k === i) b.setAttribute('aria-current', 'step'); else b.removeAttribute('aria-current');
      });
      puntos.forEach(function (b, k) {
        b.classList.toggle('on', k === i);
        if (k === i) b.setAttribute('aria-current', 'step'); else b.removeAttribute('aria-current');
      });
      tira.forEach(function (x, k) { x.classList.toggle('on', k < pasos[i].animo); });
      if (quieto) { voz.textContent = pasos[i].voz; }
      else {
        voz.classList.add('cambia');
        setTimeout(function () { voz.textContent = pasos[i].voz; voz.classList.remove('cambia'); }, 250);
      }
      leyC.textContent = pasos[i].cuando + (pasos[i].siQuiere ? ' · si quiere' : '');
      leyT.textContent = pasos[i].titulo;
      bloque.style.setProperty('--gx', pasos[i].brillo);
      if (video) { if (i === 4) video.play().catch(function () {}); else video.pause(); }
    }
    function arrancar() {
      clearInterval(reloj);
      if (pausado || !visible) return;
      reloj = setInterval(function () { ir((actual + 1) % capas.length); }, 6500);
    }
    function parar() {
      pausado = true; clearInterval(reloj);
      pausa.textContent = 'Reproducir';
    }
    raiz.querySelectorAll('[data-ir]').forEach(function (b) {
      b.addEventListener('click', function () {
        var n = Number(b.dataset.ir);
        ir(n); parar();
        anuncio.textContent = 'Paso ' + (n + 1) + ': ' + pasos[n].titulo + '. Lucía piensa: ' + pasos[n].voz;
      });
    });
    pausa.addEventListener('click', function () {
      if (pausado) { pausado = false; pausa.textContent = 'Pausar'; arrancar(); }
      else parar();
    });
    // Si alguien entra con el teclado en el bloque, se para el avance automático
    raiz.addEventListener('focusin', function () { if (!pausado) parar(); });
    // Solo avanza mientras el bloque está en pantalla
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(function (es) {
        es.forEach(function (en) { visible = en.isIntersecting; if (visible) arrancar(); else clearInterval(reloj); });
      }, { threshold: 0.35 }).observe(bloque);
    } else { visible = true; }
    if (quieto) parar();
    // Si la persona activa «reducir movimiento» con la página abierta, se para
    mql.addEventListener && mql.addEventListener('change', function (ev) { quieto = ev.matches; if (quieto) parar(); });
    ir(0);
    arrancar();
  })();
</script>

<style>
  .historia { background: var(--papel); padding-block: var(--aire); }
  .historia__bloque {
    position: relative; isolation: isolate; overflow: hidden;
    padding: clamp(3rem, 2rem + 3vw, 4.5rem) clamp(1rem, 0.25rem + 3vw, 3rem) clamp(2.75rem, 2rem + 2vw, 3.5rem);
    border-radius: 28px; background: var(--negro); color: var(--crema);
  }
  .historia__bloque::before {
    content: ''; position: absolute; inset: 0; z-index: -1;
    background: radial-gradient(600px 400px at var(--gx, 30%) 55%, color-mix(in srgb, var(--acento) 12%, transparent), transparent 70%);
  }

  /* Cabecera */
  .historia__cab { max-width: 52rem; margin: 0 auto clamp(2rem, 1.5rem + 2vw, 2.75rem); text-align: center; }
  .historia__etiqueta { font-size: var(--t1); font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase; color: var(--acento-texto); }
  .historia__titulo { margin-top: 0.875rem; font-family: var(--titular); font-weight: 800; font-stretch: 105%; font-size: var(--t5); line-height: 1.02; letter-spacing: -0.025em; }
  .historia__mano { display: block; font-family: var(--mano); font-weight: 400; font-stretch: normal; letter-spacing: 0; font-size: 1.05em; color: var(--acento-texto); }
  .historia__intro { display: grid; justify-items: center; gap: 1.25rem; max-width: 50rem; margin: 0 auto clamp(2.5rem, 2rem + 2.5vw, 4rem); text-align: center; color: var(--negro); }
  .historia__h1 { display: grid; justify-items: center; gap: 0.75rem; font-family: var(--titular); font-weight: 800; font-stretch: 105%; letter-spacing: -0.025em; }
  .historia__pregunta { font-size: var(--t5); line-height: 1.02; }
  .historia__resto { font-size: var(--t4); line-height: 1.2; letter-spacing: -0.015em; max-width: 30ch; text-wrap: balance; }
  .historia__entrada { font-size: var(--t3); line-height: 1.55; color: var(--gris-oscuro); max-width: 34rem; text-wrap: balance; }

  /* Escenario: Lucía · móvil · línea de tiempo */
  .escenario { position: relative; display: grid; gap: 1.25rem; justify-items: center; }

  .lucia { position: relative; width: 11.25rem; margin: 1.5rem 0 0 -6.5rem; }
  .lucia__polaroid { position: relative; margin: 0; padding: 0.5rem 0.5rem 2.1rem; border-radius: 6px; background: var(--crema); rotate: -4deg; box-shadow: 0 30px 50px -20px rgb(0 0 0 / 0.7); }
  .lucia__polaroid :global(.lucia__foto) { display: block; width: 100%; height: 11.25rem; object-fit: cover; filter: saturate(0.9); }
  .lucia__cinta { position: absolute; z-index: 1; top: -12px; left: 50%; translate: -50% 0; width: 90px; height: 26px; background: var(--acento); opacity: 0.9; rotate: 3deg; }
  .lucia__polaroid figcaption { position: absolute; left: 0.625rem; bottom: 0.5rem; color: var(--negro); font-size: var(--t1); font-weight: 800; }
  .lucia__polaroid figcaption span { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; font-weight: 400; color: var(--gris-oscuro); }
  .lucia__voz {
    position: absolute; top: -1.6rem; right: -8.75rem; max-width: 10rem; padding: 0.625rem 0.875rem;
    border-radius: 18px 18px 18px 4px; background: var(--crema); color: var(--negro);
    font-family: var(--mano); font-size: 1.125rem; line-height: 1.15; rotate: 3deg;
    box-shadow: 0 14px 30px -10px rgb(0 0 0 / 0.6); transition: opacity 250ms ease, scale 250ms ease;
  }
  .lucia__voz.cambia { opacity: 0; scale: 0.9; }
  .animo { display: none; margin-top: 1.625rem; rotate: -4deg; }
  .animo small { font-size: 0.75rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--gris); }
  .animo__tira { display: flex; gap: 4px; margin-top: 0.5rem; }
  .animo__tira i { flex: 1; height: 6px; border-radius: 6px; background: var(--tarjeta); transition: background 400ms ease; }
  .animo__tira i.on { background: var(--acento); }
  .animo__ext { display: flex; justify-content: space-between; margin-top: 0.375rem; font-size: 0.75rem; color: var(--gris); }

  .centro { display: grid; justify-items: center; }
  .tel { text-align: left; position: relative; width: 18.5rem; height: 37.5rem; padding: 0.75rem; border-radius: 46px; background: #0b0a09; box-shadow: 0 50px 90px -30px rgb(0 0 0 / 0.9), 0 0 0 2px #3a342e, inset 0 0 0 5px var(--negro); }
  .tel__pantalla { position: relative; height: 100%; overflow: hidden; border-radius: 36px; background: #121110; }
  .tel__notch { position: absolute; z-index: 9; top: 10px; left: 50%; translate: -50% 0; width: 92px; height: 24px; border-radius: 20px; background: #000; }

  /* Capas (pantallas) */
  .capa { position: absolute; inset: 0; display: flex; flex-direction: column; padding: 3.1rem 1.125rem 1.125rem; opacity: 0; transform: translateY(16px) scale(0.98); transition: opacity 500ms ease, transform 500ms cubic-bezier(0.23, 1, 0.32, 1); pointer-events: none; font-size: 0.875rem; }
  .capa.activa { opacity: 1; transform: none; }
  .capa--llena { padding: 0; }
  .mini { font-size: 0.6875rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--gris); }
  .barrita { display: flex; gap: 4px; margin: 0.625rem 0 1rem; }
  .barrita i { flex: 1; height: 4px; border-radius: 4px; background: var(--tarjeta); }
  .barrita i.on { background: var(--acento); }
  .tit { font-weight: 800; font-size: 1.375rem; line-height: 1.18; }
  .capa__tit { margin-top: 0.5rem; }
  .capa__pie { margin-top: auto; text-align: center; text-transform: none; letter-spacing: 0.02em; font-size: 0.75rem; color: var(--gris); }
  .opc { display: grid; gap: 0.5rem; margin-top: 0.875rem; }
  .opc div { padding: 0.75rem 0.875rem; border: 1.5px solid var(--tarjeta); border-radius: 14px; font-weight: 600; }
  .capa.activa .opc div.sel { animation: elige 300ms 1.3s forwards; }
  @keyframes elige { to { background: var(--acento); color: var(--acento-txt); border-color: var(--acento); } }
  .pila { position: relative; height: 15.5rem; margin-top: 0.25rem; }
  .carta { position: absolute; inset: 0; display: flex; flex-direction: column; padding: 1.125rem; border-radius: 20px; background: var(--tarjeta); border: 1px solid #3a342e; }
  .carta__tx { margin-top: 0.5rem; font-weight: 800; font-size: 1.25rem; line-height: 1.2; }
  .carta__de { display: flex; gap: 0.625rem; align-items: center; margin-top: auto; font-size: 0.75rem; color: var(--gris); opacity: 0; }
  .carta__de :global(img) { width: 34px; height: 34px; border-radius: 50%; object-fit: cover; }
  .carta__de b { color: var(--crema); }
  .carta:nth-child(1) { transform: rotate(4deg) translateY(10px); opacity: 0.5; }
  .carta:nth-child(2) { transform: rotate(-3deg) translateY(5px); opacity: 0.75; }
  .capa.activa .carta:nth-child(3) { animation: vuela 600ms 3.2s forwards; }
  .capa.activa .carta:nth-child(3) .carta__de { animation: aparece 300ms 1.8s forwards; }
  .capa.activa .carta:nth-child(2) .carta__de { animation: aparece 10ms 3.4s forwards; }
  @keyframes vuela { to { transform: translateX(130%) rotate(16deg); opacity: 0; } }
  @keyframes aparece { to { opacity: 1; } }
  .resp { display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem; margin-top: 1rem; }
  .resp span { padding: 0.7rem; border: 1.5px solid var(--tarjeta); border-radius: 12px; text-align: center; font-weight: 600; font-size: 0.8125rem; }
  .capa.activa .resp span.p { animation: elige 250ms 1.2s forwards; }
  .camino { display: flex; gap: 0.75rem; align-items: center; margin-top: 0.625rem; padding: 0.75rem; border-radius: 16px; background: var(--tarjeta); border: 1px solid #3a342e; opacity: 0; transform: translateY(18px); }
  .camino :global(img), .camino__ph { flex: none; width: 52px; height: 52px; border-radius: 12px; object-fit: cover; }
  .camino__ph { background: linear-gradient(135deg, #4b3f35, #2a2420); }
  .camino b { display: block; font-size: 0.625rem; font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase; color: var(--acento-texto); }
  .camino span { display: block; margin-top: 2px; font-weight: 700; font-size: 0.9375rem; }
  .capa.activa .camino { animation: sube 450ms forwards; }
  .capa.activa .camino:nth-child(2) { animation-delay: 450ms; }
  .capa.activa .camino:nth-child(3) { animation-delay: 900ms; }
  @keyframes sube { to { opacity: 1; transform: none; } }
  .llamada, .dani { position: absolute; inset: 0; }
  .llamada :global(.llamada__foto), .dani :global(.dani__media) { width: 100%; height: 100%; object-fit: cover; }
  .llamada::after { content: ''; position: absolute; inset: 0; background: linear-gradient(transparent 45%, rgb(0 0 0 / 0.85)); }
  .llamada__cab { position: absolute; z-index: 2; top: 2.9rem; left: 1rem; right: 1rem; display: flex; justify-content: space-between; font-size: 0.75rem; font-weight: 700; }
  .llamada__cab span:last-child { padding: 3px 8px; border-radius: 999px; background: rgb(0 0 0 / 0.5); }
  .llamada__yo { position: absolute; z-index: 2; top: 5rem; right: 0.875rem; width: 74px; height: 100px; overflow: hidden; border-radius: 14px; border: 2px solid rgb(255 255 255 / 0.4); }
  .llamada__yo :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .llamada__sub { position: absolute; z-index: 2; left: 0.875rem; right: 0.875rem; bottom: 5.4rem; font-size: 0.875rem; line-height: 1.3; opacity: 0; }
  .llamada__sub b { display: block; margin-bottom: 3px; font-size: 0.75rem; color: var(--acento-texto); }
  .capa.activa .llamada__sub { animation: aparece 400ms 900ms forwards; }
