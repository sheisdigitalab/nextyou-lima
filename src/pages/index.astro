  /* Personas con las que puedes hablar: foto, nombre y un camino dibujado con línea fina */
  .v7gente__lista { gap: 2rem 1.5rem; }
  .v7gente__item { display: grid; align-content: start; gap: 0; }
  .v7vid { aspect-ratio: 4 / 3; border-radius: 16px; }
  .v7vid::after { background: linear-gradient(to bottom, rgb(22 20 18 / 0.5), transparent 38%); }
  .v7vid__tag { left: 0.75rem; top: 0.75rem; bottom: auto; padding: 0.2rem 0.65rem; background: rgb(22 20 18 / 0.55); -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px); font-size: 0.875rem; font-weight: 600; }
  .v7gente__nom { display: grid; gap: 0.15rem; margin-top: 1.25rem; }
  .v7gente__nom strong { font-family: var(--titular); font-weight: 800; font-stretch: 105%; font-size: var(--t3); line-height: 1.15; letter-spacing: -0.01em; }
  .v7gente__nom span { font-size: var(--t2); color: var(--gris-oscuro); line-height: 1.4; }
  @media (min-width: 48rem) { .v7gente__nom span { min-height: 2.8em; } }
  .v7gente__camino { position: relative; list-style: none; margin: 1.25rem 0 0; padding: 0 0 0 1.375rem; display: grid; gap: 0.875rem; }
  .v7gente__camino::before { content: ''; position: absolute; left: 3px; top: 0.6em; bottom: 0.6em; width: 1px; background: rgb(22 20 18 / 0.3); }
  .v7gente__camino li { position: relative; font-size: var(--t2); line-height: 1.35; color: var(--negro); }
  .v7gente__camino li::before { content: ''; position: absolute; left: -1.375rem; top: 0.45em; width: 7px; height: 7px; border-radius: 50%; background: var(--crema); border: 1px solid rgb(22 20 18 / 0.55); box-sizing: border-box; }
  .v7gente__camino li:last-child { font-weight: 700; }
  .v7gente__camino li:last-child::before { background: var(--acento); border-color: var(--negro); }

  /* Menos vacío en «Cómo funciona»: el titular a todo el ancho, los pasos más juntos y el móvil mucho más grande */
  .v7como__frase { max-width: 24ch; text-wrap: balance; }
  @media (min-width: 64rem) {
    .v7como__cab { grid-template-columns: 1fr !important; margin-bottom: 2.5rem !important; }
    .v7como__frase { grid-column: 1 / -1 !important; grid-row: auto !important; max-width: 24ch; }
    .v7demo { grid-template-columns: minmax(0, 1fr) auto; gap: clamp(4rem, 3rem + 6vw, 9rem); align-items: start; }
    .v7demo__fijo { justify-self: end; }
    .v7paso { min-height: 62svh !important; }
    .v7paso:first-child { min-height: 52svh !important; }
    .v7paso__texto { max-width: 30rem; }
    .v7demo__fijo { top: max(10.5rem, calc(50svh - 15rem)) !important; padding-block: 0 !important; }
    .v7tel--fijo { width: 15.5rem !important; zoom: 1.12; }
  }
  @media (min-width: 64rem) and (min-height: 820px) { .v7tel--fijo { zoom: 1.2; } }
  @media (min-width: 64rem) and (min-height: 940px) { .v7tel--fijo { zoom: 1.28; } }
  @media (min-width: 64rem) and (max-height: 700px) { .v7tel--fijo { zoom: 1; } }
  /* en móvil, cada paso lleva su pantalla un poco más grande */
  @media (max-width: 63.99rem) { .v7tel--paso { width: min(100%, 19rem); } }

  /* ===== Comparador de animaciones de «Cómo funciona» (solo escritorio; ?anim=1|2|3) =====
     1 · Deslizar como una app: las pantallas del móvil entran de lado y los pasos no se apagan.
     2 · Solo fundido: las pantallas se funden sin moverse y los pasos no se apagan.
     3 · Trazo: las pantallas se funden con un mínimo de escala; el número del paso se rellena al activarse. */
  @media (min-width: 64rem) and (prefers-reduced-motion: no-preference) {
    .v7demo[data-anim-como] .v7paso__n:not(.v7paso__n--premium) { transition: color 500ms ease, -webkit-text-stroke-color 500ms ease; }
    .v7demo[data-anim-como] .v7paso.activo .v7paso__n:not(.v7paso__n--premium) { color: var(--negro) !important; -webkit-text-stroke-color: var(--negro); }
    /* 1 · deslizar */
    .v7demo[data-anim-como="1"] .v7tel--fijo .v7pant { opacity: 1; transform: translateX(-104%); transition: transform 700ms cubic-bezier(0.2, 0.8, 0.2, 1); }
    .v7demo[data-anim-como="1"] .v7tel--fijo .v7pant.activa ~ .v7pant { transform: translateX(104%); }
    .v7demo[data-anim-como="1"] .v7tel--fijo .v7pant.activa { transform: none; }
    .v7demo[data-anim-como="1"] .v7paso:not(.activo) .v7paso__texto { opacity: 1; }
    /* 2 · fundido */
    .v7demo[data-anim-como="2"] .v7tel--fijo .v7pant { opacity: 0; transform: none; transition: opacity 800ms ease; }
    .v7demo[data-anim-como="2"] .v7tel--fijo .v7pant.activa { opacity: 1; }
    .v7demo[data-anim-como="2"] .v7paso:not(.activo) .v7paso__texto { opacity: 1; }
    /* 3 · trazo */
    .v7demo[data-anim-como="3"] .v7tel--fijo .v7pant { opacity: 0; transform: scale(0.97); transition: opacity 600ms ease, transform 900ms cubic-bezier(0.2, 0.8, 0.2, 1); }
    .v7demo[data-anim-como="3"] .v7tel--fijo .v7pant.activa { opacity: 1; transform: none; }
    .v7demo[data-anim-como="3"] .v7paso:not(.activo) .v7paso__texto { opacity: 0.5; }
    .v7demo[data-anim-como="3"] .v7paso__n:not(.v7paso__n--premium)::after { width: 0; transition: width 900ms cubic-bezier(0.2, 0.8, 0.2, 1); }
    .v7demo[data-anim-como="3"] .v7paso.activo .v7paso__n:not(.v7paso__n--premium)::after { width: 100%; }
  }

  /* Halo de círculos finos detrás del móvil de «Cómo funciona» (solo escritorio): llena el hueco con trazo fino */
  @media (min-width: 64rem) {
    .v7como { overflow-x: clip; }
    .v7demo__fijo::before {
      content: ''; position: absolute; z-index: -1; left: 50%; top: 50%; width: 62rem; height: 62rem; translate: -50% -50%; border-radius: 50%; pointer-events: none;
      background: repeating-radial-gradient(circle at center, transparent 0 4rem, rgb(22 20 18 / 0.16) 4rem calc(4rem + 1px));
      -webkit-mask: radial-gradient(circle, #000 0 18%, transparent 62%); mask: radial-gradient(circle, #000 0 18%, transparent 62%);
    }
    .v7demo__fijo::after {
      content: ''; position: absolute; z-index: -1; left: 50%; top: 50%; width: 36rem; height: 36rem; translate: -50% -50%; border-radius: 50%; pointer-events: none;
      background: radial-gradient(circle at 18% 30%, var(--acento) 0 5px, transparent 6px), radial-gradient(circle at 86% 62%, var(--negro) 0 4px, transparent 5px), radial-gradient(circle at 30% 88%, var(--negro) 0 3px, transparent 4px);
    }
  }

  /* ---------- Textos legibles: nada por debajo de 14 px, tampoco dentro de las pantallas de los móviles ---------- */
  .v7tel { --pt: 0.875rem; }
  @media (min-width: 64rem) { .v7tel--fijo { --pt: 0.8125rem; } }
  @media (min-width: 64rem) and (max-height: 700px) { .v7tel--fijo { --pt: 0.875rem; } }
  .paletas__titulo, .paletas button { font-size: 0.875rem; }
