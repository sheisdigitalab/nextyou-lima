      .v7llam__tu { position: absolute; right: 0.5rem; top: 0.5rem; display: grid; place-items: center; width: 2.6rem; height: 3.4rem; border-radius: 8px; border: 1.5px solid rgb(246 241 232 / 0.7); background: #2b2622; font-size: 0.6rem; font-weight: 800; }
      .v7llam__burbuja { align-self: flex-start; max-width: 92%; margin-top: -1.6rem; position: relative; padding: 0.55rem 0.7rem; border-radius: 12px 12px 12px 3px; background: var(--crema); color: var(--negro); font-weight: 700; font-size: 0.72rem; line-height: 1.3; }
