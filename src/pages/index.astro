---
// Portada de la web (paleta Lima). Los textos y fotos de la última revisión con la clienta están en src/data/lima.ts.
import { Image, Picture, getImage } from 'astro:assets';
import V5 from '../layouts/V5.astro';
import LogoV3 from '../components/LogoV3.astro';
import { SITIO, BASE, ENLACES, CTA_PRINCIPAL } from '../config';
import caveat from '../assets/fonts/caveat.woff2?url';
import { hero, losDeDentro, familias, sara, uniNoUnico, queEsV5 } from '../data/home';
import { queEsV7, comoV7, pasosV7, unicoV7Cambios, hugoV7 } from '../data/v7';
import { queV5 as q, bifurcacion, historiasUni, testDemo } from '../data/v4';
import { unicoLima as noEresElUnico, comoAppLima as comoAppV7 } from '../data/lima';
import { universidad as uni } from '../data/universidad';
import { familiasPagina } from '../data/familias';
import profArq from '../assets/muestra/prof-arq.jpg';
import profCoc from '../assets/muestra/prof-coc.jpg';
import profDev from '../assets/muestra/prof-dev.jpg';
import profEle from '../assets/muestra/prof-ele.jpg';
import profFis from '../assets/muestra/prof-fis.jpg';
import profFot from '../assets/muestra/prof-fot.jpg';
import profPer from '../assets/muestra/prof-per.jpg';
import profEnf from '../assets/muestra/prof-enf.jpg';
const modos = familiasPagina.modos;

// PLACEHOLDER: ocho profesionales de muestra (fotos de banco de imágenes, datos inventados). PENDIENTE: sustituir por personas reales
const masDentro = [
  {
    placeholder: true, nombre: 'Pol', edad: 31, profesion: 'Arquitectura', cita: 'Dibujaba casas en los márgenes del cuaderno.', duracion: '3 min',
    video: null as string | null, subtitulos: null as string | null, foto: profArq,
    camino: ['Empezó Derecho', 'Arquitectura', 'Diseña viviendas'],
    estudios: 'Un año de Derecho y después Arquitectura',
    primerTrabajo: 'Delineante en un estudio pequeño',
    martes: 'Visita una obra por la mañana, revisa planos con el aparejador y por la tarde ajusta el proyecto con el cliente.',
    alt: 'Pol, sentado en su mesa de trabajo, sonriendo.',
  },
  {
    placeholder: true, nombre: 'Jordi', edad: 29, profesion: 'Cocina', cita: 'Empecé fregando platos y no he salido de la cocina.', duracion: '2 min',
    video: null as string | null, subtitulos: null as string | null, foto: profCoc,
    camino: ['Empezó Turismo', 'Escuela de hostelería', 'Jefe de partida'],
    estudios: 'Dos años de Turismo y después un ciclo de cocina',
    primerTrabajo: 'Ayudante de cocina en un restaurante de barrio',
    martes: 'Prepara el mise en place a primera hora, cocina el servicio de mediodía y por la tarde planea el menú de la semana.',
    alt: 'Jordi, cortando verduras en la cocina de un restaurante.',
  },
  {
    placeholder: true, nombre: 'Raúl', edad: 26, profesion: 'Desarrollo de software', cita: 'Aprendí a programar de noche, con vídeos.', duracion: '2 min',
    video: null as string | null, subtitulos: null as string | null, foto: profDev,
    camino: ['Empezó Económicas', 'Bootcamp de programación', 'Desarrolla apps'],
    estudios: 'Un año de Económicas y un bootcamp de seis meses',
    primerTrabajo: 'Desarrollador junior en una consultora',
    martes: 'Revisa el código del equipo, arregla errores que le han llegado y por la tarde construye una pantalla nueva.',
    alt: 'Raúl, con gafas y la mano en la barbilla, concentrado delante del ordenador.',
  },
  {
    placeholder: true, nombre: 'Samir', edad: 35, profesion: 'Electricidad', cita: 'Quería trabajar con las manos y que se notara.', duracion: '3 min',
    video: null as string | null, subtitulos: null as string | null, foto: profEle,
    camino: ['Empezó Bachillerato', 'FP de Electricidad', 'Instalador autónomo'],
    estudios: 'Un ciclo de FP de Instalaciones eléctricas',
    primerTrabajo: 'Ayudante de un electricista veterano',
    martes: 'Visita dos casas por la mañana, monta un cuadro eléctrico y por la tarde pasa presupuestos.',
    alt: 'Samir, con casco blanco, sonriendo a cámara.',
  },
  {
    placeholder: true, nombre: 'Nerea', edad: 30, profesion: 'Fisioterapia', cita: 'Una lesión mía me cambió la carrera.', duracion: '2 min',
    video: null as string | null, subtitulos: null as string | null, foto: profFis,
    camino: ['Empezó Biología', 'Fisioterapia', 'Clínica propia'],
    estudios: 'Dos años de Biología y después el grado de Fisioterapia',
    primerTrabajo: 'Fisioterapeuta en un gimnasio',
    martes: 'Atiende a siete pacientes en la clínica, prepara ejercicios personalizados y por la tarde da una clase de movilidad.',
    alt: 'Nerea, sonriendo y mirando hacia un lado.',
  },
  {
    placeholder: true, nombre: 'Carla', edad: 28, profesion: 'Fotografía', cita: 'Empecé retratando a mis amigas con el móvil.', duracion: '2 min',
    video: null as string | null, subtitulos: null as string | null, foto: profFot,
    camino: ['Empezó Publicidad', 'Curso de fotografía', 'Fotógrafa freelance'],
    estudios: 'Publicidad y un curso intensivo de fotografía',
    primerTrabajo: 'Ayudante en un estudio de moda',
    martes: 'Hace una sesión por la mañana, edita las fotos al mediodía y por la tarde responde presupuestos.',
    alt: 'Carla, sentada en unas escaleras con la cámara.',
  },
  {
    placeholder: true, nombre: 'Irene', edad: 33, profesion: 'Periodismo', cita: 'Quería contar lo que nadie estaba contando.', duracion: '3 min',
    video: null as string | null, subtitulos: null as string | null, foto: profPer,
    camino: ['Empezó Filología', 'Periodismo', 'Reportera de radio'],
    estudios: 'Dos años de Filología y después Periodismo',
    primerTrabajo: 'Becaria en la redacción de un periódico local',
    martes: 'Va a la reunión de la mañana, sale a grabar una entrevista y por la tarde escribe y monta la pieza.',
    alt: 'Irene, de pie con los brazos cruzados, sobre fondo blanco.',
  },
  {
    placeholder: true, nombre: 'Mar', edad: 37, profesion: 'Enfermería', cita: 'Pasé de querer ser médica a querer cuidar.', duracion: '2 min',
    video: null as string | null, subtitulos: null as string | null, foto: profEnf,
    camino: ['Empezó Medicina', 'Enfermería', 'Enfermera de urgencias'],
    estudios: 'Un año de Medicina y después el grado de Enfermería',
    primerTrabajo: 'Enfermera en planta de un hospital',
    martes: 'Entra al turno de mañana, pasa visita con el equipo y atiende a los pacientes que llegan a urgencias.',
    alt: 'Mar, con uniforme azul, sentada en un taburete.',
  },
];
const reels = await Promise.all(
  [...losDeDentro.personas, ...masDentro].map(async (p) => ({ ...p, grande: (await getImage({ src: p.foto, width: 900, format: 'webp' })).src }))
);
const insider = reels[0];
const heroGrande = (await getImage({ src: hero.foto, width: 900, format: 'webp' })).src;

// Paso 3 de «Cómo funciona»: entrevistas de ejemplo con gente de «Los de dentro»
// Cromos: personas nuevas (no están en «Los de dentro»). Sin foto todavía: inicial + icono, y póster neutro en el visor
const iconosCromo: Record<string, string> = {
  contenido: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" stroke-linecap="round"><rect x="7" y="2.5" width="10" height="19" rx="2.5"/><circle cx="12" cy="11" r="2.6"/><path d="M10.5 18.5h3"/></svg>',
  animacion: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"><path d="M12 2.5l8.5 4.75v9.5L12 21.5l-8.5-4.75v-9.5z"/><path d="M3.5 7.25L12 12l8.5-4.75M12 12v9.5"/></svg>',
  ciber: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" stroke-linecap="round"><path d="M12 2.5l8 3v6c0 5-3.5 8.5-8 10-4.5-1.5-8-5-8-10v-6z"/><rect x="9" y="10.5" width="6" height="5" rx="1"/><path d="M10 10.5V9a2 2 0 0 1 4 0v1.5"/></svg>',
};
const posterCromo = (inicial: string) => `data:image/svg+xml,${encodeURIComponent(`<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 900 600"><rect width="900" height="600" fill="#24201c"/><text x="450" y="370" font-family="Arial,sans-serif" font-size="260" font-weight="700" fill="#c8f53b" text-anchor="middle">${inicial}</text></svg>`)}`;
// Caras de MUESTRA (banco de imágenes, Unsplash) para Noa, Leo, Aitana y la coach. No son las personas reales: sustituir antes de publicar
import fotoNoa from '../assets/muestra/noa.jpg';
import fotoLeo from '../assets/muestra/laia.jpg'; // foto de muestra pasada por Jenifer (Laia, paso 3)
import fotoAitana from '../assets/muestra/aitana.jpg';
import fotoCoach from '../assets/muestra/coach-4.jpg'; // foto de muestra pasada por Jenifer (coach)
import fotoLeoV from '../assets/muestra/laia.jpg';
import fotoCoachV from '../assets/muestra/coach-v.jpg';
const caraCromo: Record<string, ImageMetadata> = { Noa: fotoNoa, Leo: fotoLeo, Aitana: fotoAitana };
const grandesCromo: Record<string, string> = Object.fromEntries(
  await Promise.all(Object.entries(caraCromo).map(async ([k, v]) => [k, (await getImage({ src: v, width: 900, format: 'webp' })).src]))
);
const cromos = q.pasos[2].cromos!.map((c, n) => ({
  ...c,
  camino: q.pasos[1].ramas![n].tipo,
  img: caraCromo[c.nombre],
  i: undefined as number | undefined,
  r: { edad: c.edad, foto: caraCromo[c.nombre] as ImageMetadata | null, profesion: c.profesion, cita: c.cita, duracion: c.duracion, grande: grandesCromo[c.nombre] ?? posterCromo(c.nombre[0]), video: '', subtitulos: '', camino: c.camino, estudios: c.estudios, primerTrabajo: c.primerTrabajo, martes: c.martes },
}));
// Tambor 3D (móvil): 6 posiciones, cada cromo aparece dos veces
const tambor = [0, 1, 2, 3, 4, 5].map((k) => ({ ...cromos[k % 3], k: k % 3, copia: k >= 3 }));
// «La uni no es el único camino»: trayectorias con foto de muestra (banco de imágenes libre; no repiten a nadie de la home)
import fotoClaudia from '../assets/muestra/uni-claudia.jpg';
import fotoRuben from '../assets/muestra/uni-ruben.jpg';
import fotoHugo from '../assets/muestra/uni-hugo.jpg';
// Sara: foto de MUESTRA de banco de imágenes (Unsplash). No es Sara: sustituir por su foto real antes de publicar
const fotosUni: Record<string, ImageMetadata> = { Claudia: fotoClaudia, 'Rubén': fotoRuben, Hugo: fotoHugo };
const trayectorias = [hugoV7, ...historiasUni.personas].map((r) => ({ ...r, foto: fotosUni[r.nombre] }));

// «¿Qué es NextYou?»: collage de profesiones para probar
const collage = [
  { foto: reels[0].foto, eti: '¿Diseño?' },
  { foto: reels[1].foto, eti: '¿Sonido?' },
  { foto: reels[2].foto, eti: '¿Datos?' },
];

// Vídeo de fondo de la portada (public/videos): una versión para móvil y otra para escritorio
const VIDEO = `${BASE}videos/`;

// Iconos de trazo fino del mapa de «Cómo funciona»
const ICONOS_MAPA: Record<string, string> = {
  test: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" stroke-linecap="round"><rect x="6" y="4" width="12" height="16" rx="1.5"/><path d="M9 9h6M9 12h6M9 15h4"/></svg>',
  caminos: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h6M10 12c3 0 4-5 8-5M10 12c3 0 4 5 8 5M10 12h8"/></svg>',
  persona: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"><circle cx="12" cy="9" r="3.2"/><path d="M5.5 19c1.2-3.2 3.7-4.8 6.5-4.8s5.3 1.6 6.5 4.8"/></svg>',
  coach: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" stroke-linecap="round"><path d="M5 6h14v9H10l-4 3.5V15H5z"/><path d="M9 10.5h6"/></svg>',
};

// Paso 2: icono de cada destino del mapa (mismo orden que las ramas)
const iconosRamas = [
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" stroke-linecap="round"><rect x="3" y="8" width="18" height="12" rx="2"/><path d="M3 8l2.5-4h15L18 8M8 4l-2.5 4M13 4l-2.5 4M18 4l-2.5 4"/></svg>',
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" stroke-linecap="round"><rect x="3" y="4" width="18" height="13" rx="2"/><path d="M12 9l4 7-2-.5-1 2.5z"/></svg>',
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" stroke-linecap="round"><path d="M4 15v-3a8 8 0 0 1 16 0v3"/><rect x="3" y="14" width="4" height="6" rx="1.5"/><rect x="17" y="14" width="4" height="6" rx="1.5"/></svg>',
];

// Demo de «¿Qué es NextYou?»: pastillas de tiempo propias de la v3 y la v4 (las de home.ts las usan la v1 y la v2)
const tiempos = ['8 min · 12 preguntas', 'al momento', 'según tus resultados'];
const UNIVERSIDAD = '#universidad';

// Palabra destacada en cursiva dentro de un titular.
const cursiva = (texto: string, palabra: string) => texto.replace(palabra, `<em>${palabra}</em>`);
---

<V5 titulo={SITIO.titulo} descripcion={SITIO.descripcion} actual="bachillerato" soloBachillerato ruta="">
    <main id="contenido">
      <!-- ===================== Portada =====================
           Nada más entrar se entiende qué es: título (h1), una frase y el botón del test.
           De fondo, el vídeo (decorativo). -->
      <section class="v7hero" aria-labelledby="hero-titulo" data-placeholder="true">
        <!-- v7: vídeo a pantalla completa (como en la v5) y el texto centrado, con «se explora» a rotulador:
             distinto del titular gigante abajo a la izquierda de Roadtrip Nation. Sin botón de pausa -->
        <div class="v7hero__video" aria-hidden="true">
          <picture>
            <source media="(max-width: 47.99rem)" srcset={`${VIDEO}hero-movil-poster.jpg`} />
            <img class="v7hero__poster" src={`${VIDEO}hero-escritorio-poster.jpg`} alt="" width="1280" height="720" fetchpriority="high" />
          </picture>
          <video class="v7hero__vid" data-hero-video autoplay muted loop playsinline preload="metadata" disablepictureinpicture tabindex="-1">
            <source src={`${VIDEO}hero-movil.mp4`} type="video/mp4" media="(max-width: 47.99rem)" />
            <source src={`${VIDEO}hero-escritorio.mp4`} type="video/mp4" />
          </video>
          <script is:inline>
            // Con «reducir movimiento» no se reproduce: se queda el póster
            (function () {
              var v = document.currentScript.previousElementSibling;
              if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) { v.removeAttribute('autoplay'); v.preload = 'none'; v.pause(); }
            })();
          </script>
        </div>
        <div class="v7hero__texto ancho">
          <h1 id="hero-titulo" class="v7hero__titulo">
            <span class="v7hero__lema">Tu futuro no se adivina, <span class="v7hero__explora">se explora</span>.</span>
          </h1>
        </div>
      </section>

      <!-- Universidad y familias: aparcadas para más adelante (fase 1 solo bachillerato). Siguen en /v4/. -->

      <!-- ===================== No eres el único ===================== -->
      <section class="seccion unico v7unico" aria-labelledby="unico-titulo">
        <div class="ancho">
          <header class="cabecera cabecera--centro" data-aparece>
            <p class="antetitulo">{noEresElUnico.etiqueta}</p>
            <h2 id="unico-titulo" class="titular titular--unico" set:html={cursiva(noEresElUnico.titulo, noEresElUnico.resaltado)} />
          </header>
          <ul data-aparece class="unico__lista" role="list" aria-label="Testimonios" tabindex="0">
            {
              noEresElUnico.personas.map((p0) => ({ ...p0, ...(unicoV7Cambios[p0.nombre] ?? {}), universidad: false })).map((p) => (
                <li class:list={['tarjeta', { 'tarjeta--uni': p.universidad }]} data-placeholder="true">
                  <Fragment set:html="<!-- PLACEHOLDER: sustituir por persona real -->" />
                  <Image src={p.foto} alt={p.alt} width={480} height={420} quality={70} class="tarjeta__foto" />
                  <div class="tarjeta__texto">
                    <p class="tarjeta__cita">«{p.cita}»</p>
                    <p class="tarjeta__firma">— {p.nombre}, {p.edad}</p>
                  </div>
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <!-- ===================== ¿Qué es NextYou? (v7: fondo negro, párrafo corto y directo) ===================== -->
      <section id="que-es" class="v7que" aria-labelledby="que-titulo">
        <div class="ancho v7que__rejilla">
          <div class="v7que__texto" data-aparece>
            <h2 id="que-titulo" class="v7que__tit">¿Qué es <span class="que__marca"><span class="que__logo-d"><LogoV3 clase="logo--grande" /></span><span class="que__logo-f" aria-hidden="true"><span class="que__next">Next</span><LogoV3 clase="logo--grande" solo="you" /></span><span class="solo-lector">NextYou</span>?</span></h2>
            <p class="v7que__lema" set:html={cursiva(queEsV7.lema, queEsV7.resaltado)} />
            <Fragment set:html="<!-- PENDIENTE CLIENTA: validar el texto -->" />
            <p class="v7que__p">{queEsV7.texto}</p>
          </div>
          <!-- Antes en la portada: la pregunta, el botón del test y el microtexto -->
          <div class="v7que__accion" data-aparece>
            <p class="v7que__pregunta">¿No sabes qué estudiar? Haz el test gratis y descubre <em>3 caminos</em> que encajan contigo.</p>
            <Fragment set:html="<!-- PENDIENTE: CTA a revisar con la propuesta de Elias (comentario #14) -->" />
            <a href={CTA_PRINCIPAL.href} class="boton boton--grande">{hero.boton} <span aria-hidden="true">→</span></a>
            <p class="v7que__micro">{pasosV7.micro}</p>
          </div>
        </div>
      </section>


      <!-- ===================== Cómo funciona (v7 · versión app, rica) =====================
           Ordenador: textos a la izquierda y un solo móvil fijo a la derecha (plano) que cambia de pantalla
           al llegar a cada paso (el script mueve los tres móviles a .cfa__escena). Móvil: cada paso con su móvil debajo.
           Las pantallas se animan solas (no son interactivas). Versión anterior en exploracion/_respaldo/v7-index-antes-como-rico.astro -->
      <section id="como-funciona" class="cfa" aria-labelledby="como-titulo">
        <header class="cfa__cab">
          <p class="cfa__eti">Cómo funciona</p>
          <h2 id="como-titulo" class="cfa__tit">De no saber qué estudiar a saber qué <u>quieres probar</u></h2>
          <p class="cfa__sub">{comoAppV7.sub}</p>
        </header>

        <div class="cfa__flujo" data-cfa-flujo>
          <ol class="cfa__pasos" role="list">
            {comoAppV7.pasos.map((p, i) => (
              <li class="cfa__paso" data-cfa-paso={i}>
                <div class="cfa__txt">
                  <p class="cfa__num"><span aria-hidden="true">0{i + 1}</span>{p.eti}</p>
                  <h3>{p.titulo}</h3>
                  <p class="cfa__p">{p.texto}</p>
                  <ul class="cfa__lista" role="list">
                    {p.puntos.map((t) => <li set:html={t} />)}
                  </ul>
                  {p.cierre && <p class="cfa__cierre">{p.cierre}</p>}
                  {i === 1 && <a class="cfa__ejemplo" href={`${BASE}resultados/`}>Ver un ejemplo de resultados <span aria-hidden="true">→</span></a>}
                </div>
                <div class="cfa__hueco" data-cfa-hueco={i}>
                  {i === 0 && (
                    <div class="cfa-app cfa-app--1" aria-hidden="true" data-cfa-app="0">
                      <div class="cfa-tel"><div class="cfa-pan cfa-pan--test" data-cfa-test>
                        <div class="cfa-est"><span>9:41</span><b></b></div>
                        <div class="cfa-t-top"><span class="cfa-x">✕</span><span class="cfa-seg">{Array.from({ length: 12 }, () => <i />)}</span><small data-cfa-q>4/12</small></div>
                        <p class="cfa-pill">Brújula interior</p>
                        <h4 data-cfa-preg>Un sábado libre, ¿qué te apetece más?</h4>
                        <div class="cfa-ops" data-cfa-ops>
                          <span class="cfa-op"><i><svg viewBox="0 0 24 24"><path d="M4 20l4-1 11-11-3-3L5 16z"/><path d="M14 6l3 3"/></svg></i><b>Crear algo desde cero</b></span>
                          <span class="cfa-op"><i><svg viewBox="0 0 24 24"><path d="M9 3h6v4a2 2 0 1 0 0 4v4h-4a2 2 0 1 0-4 0H3V9h4a2 2 0 1 0 0-4V3z"/></svg></i><b>Resolver un reto</b></span>
                          <span class="cfa-op"><i><svg viewBox="0 0 24 24"><circle cx="8" cy="9" r="3"/><circle cx="16" cy="9" r="3"/><path d="M3 19c1-3 3-4 5-4s4 1 5 4M11 19c1-3 3-4 5-4s4 1 5 4"/></svg></i><b>Quedar con gente</b></span>
                          <span class="cfa-op"><i><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M15.5 8.5l-2 5-5 2 2-5z"/></svg></i><b>Descubrir un sitio nuevo</b></span>
                        </div>
                        <div class="cfa-perfil">
                          <p>Tu perfil se está formando</p>
                          <span style="--v:62%" data-cfa-r="0"><small>Creatividad</small><i><b></b></i></span>
                          <span style="--v:40%" data-cfa-r="1"><small>Autonomía</small><i><b></b></i></span>
                          <span style="--v:28%" data-cfa-r="2"><small>Ayudar a otros</small><i><b></b></i></span>
                        </div>
                        <span class="cfa-cta cfa-off" data-cfa-cta>Continuar</span>
                      </div></div>
