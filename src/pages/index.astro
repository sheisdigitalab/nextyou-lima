  .v7uni .uni-par__ola { display: block; width: 30px; height: 7px; margin-top: 0.625rem; background: var(--acento); -webkit-mask: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 34 8'><path d='M1 4c3-4 5-4 8 0s5 4 8 0 5-4 8 0 5 4 8 0' fill='none' stroke='black' stroke-width='2' stroke-linecap='round'/></svg>") center / contain no-repeat; mask: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 34 8'><path d='M1 4c3-4 5-4 8 0s5 4 8 0 5-4 8 0 5 4 8 0' fill='none' stroke='black' stroke-width='2' stroke-linecap='round'/></svg>") center / contain no-repeat; }
  .v7uni .uni-par__camino { margin-top: 0.625rem; max-width: 22em; font-size: var(--t1); font-weight: 600; line-height: 1.45; color: #D9D4CA; }
  .v7uni .uni-par__it:not(.act) .uni-par__quien, .v7uni .uni-par__it:not(.act) .uni-par__cita, .v7uni .uni-par__it:not(.act) .uni-par__ola, .v7uni .uni-par__it:not(.act) .uni-par__camino { opacity: 0; transition: opacity 0.2s; }
