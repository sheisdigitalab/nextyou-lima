<style is:global>
  /* =====================================================================
     Limpieza visual de la v7 (2026-10-08): aire, tipografía, menos cajas, color y botones.
     Solo espaciado, tipografía, color y cajas: no cambia textos ni el orden de las secciones.
     Referencias: Headspace, Notion, Brilliant, Forage.
     ===================================================================== */
  :root:root {
    --margen: 1.375rem;                       /* 22 px */
    --aire: 7.5rem;                           /* 120 px entre secciones (arriba y abajo de cada una) */
    --t-seccion: 1.875rem;                    /* 30 px · todos los H2 */
    --negro-2: #161412;                       /* un solo negro de fondo en toda la página */
    --t2: 1rem;                               /* 16 px · texto normal */
    --y-titulo: 1.25rem;                      /* título → texto: 20 px */
    --y-contenido: 3rem;                      /* texto → contenido: 48 px */
    --linea: rgb(246 241 232 / 0.1);
    --linea-clara: rgb(22 20 18 / 0.1);
    --micro-tx: 0.75rem;                     /* 12 px · etiquetas */
  }
  @media (min-width: 48rem) {
    :root:root {
      --margen: 4rem;                         /* 64 px */
      --micro-tx: 0.75rem;                       /* 12 px · etiquetas */
      --t-seccion: 3.25rem;                   /* 52 px */
      --aire: 11.25rem;                       /* 180 px */
      --t2: 1.125rem;                         /* 18 px */
      --y-contenido: 4.5rem;                  /* 72 px */
    }
  }

  /* ---------- 1 · AIRE ---------- */
  .v7unico, .v7que, .v7como, .dentro, .v7uni, .sara, .cierre { padding-block: var(--aire) !important; border: 0 !important; }
  .v7unico { padding-top: var(--aire) !important; }
  .ancho, .estrecho { width: min(100% - 2 * var(--margen), 78rem); }
  /* título → texto */
  .cabecera, .v7como__cab, .uni-no__texto, .v7que__texto, .sara__texto { gap: var(--y-titulo); }
  .cabecera__sub, .v7paso__p, .uni-no__lead, .v7que__p, .sara__texto > p:not([class]) { margin-top: 0; }
  /* texto → contenido */
  .v7unico .cabecera, .dentro .cabecera, .v7como__cab { margin-bottom: var(--y-contenido) !important; }
  .dentro__nav { margin-block: 0 1.5rem; }
  .uni-no__rejilla, .v7que__rejilla, .sara__rejilla { gap: var(--y-contenido); }
  .v7como__pie { margin-top: var(--y-contenido); gap: 1rem; }
  .uni-par { margin-top: 0; }
  /* anchura cómoda de lectura */
  .cabecera__sub, .v7paso__p, .uni-no__lead, .v7que__p, .sara__texto > p:not([class]), .cierre p { max-width: 34em; }

  /* ---------- 2 · TIPOGRAFÍA ---------- */
  .unico .cabecera--centro .titular--unico, .v7que__tit, .v7como__frase, .uni-no__titulo, #dentro-titulo, #sara-titulo, #cierre-titulo {
    font-size: var(--t-seccion) !important; font-weight: 800 !important; line-height: 1.05 !important; letter-spacing: -0.025em;
  }
  .cabecera__sub, .v7paso__p, .uni-no__lead, .v7que__p, .sara__texto > p:not([class]), .v7gente__tray {
    font-size: var(--t2); line-height: 1.55;
  }
  /* etiquetas pequeñas: todas iguales */
  .antetitulo, .v7como__eti, .v7gente__eti, .v7paso__n--premium, .uni-par__quien, .nota-mano {
    font-size: var(--micro-tx) !important; font-weight: 700 !important; letter-spacing: 0.16em !important; text-transform: uppercase; line-height: 1.4;
  }
  /* un único recurso de entradilla por sección (18-20 px) */
  .v7que__lema, .v7que__pregunta, .uni-par__cita, .tarjeta__cita { font-size: var(--t3); line-height: 1.3; }
  .v7paso h3 { font-size: var(--t4); line-height: 1.15; }

  /* ---------- 3 · MENOS CAJAS ---------- */
  .v7que__accion { border: 0; padding: 0; border-radius: 0; background: none; }
  .v7paso__meta, .v7paso__n--premium { border: 0; padding: 0; border-radius: 0; background: none; }
  .uni-no__rutas { gap: 0.5rem 1.5rem; }
  .v7uni .uni-no__rutas li { border: 0; padding: 0; border-radius: 0; font-size: var(--t2); font-weight: 600; display: inline-flex; align-items: center; gap: 0.5rem; }
  .v7uni .uni-no__rutas li::before { content: ''; width: 6px; height: 6px; border-radius: 50%; background: var(--acento); flex: none; }
  .v7paso__n { border-bottom: 0 !important; }

  /* ---------- 4 · COLOR: domina el negro ----------
     Solo «Cómo funciona» es crema (para que destaquen los móviles). El resto, en dos tonos de negro que se alternan
     para que no haya dos fondos iguales seguidos:
     hero (vídeo) → No eres el único (negro) → ¿Qué es? (negro 2) → Cómo funciona (CREMA) → Los de dentro (negro)
     → La uni (negro 2) → Sara (negro) → cierre (negro 2) → pie (negro) */
  .v7como { background: var(--crema) !important; color: var(--negro) !important; }
  .v7unico, .dentro, .sara { background: var(--negro) !important; color: var(--crema) !important; }
  .v7que, .v7uni, .cierre { background: var(--negro-2) !important; color: var(--crema) !important; }
  .v7como__eti, .v7gente__eti { color: var(--gris-oscuro) !important; }
  .antetitulo, .nota-mano, .uni-par__quien { color: var(--gris) !important; }
  .v7como .antetitulo { color: var(--gris-oscuro) !important; }
  /* lima solo en subrayados, detalles y botones: nunca en etiquetas ni textos */
  .firma { color: inherit; }
  .v7como__eti span { background: currentColor; opacity: 0.5; }
  /* las palabras clave llevan subrayado lima y el texto en su color */
  .titular em, .uni-no__titulo em, .v7como__frase em, .cierre .titular em {
    color: inherit; background: linear-gradient(var(--acento), var(--acento)) no-repeat left 92% / 100% 0.14em; box-shadow: none; padding-bottom: 0.08em; font-style: normal;
  }
  /* No eres el único: tarjetas con foto (crema sobre negro) */
  .v7unico .tarjeta { background: var(--crema); color: var(--negro); box-shadow: 0 22px 36px -22px rgb(0 0 0 / 0.7); }
  .v7unico .tarjeta__firma { color: var(--gris-oscuro); }
  /* La uni */
  .v7uni .uni-no__lead { color: rgb(246 241 232 / 0.85); }
  .v7uni .uni-par__camino { color: #D9D4CA; font-size: var(--t1); }
  .v7uni .uni-par__marco { background: var(--negro); box-shadow: 0 24px 40px -28px rgb(0 0 0 / 0.8); }
  .v7uni .uni-par__punto::before { background: var(--crema); opacity: 0.25; }
  .v7uni .uni-par__punto.on::before { background: var(--acento); opacity: 1; }
  /* Cierre: sin degradado lima */
  .cierre { background-image: none !important; }
  .cierre__meta { color: var(--gris) !important; }

  /* ---------- 5 · BOTONES: un solo estilo principal ---------- */
  .boton:not(.boton--sm):not(.boton--contorno):not(.boton--contorno-oscuro):not(.boton--pronto), .boton--grande {
    min-height: 56px; padding: 0.75rem 1.75rem; border-radius: 999px; background: var(--acento); color: var(--acento-txt);
    font-size: 1rem; font-weight: 700; box-shadow: none;
  }
  .boton:hover { box-shadow: none; }
  .v7micro { margin: 0; font-size: var(--t1); line-height: 1.4; color: var(--gris-oscuro); text-align: center; }
  .cierre__meta, .v7que__micro { font-size: var(--t1); line-height: 1.4; }

  /* El lima no se usa como color de texto: las palabras clave van en el color del texto con subrayado lima */
  .dentro .titular em, #dentro-titulo em, .v7que__pregunta em, .v7que__lema em, .rotulador em {
    color: inherit !important; background: linear-gradient(var(--acento), var(--acento)) no-repeat left 92% / 100% 0.14em; box-shadow: none; padding-bottom: 0.08em;
  }
  .v7que__pregunta em { font-style: normal; }
  /* números de los pasos: sin bloque lima; solo un subrayado fino */
  .v7paso__n { background: none !important; box-shadow: none !important; min-width: 0 !important; display: inline-block; padding-bottom: 0.2em; position: relative; }
  .v7paso__n::after { content: ''; position: absolute; left: 0; bottom: 0; width: 100%; height: 3px; border-radius: 2px; background: var(--acento); }
  .v7paso__n--premium::after { display: none; }
  /* etiquetas «pronto» del pie: sin caja */
  .boton--pronto, [class*="pronto"] { border: 0 !important; background: none !important; padding-inline: 0; }
  .boton--pronto { opacity: 0.7; }
