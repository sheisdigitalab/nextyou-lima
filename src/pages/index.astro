        pista.addEventListener('scroll', () => requestAnimationFrame(pintar), { passive: true });
        pintar();
      }
      // Comparador de animaciones de «Cómo funciona» (?anim=1, 2 o 3). Sin parámetro, se queda la animación actual.
      const animComo = new URLSearchParams(location.search).get('anim');
      const demoComo = document.querySelector<HTMLElement>('.v7demo');
      if (demoComo && animComo && ['1', '2', '3'].includes(animComo)) demoComo.dataset.animComo = animComo;

      // Slider de «La uni no es el único camino»: se mueve solo y siempre en el mismo sentido (hacia la derecha), sin saltos
      // visibles (tres copias de las tarjetas y vuelta invisible al centro). La foto se mueve en sentido contrario (parallax,
      // máx. ±12 %). Se pausa con el ratón encima, con el foco dentro o al tocar/arrastrar. Con «reducir movimiento», no se
      // mueve solo ni hay parallax.
      const uniPista = document.querySelector<HTMLElement>('[data-uni-pista]');
      if (uniPista) {
        const todas = [...uniPista.querySelectorAll<HTMLElement>('.uni-par__it')];
        const n = todas.length / 3;
        const pts = [...document.querySelectorAll<HTMLButtonElement>('[data-uni-punto]')];
        const reducido = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const anchoSet = () => todas[n].offsetLeft - todas[0].offsetLeft;
        const centroDe = (i: number) => todas[i].offsetLeft + todas[i].offsetWidth / 2 - uniPista.clientWidth / 2;
        let x0: number | null = null;
        let s0 = 0;
        let arrastrado = false;
        if (reducido) uniPista.classList.add('uni-par__pista--snap');

        const pintarU = () => {
          const c = uniPista.scrollLeft + uniPista.clientWidth / 2;
          let mejor = 0;
          let dmin = Infinity;
          todas.forEach((it, i) => {
            const m = it.offsetLeft + it.offsetWidth / 2;
            if (!reducido) {
              const d = Math.max(-1, Math.min(1, (m - c) / uniPista.clientWidth));
              const foto = it.querySelector<HTMLElement>('.uni-par__foto');
              if (foto) foto.style.transform = `translateX(${d * -12}%)`;
            }
            if (Math.abs(m - c) < dmin) { dmin = Math.abs(m - c); mejor = i; }
          });
          todas.forEach((it, i) => it.classList.toggle('act', i === mejor));
          pts.forEach((p, i) => { const on = i === mejor % n; p.classList.toggle('on', on); if (on) p.setAttribute('aria-current', 'true'); else p.removeAttribute('aria-current'); });
        };
        // Bucle invisible: al pasar de una copia a la siguiente, se vuelve una vuelta atrás sin que se note
        const normalizar = () => {
          const w = anchoSet();
          const base = centroDe(n);
          if (uniPista.scrollLeft >= base + w / 2) uniPista.scrollLeft -= w;
          else if (uniPista.scrollLeft < base - w / 2) uniPista.scrollLeft += w;
        };
        const alAlcance = (k: number) => {
          const actual = uniPista.scrollLeft;
          let mejor = k;
          [k, k + n, k + 2 * n].forEach((i) => { if (Math.abs(centroDe(i) - actual) < Math.abs(centroDe(mejor) - actual)) mejor = i; });
          return mejor;
        };
        let hasta = 0; // no avanza solo hasta este instante
        const esperar = (ms: number) => { hasta = Math.max(hasta, Date.now() + ms); };
        uniPista.addEventListener('scroll', () => { normalizar(); requestAnimationFrame(pintarU); }, { passive: true });
        addEventListener('resize', () => { uniPista.scrollLeft = centroDe(n); pintarU(); });
        pts.forEach((p, i) => p.addEventListener('click', () => { esperar(8000); uniPista.scrollTo({ left: centroDe(alAlcance(i)), behavior: 'smooth' }); }));
        todas.forEach((it, i) => it.addEventListener('click', () => { if (!it.classList.contains('act') && !arrastrado) { esperar(8000); uniPista.scrollTo({ left: centroDe(i), behavior: 'smooth' }); } }));
        // Arrastrar con el ratón (ordenador)
        uniPista.addEventListener('pointerdown', (e) => {
          if (e.pointerType !== 'mouse') return;
          x0 = e.clientX; s0 = uniPista.scrollLeft; arrastrado = false;
          uniPista.classList.add('agarrada');
        });
        addEventListener('pointermove', (e) => {
          if (x0 === null) return;
          if (Math.abs(e.clientX - x0) > 4) arrastrado = true;
          uniPista.scrollLeft = s0 - (e.clientX - x0);
        });
        addEventListener('pointerup', () => {
          if (x0 === null) return;
          x0 = null;
          uniPista.classList.remove('agarrada');
          esperar(3000);
          setTimeout(() => { arrastrado = false; }, 0);
        });
        uniPista.addEventListener('dragstart', (e) => e.preventDefault());
        uniPista.addEventListener('touchstart', () => esperar(1e9), { passive: true });
        uniPista.addEventListener('touchend', () => { hasta = Date.now() + 4000; }, { passive: true });
        uniPista.scrollLeft = centroDe(n);
        pintarU();

        // Movimiento continuo hacia la derecha (las tarjetas se desplazan hacia la derecha), solo mientras se ve en pantalla
        if (!reducido) {
          const caja = uniPista.closest('.uni-par') as HTMLElement;
          const VELOCIDAD = 34; // px por segundo
          let visible = false;
          let encima = false;
          let pos = uniPista.scrollLeft;
          let anterior = 0;
          if ('IntersectionObserver' in window) new IntersectionObserver(([e]) => { visible = e.isIntersecting; }, { threshold: 0.15 }).observe(caja);
          else visible = true;
          caja.addEventListener('mouseenter', () => { encima = true; });
          caja.addEventListener('mouseleave', () => { encima = false; esperar(1500); });
          caja.addEventListener('focusin', () => { encima = true; });
          caja.addEventListener('focusout', () => { encima = false; esperar(1500); });
          const paso = (t: number) => {
            const dt = Math.min(64, t - anterior) / 1000;
            anterior = t;
            if (visible && !encima && x0 === null && !document.hidden && Date.now() >= hasta) {
              if (Math.abs(uniPista.scrollLeft - pos) > 1.5) pos = uniPista.scrollLeft;
              pos -= VELOCIDAD * dt;
              uniPista.scrollLeft = pos;
            }
            requestAnimationFrame(paso);
          };
          requestAnimationFrame(paso);
        }
      }
