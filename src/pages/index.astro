<script>
  // Cómo funciona (versión app, rica): un móvil fijo en ordenador que cambia de pantalla con el scroll,
  // y animaciones de las tres pantallas (test, caminos y gente real)
  {
    const sec = document.querySelector<HTMLElement>('.cfa');
    if (sec) {
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const mq = matchMedia('(min-width: 960px)');
      const escena = sec.querySelector<HTMLElement>('[data-cfa-escena]')!;
      const apps = [...sec.querySelectorAll<HTMLElement>('[data-cfa-app]')];
      const huecos = [...sec.querySelectorAll<HTMLElement>('[data-cfa-hueco]')];
      const pasos = [...sec.querySelectorAll<HTMLElement>('[data-cfa-paso]')];
      const marcas = [...sec.querySelectorAll<HTMLElement>('.cfa__marcas i')];

      // Ordenador: los tres móviles pasan a la escena fija; en móvil vuelven debajo de su texto
      const colocar = () => {
        if (mq.matches) { apps.forEach((a) => escena.appendChild(a)); sec.classList.add('cfa--escena'); }
        else { apps.forEach((a, i) => huecos[i].appendChild(a)); sec.classList.remove('cfa--escena'); }
      };
      colocar();
      mq.addEventListener('change', colocar);

      // Móvil fijo (ordenador): se ajusta a la altura de la ventana para verse siempre entero, con cualquier tamaño de escritorio
      const ajustarEscena = () => {
        const menu = document.querySelector<HTMLElement>('.menu');
        const apilado = menu ? (parseFloat(getComputedStyle(menu).top) || 0) + menu.offsetHeight : 72;
        const libre = window.innerHeight - apilado - 24;
        const k = Math.max(0.45, Math.min(1, libre / 670));
        const top = Math.max(apilado + 12, apilado + (libre - 670 * k) / 2);
        sec.style.setProperty('--cfa-k', k.toFixed(3));
        sec.style.setProperty('--cfa-top', Math.round(top) + 'px');
      };
      ajustarEscena();
      addEventListener('resize', ajustarEscena);

      let alCambiar: (i: number) => void = () => {};
      let activo = -1;
      const activar = (i: number) => {
        if (i === activo) return;
        activo = i;
        escena.dataset.paso = String(i);
        pasos.forEach((p, k) => p.classList.toggle('cfa-act', k === i));
        apps.forEach((a, k) => { a.classList.toggle('cfa-act', k === i); if (k === i) a.classList.add('cfa-visto'); });
        marcas.forEach((m, k) => m.classList.toggle('cfa-on', k === i));
        alCambiar(i);
      };
      if (reduce) apps.forEach((a) => a.classList.add('cfa-visto'));
      const io = new IntersectionObserver((es) => {
        es.forEach((e) => { if (e.isIntersecting) activar(Number((e.target as HTMLElement).dataset.cfaPaso)); });
      }, { rootMargin: '-40% 0px -40% 0px' });
      pasos.forEach((p) => io.observe(p));
      activar(0);

      // Paso 1: el test avanza solo, marca una respuesta y el perfil se va llenando
      const t = sec.querySelector<HTMLElement>('[data-cfa-test]')!;
      const preg = t.querySelector<HTMLElement>('[data-cfa-preg]')!;
      const ops = [...t.querySelectorAll<HTMLElement>('.cfa-op')];
      const segs = [...t.querySelectorAll<HTMLElement>('.cfa-seg i')];
      const num = t.querySelector<HTMLElement>('[data-cfa-q]')!;
      const cta = t.querySelector<HTMLElement>('[data-cfa-cta]')!;
      const rasgos = [...t.querySelectorAll<HTMLElement>('[data-cfa-r]')];
      const insight = sec.querySelector<HTMLElement>('[data-cfa-insight]')!;
      const insightTx = sec.querySelector<HTMLElement>('[data-cfa-insight-tx]')!;
      const PREG = [
        { q: 'Un sábado libre, ¿qué te apetece más?', o: ['Crear algo desde cero', 'Resolver un reto', 'Quedar con gente', 'Descubrir un sitio nuevo'], s: 0, i: 'Te mueve crear cosas nuevas', r: [62, 40, 28] },
        { q: 'En un trabajo en grupo, tú sueles…', o: ['Proponer las ideas', 'Buscar la solución', 'Que todos se entiendan', 'Investigar el tema'], s: 1, i: 'Disfrutas resolviendo problemas', r: [68, 58, 32] },
        { q: '¿Con qué te sentirías más orgulloso/a?', o: ['Algo que he creado', 'Superar un reto difícil', 'Ayudar a alguien', 'Aprender algo nuevo'], s: 2, i: 'También te importa ayudar a otros', r: [72, 60, 54] },
      ];
      let n = 0;
      const pintarSegs = (hechas: number) => segs.forEach((s, k) => s.classList.toggle('cfa-on', k < hechas));
      const cicloTest = () => {
        const p = PREG[n % PREG.length];
        const hechas = 3 + (n % PREG.length);
        t.classList.add('cfa-cambia');
        setTimeout(() => {
          preg.textContent = p.q;
          ops.forEach((o, k) => { o.classList.remove('cfa-sel'); o.querySelector('b')!.textContent = p.o[k]; });
          cta.classList.add('cfa-off'); num.textContent = `${hechas + 1}/12`; pintarSegs(hechas);
          t.classList.remove('cfa-cambia');
        }, 250);
        setTimeout(() => {
          ops[p.s].classList.add('cfa-sel'); cta.classList.remove('cfa-off');
          rasgos.forEach((r, k) => r.style.setProperty('--v', p.r[k] + '%'));
          insight.classList.remove('cfa-pop'); void insight.offsetWidth; insightTx.textContent = p.i; insight.classList.add('cfa-pop');
        }, 1300);
        n++;
      };

      // Paso 2: al llegar se ven los 3 caminos; luego se toca uno, se abre su ficha y baja hasta «Cómo llegar»
      const cam = sec.querySelector<HTMLElement>('[data-cfa-caminos]')!;
      const cams = [...cam.querySelectorAll<HTMLElement>('[data-cfa-cam]')];
      const toque = cam.querySelector<HTMLElement>('[data-cfa-toque]')!;
      const ficha = cam.querySelector<HTMLElement>('[data-cfa-ficha]')!;
      const fin = ficha.querySelector<HTMLElement>('[data-cfa-fin]')!;
      const campo = (k: string) => ficha.querySelector<HTMLElement>(`[data-cfa-f="${k}"]`)!;
      const fotosFicha = [...ficha.querySelectorAll<HTMLElement>('[data-cfa-ff]')];
      const chipsFicha = [...ficha.querySelectorAll<HTMLElement>('[data-cfa-chip]')];
      const rutasT = [...ficha.querySelectorAll<HTMLElement>('[data-cfa-rt]')];
      const rutasD = [...ficha.querySelectorAll<HTMLElement>('[data-cfa-rd]')];
      // PENDIENTE CLIENTA: contenido de ejemplo de las fichas
      const FICHAS = [
        { tag: 'Camino 1 · Lo que más te pega', nom: 'Creación de contenido', chips: ['Creatividad', 'Comunicación', 'Redes'],
          que: 'Creas vídeos y publicaciones para marcas o para tu propio canal.', dia: 'Grabas, editas y miras qué ha funcionado para mejorar.', porque: 'Te encanta crear y contar historias.',
          rutas: [['FP de Marketing y Publicidad', 'FP de grado superior · 2 años'], ['Grado en Comunicación Audiovisual', 'Universidad · 4 años'], ['Cursos de edición y redes', 'Unos meses'], ['Por tu cuenta', 'Abre tu canal y aprende publicando']] },
        { tag: 'Camino 2 · El puente', nom: 'Animación 3D', chips: ['Dibujo', 'Tecnología', 'En equipo'],
          que: 'Das vida a personajes para videojuegos, series y anuncios.', dia: 'Animas escenas y las revisas con tu equipo.', porque: 'Está cerca del dibujo, que ya te gusta.',
          rutas: [['FP de Animación 3D, Juegos y Entornos Interactivos', 'FP de grado superior · 2 años'], ['Grado en Animación', 'Universidad · 4 años'], ['Cursos online y bootcamps', 'Unos meses'], ['Por tu cuenta', 'Blender es gratis y un buen portfolio abre puertas']] },
        { tag: 'Camino 3 · El salto', nom: 'Ciberseguridad', chips: ['Lógica', 'Retos', 'Tecnología'],
          que: 'Proteges a empresas y personas de ataques informáticos.', dia: 'Buscas fallos de seguridad antes de que los encuentre otro.', porque: 'Disfrutas resolviendo retos difíciles.',
          rutas: [['FP de Informática + especialización en Ciberseguridad', 'FP de grado superior · 3 años'], ['Grado en Ingeniería Informática', 'Universidad · 4 años'], ['Certificaciones y bootcamps', 'Unos meses'], ['Por tu cuenta', 'Practica con retos de hacking ético']] },
      ];
      const T: number[] = [];
      const luego = (ms: number, fn: () => void) => { T.push(window.setTimeout(fn, ms)); };
      const pararCaminos = () => {
        T.splice(0).forEach((x) => clearTimeout(x));
        ficha.classList.remove('cfa-abierta', 'cfa-baja'); cams.forEach((c) => c.classList.remove('cfa-pulsado'));
      };
      const rellenar = (k: number) => {
        const d = FICHAS[k];
        (['tag', 'nom', 'que', 'dia', 'porque'] as const).forEach((x) => { campo(x).textContent = d[x]; });
        chipsFicha.forEach((c, j) => { c.textContent = d.chips[j]; });
        rutasT.forEach((r, j) => { r.textContent = d.rutas[j][0]; }); rutasD.forEach((r, j) => { r.textContent = d.rutas[j][1]; });
        fotosFicha.forEach((im, j) => im.classList.toggle('cfa-on', j === k));
      };
      const ronda = (k: number) => {
        const c = cams[k];
        const rc = c.getBoundingClientRect(), rp = cam.getBoundingClientRect();
        toque.style.top = `${rc.top - rp.top + rc.height / 2}px`;
        toque.style.left = `${rc.left - rp.left + rc.width * 0.62}px`;
        toque.classList.remove('cfa-ver'); void toque.offsetWidth; toque.classList.add('cfa-ver');
        luego(250, () => c.classList.add('cfa-pulsado'));
        luego(650, () => { rellenar(k); fin.style.setProperty('--baja', '0px'); ficha.classList.add('cfa-abierta'); });
        luego(3400, () => {
          const vp = fin.parentElement!;
          fin.style.setProperty('--baja', `${Math.max(0, fin.scrollHeight - vp.clientHeight)}px`);
          ficha.classList.add('cfa-baja');
        });
        luego(7400, () => { ficha.classList.remove('cfa-abierta'); c.classList.remove('cfa-pulsado'); });
        luego(8000, () => ficha.classList.remove('cfa-baja'));
        luego(10000, () => ronda((k + 1) % 3));
      };
      let siguiente = 1;
      // Ramas: desde «Tú» sale una línea que se divide en tres y llega a cada camino (el salto, punteado)
      const lista = cam.querySelector<HTMLElement>('[data-cfa-lista]')!;
      const ramas = lista.querySelector<SVGSVGElement>('.cfa-ramas')!;
      const dibujarRamas = () => {
        ramas.innerHTML = '';
        ramas.classList.remove('cfa-vivo');
        cams.forEach((c, i) => {
          const y = c.offsetTop + c.offsetHeight / 2;
          const p = document.createElementNS('http://www.w3.org/2000/svg', 'path');
          p.setAttribute('d', `M6.5 -22 V${y - 10} Q6.5 ${y} 16.5 ${y} H21`);
          if (i === 2) p.setAttribute('class', 'cfa-salto');
          ramas.appendChild(p);
          p.style.setProperty('--len', String(p.getTotalLength()));
        });
        void ramas.getBoundingClientRect();
        requestAnimationFrame(() => ramas.classList.add('cfa-vivo'));
      };
      // Si cambia el ancho de la lista (girar el móvil, redimensionar), las ramas se vuelven a colocar
      if ('ResizeObserver' in window) {
        let anterior = lista.offsetWidth;
        let t: number | undefined;
        new ResizeObserver(() => {
          if (lista.offsetWidth === anterior) return;
          anterior = lista.offsetWidth;
          if (!ramas.childElementCount) return;
          clearTimeout(t);
          t = window.setTimeout(dibujarRamas, 150);
        }).observe(lista);
      }
      alCambiar = (i: number) => {
        if (i === 1) dibujarRamas();
        pararCaminos();
        if (i === 1 && !reduce) luego(2600, () => { ronda(siguiente); siguiente = (siguiente + 1) % 3; });
      };

      // Paso 3: vídeo de Laia; fuera del móvil, un globo con frases suyas que van cambiando
      const frase = sec.querySelector<HTMLElement>('[data-cfa-frase]')!;
      const ella = sec.querySelector<HTMLElement>('[data-cfa-ella]')!;
      const FRASES = [
        '«Empecé subiendo mis animaciones a redes. Así me escribió una productora.»',
        '«Dibujaba cómics y luego hice una FP de Animación 3D.»',
        '«Por la mañana animo personajes y por la tarde los revisamos en equipo.»',
      ];
      let c = 1;
      const cicloGente = () => {
        frase.classList.add('cfa-cambia');
        setTimeout(() => { ella.textContent = FRASES[c % 3]; frase.classList.remove('cfa-cambia'); c++; }, 400);
      };

      // Paso 4 (premium): al llegar, toda la pantalla se vuelve negra y aparece el bloque del coach
      const prem = sec.querySelector<HTMLElement>('[data-cfa-prem]')!;
      new IntersectionObserver((es) => { sec.classList.toggle('cfa--negro', es[0].isIntersecting); }, { rootMargin: '0px 0px -45% 0px' }).observe(prem);

      if (reduce) {
        segs.forEach((s, k) => s.classList.toggle('cfa-on', k < 3)); ops[0].classList.add('cfa-sel'); cta.classList.remove('cfa-off');
        insight.classList.add('cfa-pop');
      } else {
        new IntersectionObserver((es, o) => {
          if (!es[0].isIntersecting) return;
          o.disconnect();
          cicloTest(); setInterval(cicloTest, 3600);
          cicloGente(); setInterval(cicloGente, 4800);
        }, { threshold: 0.05 }).observe(sec);
      }
    }
  }
</script>

