      .hero__pregunta { font-size: clamp(2.75rem, 0.9rem + 6.6vw, 7.5rem); line-height: 0.92; text-wrap: balance; }
      .hero__explora { display: block; color: var(--acento-texto); }
      .hero__resto { max-width: 34rem; font-family: var(--sans); font-stretch: 100%; font-size: var(--t3); font-weight: 600; line-height: 1.4; letter-spacing: 0; }
      .hero__resto b { font-weight: 800; color: var(--acento-texto); }
      .hero__boton span { margin-left: 0.4em; }
      /* Pausa: círculo claro encima del titular, como en la referencia */
      @media (min-width: 64rem) {
        /* Titular a todo el ancho, como la referencia: una línea por frase */
        .hero__marco { padding-block: 10rem 3.5rem; }
        .hero__pregunta { font-size: clamp(3.5rem, 6.1vw, 7.25rem); line-height: 0.95; }
        .hero__linea { display: block; white-space: nowrap; }
        .hero__resto { max-width: 40rem; }
        .hero__accion { position: absolute; right: 0; bottom: 3.5rem; }
        .hero__fondo::after { background: linear-gradient(to bottom, rgb(22 20 18 / 0.3) 0%, rgb(22 20 18 / 0) 20%, rgb(22 20 18 / 0.5) 40%, rgb(22 20 18 / 0.82) 60%, rgb(22 20 18 / 0.94) 100%); }
        .hero__poster, .hero__video { object-position: 50% 35%; }
      }
      /* Apertura: la ventana se abre a pantalla completa y después entra el texto. Sin JS también funciona; con «reducir movimiento», nada se mueve */
      @media (prefers-reduced-motion: no-preference) {
        .ruta { animation: hero-ruta 0.9s cubic-bezier(0.65, 0, 0.35, 1) both; }
        .ruta--2 { animation-delay: 0.12s; }
        .ruta--3 { animation-delay: 0.24s; }
        .hero__tu { animation: hero-tu 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) 0.05s both, hero-tu-fuera 0.45s ease 1.25s forwards; }
        .hero__fondo { animation: hero-circulo 1.3s cubic-bezier(0.76, 0, 0.24, 1) 1s both; }
        .hero__marco > * { animation: hero-texto 0.8s cubic-bezier(0.23, 1, 0.32, 1) both; animation-delay: calc(1.9s + var(--o, 0) * 0.12s); }
        .hero__marco > :nth-child(2) { --o: 1; }
        .hero__marco > :nth-child(3) { --o: 2; }
      }
      @keyframes hero-ruta { from { clip-path: circle(0% at 50% 50%); } to { clip-path: circle(75% at 50% 50%); } }
      @keyframes hero-tu { from { scale: 0; } }
      @keyframes hero-tu-fuera { to { opacity: 0; scale: 1.4; } }
      @keyframes hero-circulo { from { clip-path: circle(0% at 50% 50%); } to { clip-path: circle(75% at 50% 50%); } }
      @keyframes hero-texto { from { opacity: 0; translate: 0 1.25rem; } }

      /* ---------- Qué es (bajo la portada) ---------- */

      /* ---------- Qué es (bloque explicativo bajo la portada) ---------- */
      .intro { background: var(--papel); color: var(--negro); padding-block: var(--aire); overflow: hidden; }
      .intro__rejilla { display: grid; gap: clamp(2.5rem, 2rem + 2vw, 3.5rem); align-items: center; }
      .intro__izq { display: grid; gap: 1.5rem; }
      .intro__titulo { display: grid; gap: 0.75rem; font-size: var(--t5); font-family: var(--titular); font-weight: 800; font-stretch: 105%; letter-spacing: -0.025em; }
      .intro__pregunta { font-size: var(--t5); line-height: 1.02; }
      .intro__resto { font-size: var(--t4); line-height: 1.2; letter-spacing: -0.015em; max-width: 30ch; }
      .intro__texto { font-size: var(--t3); line-height: 1.55; color: var(--gris-oscuro); max-width: 34rem; }

      /* El pase del test */
      .pase { position: relative; justify-self: center; width: min(100%, 24rem); display: grid; gap: 1.25rem; padding: 1.75rem 1.5rem 1.5rem; border-radius: 22px; background: var(--negro); color: var(--crema); box-shadow: 0 30px 50px -28px rgb(22 20 18 / 0.7), 0 0 90px -20px color-mix(in srgb, var(--acento) 45%, transparent); rotate: 2deg; }
      .pase__cabeza { display: flex; justify-content: space-between; align-items: end; gap: 1rem; padding-bottom: 1rem; border-bottom: 1px solid var(--linea); }
      .pase__nombre { font-family: var(--titular); font-weight: 800; font-stretch: 105%; font-size: var(--t3); line-height: 1.1; }
      .pase__tiempo { font-size: var(--t2); color: var(--gris); white-space: nowrap; }
      .pase__tiempo strong { font-family: var(--titular); font-weight: 800; font-size: var(--t5); line-height: 0.9; color: var(--acento-texto); margin-right: 0.15em; }
      .pase__lista { display: grid; gap: 0.75rem; }
      .pase__lista li { display: flex; gap: 0.75rem; align-items: center; font-weight: 600; }
      .pase__check { display: grid; place-items: center; flex-shrink: 0; width: 24px; height: 24px; border-radius: 50%; background: var(--acento); color: var(--acento-txt); }
      /* Línea de corte con muescas, como un pase o una entrada */
      .pase__corte { position: relative; height: 0; margin-inline: -1.5rem; border-top: 2px dashed rgb(246 241 232 / 0.22); }
      .pase__corte::before, .pase__corte::after { content: ''; position: absolute; top: -13px; width: 24px; height: 24px; border-radius: 50%; background: var(--papel); }
      .pase__corte::before { left: -12px; }
      .pase__corte::after { right: -12px; }
      .pase__boton { width: 100%; }
      @media (hover: hover) and (prefers-reduced-motion: no-preference) {
        .pase { transition: rotate 300ms cubic-bezier(0.23, 1, 0.32, 1), translate 300ms cubic-bezier(0.23, 1, 0.32, 1); }
        .pase:hover { rotate: 0deg; translate: 0 -4px; }
      }
      @media (min-width: 60rem) {
        .intro__rejilla { grid-template-columns: 1.2fr 0.8fr; gap: 5rem; }
        .pase { justify-self: end; }
      }

      /* La portada clara y «¿Qué es NextYou?» comparten fondo: un solo aire entre ambas, no dos */
      .intro + .que { padding-top: 0; }

      /* ---------- ¿Qué es NextYou? (v5): título, lema y la frase «no te decimos… / te permitimos…» ---------- */
      .quees { display: grid; gap: clamp(1.75rem, 1.25rem + 2vw, 3rem); }
      .quees__rejilla { display: grid; gap: clamp(2rem, 1.5rem + 2vw, 3rem); align-items: start; }
      .quees__texto { display: grid; justify-items: start; gap: 0.5rem; }
      .quees__lema { font-family: var(--titular); font-weight: 800; font-stretch: 105%; font-size: var(--t4); line-height: 1.2; letter-spacing: -0.015em; max-width: 20ch; text-wrap: balance; margin-bottom: 1.25rem; }
      .quees__no { font-size: var(--t2); color: var(--gris-oscuro); text-decoration: line-through; text-decoration-color: var(--negro); text-decoration-thickness: 2px; }
      .quees__si { font-family: var(--titular); font-weight: 800; font-stretch: 105%; font-size: var(--t4); line-height: 1.3; letter-spacing: -0.015em; text-wrap: balance; max-width: 20ch; }
      .quees__pegatina { display: inline-block; margin-inline: 0.1em; padding: 0 0.3em 0.05em; border-radius: 6px; background: var(--acento); color: var(--acento-txt); font-family: var(--mano); font-weight: 400; font-size: 0.9em; rotate: -3deg; box-shadow: 2px 2px 0 var(--negro); }
      .quees__boton { margin-top: 1.25rem; }
      .quees__boton span { margin-left: 0.4em; }
      /* Collage de polaroids */
      .collage { position: relative; height: 23rem; }
      .pol { position: absolute; width: 9.5rem; margin: 0; padding: 7px 7px 28px; background: #fff; box-shadow: 0 18px 30px -18px rgb(0 0 0 / 0.55); }
      .pol__img { display: block; width: 100%; height: auto; aspect-ratio: 1; object-fit: cover; }
      .pol figcaption { position: absolute; left: 0; right: 0; bottom: 3px; text-align: center; font-family: var(--mano); font-size: 1.05rem; color: var(--negro); }
      .pol--1 { left: 0; top: 1rem; rotate: -8deg; }
      .pol--2 { left: 50%; top: 4rem; translate: -45% 0; rotate: 5deg; z-index: 2; }
      .pol--3 { right: 0; top: 0; rotate: 9deg; }
      .sello { position: absolute; z-index: 3; left: 12%; bottom: 0.75rem; display: grid; place-items: center; width: 6.5rem; height: 6.5rem; border-radius: 50%; background: var(--acento); color: var(--acento-txt); font-family: var(--mano); font-size: 1.15rem; line-height: 1; text-align: center; rotate: -12deg; box-shadow: 4px 4px 0 var(--negro); }
      @media (min-width: 64rem) {
        .quees__rejilla { grid-template-columns: 1fr 1fr; gap: 4rem; align-items: center; }
        .collage { height: 26rem; }
        .pol { width: 13rem; }
        .sello { width: 7.5rem; height: 7.5rem; font-size: 1.3rem; }
      }

      /* ---------- Bifurcación a universidad ---------- */
      .bifurca { background: var(--negro); border-top: 1px solid var(--linea); border-bottom: 1px solid var(--linea); }
      .bifurca__enlace { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.5rem 1.5rem; min-height: 64px; padding-block: 1rem; text-decoration: none; font-size: var(--t2); color: var(--crema); }
      .bifurca__enlace strong { color: var(--acento-texto); font-weight: 800; white-space: nowrap; }
      .bifurca__enlace:hover strong { text-decoration: underline; text-underline-offset: 0.2em; }

      /* ---------- No eres el único ---------- */
      .unico .cabecera { margin-bottom: clamp(2.5rem, 2rem + 2vw, 4.5rem); }
      /* Título en una o dos líneas: más ancho y, en móvil, algo más pequeño */
      .unico .cabecera--centro .titular--unico { max-width: 30ch !important; margin-inline: auto; font-size: clamp(1.5rem, 0.95rem + 2.5vw, 3.5rem); text-wrap: balance; }
      .unico__lista { display: grid; grid-auto-flow: column; grid-auto-columns: 80%; gap: 0.875rem; overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding-inline: var(--margen); margin-inline: calc(-1 * var(--margen)); padding-inline: var(--margen); padding-block: 1.25rem 2rem; scrollbar-width: none; }
      .unico__lista::-webkit-scrollbar { display: none; }
      .unico__lista .tarjeta { scroll-snap-align: start; }
      .tarjeta { position: relative; display: grid; grid-template-rows: auto 1fr; border-radius: 6px; background: var(--crema); color: var(--negro); padding: 0.625rem 0.625rem 0; box-shadow: 0 18px 30px -18px rgb(0 0 0 / 0.7); }
  .tarjeta__enlace { justify-self: start; margin-top: 0.25rem; font-size: var(--t1); font-weight: 800; color: var(--negro); text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 0.2em; }
  .tarjeta__enlace::after { content: ''; position: absolute; inset: 0; z-index: 2; }
  .tarjeta::before { content: ''; position: absolute; z-index: 1; top: -10px; left: 50%; width: 76px; height: 22px; translate: -50% 0; rotate: -3deg; background: var(--acento); opacity: 0.85; }
  .tarjeta:nth-child(odd) { rotate: -1.2deg; }
  .tarjeta:nth-child(even) { rotate: 1.2deg; }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .tarjeta { transition: rotate 300ms cubic-bezier(.2,.7,.2,1), translate 300ms cubic-bezier(.2,.7,.2,1), box-shadow 300ms ease; }
    .tarjeta:hover { rotate: 0deg; translate: 0 -6px; box-shadow: 0 28px 40px -20px rgb(0 0 0 / 0.75); }
  }
  .tarjeta__foto { border-radius: 3px; }
  .tarjeta__firma { color: var(--gris-oscuro) !important; }
      .tarjeta__foto { width: 100%; aspect-ratio: 8 / 7; object-fit: cover; }
      .tarjeta__texto { display: grid; align-content: start; gap: 0.75rem; padding: 1.25rem 1.25rem 1.5rem; }
      .tarjeta__cita { font-family: var(--titular); font-weight: 800; font-stretch: 105%; font-size: var(--t3); line-height: 1.2; }
      .tarjeta__firma { color: var(--gris); font-size: var(--t1); }
      @media (min-width: 40rem) { .unico__lista { grid-auto-flow: row; grid-template-columns: repeat(2, 1fr); gap: 1.25rem; overflow: visible; margin-inline: 0; padding-inline: 0; padding-block: 0.75rem 0; } }
      @media (min-width: 64rem) { .unico__lista { grid-template-columns: repeat(4, 1fr); } }

      /* ---------- ¿Qué es NextYou? ---------- */
      .que { background: var(--papel); color: var(--negro); }
      /* Paso 2: los tres recorridos como un mapa. «Tú» arriba, carreteras que bajan y señales con icono.
         Un punto recorre la carretera del destino elegido; las otras se suavizan */
      .mapa { position: relative; display: grid; justify-items: center; width: 100%; max-width: 28rem; }
      .mapa__tu { position: relative; z-index: 1; display: grid; place-items: center; width: 3rem; height: 3rem; border-radius: 50%; background: var(--negro); color: var(--crema); font-weight: 800; font-size: var(--t2); box-shadow: 0 0 0 5px color-mix(in srgb, var(--acento) 70%, transparent); }
      .mapa__vias { display: block; width: 100%; height: clamp(7.5rem, 6rem + 4vw, 9.5rem); margin-top: -0.25rem; overflow: visible; }
      .via { transition: opacity 300ms ease; }
      .via path, .mapa__gps { fill: none; vector-effect: non-scaling-stroke; stroke-linecap: round; stroke-linejoin: round; }
      .via__firme { stroke: var(--negro); stroke-width: 14; }
      .via__linea { stroke: var(--crema); stroke-width: 2; stroke-dasharray: 7 9; }
      .via--1 .via__firme { stroke: var(--acento); stroke-width: 18; }
      .via--1 .via__linea { stroke: var(--acento-txt); }
      .via__sendero { stroke: var(--negro); stroke-width: 6; stroke-dasharray: 0.1 11; }
      .mapa__gps--borde { stroke: var(--negro); stroke-width: 16; }
      .mapa__gps--centro { stroke: var(--crema); stroke-width: 8; }
      .mapa[data-sel='1'] :is(.via--2, .via--3), .mapa[data-sel='2'] :is(.via--1, .via--3), .mapa[data-sel='3'] :is(.via--1, .via--2) { opacity: 0.35; }
      .mapa__destinos { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.625rem; width: 100%; margin-top: 0.25rem; }
      /* Señal: cartel con una muesca de flecha arriba, hacia la carretera que llega */
      .senal { position: relative; display: grid; align-content: start; justify-items: center; gap: 0.2rem; padding: 1.1rem 0.5rem 0.75rem; border-radius: 12px; border: 1.5px solid var(--negro); background: var(--papel); color: var(--negro); font: inherit; text-align: center; cursor: pointer; transition: opacity 250ms ease, translate 250ms cubic-bezier(0.23, 1, 0.32, 1); }
      .senal::before { content: ''; position: absolute; top: -11px; left: 50%; translate: -50% 0; width: 20px; height: 20px; rotate: 45deg; background: inherit; border-left: inherit; border-top: inherit; border-radius: 3px; }
      .senal--1 { background: var(--acento); color: var(--acento-txt); box-shadow: 0 16px 28px -16px color-mix(in srgb, var(--acento) 70%, var(--negro)); }
      .senal--3 { border-style: dashed; background: color-mix(in srgb, var(--papel) 70%, #e2d9ca); }
      /* Elegida: sube y lleva doble borde. Las demás, más planas, pero con el texto a contraste completo */
      .senal[aria-pressed='true'] { translate: 0 -4px; box-shadow: 0 0 0 2px var(--papel), 0 0 0 4px var(--negro), 0 14px 24px -16px rgb(22 20 18 / 0.5); }
      .senal--1[aria-pressed='false'] { background: color-mix(in srgb, var(--acento) 45%, var(--papel)); box-shadow: none; }
      .senal[aria-pressed='false'] .senal__icono { background: var(--gris-oscuro); }
      .senal:focus-visible { outline: 3px solid var(--negro); outline-offset: 3px; }
      .senal__icono { display: grid; place-items: center; width: 2rem; height: 2rem; border-radius: 50%; background: var(--negro); color: var(--crema); }
      .senal--1 .senal__icono { color: var(--acento); }
      .senal__icono svg { width: 1.125rem; height: 1.125rem; }
      .senal__tipo { font-size: 0.625rem; font-weight: 800; letter-spacing: 0.08em; line-height: 1.2; text-transform: uppercase; color: var(--gris-oscuro); }
      .senal--1 .senal__tipo, .senal--1 .senal__nota { color: var(--acento-txt); }
      .senal__ejemplo { font-family: var(--titular); font-weight: 800; font-stretch: 105%; font-size: var(--t2); line-height: 1.15; }
      .senal__nota { font-size: 0.6875rem; line-height: 1.3; color: var(--gris-oscuro); }
      @media (max-width: 47.99rem) {
        .senal { padding: 1rem 0.35rem 0.65rem; }
        .senal__icono { width: 1.875rem; height: 1.875rem; }
        .senal__tipo { font-size: 0.625rem; letter-spacing: 0.05em; }
        .senal__ejemplo { font-size: 0.875rem; hyphens: auto; overflow-wrap: anywhere; }
        .senal__nota { display: none; }
      }
      /* Entrada: las carreteras se dibujan de arriba abajo desde «Tú» y aparecen las señales */
      @media (prefers-reduced-motion: no-preference) {
        .via { clip-path: inset(-24px) view-box; transition: clip-path 800ms cubic-bezier(0.65, 0, 0.35, 1), opacity 300ms ease; }
        .via--1 { transition-delay: 250ms, 0ms; }
        .via--2 { transition-delay: 380ms, 0ms; }
        .via--3 { transition-delay: 510ms, 0ms; }
        .mapa__tu { transition: scale 450ms cubic-bezier(0.34, 1.56, 0.64, 1); }
        .senal { transition: opacity 400ms ease, translate 500ms cubic-bezier(0.23, 1, 0.32, 1); }
        .js .mapa:not(.en-vista) .via { clip-path: inset(-24px -24px calc(100% + 24px) -24px) view-box; }
        .js .mapa:not(.en-vista) .mapa__tu { scale: 0; }
        .js .mapa:not(.en-vista) .senal { opacity: 0; translate: 0 0.75rem; }
        .js .mapa:not(.en-vista) .mapa__gps { opacity: 0; }
      }

      /* Paso 3: una sesión con el coach, como una videollamada */
      .llamada { display: grid; gap: 0.75rem; width: min(100%, 25rem); padding: 0.75rem; border-radius: 26px; background: color-mix(in srgb, var(--papel) 35%, #ffffff); border: 1px solid rgb(22 20 18 / 0.1); box-shadow: 0 40px 60px -35px rgb(22 20 18 / 0.45); rotate: -1.5deg; }
      .llamada__barra { display: flex; align-items: center; gap: 0.5rem; padding: 0.25rem 0.5rem 0; font-size: var(--t1); font-weight: 700; color: var(--gris-oscuro); }
      .llamada__punto { width: 0.5rem; height: 0.5rem; border-radius: 50%; background: #2fbf71; box-shadow: 0 0 0 3px rgb(47 191 113 / 0.2); }
      .llamada__video { position: relative; aspect-ratio: 4 / 3; border-radius: 18px; overflow: hidden; display: grid; place-items: end center; background: radial-gradient(80% 70% at 50% 30%, #4a423b, var(--negro)); }
      .llamada__silueta { width: 62%; fill: #7a6f64; }
      .llamada__nombre { position: absolute; left: 0.75rem; top: 0.75rem; padding: 0.3rem 0.65rem; border-radius: 999px; background: rgb(0 0 0 / 0.55); color: var(--crema); font-size: 0.75rem; font-weight: 700; }
      .llamada__tu { position: absolute; right: 0.75rem; top: 0.75rem; display: grid; place-items: center; width: 24%; aspect-ratio: 3 / 4; border-radius: 12px; border: 2px solid rgb(246 241 232 / 0.75); background: linear-gradient(160deg, #6b6158, #2b2622); color: var(--crema); font-size: 0.75rem; font-weight: 800; }
      .llamada__burbuja { position: relative; z-index: 1; justify-self: start; max-width: 88%; margin: -2.25rem 0 0 0.75rem; padding: 0.75rem 1rem; border-radius: 16px 16px 16px 4px; background: var(--acento); color: var(--acento-txt); font-size: var(--t2); font-weight: 700; line-height: 1.35; box-shadow: 0 12px 24px -14px rgb(22 20 18 / 0.5); }
      .llamada__reto { display: grid; gap: 0.15rem; padding: 0.75rem 1rem; border-radius: 14px; border: 1.5px dashed rgb(22 20 18 / 0.35); }
      .llamada__reto span { font-size: 0.75rem; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; color: var(--gris-oscuro); }
      .llamada__reto strong { font-family: var(--titular); font-weight: 800; font-stretch: 105%; font-size: var(--t3); line-height: 1.2; color: var(--negro); }
      .llamada__controles { display: flex; justify-content: center; gap: 0.75rem; padding-bottom: 0.25rem; }
      .llamada__controles span { display: grid; place-items: center; width: 2.5rem; height: 2.5rem; border-radius: 50%; background: rgb(22 20 18 / 0.08); color: var(--negro); }
      .llamada__controles .llamada__colgar { background: #d8452b; color: #ffffff; }

      /* Paso 3: cromos de quien ya está ahí. Móvil: mazo para deslizar. Escritorio: abanico que se reparte */
      .cromos { position: relative; width: 100%; height: 30rem; }
      .cromo { position: absolute; left: 50%; top: 0.5rem; display: grid; width: 13.5rem; padding: 0.5rem; border-radius: 20px; background: var(--negro); color: var(--crema); box-shadow: 0 24px 34px -20px rgb(22 20 18 / 0.6); translate: -50% 0; user-select: none; -webkit-user-select: none; touch-action: pan-y; }
      /* Cromo sin foto todavía: inicial grande e icono de la profesión */
      .foto-hueco { position: relative; display: grid; place-items: center; width: 100%; height: 100%; aspect-ratio: 1 / 1; background: radial-gradient(circle at 30% 25%, #3a342e, #1d1a17); color: var(--acento); }
      .foto-hueco[data-k='1'] { background: radial-gradient(circle at 70% 25%, #34302b, #1d1a17); }
      .foto-hueco[data-k='2'] { background: radial-gradient(circle at 50% 80%, #2e2b33, #1d1a17); }
      .foto-hueco__ini { font-family: var(--titular); font-weight: 800; font-stretch: 105%; font-size: 6rem; line-height: 1; opacity: 0.18; color: var(--crema); }
      .foto-hueco__ic { position: absolute; display: grid; place-items: center; width: 4.5rem; height: 4.5rem; border-radius: 50%; background: rgb(200 245 59 / 0.12); }
      .foto-hueco__ic svg { width: 2.5rem; height: 2.5rem; }
      .cromo__foto { aspect-ratio: 1 / 1; border-radius: 14px; overflow: hidden; border: 2px solid var(--acento); }
      .cromo__img { width: 100%; height: 100%; object-fit: cover; pointer-events: none; }
