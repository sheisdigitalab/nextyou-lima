        .v7pasos { gap: 0; }
        .v7paso { min-height: 70svh; align-content: center; }
        .v7paso__movil { display: none; }
        .v7paso__texto { position: relative; padding-left: 1.5rem; transition: opacity 300ms ease; }
        .v7paso:not(.activo) .v7paso__texto { opacity: 0.35; }
        .v7demo__fijo { display: grid; place-items: center; position: sticky; top: max(5.5rem, calc(50svh - 19rem)); }
        .v7tel--fijo { width: 17.5rem; }
        .v7tel--fijo .v7pant { opacity: 0; transform: translateY(14px); transition: opacity 400ms cubic-bezier(0.23, 1, 0.32, 1), transform 400ms cubic-bezier(0.23, 1, 0.32, 1); }
        .v7tel--fijo .v7pant.activa { opacity: 1; transform: none; }
      }
