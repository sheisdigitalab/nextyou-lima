---
// Página para madres, padres y tutores. Registro más sereno que la home:
// fondo claro, menos juego, más método. El lima queda para detalles; los botones van en negro.
import Base from '../layouts/Base.astro';
import Menu from '../components/Menu.astro';
import Pie from '../components/Pie.astro';
import Boton from '../components/Boton.astro';
import Icono from '../components/Icono.astro';
import { familiasPagina as f } from '../data/familias';
import { resaltar } from '../utils/resaltar';
import { ENLACES } from '../config';
---

<Base titulo={f.titulo} descripcion={f.descripcion}>
  <Menu solido />
  <main id="contenido" class="familias-pag claro">
    <!-- Hero -->
    <section class="f-hero" aria-labelledby="f-titulo">
      <div class="contenedor f-hero__rejilla">
        <div class="f-hero__texto">
          <p class="etiqueta">{f.hero.etiqueta}</p>
          <h1 id="f-titulo" set:html={resaltar(f.hero.titulo, f.hero.resaltado, 'subrayado subrayado--negro')} />
          <p class="f-hero__lead">{f.hero.texto}</p>
          <div class="f-hero__acciones">
            <Fragment set:html="<!-- PENDIENTE: destino de los botones (relevo por enlace / ruta conjunta) -->" />
            <Boton variante="oscuro" flecha>{f.hero.principal}</Boton>
            <Boton variante="contorno">{f.hero.secundario}</Boton>
          </div>
          <ul class="f-meta" role="list">
            {f.hero.meta.map((m) => <li class="pastilla pastilla--contorno">{m}</li>)}
          </ul>
        </div>

        <!-- Muestra de la pantalla en la que el joven elige qué comparte -->
        <figure class="hoja cinta" aria-labelledby="hoja-titulo">
          <p class="nota hoja__nota" aria-hidden="true">esto lo decide él o ella ↓</p>
          <h2 id="hoja-titulo" class="hoja__titulo">¿Qué quieres compartir?</h2>
          <ul class="hoja__opciones" role="list">
            {
              f.compartir.niveles.map((n, i) => (
                <li class:list={['hoja__opcion', i === 1 && 'hoja__opcion--sel']}>
                  <span class="hoja__radio" aria-hidden="true" />
                  <span>{n.nombre}</span>
                </li>
              ))
            }
          </ul>
          <figcaption class="hoja__pie">Ejemplo de la pantalla que ve al terminar</figcaption>
        </figure>
      </div>
    </section>

    <!-- Por qué funciona así -->
    <section class="f-bloque" aria-labelledby="f-porque">
      <div class="contenedor">
        <header class="f-cabecera">
          <p class="etiqueta">{f.porque.etiqueta}</p>
          <h2 id="f-porque">{f.porque.titulo}</h2>
          <p class="f-lead">{f.porque.texto}</p>
        </header>
        <ul class="f-ideas" role="list">
          {
            f.porque.ideas.map((idea) => (
              <li>
                <h3>{idea.titulo}</h3>
                <p>{idea.texto}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- Dos formas de empezar -->
    <section class="f-bloque f-bloque--hueso" aria-labelledby="f-modos">
      <div class="contenedor">
        <header class="f-cabecera">
          <p class="etiqueta">{f.modos.etiqueta}</p>
          <h2 id="f-modos">{f.modos.titulo}</h2>
        </header>
        <ul class="f-modos" role="list">
          {
            f.modos.opciones.map((o, i) => (
              <li class="f-modo">
                <Icono nombre={i === 0 ? 'lado' : 'camino'} tam={44} />
                <h3>{o.nombre}</h3>
                <p>{o.texto}</p>
                <ul class="f-chips" role="list">
                  {o.puntos.map((pt) => <li class="pastilla pastilla--contorno">{pt}</li>)}
                </ul>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- Qué ves tú y qué no -->
    <section class="f-bloque" aria-labelledby="f-compartir">
      <div class="contenedor f-dos">
        <header class="f-cabecera">
          <p class="etiqueta">{f.compartir.etiqueta}</p>
          <h2 id="f-compartir">{f.compartir.titulo}</h2>
          <p class="f-lead">{f.compartir.nota}</p>
        </header>
        <div class="f-compartir">
          <ol class="f-niveles" role="list">
            {
              f.compartir.niveles.map((n, i) => (
                <li>
                  <span class="f-niveles__n" aria-hidden="true">{i + 1}</span>
                  <div>
                    <h3>{n.nombre}</h3>
                    <p>{n.texto}</p>
                  </div>
                </li>
              ))
            }
          </ol>
          <div class="f-nunca">
            <h3 class="mano">Lo que no vas a ver</h3>
            <ul role="list">
              {
                f.compartir.nunca.map((t) => (
                  <li>
                    <svg width="16" height="16" viewBox="0 0 14 14" aria-hidden="true">
                      <path d="M2 2l10 10M12 2L2 12" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" />
                    </svg>
                    {t}
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- La guía para hablarlo -->
    <section class="f-bloque f-bloque--oscuro" aria-labelledby="f-guia">
      <div class="contenedor">
        <header class="f-cabecera">
          <p class="etiqueta">{f.guia.etiqueta}</p>
          <h2 id="f-guia">{f.guia.titulo}</h2>
        </header>
        <ul class="f-guia" role="list">
          {
            f.guia.puntos.map((pt) => (
              <li>
                <h3>{pt.titulo}</h3>
                <p>{pt.texto}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- Acompañamiento con coach -->
    <section class="f-bloque" aria-labelledby="f-coach">
      <div class="contenedor f-dos">
        <header class="f-cabecera">
          <p class="etiqueta">{f.coach.etiqueta}</p>
          <h2 id="f-coach">{f.coach.titulo}</h2>
          <p class="f-lead">{f.coach.nota}</p>
          <a class="f-enlace" href={ENLACES.acompanamiento}>Cómo es el acompañamiento, paso a paso →</a>
          <Fragment set:html="<!-- PENDIENTE: precio del acompañamiento con coach -->" />
        </header>
        <div>
          <ol class="f-pasos" role="list">
            {
              f.coach.pasos.map((p, i) => (
                <li>
                  <span class="f-pasos__n mano" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                  <div>
                    <h3>{p.titulo}</h3>
                    <p>{p.texto}</p>
                  </div>
                </li>
              ))
            }
          </ol>
          <div class="f-nohace">
            <h3>Lo que un coach no hace</h3>
            <ul role="list">
              {f.coach.noHace.map((t) => <li>{t}</li>)}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- Datos -->
    <section class="f-bloque f-bloque--hueso" aria-labelledby="f-datos">
      <div class="contenedor f-dos">
        <header class="f-cabecera">
          <p class="etiqueta">{f.datos.etiqueta}</p>
          <h2 id="f-datos">{f.datos.titulo}</h2>
        </header>
        <ul class="f-datos" role="list">
          {f.datos.puntos.map((t) => <li>{t}</li>)}
        </ul>
        <Fragment set:html="<!-- PENDIENTE: enlace a la política de privacidad y datos de menores (textos legales de la clienta) -->" />
      </div>
    </section>

    <!-- Preguntas -->
    <section class="f-bloque" aria-labelledby="f-preguntas">
      <div class="contenedor f-dos">
        <header class="f-cabecera">
          <p class="etiqueta">{f.preguntas.etiqueta}</p>
          <h2 id="f-preguntas">{f.preguntas.titulo}</h2>
        </header>
        <div class="f-faq">
          {
            f.preguntas.lista.map((q) => (
              <details>
                <summary>{q.p}</summary>
                <p>{q.r}</p>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Cierre -->
    <section class="f-cierre" aria-labelledby="f-cierre">
      <div class="contenedor f-cierre__caja">
        <h2 id="f-cierre">{f.cierre.titulo}</h2>
        <Boton variante="oscuro" flecha>{f.cierre.boton}</Boton>
      </div>
    </section>
  </main>
  <Pie cierre={false} />
</Base>

<style>
  /* Página clara: texto negro sobre papel. */
  .familias-pag {
    background: var(--papel);
    color: var(--negro);
  }

  .f-bloque {
    padding-block: var(--e-5);
  }

  .f-bloque--hueso {
    background: var(--hueso);
  }

  .f-bloque--oscuro {
    background: var(--negro);
    color: var(--hueso);
  }

  .f-bloque--oscuro .etiqueta {
    color: var(--hueso-suave);
  }

  .f-bloque--oscuro .etiqueta::before {
    background: var(--lima);
  }

  .f-cabecera {
    display: grid;
    gap: var(--e-2);
    margin-bottom: var(--e-4);
    align-content: start;
  }

  .f-cabecera h2 {
    font-size: var(--t-5);
    max-width: 18ch;
  }

  .f-lead {
    font-size: var(--t-3);
    color: var(--gris);
    max-width: 38rem;
  }

  /* ---------- Hero ---------- */
  .f-hero {
    padding-block: 8rem var(--e-5);
  }

  .f-hero__rejilla {
    display: grid;
    gap: var(--e-5);
    align-items: center;
  }

  .f-hero__texto {
    display: grid;
    gap: var(--e-3);
    justify-items: start;
  }

  .f-hero__texto h1 {
    font-size: clamp(2.5rem, 1.4rem + 4.4vw, 5rem);
    max-width: 13ch;
  }

  .f-hero__lead {
    font-size: var(--t-3);
    max-width: 34rem;
  }

  .f-hero__acciones {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .f-meta,
  .f-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }

  /* Hoja de elección: muestra del producto */
  .hoja {
    position: relative;
    display: grid;
    gap: var(--e-2);
    padding: var(--e-4) var(--e-3) var(--e-3);
    border-radius: 18px;
    background: var(--negro);
    color: var(--hueso);
    rotate: 1.5deg;
    box-shadow: 0 18px 40px -16px rgb(22 20 18 / 0.45);
    max-width: 26rem;
    justify-self: center;
    width: 100%;
  }

  .hoja__nota {
    position: absolute;
    top: -2.5rem;
    right: 0;
    font-size: 1.1rem;
    color: var(--negro);
  }

  .hoja__titulo {
    font-size: var(--t-4);
  }

  .hoja__opciones {
    display: grid;
    gap: 0.5rem;
  }

  .hoja__opcion {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.875rem 1rem;
    border-radius: 12px;
    border: 1.5px solid var(--linea);
    font-weight: 600;
  }

  .hoja__opcion--sel {
    border-color: var(--lima);
    background: rgb(200 245 59 / 0.08);
  }

  .hoja__radio {
    flex-shrink: 0;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    border: 2px solid var(--hueso-suave);
  }

  .hoja__opcion--sel .hoja__radio {
    border-color: var(--lima);
    background: radial-gradient(circle, var(--lima) 0 45%, transparent 50%);
  }

  .hoja__pie {
    font-size: var(--t-1);
    color: var(--hueso-suave);
  }

  /* ---------- Ideas ---------- */
  .f-ideas {
    display: grid;
    gap: var(--e-4);
  }

  .f-ideas li {
    display: grid;
    gap: var(--e-1);
    padding-top: var(--e-2);
    border-top: 2px solid var(--negro);
  }

  .f-ideas h3,
  .f-modo h3,
  .f-guia h3,
  .f-niveles h3,
  .f-pasos h3 {
    font-size: var(--t-4);
    line-height: 1.12;
  }

  .f-ideas p,
  .f-modo p,
  .f-niveles p,
  .f-pasos p {
    color: var(--gris);
  }

  /* ---------- Modos ---------- */
  .f-modos {
    display: grid;
    gap: var(--e-3);
  }

  .f-modo {
    display: grid;
    gap: var(--e-2);
    align-content: start;
    padding: var(--e-4) var(--e-3);
    border-radius: var(--radio);
    background: var(--papel);
  }

  .f-modo :global(.icono) {
    color: var(--negro);
  }

  /* ---------- Compartir ---------- */
  .f-compartir {
    display: grid;
    gap: var(--e-4);
  }

  .f-niveles {
    display: grid;
    gap: var(--e-3);
  }

  .f-niveles li,
  .f-pasos li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--e-2);
    align-items: start;
  }

  .f-niveles__n {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    background: var(--negro);
    color: var(--lima);
    font-weight: 800;
  }

  .f-niveles div,
  .f-pasos div {
    display: grid;
    gap: 0.25rem;
  }

  .f-nunca {
    padding: var(--e-3);
    border-radius: var(--radio);
    background: var(--negro);
    color: var(--hueso);
  }

  .f-nunca h3 {
    font-size: 1.5rem;
    color: var(--lima);
    margin-bottom: var(--e-2);
    font-weight: 400;
  }

  .f-nunca ul {
    display: grid;
    gap: 0.75rem;
    font-weight: 600;
  }

  .f-nunca li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.75rem;
    align-items: baseline;
  }

  .f-nunca svg {
    color: var(--lima);
    translate: 0 2px;
  }

  /* ---------- Guía ---------- */
  .f-guia {
    display: grid;
    gap: var(--e-3);
  }

  .f-guia li {
    display: grid;
    gap: var(--e-1);
    padding: var(--e-3);
    border-radius: var(--radio);
    border: 1px solid var(--linea);
  }

  .f-guia p {
    color: var(--hueso-suave);
  }

  .f-enlace {
    font-weight: 800;
    text-decoration: underline;
    text-decoration-color: var(--negro);
    text-underline-offset: 0.25em;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }

  /* ---------- Coach ---------- */
  .f-pasos {
    display: grid;
    gap: var(--e-3);
  }

  .f-pasos__n {
    font-size: 1.75rem;
    line-height: 1;
    min-width: 2.5rem;
    rotate: -4deg;
  }

  .f-nohace {
    margin-top: var(--e-4);
    padding-top: var(--e-3);
    border-top: 1.5px dashed rgb(22 20 18 / 0.25);
  }

  .f-nohace h3 {
    font-size: var(--t-3);
    margin-bottom: var(--e-2);
  }

  .f-nohace ul {
    display: grid;
    gap: 0.5rem;
    font-weight: 600;
  }

  .f-nohace li::before {
    content: '';
    display: inline-block;
    width: 10px;
    height: 10px;
    margin-right: 0.75rem;
    border-radius: 50%;
    background: var(--negro);
  }

  /* ---------- Datos ---------- */
  .f-datos {
    display: grid;
    gap: var(--e-2);
    font-size: var(--t-3);
    font-weight: 600;
    align-content: start;
  }

  .f-datos li {
    padding-bottom: var(--e-2);
    border-bottom: 1px solid rgb(22 20 18 / 0.15);
  }

  /* ---------- Preguntas ---------- */
  .f-faq {
    display: grid;
    border-top: 1px solid rgb(22 20 18 / 0.15);
  }

  .f-faq details {
    border-bottom: 1px solid rgb(22 20 18 / 0.15);
  }

  .f-faq summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--e-2);
    min-height: 56px;
    padding-block: var(--e-2);
    font-size: var(--t-3);
    font-weight: 800;
    cursor: pointer;
    list-style: none;
  }

  .f-faq summary::-webkit-details-marker {
    display: none;
  }

  .f-faq summary::after {
    content: '+';
    font-size: 1.5rem;
    font-weight: 600;
    transition: rotate 200ms ease;
  }

  .f-faq details[open] summary::after {
    rotate: 45deg;
  }

  .f-faq details p {
    padding-bottom: var(--e-3);
    color: var(--gris);
    max-width: 40rem;
  }

  /* ---------- Cierre ---------- */
  .f-cierre {
    padding-block: var(--e-5);
    background: var(--hueso);
  }

  .f-cierre__caja {
    display: grid;
    gap: var(--e-3);
    justify-items: start;
  }

  .f-cierre h2 {
    font-size: var(--t-5);
    max-width: 18ch;
  }

  @media (min-width: 48rem) {
    .f-ideas,
    .f-guia {
      grid-template-columns: repeat(3, 1fr);
    }

    .f-modos {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 64rem) {
    .f-hero__rejilla {
      grid-template-columns: 1.2fr 1fr;
    }

    .f-dos {
      display: grid;
      grid-template-columns: 1fr 1.2fr;
      gap: var(--e-5);
      align-items: start;
    }

    .f-dos .f-cabecera {
      margin-bottom: 0;
      position: sticky;
      top: 6rem;
    }

    .f-compartir {
      grid-template-columns: 1fr;
    }
  }
</style>
