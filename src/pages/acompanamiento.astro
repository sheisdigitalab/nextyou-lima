  @media (min-width: 54rem) { .ac .ac-endg { grid-template-columns: 1.3fr 1fr; } }
  .ac .ac-tel { position: relative; justify-self: center; width: 290px; height: 600px; border-radius: 46px; background: #121212; padding: 9px; box-shadow: inset 0 0 0 1.5px #2e2e2e, 0 40px 70px -40px #000; transform: rotate(3deg); }
  .ac .ac-tel .cfa-pan { width: 100%; height: 100%; }
  .ac .ac-noti { position: absolute; z-index: 6; bottom: 84px; left: -64px; display: flex; gap: 9px; align-items: center; width: max-content; max-width: 220px; padding: 9px 13px 9px 9px; border-radius: 16px; background: #fff; color: #141414; box-shadow: 0 18px 36px -18px rgb(0 0 0 / 0.5), 0 0 0 1px rgb(0 0 0 / 0.05); }
  .ac .ac-noti > i { flex: none; width: 34px; height: 34px; border-radius: 11px; background: #c8f53b; display: grid; place-items: center; font: 900 16px/1 var(--titular); font-style: normal; }
  .ac .ac-noti span { display: grid; gap: 1px; }
  .ac .ac-noti small { font-size: 11.5px; font-weight: 700; color: #5f5e58; }
  .ac .ac-noti b { font-size: 13.5px; font-weight: 800; line-height: 1.2; }
  @media (max-width: 53.99rem) { .ac .ac-tel { display: none; } }

  /* Coaches: tarjetas de vídeo con el estilo de los reels de la home, alineadas */
  .ac .ac-co { align-items: stretch; }
  .ac .ac-cl { aspect-ratio: 3 / 4.2; border-radius: 18px; background: var(--negro-2, #161412); isolation: isolate; box-shadow: none; transition: none; }
  .ac .ac-cl::before { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(170deg, #3a342c, #1f1b17); }
  .ac .ac-cl::after { background: linear-gradient(to bottom, rgb(22 20 18 / 0.35) 0%, rgb(22 20 18 / 0) 22%, rgb(22 20 18 / 0) 40%, rgb(22 20 18 / 0.92) 100%); }
  .ac .ac-cl .ac-pie { left: 0; right: 0; bottom: 0; padding: 1.125rem; display: grid; gap: 0.25rem; justify-items: start; }
  .ac .ac-cl h3 { font-size: 1.1875rem; font-weight: 800; }
  .ac .ac-cl p { margin: 0.2rem 0 0; min-height: 0; font-size: 0.9375rem; line-height: 1.3; }
  .ac .ac-cl button { background: rgb(22 20 18 / 0.55); color: var(--hueso, #ece8de); border: 1px solid rgb(236 232 222 / 0.35); backdrop-filter: blur(6px); font-weight: 600; font-size: 0.8125rem; padding: 0.3rem 0.8rem; margin-top: 0.6rem; }
  .ac .ac-cl button:hover { background: #c8f53b; border-color: #c8f53b; color: #161412; }
  .ac .ac-cl .ac-fo { color: #f6f1e81f; }
  @media (max-width: 30rem) { .ac .ac-cl { aspect-ratio: auto; min-height: 19rem; } .ac .ac-cl .ac-pie { padding: 0.875rem; } }

  /* Entrada suave al hacer scroll */
  html.ac-js .ac .ac-rv { opacity: 0; transform: translateY(18px); transition: opacity 0.6s ease, transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1); }
