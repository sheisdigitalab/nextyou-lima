<style is:global>
  /* ---------- Ajustes a la web: tokens, tipografía, botones, teléfono y barra fija ---------- */
  .ac { --n: #161412; --t: var(--tarjeta, #24201c); --c: var(--crema, #f6f1e8); --g: var(--gris, #b8b0a3); --g2: #d9d2c6; --a: #c8f53b; --gl: #5f574e; --l: var(--linea, #f6f1e81a);
    background: var(--negro-2, #161412); color: var(--crema); font-family: var(--sans); line-height: 1.55; }
  .ac h1, .ac h2 { font-family: var(--titular); font-weight: 900; font-stretch: 100%; }
  .ac h1 { font-size: var(--t-h1); line-height: 1.04; max-width: 17ch; }
  .ac h2 { font-size: clamp(1.9rem, 1.2rem + 3.2vw, 3rem); }
  .ac h3, .ac h4 { font-family: var(--titular); }
  .ac .ac-ey { color: var(--a); }
  /* Palabras destacadas: verde lima, sin subrayado ni franja. En el bloque crema, negro sobre píldora lima */
  .ac .ac-hl { font-style: normal; color: #c8f53b; text-decoration: none; background: none; }
  .ac .ac-light .ac-hl { color: #161412; background: #c8f53b; padding: 0 0.14em; border-radius: 8px; -webkit-box-decoration-break: clone; box-decoration-break: clone; }
  .ac .ac-light .ac-ey { color: #161412; }
  .ac .boton { min-height: 48px; justify-content: center; }
  .ac .boton.boton--sm { min-height: 44px; width: 100%; }
  .ac .ac-light .boton--contorno { color: #161412; border-color: rgb(22 20 18 / 0.4); }
  .ac .ac-plan.ac-rec .boton--oscuro, .ac .ac-cmp .ac-r .boton--oscuro { background: #161412; color: #f6f1e8; border-color: #161412; }
  .ac a:focus-visible, .ac button:focus-visible, .ac summary:focus-visible { outline: 2px solid var(--a); outline-offset: 3px; }
  .ac .ac-light a:focus-visible { outline-color: #161412; }
  .ac summary:focus:not(:focus-visible) { outline: none; }
  .ac .ac-rec .ac-chips li { background: rgb(22 20 18 / 0.08); }

  /* Teléfono del cierre: la pantalla «Tus 3 caminos» de la home, con iconos */
