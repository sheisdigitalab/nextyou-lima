  @media (prefers-reduced-motion: reduce) { html.ac-js .ac .ac-rv { opacity: 1; transform: none; transition: none; } .ac { scroll-behavior: auto; } }

  /* Barra fija en móvil: aparece al pasar el hero y se oculta en planes y en el pie */
  .ac-stick { position: fixed; left: 0; right: 0; bottom: 0; z-index: 30; display: none; align-items: center; justify-content: space-between; gap: 0.75rem; padding: 0.75rem max(1rem, env(safe-area-inset-left, 0px)) calc(0.75rem + env(safe-area-inset-bottom, 0px)); background: rgb(22 20 18 / 0.95); border-top: 1px solid var(--linea); backdrop-filter: blur(8px); transform: translateY(110%); transition: transform 0.25s; }
  .ac-stick.ac-on { transform: none; }
  .ac-stick p { margin: 0; font-size: 0.9375rem; color: #d9d2c6; }
  .ac-stick b { color: #f6f1e8; }
  .ac-stick .boton { min-height: 44px; padding: 0.5rem 1.125rem; font-size: 0.9375rem; }
  @media (max-width: 53.75rem) { .ac-stick { display: flex; } }
</style>

<script>
  // Entrada suave de los bloques
  (function () {
    if (!('IntersectionObserver' in window) || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    document.documentElement.classList.add('ac-js');
    var els = document.querySelectorAll('.ac section > h2, .ac section > .ac-lead, .ac .ac-sit > div, .ac .ac-steps li, .ac .ac-plans > article, .ac .ac-light, .ac .ac-co > li, .ac .ac-faq, .ac .ac-contact, .ac .ac-endg > *');
    els.forEach(function (e, i) { e.classList.add('ac-rv'); (e as HTMLElement).style.transitionDelay = (i % 4) * 70 + 'ms'; });
    var io = new IntersectionObserver(function (en) {
      en.forEach(function (x) { if (x.isIntersecting) { x.target.classList.add('ac-in'); io.unobserve(x.target); } });
    }, { rootMargin: '0px 0px -8% 0px' });
    els.forEach(function (e) { io.observe(e); });
  })();
  // Barra fija «Desde 49 €»: visible tras el hero, oculta en la sección de planes y en el pie
  (function () {
    var s = document.getElementById('ac-stick'), h = document.querySelector('.ac-hero'), p = document.getElementById('planes'), f = document.querySelector('.pie, footer');
    if (!s || !h || !p || !('IntersectionObserver' in window)) return;
    var vis = { h: true, p: false, f: false };
    function u() { s.classList.toggle('ac-on', !vis.h && !vis.p && !vis.f); }
    var o = new IntersectionObserver(function (e) {
      e.forEach(function (x) { if (x.target === h) vis.h = x.isIntersecting; if (x.target === p) vis.p = x.isIntersecting; if (x.target === f) vis.f = x.isIntersecting; });
      u();
    });
    o.observe(h); o.observe(p); if (f) o.observe(f);
  })();
</script>
