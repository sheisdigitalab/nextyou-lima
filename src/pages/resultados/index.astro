---
// Página de resultados del test: un mapa fino con «Tú» y tres ramas hacia los 3 caminos. Al elegir uno se ve su
// ficha (qué haces, el dato, qué necesitas saber y cómo llegar, con las vías comparadas por duración) y, debajo,
// el acompañamiento premium que se puede contratar.
//
// PENDIENTE CLIENTA / DESARROLLO:
//  - Los caminos de esta página son de EJEMPLO (src/data/resultados.ts). En el producto real salen de las respuestas del test.
//  - Nombre: se lee de ?nombre=... y, si no viene, el saludo no lo lleva.
//  - Precio, sesiones y enlace de contratación del coach: hoy el botón abre el aviso «próximamente».
import { Image } from 'astro:assets';
import V5 from '../../layouts/V5.astro';
import { CTA_PRINCIPAL } from '../../config';
import { caminos, acompanamiento as coach } from '../../data/resultados';

// Bloque del coach: 'C' = banda discreta (la que se ve) · 'B' = «tus 3 caminos llevan al coach» (montada, oculta)
const coachVariante: 'C' | 'B' = 'C';
// Fila «Envíame mis caminos» / «Compartir»: solo diseño, sin funcionalidad ni datos (pon false para quitarla)
const mostrarGuardar = true;
const MAX_MESES = 48; // la línea más larga (4 años) ocupa todo el ancho
const ramas = ['M150 0 V10 C150 38 50 34 50 70', 'M150 0 V70', 'M150 0 V10 C150 38 250 34 250 70'];
const iconos = {
  fp: '<path d="M14.7 6.3a4 4 0 0 0-5.4 5.4L3 18l3 3 6.3-6.3a4 4 0 0 0 5.4-5.4l-2.5 2.5-2.4-.6-.6-2.4z"/>',
  uni: '<path d="M2 9l10-5 10 5-10 5z"/><path d="M6 11v5c3 2 9 2 12 0v-5"/>',
  curso: '<rect x="3" y="5" width="18" height="11" rx="2"/><path d="M2 19h20"/>',
  solo: '<path d="M12 3l2.2 5.8L20 11l-5.8 2.2L12 19l-2.2-5.8L4 11l5.8-2.2z"/>',
};
---

<V5
  titulo="Tus 3 caminos · NextYou"
  descripcion="Tus 3 caminos profesionales: en qué consiste cada uno, qué formación necesitas y cómo llegar. Y, si quieres, un coach que te acompañe."
  actual="bachillerato"
  soloBachillerato
  ruta=""
  robots="noindex, follow"
  cta={{ texto: 'Repetir el test', href: CTA_PRINCIPAL.href }}
>
  <main id="contenido" class="res">
    <div class="ancho res__caja">
      <header class="res__cab">
        <p class="res__saludo" data-saludo>¡Listo!</p>
        <h1 class="res__titulo">Tus <span class="res__tres">3</span> caminos</h1>
        <p class="res__lead">Salen de tus respuestas. No son una lista cerrada: son tres pistas para empezar a explorar.</p>
        <p class="res__toca">Toca cada uno para ver de qué va y cómo llegar.</p>
        {/* PENDIENTE: caminos de ejemplo; en el producto real salen del test */}
      </header>

      <section class="mp" data-mapa data-sel="0" aria-label="Mapa de tus caminos">
        <div class="mp__tu"><span class="mp__punto" aria-hidden="true"></span><b>Tú</b></div>
        <svg class="mp__ramas" viewBox="0 0 300 70" preserveAspectRatio="none" aria-hidden="true">
          {ramas.map((d, i) => <path class="mp__rama" data-r={i} d={d} />)}
        </svg>
        <div class="mp__destinos" role="tablist" aria-label="Tus 3 caminos">
          {
            caminos.map((c, i) => (
              <button type="button" role="tab" class="mp__dest" id={`tab-${c.id}`} aria-controls={`panel-${c.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-i={i}>
                <span class="mp__foto">
                  <Image src={c.foto} alt="" width={140} height={140} loading="lazy" />
                  <span class="mp__n" aria-hidden="true">{i + 1}</span>
                </span>
                <small class="mp__tipo">{c.tipo}</small>
                <b class="mp__nombre">{c.nombre}</b>
              </button>
            ))
          }
        </div>
      </section>

      <nav class="mp__fija" aria-label="Cambiar de camino" data-fija>
        {
          caminos.map((c, i) => (
            <button type="button" class="mp__fb" data-i={i} aria-pressed={i === 0 ? 'true' : 'false'} aria-label={`Camino ${i + 1}: ${c.nombre}`}>
              <span class="mp__fn" aria-hidden="true">{i + 1}</span>
              <span class="mp__ft">{c.nombre}</span>
            </button>
          ))
        }
      </nav>

      {
        caminos.map((c, i) => (
          <section class="mp__panel" role="tabpanel" id={`panel-${c.id}`} aria-labelledby={`tab-${c.id}`} hidden={i !== 0} data-placeholder="true" tabindex="0">
            <header class="mp__cab">
              <p class="mp__sup">Camino {i + 1} · {c.tipo}</p>
              <p class="mp__def">{c.definicion}</p>
              <h2 class="mp__h2">{c.nombre}</h2>
              <p class="mp__gancho">{c.resumen}</p>
              <ul class="mp__chips" role="list" aria-label="Se te da bien">
                {c.chips.map((t) => <li>{t}</li>)}
              </ul>
            </header>

            <div class="mp__bloque">
              <h3 class="mp__h3">En qué consiste</h3>
              <dl class="mp__datos">
                <div class="mp__dato mp__dato--que"><dt>Qué haces</dt><dd>{c.que}</dd></div>
                {c.trabajo && <div class="mp__dato mp__dato--trabajo"><dt>Cómo se llama este trabajo</dt><dd>{c.trabajo}</dd></div>}
                <div class="mp__dato mp__dato--dia"><dt>Un día normal</dt><dd>{c.dia}</dd></div>
                <div class="mp__dato mp__dato--porque"><dt>Por qué encaja contigo</dt><dd>{c.porque}</dd></div>
              </dl>
            </div>

            <div class="mp__bloque">
              <h3 class="mp__h3">Cómo llegar <small>Hay más de un camino</small></h3>
              <ol class="vias" role="list">
                {
                  c.rutas.map((r) => (
                    <li>
                      <details class={`via via--${r.tipo}`} style={r.meses ? `--w: ${Math.round((r.meses / MAX_MESES) * 100)}%` : undefined}>
                        <summary>
                          <span class="via__ic" aria-hidden="true"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={iconos[r.tipo]} /></span>
                          <b class="via__tit">{r.titulo}</b>
                          <span class="via__mas" aria-hidden="true"></span>
                          <span class="via__pista">
                            <span class="via__linea" aria-hidden="true"><span class="via__barra"></span></span>
                            <span class="via__dur">{r.duracion}</span>
                          </span>
                        </summary>
                        <p class="via__det">{r.detalle}</p>
                      </details>
                    </li>
                  ))
                }
              </ol>
              <p class="mp__ref">Cuanto más larga la línea, más tiempo de formación. Toca una vía para ver qué aprendes. Las duraciones son aproximadas.</p>
            </div>

            <div class="mp__mas">
              <details class="mp__det">
                {/* PENDIENTE CLIENTA: validar dato */}
                <summary><span>El dato</span><i aria-hidden="true"></i></summary>
                <p class="mp__p">{c.dato}</p>
                <p class="mp__ref">Datos de referencia en España. Pueden variar según la empresa y la ciudad.</p>
              </details>
              <details class="mp__det">
                <summary><span>{c.formacionTitulo ?? 'La formación'}</span><i aria-hidden="true"></i></summary>
                <p class="mp__p">{c.formacion}</p>
              </details>
            </div>

            <a class="mp__coach" href="#coach">¿Quieres ayuda para decidir? <b>Habla con un coach</b> <span aria-hidden="true">↓</span></a>
          </section>
        ))
      }

      <div class="res__cierre">
        <h3 class="res__cierre-t">No tienes que elegir ya.</h3>
        <p class="res__cierre-p">Lo importante ahora es explorar: empieza por el camino que más curiosidad te dé. Y repite el test cuando quieras: si cambias tú, cambian tus caminos.</p>
        <a class="boton boton--contorno" href={CTA_PRINCIPAL.href}>Repetir el test</a>
      </div>

      {
        mostrarGuardar && (
          <div class="res__guardar">
            <div class="res__guardar-botones">
              <button type="button" class="boton boton--contorno" data-proximamente>
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="M3 7l9 6 9-6" /></svg>
                Envíame mis caminos
              </button>
              <button type="button" class="boton boton--contorno" data-proximamente>
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="6" cy="12" r="2.5" /><circle cx="18" cy="6" r="2.5" /><circle cx="18" cy="18" r="2.5" /><path d="M8.2 10.8l7.6-3.6M8.2 13.2l7.6 3.6" /></svg>
                Compartir
              </button>
            </div>
            <p class="res__aviso" role="status" aria-live="polite" data-aviso></p>
          </div>
        )
      }

      {/* ===================== Acompañamiento premium ===================== */}
      {
        coachVariante === 'C' && (
          <section id="coach" class="coach coach--c" aria-label="Acompañamiento premium" data-placeholder="true">
            {/* PENDIENTE CLIENTA: precio, número y duración de las sesiones, condiciones, enlace de contratación y nombre del coach */}
            <Image src={coach.foto} alt="" width={220} height={220} class="coach__av" loading="lazy" />
            <div class="coach__txt">
              <p class="mp__sup"><span aria-hidden="true">★</span> {coach.eti}</p>
              <blockquote class="coach__frase">«{coach.frase}»</blockquote>
              <p class="coach__firma">{coach.firma}</p>
            </div>
            <div class="coach__cta">
              <a class="boton boton--grande" href="#">{coach.cta} <span aria-hidden="true">→</span></a>
              <small>{coach.nota}</small>
            </div>
          </section>
        )
      }
      {
        coachVariante === 'B' && (
          <section id="coach" class="coach coach--b" aria-labelledby="coach-titulo" data-placeholder="true">
            {/* PENDIENTE CLIENTA: precio, número y duración de las sesiones, condiciones, enlace de contratación y nombre del coach */}
            <p class="mp__sup"><span aria-hidden="true">★</span> {coach.eti}</p>
            <h2 id="coach-titulo" class="coach__tit">{coach.titulo.antes}<em>{coach.titulo.enfasis}</em>{coach.titulo.despues}</h2>
            <p class="coach__intro">{coach.intro}</p>

            <div class="coach__flujo">
              <ul class="coach__cams" role="list" aria-label="Tus 3 caminos">
                {
                  caminos.map((c, i) => (
                    <li class={i === 2 ? 'salto' : undefined}>
                      <Image src={c.foto} alt="" width={68} height={68} loading="lazy" />
                      {c.nombre}
                    </li>
                  ))
                }
              </ul>
              <svg class="coach__lin" viewBox="0 0 120 180" preserveAspectRatio="none" aria-hidden="true">
                <path d="M0 30 C60 30 60 90 120 90" />
                <path d="M0 90 H120" />
                <path d="M0 150 C60 150 60 90 120 90" class="pt" />
              </svg>
              <div class="coach__yo">
                <Image src={coach.foto} alt="" width={192} height={192} loading="lazy" />
                <b>{coach.tuCoach}</b>
              </div>
              <svg class="coach__lin coach__lin--lima" viewBox="0 0 120 180" preserveAspectRatio="none" aria-hidden="true">
                <path d="M0 90 H120" />
              </svg>
              <div class="coach__plan">
                <span class="coach__ok" aria-hidden="true">✓</span>
                <b>{coach.plan.titulo}</b>
                <small>{coach.plan.texto}</small>
              </div>
            </div>

            <div class="coach__pie">
              <ul class="mp__chips coach__chips" role="list">
                {coach.chips.map((t) => <li>{t}</li>)}
              </ul>
              <div class="coach__cta">
                <a class="boton boton--grande" href="#">{coach.cta} <span aria-hidden="true">→</span></a>
                <small>{coach.nota}</small>
              </div>
            </div>
          </section>
        )
      }
    </div>
  </main>
</V5>

<script>
  // Saludo con el nombre, si llega en la dirección (?nombre=...)
  const nombre = (new URLSearchParams(location.search).get('nombre') || '').trim().slice(0, 40);
  const saludo = document.querySelector<HTMLElement>('[data-saludo]');
  if (saludo && nombre) saludo.textContent = `¡Listo, ${nombre}!`;

  // «Envíame mis caminos» y «Compartir»: de momento solo un aviso discreto; no se recoge ni se envía nada
  const aviso = document.querySelector<HTMLElement>('[data-aviso]');
  let avisoTimer: number | undefined;
  document.querySelectorAll<HTMLElement>('[data-proximamente]').forEach((b) =>
    b.addEventListener('click', () => {
      if (!aviso) return;
      aviso.textContent = 'Próximamente';
      aviso.classList.add('is-on');
      window.clearTimeout(avisoTimer);
      avisoTimer = window.setTimeout(() => {
        aviso.classList.remove('is-on');
        aviso.textContent = '';
      }, 2600);
    })
  );

  // Pestañas: elegir un camino muestra su ficha y resalta su rama del mapa (también con las flechas del teclado)
  const mapa = document.querySelector<HTMLElement>('[data-mapa]');
  if (mapa) {
    const tabs = [...mapa.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const paneles = [...document.querySelectorAll<HTMLElement>('.mp__panel')];
    const fija = document.querySelector<HTMLElement>('[data-fija]');
    const botones = fija ? [...fija.querySelectorAll<HTMLButtonElement>('.mp__fb')] : [];
    const menu = document.querySelector<HTMLElement>('.menu');
    const sinMovimiento = window.matchMedia('(prefers-reduced-motion: reduce)');

    // El menú de la web es fijo: la barra de caminos se pega justo debajo y la ficha se alinea bajo las dos
    const medir = () => document.documentElement.style.setProperty('--menu-h', `${menu?.offsetHeight ?? 0}px`);
    medir();
    window.addEventListener('resize', medir);

    const elegir = (i: number, opciones: { foco?: boolean; ir?: boolean } = {}) => {
      tabs.forEach((t, k) => {
        t.setAttribute('aria-selected', String(k === i));
        t.tabIndex = k === i ? 0 : -1;
      });
      botones.forEach((b, k) => b.setAttribute('aria-pressed', String(k === i)));
      paneles.forEach((p, k) => (p.hidden = k !== i));
      mapa.dataset.sel = String(i);
      if (opciones.foco) tabs[i].focus();
      // Llevar la vista a la ficha para que se note el cambio (solo si queda lejos de lo que se está viendo)
      if (opciones.ir && paneles[i].getBoundingClientRect().top > window.innerHeight * 0.5) {
        paneles[i].scrollIntoView({ behavior: sinMovimiento.matches ? 'auto' : 'smooth', block: 'start' });
      }
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => elegir(i, { ir: true }));
      t.addEventListener('keydown', (e) => {
        const n = tabs.length;
        if (e.key === 'ArrowRight' || e.key === 'ArrowDown') { e.preventDefault(); elegir((i + 1) % n, { foco: true }); }
        else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') { e.preventDefault(); elegir((i + n - 1) % n, { foco: true }); }
        else if (e.key === 'Home') { e.preventDefault(); elegir(0, { foco: true }); }
        else if (e.key === 'End') { e.preventDefault(); elegir(n - 1, { foco: true }); }
      });
    });

    // Barra 1·2·3: cambia de camino y lleva al principio de su ficha
    botones.forEach((b, i) =>
      b.addEventListener('click', () => {
        elegir(i);
        paneles[i].scrollIntoView({ behavior: sinMovimiento.matches ? 'auto' : 'smooth', block: 'start' });
      })
    );

    // La barra solo aparece cuando los tres caminos del mapa ya han quedado arriba, y se va al llegar al bloque del coach
    const destinos = mapa.querySelector<HTMLElement>('.mp__destinos');
    const bloqueCoach = document.querySelector<HTMLElement>('#coach');
    if (fija && destinos && 'IntersectionObserver' in window) {
      let mapaFuera = false;
      let coachCerca = false;
      const actualizar = () => fija.classList.toggle('is-on', mapaFuera && !coachCerca);
      const altoMenu = menu?.offsetHeight ?? 0;
      new IntersectionObserver(
        ([e]) => {
          mapaFuera = !e.isIntersecting && e.boundingClientRect.top < 0;
          actualizar();
        },
        { rootMargin: `-${altoMenu + 4}px 0px 0px 0px` }
      ).observe(destinos);
      if (bloqueCoach) {
        new IntersectionObserver(
          ([e]) => {
            coachCerca = e.isIntersecting;
            actualizar();
          },
          { rootMargin: `-${altoMenu}px 0px -35% 0px` }
        ).observe(bloqueCoach);
      }
    }
  }
</script>

<style is:global>
  .res { background: var(--negro); color: var(--crema); padding-block: clamp(1.5rem, 1rem + 2vw, 3.5rem) var(--aire, 6rem); min-height: calc(100svh - 125px); }
  .res__caja { display: grid; gap: 1.5rem; max-width: 68.75rem; }
  .res__cab { display: grid; gap: 0.6rem; }
  .res__saludo { font-size: var(--t1); font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--acento-texto); }
  .res__titulo { font-family: var(--titular); font-weight: 800; font-size: clamp(2.25rem, 1.6rem + 3vw, 3.75rem); line-height: 1.02; letter-spacing: -0.025em; }
  .res__tres { display: inline-block; padding: 0 0.22em; border-radius: 0.2em; background: var(--acento); color: var(--acento-txt); }
  .res__toca { margin: 0; font-size: var(--t1); line-height: 1.45; color: var(--gris); }
  .res__lead { max-width: 38rem; font-size: var(--t3, 1.125rem); line-height: 1.55; color: var(--gris); }

  /* El mapa fino: «Tú» y tres ramas de 1 px hacia los tres caminos (como el de la web) */
  .mp { display: grid; justify-items: center; margin-top: 0.5rem; }
  .mp__tu { display: inline-flex; align-items: center; gap: 0.55rem; padding: 0.4rem 1rem 0.4rem 0.5rem; border-radius: 999px; background: var(--crema); color: var(--negro); font-size: var(--t2); }
  .mp__punto { width: 1rem; height: 1rem; border-radius: 50%; background: var(--acento); border: 3px solid var(--negro); }
  .mp__ramas { width: 100%; height: 4.5rem; display: block; overflow: visible; }
  .mp__rama { fill: none; stroke: rgb(246 241 232 / 0.5); stroke-width: 1.25; stroke-linecap: round; vector-effect: non-scaling-stroke; transition: stroke 250ms ease, stroke-width 250ms ease; }
  .mp__rama[data-r='2'] { stroke-dasharray: 2 5; } /* el salto, punteado como en la web */
  .mp[data-sel='0'] .mp__rama[data-r='0'], .mp[data-sel='1'] .mp__rama[data-r='1'], .mp[data-sel='2'] .mp__rama[data-r='2'] { stroke: var(--acento); stroke-width: 1.75; }
  .mp__destinos { width: 100%; display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.5rem; }
  .mp__dest { display: grid; justify-items: center; align-content: start; gap: 0.3rem; padding: 0.7rem 0.3rem 0.9rem; min-height: 44px; border-radius: 1.1rem; border: 1px solid var(--linea); background: transparent; color: var(--crema); font: inherit; cursor: pointer; text-align: center; transition: background-color 200ms ease, border-color 200ms ease; }
  .mp__dest:hover { background: rgb(246 241 232 / 0.04); }
  .mp__dest[aria-selected='true'] { border-color: var(--acento); background: color-mix(in srgb, var(--acento) 6%, transparent); }
  .mp__dest:focus-visible { outline: 3px solid var(--acento); outline-offset: 3px; }
  .mp__foto { position: relative; width: clamp(3.4rem, 2.4rem + 4vw, 5rem); aspect-ratio: 1; margin-bottom: 0.2rem; }
  .mp__foto img { width: 100%; height: 100%; border-radius: 50%; object-fit: cover; border: 1px solid var(--linea); }
  .mp__dest[aria-selected='true'] .mp__foto img { border-color: var(--acento); }
  .mp__n { position: absolute; right: -0.25rem; top: -0.25rem; display: grid; place-items: center; width: 1.6rem; height: 1.6rem; border-radius: 50%; background: var(--negro); border: 1px solid var(--acento); color: var(--crema); font-weight: 700; font-size: 0.875rem; }
  .mp__tipo { font-size: 0.875rem; font-weight: 700; letter-spacing: 0.03em; text-transform: uppercase; color: var(--acento-texto); line-height: 1.15; }
  .mp__nombre { font-family: var(--titular); font-weight: 700; font-size: clamp(0.9375rem, 0.85rem + 0.5vw, 1.2rem); line-height: 1.12; letter-spacing: -0.02em; overflow-wrap: break-word; }

  /* Ficha del camino elegido */
  .mp__panel { scroll-margin-top: calc(var(--menu-h, 4.5rem) + 3.6rem); display: grid; gap: 1.9rem; padding: clamp(1.2rem, 1rem + 1.5vw, 2rem); border-radius: 1.25rem; border: 1px solid var(--linea); }
  .mp__panel[hidden] { display: none; }
  .mp__panel:focus-visible { outline: 3px solid var(--acento); outline-offset: 3px; }
  .mp__cab { display: grid; gap: 0.6rem; }
  .mp__sup { font-size: var(--t1); font-weight: 700; letter-spacing: 0.07em; text-transform: uppercase; color: var(--acento-texto); }
  .mp__def { margin: -0.25rem 0 0; font-size: var(--t2); line-height: 1.4; color: rgb(246 241 232 / 0.78); }
  .mp__h2 { font-family: var(--titular); font-weight: 700; font-size: clamp(1.75rem, 1.4rem + 1.6vw, 2.5rem); line-height: 1.05; letter-spacing: -0.02em; }
  .mp__gancho { font-size: var(--t3, 1.125rem); line-height: 1.45; color: rgb(246 241 232 / 0.88); max-width: 38rem; }
  .mp__chips { list-style: none; margin: 0.25rem 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .mp__chips li { padding: 0.35rem 0.85rem; border-radius: 999px; border: 1px solid var(--linea); font-size: var(--t1); }
  .mp__bloque { display: grid; gap: 0.85rem; }
  .mp__h3 { font-family: var(--titular); font-weight: 700; font-size: 1.1875rem; line-height: 1.15; display: flex; align-items: baseline; flex-wrap: wrap; gap: 0.2rem 0.7rem; }
  .mp__h3 small { font-family: var(--sans); font-weight: 500; font-size: var(--t1); color: var(--gris); }
  .mp__p { font-size: var(--t2); line-height: 1.6; color: rgb(246 241 232 / 0.86); }
