---
// Página de resultados del test · DISEÑO 2 · MAPA: de «Tú» salen 3 ramas (los 3 caminos). Al elegir una se ve
// su ficha y, sobre todo, las distintas vías para llegar comparadas por duración.
// PENDIENTE CLIENTA / DESARROLLO: contenido de ejemplo (src/data/resultados.ts); ver la nota del diseño 1.
import { Image } from 'astro:assets';
import V5 from '../../../layouts/V5.astro';
import CabResultados from '../../../components/CabResultados.astro';
import Acompanamiento from '../../../components/Acompanamiento.astro';
import { caminos } from '../../../data/resultados';

const MAX_MESES = 48; // la barra más larga (4 años) ocupa todo el ancho
const iconos = {
  fp: '<path d="M14.7 6.3a4 4 0 0 0-5.4 5.4L3 18l3 3 6.3-6.3a4 4 0 0 0 5.4-5.4l-2.5 2.5-2.4-.6-.6-2.4z"/>',
  uni: '<path d="M2 9l10-5 10 5-10 5z"/><path d="M6 11v5c3 2 9 2 12 0v-5"/>',
  curso: '<rect x="3" y="5" width="18" height="11" rx="2"/><path d="M2 19h20"/>',
  solo: '<path d="M12 3l2.2 5.8L20 11l-5.8 2.2L12 19l-2.2-5.8L4 11l5.8-2.2z"/>',
};
const ramas = ['M150 0 V10 C150 38 50 34 50 70', 'M150 0 V70', 'M150 0 V10 C150 38 250 34 250 70'];
---

<V5
  titulo="Tus 3 caminos · NextYou"
  descripcion="Tus 3 caminos profesionales en un mapa: elige uno y compara las vías para llegar. Y, si quieres, un coach que te acompañe."
  actual="bachillerato"
  soloBachillerato
  ruta=""
>
  <main id="contenido" class="res">
    <div class="ancho res__caja">
      <CabResultados actual={2} lead="Estos son tus 3 caminos, y cada uno tiene varias formas de llegar. Toca un camino para ver su mapa." />

      <section class="mp" data-mapa data-sel="0" aria-label="Mapa de tus caminos">
        <div class="mp__tu"><span class="mp__punto" aria-hidden="true"></span><b>Tú</b></div>
        <svg class="mp__ramas" viewBox="0 0 300 70" preserveAspectRatio="none" aria-hidden="true">
          {ramas.map((d, i) => <path class="mp__rama" data-r={i} d={d} />)}
        </svg>
        <div class="mp__destinos" role="tablist" aria-label="Tus 3 caminos">
          {
            caminos.map((c, i) => (
              <button type="button" role="tab" class="mp__dest" id={`tab-${c.id}`} aria-controls={`panel-${c.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-i={i}>
                <span class="mp__foto">
                  <Image src={c.foto} alt="" width={140} height={140} loading="lazy" />
                  <span class="mp__n" aria-hidden="true">{i + 1}</span>
                </span>
                <small class="mp__tipo">{c.tipo}</small>
                <b class="mp__nombre">{c.nombre}</b>
              </button>
            ))
          }
        </div>
      </section>

      {
        caminos.map((c, i) => (
          <section class="mp__panel" role="tabpanel" id={`panel-${c.id}`} aria-labelledby={`tab-${c.id}`} hidden={i !== 0} data-placeholder="true" tabindex="0">
            <header class="mp__cab">
              <p class="mp__sup">Camino {i + 1} · {c.tipo}</p>
              <h2 class="mp__h2">{c.nombre}</h2>
              <p class="mp__resumen">{c.resumen}</p>
              <ul class="mp__chips" role="list" aria-label="Se te da bien">
                {c.chips.map((t) => <li>{t}</li>)}
              </ul>
            </header>

            <div class="mp__bloque">
              <h3 class="mp__h3">Así se llega <small>Hay más de una vía</small></h3>
              <ol class="vias" role="list">
                {
                  c.rutas.map((r) => (
                    <li class={`via via--${r.tipo}`} style={r.meses ? `--w: ${Math.round((r.meses / MAX_MESES) * 100)}%` : undefined}>
                      <div class="via__cab">
                        <i aria-hidden="true"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={iconos[r.tipo]} /></i>
                        <span><b>{r.titulo}</b><small>{r.detalle}</small></span>
                      </div>
                      <div class="via__pista" aria-hidden="true">
                        <span class="via__barra"></span>
                        <span class="via__meta">{r.meses ? '' : 'A tu ritmo'}</span>
                      </div>
                    </li>
                  ))
                }
              </ol>
              <p class="mp__leyenda">Cuanto más larga la barra, más tiempo de formación. Las duraciones son aproximadas.</p>
            </div>

            <div class="mp__bloque">
              <h3 class="mp__h3">En qué consiste</h3>
              <dl class="mp__datos">
                <div><dt>Qué haces</dt><dd>{c.que}</dd></div>
                <div><dt>Un día normal</dt><dd>{c.dia}</dd></div>
                <div><dt>Por qué encaja contigo</dt><dd>{c.porque}</dd></div>
              </dl>
              <p class="mp__p">{c.formacion}</p>
            </div>

            <a class="mp__coach" href="#coach">¿Quieres ayuda para decidir? <b>Habla con un coach</b> <span aria-hidden="true">↓</span></a>
          </section>
        ))
      }

      <p class="res__nota">No tienes que elegir ya. Repite el test cuando quieras: si cambias tú, cambian tus caminos.</p>

      <Acompanamiento />
    </div>
  </main>
</V5>

<script>
  // Pestañas: elegir un camino muestra su ficha y resalta su rama del mapa (con flechas del teclado también)
  const mapa = document.querySelector<HTMLElement>('[data-mapa]');
  if (mapa) {
    const tabs = [...mapa.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const paneles = [...document.querySelectorAll<HTMLElement>('.mp__panel')];
    const elegir = (i: number, foco = false) => {
      tabs.forEach((t, k) => {
        t.setAttribute('aria-selected', String(k === i));
        t.tabIndex = k === i ? 0 : -1;
      });
      paneles.forEach((p, k) => (p.hidden = k !== i));
      mapa.dataset.sel = String(i);
      if (foco) tabs[i].focus();
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => elegir(i));
      t.addEventListener('keydown', (e) => {
        const n = tabs.length;
        if (e.key === 'ArrowRight' || e.key === 'ArrowDown') { e.preventDefault(); elegir((i + 1) % n, true); }
        else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') { e.preventDefault(); elegir((i + n - 1) % n, true); }
        else if (e.key === 'Home') { e.preventDefault(); elegir(0, true); }
        else if (e.key === 'End') { e.preventDefault(); elegir(n - 1, true); }
      });
    });
  }
</script>

<style is:global>
  /* El mapa: «Tú» arriba y tres ramas hacia los tres caminos */
  .mp { display: grid; justify-items: center; margin-top: 0.5rem; }
  .mp__tu { display: inline-flex; align-items: center; gap: 0.55rem; padding: 0.4rem 1rem 0.4rem 0.5rem; border-radius: 999px; background: var(--crema); color: var(--negro); font-size: var(--t2); }
  .mp__punto { width: 1.1rem; height: 1.1rem; border-radius: 50%; background: var(--acento); border: 3px solid var(--negro); }
  .mp__ramas { width: 100%; height: 4.5rem; display: block; overflow: visible; }
  .mp__rama { fill: none; stroke: rgb(246 241 232 / 0.35); stroke-width: 2.5; stroke-dasharray: 3 7; stroke-linecap: round; vector-effect: non-scaling-stroke; transition: stroke 250ms ease; }
  .mp[data-sel='0'] .mp__rama[data-r='0'], .mp[data-sel='1'] .mp__rama[data-r='1'], .mp[data-sel='2'] .mp__rama[data-r='2'] { stroke: var(--acento); stroke-dasharray: none; stroke-width: 3.5; }
  .mp__destinos { width: 100%; display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.5rem; }
  .mp__dest { display: grid; justify-items: center; align-content: start; gap: 0.3rem; padding: 0.6rem 0.2rem 0.85rem; min-height: 44px; border-radius: 1.1rem; border: 1px solid var(--linea); background: transparent; color: var(--crema); font: inherit; cursor: pointer; text-align: center; transition: background-color 200ms ease, border-color 200ms ease; }
  .mp__dest:hover { background: rgb(246 241 232 / 0.05); }
  .mp__dest[aria-selected='true'] { background: var(--tarjeta); border-color: var(--acento); }
  .mp__dest:focus-visible { outline: 3px solid var(--acento); outline-offset: 3px; }
  .mp__foto { position: relative; width: clamp(3.4rem, 2.4rem + 4vw, 5rem); aspect-ratio: 1; margin-bottom: 0.2rem; }
  .mp__foto img { width: 100%; height: 100%; border-radius: 50%; object-fit: cover; border: 2px solid var(--linea); }
  .mp__dest[aria-selected='true'] .mp__foto img { border-color: var(--acento); }
  .mp__n { position: absolute; right: -0.2rem; top: -0.2rem; display: grid; place-items: center; width: 1.6rem; height: 1.6rem; border-radius: 50%; background: var(--crema); color: var(--negro); font-weight: 800; font-size: 0.875rem; }
  .mp__tipo { font-size: 0.875rem; font-weight: 700; letter-spacing: 0.03em; text-transform: uppercase; color: var(--acento-texto); line-height: 1.15; }
  .mp__nombre { font-family: var(--titular); font-weight: 800; font-size: clamp(0.875rem, 0.8rem + 0.5vw, 1.2rem); line-height: 1.12; letter-spacing: -0.025em; overflow-wrap: break-word; }

  /* Ficha del camino elegido */
  .mp__panel { display: grid; gap: 1.75rem; padding: clamp(1.2rem, 1rem + 1.5vw, 2rem); border-radius: 1.5rem; background: var(--tarjeta); border: 1px solid var(--linea); }
  .mp__panel[hidden] { display: none; }
  .mp__panel:focus-visible { outline: 3px solid var(--acento); outline-offset: 3px; }
  .mp__cab { display: grid; gap: 0.5rem; }
  .mp__sup { font-size: var(--t1); font-weight: 700; letter-spacing: 0.07em; text-transform: uppercase; color: var(--acento-texto); }
  .mp__h2 { font-family: var(--titular); font-weight: 800; font-size: clamp(1.75rem, 1.4rem + 1.6vw, 2.5rem); line-height: 1.05; letter-spacing: -0.02em; }
  .mp__resumen { font-size: var(--t2); line-height: 1.5; color: var(--gris); }
  .mp__chips { list-style: none; margin: 0.25rem 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .mp__chips li { padding: 0.35rem 0.85rem; border-radius: 999px; border: 1px solid var(--linea); font-size: var(--t1); }
  .mp__bloque { display: grid; gap: 0.9rem; }
  .mp__h3 { font-family: var(--titular); font-weight: 800; font-size: 1.1875rem; line-height: 1.15; display: flex; align-items: baseline; flex-wrap: wrap; gap: 0.2rem 0.7rem; }
  .mp__h3 small { font-family: var(--sans); font-weight: 500; font-size: var(--t1); color: var(--gris); }
  .mp__p { font-size: var(--t2); line-height: 1.6; color: rgb(246 241 232 / 0.86); }
  .mp__leyenda { font-size: var(--t1); color: var(--gris); }
  .mp__datos { display: grid; gap: 0.85rem; margin: 0; }
  .mp__datos dt { font-size: var(--t1); font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase; color: var(--gris); margin-bottom: 0.15rem; }
  .mp__datos dd { margin: 0; font-size: var(--t2); line-height: 1.5; color: rgb(246 241 232 / 0.92); }

  /* Vías para llegar, comparadas por duración */
  .vias { list-style: none; margin: 0; padding: 0; display: grid; gap: 1rem; }
  .via { display: grid; gap: 0.5rem; }
  .via__cab { display: flex; align-items: center; gap: 0.75rem; }
  .via__cab i { flex: none; display: grid; place-items: center; width: 2.2rem; height: 2.2rem; border-radius: 50%; background: rgb(246 241 232 / 0.1); color: var(--crema); }
  .via__cab span { display: grid; gap: 0.1rem; min-width: 0; }
  .via__cab b { font-size: var(--t2); line-height: 1.3; }
  .via__cab small { font-size: var(--t1); color: var(--gris); }
  .via__pista { position: relative; display: flex; align-items: center; height: 1.1rem; margin-left: 2.95rem; border-radius: 999px; background: rgb(246 241 232 / 0.07); }
  .via__barra { height: 100%; width: var(--w, 100%); border-radius: 999px; background: var(--crema); }
  .via--fp .via__barra { background: var(--acento); }
  .via--curso .via__barra { background: rgb(246 241 232 / 0.55); }
  .via--solo .via__pista { background: none; }
  .via--solo .via__barra { height: 0; border-top: 3px dashed rgb(246 241 232 / 0.5); border-radius: 0; background: none; }
  .via__meta { position: absolute; right: 0; padding: 0.1rem 0.6rem; border-radius: 999px; background: var(--tarjeta); font-size: var(--t1); color: var(--crema); }

  .mp__coach { display: flex; flex-wrap: wrap; align-items: center; gap: 0.3rem 0.5rem; min-height: 44px; padding: 0.7rem 1rem; border-radius: 0.9rem; border: 1px dashed rgb(246 241 232 / 0.3); color: var(--crema); text-decoration: none; font-size: var(--t2); }
  .mp__coach b { color: var(--acento-texto); }
  .mp__coach:hover { border-color: var(--acento); }
  .mp__coach:focus-visible { outline: 3px solid var(--acento); outline-offset: 3px; }

  @media (min-width: 48rem) {
    .mp__datos { grid-template-columns: repeat(3, 1fr); gap: 1.25rem; }
    .mp__ramas { height: 5.5rem; }
  }
  @media (prefers-reduced-motion: reduce) { .mp__rama, .mp__dest { transition: none; } }
</style>
