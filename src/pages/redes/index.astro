---
// La versión vigente de las redes sociales es /redes-v2/. Esta ruta solo redirige.
import { BASE } from '../../config';

const destino = `${BASE}redes-v2/`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Redes sociales de NextYou</title>
    <meta name="robots" content="noindex, nofollow" />
    <meta http-equiv="refresh" content={`0; url=${destino}`} />
    <link rel="canonical" href={destino} />
    <link rel="icon" type="image/svg+xml" href={`${BASE}favicon.svg`} />
    <style>
      html { background: #161412; color: #f6f1e8; font-family: system-ui, -apple-system, 'Segoe UI', sans-serif; }
      body { margin: 0; min-height: 100vh; display: grid; place-items: center; padding: 1.5rem; }
      p { margin: 0; font-size: 1.125rem; line-height: 1.5; }
      a { color: #c8f53b; text-underline-offset: 0.25em; }
    </style>
  </head>
  <body>
    <p><a href={destino}>Las redes sociales están aquí</a></p>
  </body>
</html>
