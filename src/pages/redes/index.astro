---
// Prototipo de la marca en redes sociales con el lenguaje de la app de «Cómo funciona»: fondo crema, tarjetas blancas, números en círculo negro,
// lima solo en rellenos y la pantalla del test / de «Tus 3 caminos» como contenido. Fotos y datos DE EJEMPLO: no es ninguna cuenta real.
import { Image } from 'astro:assets';
import V5 from '../../layouts/V5.astro';
import LogoV3 from '../../components/LogoV3.astro';
import GuiaCabecera from '../../components/GuiaCabecera.astro';
import { BASE } from '../../config';
import fotoDev from '../../assets/muestra/prof-dev.jpg';
import fotoFot from '../../assets/muestra/prof-fot.jpg';
import fotoArq from '../../assets/muestra/prof-arq.jpg';
import fotoCoc from '../../assets/muestra/prof-coc.jpg';
import fotoPer from '../../assets/muestra/prof-per.jpg';

const monograma = `${BASE}marca/avatar.svg`;
const destacadas = ['Test', 'Caminos', 'Dentro', 'Familias'];
const opciones = [
  { t: 'Crear algo desde cero', i: '<path d="M4 20l4-1 11-11-3-3L5 16z"/>' },
  { t: 'Resolver un reto', i: '<path d="M9 4h3v3a2 2 0 1 0 0 4v3H9v-2a2 2 0 1 1 0-4z"/>' },
  { t: 'Quedar con gente', i: '<circle cx="9" cy="9" r="3"/><path d="M3 19c0-3 3-5 6-5s6 2 6 5M16 7a3 3 0 0 1 0 6M18 19c0-2-1-3-2-4"/>' },
  { t: 'Descubrir un sitio nuevo', i: '<circle cx="12" cy="12" r="9"/><path d="M15 9l-2 6-4 0 2-6z"/>' },
];
const caminos = [
  { n: 1, tipo: 'Lo que más te pega', nombre: 'Creación de contenido' },
  { n: 2, tipo: 'El puente', nombre: 'Animación 3D' },
  { n: 3, tipo: 'El salto', nombre: 'Ciberseguridad' },
];
const svg = (d: string, s = 18) => `<svg viewBox="0 0 24 24" width="${s}" height="${s}" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">${d}</svg>`;
const lateral = [
  '<path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z"/>',
  '<path d="M4 5h16v11H9l-5 4z"/>',
  '<path d="M21 3L3 10l7 3 3 7z"/><path d="M10 13l11-10"/>',
  '<path d="M6 3h12v18l-6-4-6 4z"/>',
];
---

<V5 titulo="NextYou en redes sociales" descripcion="Prototipo de la marca aplicada a redes sociales." actual="" ruta="" robots="noindex, nofollow">
  <main id="contenido" class="rs">
    <div class="ancho rs__caja">
      <GuiaCabecera actual="redes" titulo="Redes sociales" lead="Cómo se ve NextYou en Instagram, TikTok y LinkedIn con el mismo lenguaje que la app: fondo crema, tarjetas blancas, números en círculo negro y lima solo en los detalles. Datos y fotos de ejemplo." />

      <section class="rs__fila" aria-label="Avatar y perfil de Instagram">
        <figure class="rs__card rs__card--centro">
          <div class="rs__avatar rs__avatar--grande"><span><img src={monograma} alt="Monograma de NextYou" width="200" height="200" /></span></div>
          <figcaption>Foto de perfil · el monograma sobre lima, dentro de la corona de Instagram</figcaption>
        </figure>

        <figure class="rs__card">
          <div class="ig">
            <div class="ig__cab">
              <div class="rs__avatar"><span><img src={monograma} alt="" width="96" height="96" /></span></div>
              <ul class="ig__cifras" role="list"><li><b>24</b>publicaciones</li><li><b>—</b>seguidores</li><li><b>—</b>seguidos</li></ul>
            </div>
            <p class="ig__nombre">NextYou</p>
            <p class="ig__cat">Educación</p>
            <p class="ig__bio">¿No sabes qué estudiar?<br />Test gratis de 8 minutos y 3 caminos para explorar.</p>
            <p class="ig__enlace">nextyou.example/test</p>
            <div class="ig__botones"><span class="ig__seguir">Seguir</span><span>Mensaje</span></div>
            <ul class="ig__dest" role="list">
              {destacadas.map((d) => <li><span class="ig__aro"><i></i></span>{d}</li>)}
            </ul>
          </div>
          <figcaption>Perfil de Instagram · bio, enlace y destacadas</figcaption>
        </figure>
      </section>

      <section class="rs__bloque" aria-label="Feed de Instagram">
        <figure class="rs__card rs__card--ancha">
          <div class="feed">
            <div class="post post--crema"><p class="post__t">¿No sabes <span class="post__marca">qué estudiar</span>?</p><p class="post__s">Está bien. Empieza por probar.</p><LogoV3 clase="post__logo" /></div>
            <div class="post post--foto"><Image src={fotoDev} alt="" width={600} height={600} /><p class="post__tag"><span>Los de dentro</span>«Programo cosas que usa gente de verdad.»</p></div>
            <div class="post post--app">
              <p class="ap__eti">Brújula interior</p>
              <p class="ap__q">Un sábado libre, ¿qué te apetece más?</p>
              <div class="ap__ops">{opciones.slice(0, 2).map((o, i) => <span class={i === 0 ? 'ap__op ap__op--sel' : 'ap__op'}>{o.t}</span>)}</div>
            </div>
            <div class="post post--foto"><Image src={fotoFot} alt="" width={600} height={600} /><p class="post__tag"><span>Un día normal</span>Fotógrafa</p></div>
            <div class="post post--app">
              <p class="ap__q ap__q--g">Tus <em>3</em> caminos</p>
              <ol class="ap__cams" role="list">{caminos.map((c) => <li><i>{c.n}</i>{c.nombre}</li>)}</ol>
            </div>
            <div class="post post--foto"><Image src={fotoArq} alt="" width={600} height={600} /><p class="post__tag"><span>Un día normal</span>Arquitecto</p></div>
            <div class="post post--app">
              <p class="ap__eti">Tu perfil se está formando</p>
              <ul class="ap__barras" role="list"><li><span>Creatividad</span><i style="--w:70%"></i></li><li><span>Autonomía</span><i style="--w:45%" class="n"></i></li><li><span>Ayudar a otros</span><i style="--w:30%" class="n"></i></li></ul>
            </div>
            <div class="post post--foto"><Image src={fotoCoc} alt="" width={600} height={600} /><p class="post__tag"><span>Un día normal</span>Cocinero</p></div>
            <div class="post post--lima"><p class="post__t">No eres<br />el único.</p><LogoV3 clase="post__logo" /></div>
          </div>
          <figcaption>Cuadrícula del feed · las pantallas de la app se alternan con las personas de «Los de dentro»</figcaption>
        </figure>
      </section>

      <section class="rs__fila" aria-label="Carrusel">
        <figure class="rs__card rs__card--ancha">
          <div class="carr">
            <div class="slide slide--lima"><i class="slide__n">1</i><p class="slide__t">3 señales de que aún no sabes qué estudiar (y está bien)</p><LogoV3 clase="slide__logo" /></div>
            <div class="slide"><i class="slide__n">2</i><p class="slide__t">Te gustan muchas cosas.</p><p class="slide__s">Eso no es un problema. Es un punto de partida.</p></div>
            <div class="slide"><i class="slide__n">3</i><p class="slide__t">Te da miedo equivocarte.</p><p class="slide__s">Probar antes de elegir es la forma de reducirlo.</p></div>
            <div class="slide slide--negra"><i class="slide__n">4</i><p class="slide__t">Haz el test y mira tus 3 caminos.</p><span class="post__btn">nextyou.example →</span></div>
          </div>
          <figcaption>Carrusel 4:5 · un número en círculo por diapositiva, una idea cada una, cierre con llamada a la acción</figcaption>
        </figure>
      </section>

      <section class="rs__fila rs__fila--3" aria-label="Stories y reel">
        <figure class="rs__card rs__card--centro">
          <div class="movil">
            <div class="story story--app">
              <div class="ap__top"><span class="ap__x">×</span><span class="ap__prog"><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i></span><b>4/12</b></div>
              <p class="ap__eti">Brújula interior</p>
              <p class="ap__q">Un sábado libre, ¿qué te apetece más?</p>
              <div class="ap__grid">
                {opciones.map((o, i) => (
                  <span class={i === 0 ? 'ap__card ap__card--sel' : 'ap__card'}>
                    <i class={i === 0 ? 'ap__ic ap__ic--sel' : 'ap__ic'} set:html={svg(o.i, 14)} />
                    {i === 0 && <em class="ap__ok">✓</em>}
                    {o.t}
                  </span>
                ))}
              </div>
              <span class="ap__cta">Continuar</span>
            </div>
          </div>
          <figcaption>Story · la pregunta del test, tal cual la app</figcaption>
        </figure>

        <figure class="rs__card rs__card--centro">
          <div class="movil">
            <div class="story story--app">
              <p class="ap__hola">¡Listo, Lucía!</p>
              <p class="ap__q ap__q--g">Tus <em>3</em> caminos</p>
              <p class="ap__sub">Elegidos con tus respuestas</p>
              <div class="ap__arbol">
                <span class="ap__tu"><i></i>Tú</span>
                <ol class="ap__lista" role="list">
                  {caminos.map((c) => (
                    <li class="ap__cam"><i class="ap__n">{c.n}</i><span><small>{c.tipo}</small><b>{c.nombre}</b></span></li>
                  ))}
                </ol>
              </div>
              <span class="ap__pie">Toca un camino para ver cómo llegar</span>
            </div>
          </div>
          <figcaption>Story · «Tus 3 caminos», con la lista que cuelga de «Tú»</figcaption>
        </figure>

        <figure class="rs__card rs__card--centro">
          <div class="movil">
            <div class="story story--reel">
              <Image src={fotoPer} alt="" width={500} height={900} class="story__img" />
              <div class="reel__lat" aria-hidden="true">{lateral.map((d) => <span set:html={svg(d, 26)} />)}</div>
              <div class="reel__noti"><i set:html={svg('<path d="M9 18h6M10 21h4M12 3a6 6 0 0 0-4 10.5c.7.7 1 1.5 1 2.5h6c0-1 .3-1.8 1-2.5A6 6 0 0 0 12 3z"/>', 16)} /><span><small>Patrón detectado</small><b>Te mueve crear cosas nuevas</b></span></div>
              <div class="story__pie"><p class="story__tag">Un día normal</p><p class="story__txt">Periodista, 23 años</p></div>
            </div>
          </div>
          <figcaption>Portada de reel / TikTok · «Un día normal de…» con el aviso de la app</figcaption>
        </figure>
      </section>

      <section class="rs__fila" aria-label="LinkedIn">
        <figure class="rs__card rs__card--ancha">
          <div class="li">
            <div class="li__banner"><LogoV3 clase="li__logo" /><p>Descubre a qué te podrías dedicar.</p></div>
            <div class="li__perfil">
              <div class="li__av"><img src={monograma} alt="" width="120" height="120" /></div>
              <p class="li__nombre">NextYou</p>
              <p class="li__desc">Test vocacional gratis y 3 caminos para explorar. Para jóvenes que no saben qué estudiar y para las familias y centros que les acompañan.</p>
              <p class="li__meta">Educación · España</p>
              <div class="li__botones"><span class="li__seguir">+ Seguir</span><span>Más</span></div>
            </div>
          </div>
          <figcaption>Página de LinkedIn · orientada a familias, orientadores y centros</figcaption>
        </figure>
      </section>

      <footer class="rs__pie"><p>Prototipo con fotos y datos de ejemplo. Nada de lo que aparece es una cuenta real.</p></footer>
    </div>
  </main>
</V5>

<style is:global>
  .menu, .pie, .paletas { display: none !important; }

  /* Avatar con corona de Instagram */
  .rs__avatar { flex: none; display: grid; place-items: center; width: 5rem; aspect-ratio: 1; border-radius: 50%; padding: 3px; background: conic-gradient(from 200deg, #f9a825, #e91e8c, #9c27b0, #f9a825); }
  .rs__avatar > span { display: grid; place-items: center; width: 100%; height: 100%; border-radius: 50%; padding: 3px; background: #fff; }
  .rs__avatar img { width: 100%; height: 100%; border-radius: 50%; display: block; }
  .rs__avatar--grande { width: min(15rem, 70%); }

  /* Perfil de Instagram */
  .ig { display: grid; gap: 0.35rem; max-width: 22rem; margin-inline: auto; width: 100%; background: #fff; border-radius: 1rem; padding: 1.25rem; box-shadow: 0 12px 30px -18px rgb(0 0 0 / 0.4); }
  .ig__cab { display: flex; align-items: center; gap: 1rem; }
  .ig__cifras { list-style: none; margin: 0; padding: 0; display: flex; gap: 0.9rem; font-size: 0.75rem; color: #161412; }
  .ig__cifras li { display: grid; text-align: center; }
  .ig__cifras b { font-size: 1rem; }
  .ig__nombre { margin: 0.4rem 0 0; font-weight: 700; font-size: 0.9375rem; }
  .ig__cat { margin: 0; font-size: 0.8125rem; color: #6b645c; }
  .ig__bio { margin: 0.2rem 0 0; font-size: 0.875rem; line-height: 1.4; }
  .ig__enlace { margin: 0; font-size: 0.875rem; color: #1d4ed8; }
  .ig__botones { display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem; margin-top: 0.6rem; }
  .ig__botones span { padding: 0.45rem; border-radius: 0.5rem; background: #efefef; text-align: center; font-size: 0.8125rem; font-weight: 600; }
  .ig__botones .ig__seguir { background: #161412; color: #f6f1e8; }
  .ig__dest { list-style: none; margin: 0.9rem 0 0; padding: 0; display: flex; gap: 0.9rem; font-size: 0.6875rem; text-align: center; }
  .ig__dest li { display: grid; gap: 0.3rem; justify-items: center; }
  .ig__aro { display: grid; place-items: center; width: 3.4rem; aspect-ratio: 1; border-radius: 50%; border: 1px solid #cfcac1; }
  .ig__aro i { width: 2.7rem; aspect-ratio: 1; border-radius: 50%; background: var(--acento); }

  /* Feed 3×3 */
  .feed { display: grid; grid-template-columns: repeat(3, 1fr); gap: 3px; max-width: 46rem; margin-inline: auto; width: 100%; background: #fff; padding: 3px; }
  .post { position: relative; aspect-ratio: 1; display: grid; align-content: space-between; gap: 0.4rem; padding: clamp(0.5rem, 0.2rem + 1.6vw, 1.4rem); overflow: hidden; font-family: var(--titular); }
  .post--crema { background: #faf8f4; color: #161412; }
  .post--lima { background: #c8f53b; color: #161412; }
  .post--app { background: #faf8f4; color: #161412; align-content: start; font-family: var(--sans); }
  .post__t { margin: 0; font-weight: 800; font-size: clamp(0.8rem, 0.3rem + 2.6vw, 2rem); line-height: 1.04; letter-spacing: -0.02em; }
  .post__marca { background: #c8f53b; border-radius: 0.25em; padding: 0 0.18em; }
  .post__s { margin: 0; font-weight: 500; font-size: clamp(0.6rem, 0.3rem + 1.1vw, 1rem); line-height: 1.25; }
  .post__btn { display: inline-block; padding: 0.35rem 0.8rem; border-radius: 999px; background: #c8f53b; color: #161412; font-family: var(--sans); font-weight: 700; font-size: clamp(0.55rem, 0.2rem + 1.1vw, 1rem); justify-self: start; }
  .post__logo { width: clamp(3rem, 1rem + 8vw, 7rem); height: auto; color: #161412; --logo-you: #161412; }
  .post--foto img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .post--foto::after { content: ''; position: absolute; inset: 0; background: linear-gradient(transparent 45%, rgb(0 0 0 / 0.72)); }
  .post__tag { position: relative; z-index: 1; align-self: end; margin: 0; display: grid; gap: 0.25rem; justify-items: start; color: #fff; font-weight: 700; font-size: clamp(0.55rem, 0.2rem + 1.5vw, 1.1rem); line-height: 1.15; grid-row: 2; }
  .post__tag span { padding: 0.12rem 0.5rem; border-radius: 999px; background: #c8f53b; color: #161412; font-family: var(--sans); font-size: clamp(0.5rem, 0.2rem + 0.9vw, 0.8rem); }

  /* Piezas de la app (mismas que en «Cómo funciona») */
  .ap__eti { margin: 0; font-size: clamp(0.5rem, 0.2rem + 0.95vw, 0.8rem); font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: #6b645c; }
  .ap__q { margin: 0; font-family: var(--titular); font-weight: 800; font-size: clamp(0.7rem, 0.3rem + 1.9vw, 1.5rem); line-height: 1.06; letter-spacing: -0.02em; }
  .ap__q em { font-style: normal; background: #c8f53b; border-radius: 0.2em; padding: 0 0.2em; }
  .ap__ops { display: grid; gap: 0.3rem; }
  .ap__op { padding: clamp(0.25rem, 0.1rem + 0.7vw, 0.6rem); border-radius: 0.5rem; background: #fff; border: 1px solid #e4dfd5; font-size: clamp(0.5rem, 0.2rem + 1vw, 0.85rem); font-weight: 700; }
  .ap__op--sel { border: 1.5px solid #161412; }
  .ap__cams { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.3rem; }
  .ap__cams li { display: flex; align-items: center; gap: 0.35rem; padding: clamp(0.2rem, 0.1rem + 0.6vw, 0.5rem); border-radius: 0.5rem; background: #fff; border: 1px solid #e4dfd5; font-size: clamp(0.5rem, 0.2rem + 1vw, 0.85rem); font-weight: 700; }
  .ap__cams i { flex: none; display: grid; place-items: center; width: 1.1em; height: 1.1em; border-radius: 50%; background: #161412; color: #f6f1e8; font-style: normal; font-size: 0.85em; }
  .ap__barras { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.45rem; }
  .ap__barras li { display: grid; gap: 0.15rem; font-size: clamp(0.5rem, 0.2rem + 1vw, 0.85rem); font-weight: 700; }
  .ap__barras i { display: block; height: 0.35rem; border-radius: 999px; background: linear-gradient(90deg, #c8f53b var(--w), #e8e4dc var(--w)); }
  .ap__barras i.n { background: linear-gradient(90deg, #161412 var(--w), #e8e4dc var(--w)); }

  /* Carrusel */
  .carr { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0.6rem; }
  @media (max-width: 47.99rem) { .carr { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .slide { aspect-ratio: 4 / 5; display: grid; align-content: space-between; gap: 0.5rem; padding: clamp(0.7rem, 0.3rem + 1.4vw, 1.4rem); border-radius: 0.6rem; background: #faf8f4; color: #161412; border: 1px solid #e4dfd5; font-family: var(--titular); }
  .slide--lima { background: #c8f53b; border-color: #c8f53b; }
  .slide--negra { background: #161412; color: #f6f1e8; border-color: #161412; }
  .slide__n { display: grid; place-items: center; width: 1.9rem; height: 1.9rem; border-radius: 50%; background: #161412; color: #f6f1e8; font-style: normal; font-family: var(--sans); font-weight: 700; font-size: 0.9rem; }
  .slide--negra .slide__n { background: #c8f53b; color: #161412; }
  .slide__t { margin: 0; font-weight: 800; font-size: clamp(1rem, 0.5rem + 1.6vw, 1.65rem); line-height: 1.05; letter-spacing: -0.02em; }
  .slide__s { margin: 0; font-family: var(--sans); font-size: 0.875rem; line-height: 1.35; color: #574e46; }
  .slide__logo { width: 5.5rem; height: auto; color: #161412; --logo-you: #161412; }

  /* Móvil con story / reel */
  .movil { width: min(14rem, 100%); aspect-ratio: 9 / 18.5; padding: 0.4rem; border-radius: 1.9rem; background: linear-gradient(145deg, #5b554e, #1a1715 50%, #4d4741); box-shadow: 0 30px 40px -25px rgb(22 20 18 / 0.7); }
  .story { position: relative; width: 100%; height: 100%; display: grid; align-content: space-between; padding: 1.8rem 0.8rem 0.9rem; border-radius: 1.6rem; overflow: hidden; background: #161412; color: #f6f1e8; font-family: var(--titular); }
  .story--app { background: #faf8f4; color: #161412; align-content: start; gap: 0.5rem; font-family: var(--sans); grid-template-rows: auto; }
  .story--app .ap__q { font-size: 1.05rem; }
  .story--app .ap__q--g { font-size: 1.45rem; }
  .story--app .ap__eti { font-size: 0.625rem; }
  .ap__top { display: flex; align-items: center; gap: 0.4rem; font-size: 0.625rem; font-weight: 700; }
  .ap__x { font-size: 0.9rem; color: #6b645c; }
  .ap__prog { flex: 1; display: grid; grid-template-columns: repeat(8, 1fr); gap: 2px; }
  .ap__prog i { height: 3px; border-radius: 2px; background: #e8e4dc; }
  .ap__prog i:nth-child(-n + 3) { background: #161412; }
  .ap__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0.4rem; }
  .ap__card { position: relative; display: grid; gap: 0.5rem; align-content: space-between; min-height: 4.6rem; padding: 0.5rem; border-radius: 0.7rem; background: #fff; border: 1px solid #e4dfd5; font-size: 0.6875rem; font-weight: 700; line-height: 1.15; }
  .ap__card--sel { border: 1.5px solid #161412; }
  .ap__ic { display: grid; place-items: center; width: 1.6rem; height: 1.6rem; border-radius: 0.45rem; background: #efece5; }
  .ap__ic--sel { background: #c8f53b; }
  .ap__ok { position: absolute; top: 0.35rem; right: 0.35rem; display: grid; place-items: center; width: 1.1rem; height: 1.1rem; border-radius: 50%; background: #161412; color: #fff; font-style: normal; font-size: 0.6rem; }
  .ap__cta { margin-top: 0.6rem; padding: 0.6rem; border-radius: 999px; background: #161412; color: #f6f1e8; text-align: center; font-size: 0.75rem; font-weight: 700; }
  .ap__hola { margin: 0; font-size: 0.6875rem; font-weight: 700; color: #6b645c; }
  .ap__sub { margin: 0; font-size: 0.6875rem; color: #6b645c; }
  .ap__arbol { position: relative; display: grid; gap: 0.5rem; margin-top: 0.6rem; }
  .ap__tu { display: inline-flex; align-items: center; gap: 0.35rem; font-size: 0.625rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: #574e46; }
  .ap__tu i { width: 0.8rem; height: 0.8rem; border-radius: 50%; background: #c8f53b; border: 2px solid #161412; }
  .ap__lista { list-style: none; margin: 0; padding: 0 0 0 1.2rem; display: grid; gap: 0.4rem; position: relative; }
