---
// Versión «Qué es NextYou»: la v5 con «¿No sabes qué estudiar?» y la historia de Lucía fusionados en un solo bloque.
// Versión 5: una sola landing. Universidad y familias son bloques de esta página (antes, páginas en la v4).
// Versión 4 de la home (a partir de la v3). Antes, versión 3: identidad de la versión 1 (logo, Archivo, negro cálido y lima, detalles a mano)
// con la estructura de la versión 2 (comentarios de Sara, SEO, demo, vídeos, familias).
// Página independiente, con su propio estilo: no usa global.css ni los componentes de la v1.
// Los textos salen de src/data/home.ts, los mismos que la v1. Personas y fotos DE MUESTRA.
import { Image, Picture, getImage } from 'astro:assets';
import V5 from '../../layouts/V5.astro';
import LogoV3 from '../../components/LogoV3.astro';
import HistoriaLucia from '../../components/HistoriaLucia.astro';
import { SITIO, BASE, ENLACES, CTA_PRINCIPAL } from '../../config';
import { hero, losDeDentro, familias, sara } from '../../data/home';
import { unicoV4 as noEresElUnico, bifurcacion, historiasUni } from '../../data/v4';
import { universidad as uni } from '../../data/universidad';
import { familiasPagina } from '../../data/familias';
const modos = familiasPagina.modos;

const reels = await Promise.all(
  losDeDentro.personas.map(async (p) => ({ ...p, grande: (await getImage({ src: p.foto, width: 900, format: 'webp' })).src }))
);
const heroGrande = (await getImage({ src: hero.foto, width: 900, format: 'webp' })).src;

const UNIVERSIDAD = '#universidad';

// Palabra destacada en cursiva dentro de un titular.
const cursiva = (texto: string, palabra: string) => texto.replace(palabra, `<em>${palabra}</em>`);
---

<V5 titulo={SITIO.titulo} descripcion={SITIO.descripcion} actual="bachillerato" ruta="que-es-nextyou/">
    <main id="contenido">
      <!-- ===================== Hero ===================== -->
      <section class="hero" aria-label="Aisha, 21: hoy estudia diseño UX/UI" data-placeholder="true">
        <Fragment set:html="<!-- PLACEHOLDER: sustituir por persona real -->" />
        <Picture
          src={hero.foto}
          alt={hero.alt}
          formats={['avif', 'webp']}
          widths={[480, 768, 1080, 1440, 2000]}
          sizes="100vw"
          quality={60}
          loading="eager"
          fetchpriority="high"
          class="hero__foto"
        />
        <div class="hero__contenido ancho">
          <button
            type="button"
            class="hero__ver"
            data-visor-abrir
            aria-haspopup="dialog"
            data-nombre={`${hero.nombre}, ${hero.edad}`}
            data-profesion={hero.detalle}
            data-cita={hero.cita}
            data-duracion="2 min"
            data-img={heroGrande}
            data-video={hero.video?.src ?? ''}
          >
            <svg width="12" height="14" viewBox="0 0 12 14" aria-hidden="true"><path d="M1.5 1.2l9 5.8-9 5.8z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" /></svg>
            Ver a {hero.nombre} · 2 min
          </button>
          <div class="hero__abajo">
            <figure class="hero__cita">
              <blockquote><p>«{hero.cita}»</p></blockquote>
              <figcaption>
                <span class="hero__nombre">{hero.nombre}, {hero.edad}</span>
                <span class="hero__detalle">{hero.detalle}</span>
              </figcaption>
            </figure>
          </div>
        </div>
      </section>

      <!-- ===================== ¿No sabes qué estudiar? + ¿Qué es NextYou? (historia de Lucía) =====================
           Un solo bloque: el h1 y el texto de la v2 arriba, la historia de Lucía como demo y un único botón.
           Sustituye al «pase» del test, a la demo de 4 pasos y a «Lo que no va a pasar» (comentarios 9, 12 y 13 de Sara). -->
      <HistoriaLucia />

      <!-- ===================== Bifurcación: universidad y FP ===================== -->
      <aside class="bifurca" aria-label="Para universitarios y FP">
        <a class="bifurca__enlace ancho" href={UNIVERSIDAD}>
          <span>{bifurcacion.texto}</span>
          <strong>{bifurcacion.enlace} <span aria-hidden="true">→</span></strong>
        </a>
      </aside>


      <!-- ===================== No eres el único ===================== -->
      <section class="seccion unico" aria-labelledby="unico-titulo">
        <div class="ancho">
          <header class="cabecera" data-aparece>
            <p class="antetitulo">{noEresElUnico.etiqueta}</p>
            <h2 id="unico-titulo" class="titular titular--unico" set:html={cursiva(noEresElUnico.titulo, noEresElUnico.resaltado)} />
            <p class="cabecera__sub">{noEresElUnico.subtitulo}</p>
          </header>
          <ul data-aparece class="unico__lista" role="list" aria-label="Testimonios" tabindex="0">
            {
              noEresElUnico.personas.map((p) => (
                <li class:list={['tarjeta', { 'tarjeta--uni': p.universidad }]} data-placeholder="true">
                  <Fragment set:html="<!-- PLACEHOLDER: sustituir por persona real -->" />
                  <Image src={p.foto} alt={p.alt} width={480} height={420} quality={70} class="tarjeta__foto" />
                  <div class="tarjeta__texto">
                    <p class="tarjeta__cita">«{p.cita}»</p>
                    <p class="tarjeta__firma">— {p.nombre}, {p.edad}</p>
                    {p.universidad && (
                      <a class="tarjeta__enlace" href={UNIVERSIDAD}>¿También en la uni? Mira esto →</a>
                    )}
                  </div>
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <!-- ===================== Los de dentro ===================== -->
      <section class="seccion dentro" aria-labelledby="dentro-titulo">
        <div class="ancho">
          <header class="cabecera" data-aparece>
            <p class="antetitulo">{losDeDentro.etiqueta}</p>
            <h2 id="dentro-titulo" class="titular titular--dentro rotulador" set:html={cursiva(losDeDentro.titulo, losDeDentro.resaltado)} />
            <p class="cabecera__sub">Sin discursos. Te cuentan cómo entraron, en qué se equivocaron y cómo es un martes cualquiera.</p>
          </header>
          <div class="dentro__nav" data-solo-carrusel>
            <button type="button" class="flecha" data-mover="-1" aria-label="Anterior" disabled>←</button>
            <span class="dentro__cuenta" aria-live="polite"><span data-actual>1</span> / {reels.length}</span>
            <button type="button" class="flecha" data-mover="1" aria-label="Siguiente">→</button>
          </div>
        </div>
        <Fragment set:html="<!-- PENDIENTE: clips de noviembre de Sara (comentario #11) -->" />
        <ul class="reels" data-reels role="list" aria-label="Vídeos de profesionales" tabindex="0">
          {
            reels.map((p, i) => (
              <li class="reel" style={`--i: ${i}`} data-placeholder="true">
                <Fragment set:html="<!-- PLACEHOLDER: sustituir por persona real -->" />
                <Image src={p.foto} alt={p.alt} width={540} height={960} loading={i < 2 ? 'eager' : 'lazy'} quality={70} class="reel__foto" />
                <div class="reel__pie">
                  <!-- La frase gancho, como una pegatina: encima del nombre para no tapar la cara -->
                  <p class="reel__gancho"><span>{p.cita}</span></p>
                  <p class="reel__nombre">{p.nombre}, {p.edad}</p>
                  <p class="reel__camino">{p.camino.join(' → ')}</p>
                  <span class="reel__ver">
                    <svg width="10" height="12" viewBox="0 0 12 14" aria-hidden="true"><path d="M1.5 1.2l9 5.8-9 5.8z" fill="currentColor" /></svg>
                    Ver su día · {p.duracion}
                  </span>
                </div>
                <button
                  type="button"
                  class="reel__abrir"
                  data-visor-abrir
                  aria-haspopup="dialog"
                  aria-label={`Ver el vídeo de ${p.nombre}, ${p.profesion}, ${p.duracion}`}
                  data-nombre={`${p.nombre}, ${p.edad}`}
                  data-profesion={p.profesion}
                  data-cita={p.cita}
                  data-duracion={p.duracion}
                  data-img={p.grande}
                  data-video={p.video ?? ''}
                  data-subtitulos={p.subtitulos ?? ''}
                  data-indice={i}
                  data-camino={p.camino.join('|')}
                  data-estudios={p.estudios}
                  data-trabajo={p.primerTrabajo}
                  data-martes={p.martes}
                >
                  <span class="reel__play" aria-hidden="true">
                    <svg width="18" height="20" viewBox="0 0 12 14"><path d="M1.5 1.2l9 5.8-9 5.8z" fill="currentColor" /></svg>
                  </span>
                </button>
              </li>
            ))
          }
        </ul>
        <div class="ancho">
          <div class="puntos" aria-hidden="true">
            {reels.map((_, i) => <span class:list={{ activo: i === 0 }} />)}
          </div>
        </div>
      </section>

      <!-- ===================== Universidad y FP (antes página propia) ===================== -->
      <section id="universidad" class="seccion uni5" aria-labelledby="uni5-titulo">
        <div class="ancho">
          <header class="uni5__cabecera" data-aparece>
            <p class="antetitulo">{uni.hero.etiqueta}</p>
            <h2 id="uni5-titulo" class="titular">{uni.hero.titulo}</h2>
            <p class="uni5__lead">{uni.hero.lema} {uni.hero.texto}</p>
          </header>
          <ul class="uni5__caminos" role="list" data-aparece>
            {uni.caminos.lista.map((c) => (
              <li>
                <h3>{c.nombre}</h3>
                <p>{c.texto}</p>
              </li>
            ))}
          </ul>
          <ul class="uni5__historias" role="list" aria-label={historiasUni.titulo} data-aparece>
            {historiasUni.personas.map((p) => (
              <li data-placeholder="true">
                <Fragment set:html="<!-- PLACEHOLDER: sustituir por persona real (también falta su foto) -->" />
                <p class="uni5__cita">«{p.cita}»</p>
                <p class="uni5__quien"><strong>{p.nombre}, {p.edad}</strong> · {p.recorrido.join(' → ')}</p>
              </li>
            ))}
          </ul>
          <div class="uni5__accion">
            <a href={CTA_PRINCIPAL.href} class="boton">{uni.hero.boton}</a>
            <span>{uni.hero.meta.join(' · ')}</span>
          </div>
        </div>
      </section>

      <!-- ===================== Familias: los padres son quienes pagan ===================== -->
      <section id="familias" class="familias" aria-labelledby="familias-titulo">
        <div class="estrecho familias__caja" data-aparece>
          <div class="familias__texto">
            <p class="familias__para">Para madres y padres</p>
            <h2 id="familias-titulo">Acompañar no es decidir por ellos</h2>
            <p>Responde vuestro hijo o hija. Vosotros recibís lo que decida compartir y una guía para hablarlo en casa.</p>
          </div>
          <div class="familias__lado">
            <ul class="familias__lista" role="list" aria-label="Cómo funciona para las familias">
              <li><span class="familias__check"><svg width="14" height="14" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8.5l3 3L13 4.5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg></span>Él o ella decide qué se comparte</li>
              <li><span class="familias__check"><svg width="14" height="14" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8.5l3 3L13 4.5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg></span>Sus respuestas una a una, nunca</li>
              <li><span class="familias__check"><svg width="14" height="14" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8.5l3 3L13 4.5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg></span>Si queréis coach, con la familia al principio y al final</li>
            </ul>
            <Fragment set:html="<!-- PENDIENTE CLIENTA: precio. Cuando lo haya: Empieza gratis · si queréis coach, desde X € al mes -->" />
            <p class="familias__futuro">Así funcionará cuando abramos el test. <button type="button" data-abrir-aviso>Si queréis, os avisamos.</button></p>
          </div>
        </div>

        <!-- Dos formas de empezar -->
        <div class="estrecho fam5" data-aparece>
          <div class="fam5__cabecera">
            <h3 class="fam5__titulo">{modos.titulo}</h3>
            <p>En las dos, quien responde es él o ella. Elegid la que os resulte más cómoda.</p>
          </div>
          <ul class="fam5__modos" role="list">
            {modos.opciones.map((o, i) => (
              <li class="fam5__modo">
                <span class="fam5__icono">{i === 0 ? <Fragment set:html={`<svg width="28" height="28" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="6" y="7" width="20" height="13" rx="2" /><path d="M12 25h8M16 20v5" /><circle cx="11" cy="13.5" r="1.4" /><circle cx="21" cy="13.5" r="1.4" /></svg>`} /> : <Fragment set:html={`<svg width="28" height="28" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 15l21-9-7 21-4-9-10-3z" /><path d="M15 18l11-12" /></svg>`} />}</span>
                <h4>{o.nombre}</h4>
                <p>{o.texto}</p>
                <ul class="fam5__datos" role="list">
                  {o.puntos.map((pt) => <li><Fragment set:html={`<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8.5l3 3L13 4.5" /></svg>`} />{pt}</li>)}
                </ul>
                <a href={CTA_PRINCIPAL.href} class="fam5__enlace" data-abrir-aviso>{i === 0 ? 'Empezar juntos' : 'Enviarle el enlace'} <span aria-hidden="true">→</span></a>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <!-- Vídeo en grande. Mientras no haya clip, se ve la foto con un aviso. -->
      <dialog class="visor" aria-labelledby="visor-nombre">
        <div class="visor__caja">
          <button type="button" class="visor__cerrar" aria-label="Cerrar">
            <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M3 3l12 12M15 3L3 15" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
          </button>
          <div class="visor__media">
            <img class="visor__img" alt="" />
            <video class="visor__video" controls playsinline preload="metadata" hidden></video>
            <p class="visor__aviso">Aquí irá el vídeo · <span data-visor="duracion"></span></p>
          </div>
          <div class="visor__texto">
            <p id="visor-nombre" class="visor__nombre" data-visor="nombre"></p>
            <span class="etiqueta-marco" data-visor="profesion"></span>
            <p class="visor__cita">«<span data-visor="cita"></span>»</p>
            <!-- Ficha mientras no haya vídeo (PLACEHOLDER: datos de ejemplo) -->
            <div class="visor__ficha" data-visor="ficha">
              <ol class="visor__camino" data-visor="camino" aria-label="Su camino"></ol>
              <dl class="visor__datos">
                <div><dt>Qué estudió</dt><dd data-visor="estudios"></dd></div>
                <div><dt>Su primer trabajo</dt><dd data-visor="trabajo"></dd></div>
                <div><dt>Cómo es un martes</dt><dd data-visor="martes"></dd></div>
              </dl>
            </div>
            <a href={CTA_PRINCIPAL.href} class="boton visor__cta">¿Te ves aquí? Haz el test</a>
            <div class="visor__nav" data-visor="nav">
              <button type="button" class="flecha" data-visor-mover="-1" aria-label="Profesional anterior">←</button>
              <span class="visor__cuenta" aria-live="polite"><span data-visor="actual"></span> / {reels.length}</span>
              <button type="button" class="flecha" data-visor-mover="1" aria-label="Siguiente profesional">→</button>
            </div>
          </div>
        </div>
      </dialog>

      <!-- ===================== Sara · fondo oscuro (comentario #15). Texto provisional suyo. ===================== -->
      <section class="sara" aria-labelledby="sara-titulo">
        <div class="estrecho sara__rejilla">
          <div class="sara__texto" data-aparece>
            <p class="antetitulo">{sara.etiqueta}</p>
            <h2 id="sara-titulo" class="titular titular--sara">{sara.titulo}</h2>
            <p>{sara.texto}</p>
            <p class="firma">{sara.firma}</p>
            {ENLACES.sara === '#' ? (
              <span class="boton boton--contorno boton--pronto" aria-disabled="true">{sara.boton}<small>pronto</small></span>
            ) : (
              <a href={ENLACES.sara} class="boton boton--contorno">{sara.boton}</a>
            )}
          </div>
          <Fragment set:html="<!-- PENDIENTE: foto de Sara -->" />
          <div class="sara__polaroid" role="img" aria-label="Foto de Sara, pendiente">
            <div class="sara__hueco" aria-hidden="true">
              <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"><path d="M4 8h3l1.5-2h7L17 8h3v11H4z" /><circle cx="12" cy="13" r="3.5" /></svg>
              <span>Aquí irá la foto de Sara</span>
            </div>
            <p class="sara__pie" aria-hidden="true"><strong>Sara</strong> · {sara.cargo}</p>
          </div>
        </div>
      </section>

      <!-- ===================== Cierre: última llamada antes del pie ===================== -->
      <section class="cierre" aria-labelledby="cierre-titulo">
        <div class="estrecho cierre__caja" data-aparece>
          <p class="nota-mano" aria-hidden="true">tu turno ↓</p>
          <h2 id="cierre-titulo" class="titular rotulador">¿Y tú, a qué te <em>podrías dedicar</em>?</h2>
          <a href={CTA_PRINCIPAL.href} class="boton boton--grande">{hero.boton}</a>
          <p class="cierre__meta">8 minutos · gratis · sin crear cuenta</p>
        </div>
      </section>
    </main>

  <Fragment slot="antes-del-pie">
    <!-- Botón siempre a mano en el móvil, entre la portada y el pie -->
    <aside class="fijo" aria-label="Acceso rápido al test" aria-hidden="true" inert>
      <a href={CTA_PRINCIPAL.href} class="boton">{hero.boton}</a>
      <span>8 min · gratis</span>
    </aside>
  </Fragment>
</V5>

<script>
      // Visor de «Los de dentro»: vídeo si lo hay; si no, foto y ficha. Flechas para pasar de profesional.
      const visor = document.querySelector<HTMLDialogElement>('.visor');
      if (visor) {
        const img = visor.querySelector<HTMLImageElement>('.visor__img')!;
        const video = visor.querySelector<HTMLVideoElement>('.visor__video')!;
        const aviso = visor.querySelector<HTMLElement>('.visor__aviso')!;
        const campo = (k: string) => visor.querySelector<HTMLElement>(`[data-visor="${k}"]`)!;
        const tarjetas = [...document.querySelectorAll<HTMLButtonElement>('.reel__abrir[data-indice]')];
        let actual = -1;
        const mostrar = (b: HTMLButtonElement) => {
          const d = b.dataset;
          actual = d.indice ? Number(d.indice) : -1;
          campo('nombre').textContent = d.nombre ?? '';
          campo('profesion').textContent = d.profesion ?? '';
          campo('cita').textContent = d.cita ?? '';
          campo('duracion').textContent = d.duracion ?? '';
          img.src = d.img ?? '';
          const hayVideo = Boolean(d.video);
          video.hidden = !hayVideo;
          img.hidden = hayVideo;
          aviso.hidden = hayVideo;
          // Ficha solo para profesionales y mientras no haya vídeo
          const ficha = !hayVideo && Boolean(d.camino);
          campo('ficha').hidden = !ficha;
          if (ficha) {
            campo('camino').replaceChildren(...d.camino!.split('|').map((paso) => Object.assign(document.createElement('li'), { textContent: paso })));
            campo('estudios').textContent = d.estudios ?? '';
            campo('trabajo').textContent = d.trabajo ?? '';
            campo('martes').textContent = d.martes ?? '';
          }
          campo('nav').hidden = actual < 0;
          campo('actual').textContent = String(actual + 1);
          video.pause();
          video.querySelectorAll('track').forEach((tr) => tr.remove());
          if (hayVideo) {
            video.poster = d.img ?? '';
            video.src = d.video!;
            if (d.subtitulos) {
              const pista = document.createElement('track');
              Object.assign(pista, { kind: 'subtitles', srclang: 'es', label: 'Español', src: d.subtitulos, default: true });
              video.append(pista);
            }
            video.play().catch(() => {});
          } else video.removeAttribute('src');
          visor.querySelector('.visor__caja')!.scrollTop = 0;
        };
        document.querySelectorAll<HTMLButtonElement>('[data-visor-abrir]').forEach((b) =>
          b.addEventListener('click', () => { mostrar(b); visor.showModal(); })
        );
        visor.querySelectorAll<HTMLButtonElement>('[data-visor-mover]').forEach((f) =>
          f.addEventListener('click', () => {
            if (actual < 0) return;
            const n = (actual + Number(f.dataset.visorMover) + tarjetas.length) % tarjetas.length;
            mostrar(tarjetas[n]);
          })
        );
        visor.addEventListener('keydown', (e) => {
          if (actual < 0) return;
          if (e.key === 'ArrowRight') mostrar(tarjetas[(actual + 1) % tarjetas.length]);
          if (e.key === 'ArrowLeft') mostrar(tarjetas[(actual - 1 + tarjetas.length) % tarjetas.length]);
        });
        const cerrar = () => visor.close();
        visor.querySelector('.visor__cerrar')!.addEventListener('click', cerrar);
        visor.addEventListener('click', (e) => { if (e.target === visor) cerrar(); });
        // El botón del test cierra el visor antes de abrir el aviso
        visor.querySelector('.visor__cta')!.addEventListener('click', cerrar);
        visor.addEventListener('close', () => { video.pause(); video.removeAttribute('src'); });
      }

      // Botón fijo en móvil: visible cuando ni la portada ni el pie están en pantalla
      const fijo = document.querySelector<HTMLElement>('.fijo');
      const portada = document.querySelector('.hero');
      const pieWeb = document.querySelector('.pie');
      if (fijo && portada && pieWeb && 'IntersectionObserver' in window) {
        const vistos = new Set<Element>();
        const actualizar = () => {
          const mostrar = vistos.size === 0;
          fijo.classList.toggle('visible', mostrar);
          fijo.toggleAttribute('inert', !mostrar);
          fijo.setAttribute('aria-hidden', String(!mostrar));
        };
        const ob = new IntersectionObserver((es) => {
          es.forEach((e) => (e.isIntersecting ? vistos.add(e.target) : vistos.delete(e.target)));
          actualizar();
        });
        ob.observe(portada);
        const tarjetasDentro = document.querySelector('.dentro');
        if (tarjetasDentro) ob.observe(tarjetasDentro);
        const cierre = document.querySelector('.cierre');
