      /* Velo oscuro uniforme y más denso en el centro, donde va el texto (AA) */
      .v7hero__video::after { content: ''; position: absolute; inset: 0; background: radial-gradient(ellipse 70% 60% at 50% 50%, rgb(22 20 18 / 0.72), rgb(22 20 18 / 0.45) 70%, rgb(22 20 18 / 0.35)), linear-gradient(to bottom, rgb(22 20 18 / 0) 70%, var(--negro)); }
      .v7hero__texto { display: grid; justify-items: center; gap: 1.75rem; padding-block: 4rem; text-align: center; }
      .v7hero__titulo { display: grid; gap: 1.25rem; justify-items: center; }
      .v7hero__lema { max-width: 16ch; font-family: var(--titular); font-weight: 800; font-stretch: 105%; font-size: clamp(2.4rem, 1.2rem + 4.6vw, 5rem); line-height: 1.02; letter-spacing: -0.03em; text-wrap: balance; }
      .v7hero__explora { font-family: var(--mano); font-weight: 400; font-stretch: normal; letter-spacing: 0; color: var(--acento-texto); font-size: 1.08em; }
      .v7hero__sub { max-width: 30rem; font-size: var(--t3); font-weight: 500; line-height: 1.45; color: var(--crema); }

      /* ---------- No eres el único: espacio negro tras el vídeo y doble entre el título y los chicos ---------- */
      .v7unico { padding-top: calc(var(--aire) * 1.4); }
      .v7unico .cabecera { margin-bottom: clamp(5rem, 4rem + 4vw, 9rem); }

      /* ---------- ¿Qué es NextYou?: fondo negro ---------- */
      .v7que { background: var(--negro); color: var(--crema); padding-block: var(--aire); }
      .v7que__rejilla { display: grid; gap: clamp(3rem, 2rem + 4vw, 5rem); align-items: center; }
      .v7que__texto { display: grid; justify-items: start; gap: 1.5rem; max-width: 34rem; }
      .v7que__tit { font-family: var(--titular); font-weight: 800; font-stretch: 105%; font-size: clamp(1.75rem, 1.2rem + 2vw, 2.75rem); line-height: 1.04; letter-spacing: -0.025em; display: flex; flex-wrap: wrap; align-items: center; gap: 0.3em; }
      .v7que .logo--grande { height: 1.3em; width: auto; color: var(--crema); --logo-you: var(--logo-you-pie, var(--acento)); translate: 0 0.04em; }
      .v7que__lema { font-family: var(--titular); font-weight: 800; font-stretch: 105%; font-size: var(--t4); line-height: 1.25; letter-spacing: -0.015em; text-wrap: balance; }
      .v7que__lema em { font-style: normal; background: var(--subrayado-oscuro) no-repeat left bottom / 100% 0.28em; padding-bottom: 0.08em; }
      .v7que__p { font-size: var(--t3); line-height: 1.6; color: var(--gris); max-width: 32rem; }
      .v7que__collage .pol figcaption { color: var(--negro); }
      @media (min-width: 64rem) { .v7que__rejilla { grid-template-columns: 1fr 1fr; gap: 5rem; } }

      /* ---------- Cómo funciona: 3 pasos con móvil continuo ---------- */
      .v7como { background: var(--papel); color: var(--negro); padding-block: var(--aire); }
      .v7como__cab { display: grid; gap: 1rem; max-width: 36rem; margin-bottom: clamp(3rem, 2rem + 4vw, 6rem); }
      .v7como__sub { font-size: var(--t3); line-height: 1.5; color: var(--gris-oscuro); }
      .v7pasos { display: grid; gap: clamp(5rem, 4rem + 4vw, 7rem); }
      .v7paso { display: grid; gap: 2.5rem; }
      .v7paso__texto { display: grid; justify-items: start; gap: 1rem; max-width: 28rem; }
      /* Número discreto: sin caja amarilla */
      .v7paso__n { font-family: var(--titular); font-weight: 800; font-stretch: 105%; font-size: var(--t5); line-height: 1; color: var(--gris-oscuro); padding-bottom: 0.5rem; border-bottom: 2px solid var(--negro); min-width: 3ch; }
      .v7paso h3 { font-family: var(--titular); font-weight: 800; font-stretch: 105%; font-size: var(--t4); line-height: 1.1; letter-spacing: -0.02em; }
      .v7paso__p { font-size: var(--t3); line-height: 1.55; color: var(--gris-oscuro); }
      .v7paso__meta { font-size: var(--t1); font-weight: 600; color: var(--gris-oscuro); padding: 0.3rem 0.75rem; border-radius: 999px; border: 1px solid rgb(22 20 18 / 0.25); }
      .v7paso__movil { display: grid; justify-items: center; }
      .v7demo__fijo { display: none; }

      /* El móvil (mismo marco en móvil y escritorio) */
      .v7tel { position: relative; width: min(100%, 16.5rem); aspect-ratio: 71.6 / 147.6; padding: 0.55rem; border-radius: 46px;
        background: linear-gradient(145deg, #5b554e 0%, #2b2724 18%, #1a1715 50%, #2b2724 82%, #4d4741 100%);
        box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.22), inset 0 0 0 4px #0b0a09, 0 40px 60px -32px rgb(22 20 18 / 0.6); }
      .v7tel::after { content: ''; position: absolute; z-index: 4; top: 1.05rem; left: 50%; width: 4.75rem; height: 1.3rem; translate: -50% 0; border-radius: 999px; background: #000; }
      .v7tel__estado { position: absolute; z-index: 3; top: 1.15rem; left: 1.75rem; right: 1.6rem; display: flex; justify-content: space-between; align-items: center; color: var(--crema); font-size: 0.7rem; font-weight: 700; }
      .v7tel__bat { width: 1.3rem; height: 0.6rem; border-radius: 3px; border: 1.5px solid rgb(246 241 232 / 0.7); background: linear-gradient(90deg, var(--crema) 70%, transparent 70%) content-box; padding: 1px; }
      .v7tel__pant { position: relative; display: grid; height: 100%; border-radius: 38px; background: var(--negro); color: var(--crema); overflow: hidden; }
      .v7pant { grid-area: 1 / 1; display: flex; flex-direction: column; gap: 0.6rem; padding: 2.9rem 0.9rem 1.4rem; font-size: 0.75rem; }
      .v7pant__cab { display: flex; justify-content: space-between; font-size: 0.6rem; font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase; color: var(--gris); }
      .v7pant__barra { height: 4px; border-radius: 4px; background: #3a342e; overflow: hidden; }
      .v7pant__barra span { display: block; height: 100%; background: var(--crema); }
      .v7pant__preg { margin-top: 0.6rem; font-family: var(--titular); font-weight: 800; font-stretch: 105%; font-size: 1.05rem; line-height: 1.15; }
      .v7pant__ops { display: grid; grid-template-columns: 1fr 1fr; gap: 0.4rem; }
      .v7pant__ops span { display: grid; gap: 0.15rem; align-content: start; min-height: 4.4rem; padding: 0.55rem; border-radius: 12px; border: 1px solid #3a342e; color: var(--gris); font-size: 0.62rem; line-height: 1.3; }
      .v7pant__ops b { font-size: 0.75rem; color: var(--crema); }
      .v7pant__ops .sel { border-color: var(--crema); box-shadow: inset 0 0 0 1px var(--crema); }
      .v7pant__sig { align-self: flex-end; margin-top: auto; padding: 0.45rem 0.8rem; border-radius: 999px; background: var(--crema); color: var(--negro); font-weight: 800; font-size: 0.7rem; }
      /* Pantalla 2: los tres recorridos, con líneas finas */
      .v7rec { position: relative; margin-top: 0.75rem; padding-left: 0.8rem; }
      .v7rec__tu { display: grid; place-items: center; width: 1.6rem; height: 1.6rem; margin-left: -0.8rem; border-radius: 50%; background: var(--crema); color: var(--negro); font-size: 0.55rem; font-weight: 800; }
      /* Línea fina que baja desde «Tú» y se bifurca hacia cada recorrido */
      .v7rec__lista { position: relative; display: grid; gap: 0.6rem; margin-left: 0; padding: 0.9rem 0 0 1.1rem; border-left: 1.5px solid rgb(246 241 232 / 0.45); }
      .v7rec__op { position: relative; }
      .v7rec__op::before { content: ''; position: absolute; left: -1.15rem; top: 50%; width: 1.1rem; height: 1.5px; background: rgb(246 241 232 / 0.45); }
      .v7rec__op { display: grid; align-content: center; gap: 0.15rem; padding: 0.7rem 0.75rem; border-radius: 12px; border: 1px solid #3a342e; }
      .v7rec__op span { font-size: 0.55rem; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; color: var(--gris); }
      .v7rec__op b { font-family: var(--titular); font-weight: 800; font-stretch: 105%; font-size: 0.85rem; }
      .v7rec__op--1 { border-color: var(--acento); }
      /* Pantalla 3: videollamada */
      .v7pant__vivo { color: #ff6b5a; letter-spacing: 0.06em; }
      .v7llam { position: relative; flex: 1; min-height: 0; border-radius: 16px; overflow: hidden; background: radial-gradient(80% 60% at 50% 35%, #4a423b, #1d1a17); }
      .v7llam__ella { position: absolute; inset: 0; display: grid; place-items: center; }
      .v7llam__ini { font-family: var(--titular); font-weight: 800; font-size: 4.5rem; color: rgb(246 241 232 / 0.25); }
      .v7llam__nom { position: absolute; left: 0.5rem; top: 0.5rem; padding: 0.2rem 0.5rem; border-radius: 999px; background: rgb(0 0 0 / 0.55); font-size: 0.6rem; font-weight: 700; }
      .v7llam__tu { position: absolute; right: 0.5rem; top: 0.5rem; display: grid; place-items: center; width: 2.6rem; height: 3.4rem; border-radius: 8px; border: 1.5px solid rgb(246 241 232 / 0.7); background: #2b2622; font-size: 0.6rem; font-weight: 800; }
      .v7llam__burbuja { align-self: flex-start; max-width: 92%; margin-top: -1.6rem; position: relative; padding: 0.55rem 0.7rem; border-radius: 12px 12px 12px 3px; background: var(--crema); color: var(--negro); font-weight: 700; font-size: 0.72rem; line-height: 1.3; }
      .v7llam__ctrl { display: flex; justify-content: center; gap: 0.5rem; }
      .v7llam__ctrl i { width: 1.8rem; height: 1.8rem; border-radius: 50%; background: #3a342e; }
      .v7llam__ctrl .rojo { background: #d8452b; }

      /* Escritorio: el móvil se queda fijo a la derecha y cambia de pantalla */
      @media (min-width: 64rem) {
        .v7demo { display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; align-items: start; }
        .v7pasos { gap: 0; }
        .v7paso { min-height: 70vh; align-content: center; }
        .v7paso__movil { display: none; }
        .v7paso__texto { position: relative; padding-left: 1.5rem; transition: opacity 300ms ease; }
        .v7paso:not(.activo) .v7paso__texto { opacity: 0.35; }
        .v7demo__fijo { display: grid; place-items: center; position: sticky; top: max(5.5rem, calc(50vh - 19rem)); }
        .v7tel--fijo { width: 17.5rem; }
        .v7tel--fijo .v7pant { opacity: 0; transform: translateY(14px); transition: opacity 400ms cubic-bezier(0.23, 1, 0.32, 1), transform 400ms cubic-bezier(0.23, 1, 0.32, 1); }
        .v7tel--fijo .v7pant.activa { opacity: 1; transform: none; }
      }
      @media (prefers-reduced-motion: reduce) { .v7tel--fijo .v7pant, .v7paso__texto { transition: none !important; } }

      /* Personas del paso 3: videollamada horizontal. Móvil: carrusel con el dedo */
      .v7gente { margin-top: clamp(5rem, 4rem + 4vw, 8rem); }
      .v7gente__eti { margin-bottom: 1.5rem; font-size: var(--t1); font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase; color: var(--gris-oscuro); }
      .v7gente__lista { display: grid; grid-auto-flow: column; grid-auto-columns: 82%; gap: 1rem; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; margin-inline: calc(-1 * var(--margen)); padding-inline: var(--margen); scroll-padding-inline: var(--margen); }
      .v7gente__lista::-webkit-scrollbar { display: none; }
      .v7gente__item { display: grid; gap: 0.5rem; align-content: start; scroll-snap-align: start; }
      .v7vid { position: relative; display: grid; place-items: center; aspect-ratio: 16 / 10; border-radius: 18px; overflow: hidden; background: radial-gradient(circle at 30% 30%, #3a342e, #1a1715); color: var(--crema); }
      .v7vid[data-k='1'] { background: radial-gradient(circle at 70% 30%, #36312c, #1a1715); }
      .v7vid[data-k='2'] { background: radial-gradient(circle at 50% 80%, #302c33, #1a1715); }
      .v7vid__ini { position: absolute; font-family: var(--titular); font-weight: 800; font-size: 6rem; color: rgb(246 241 232 / 0.12); }
      .v7vid__ic { position: relative; display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border-radius: 50%; background: rgb(246 241 232 / 0.08); }
      .v7vid__ic svg { width: 1.9rem; height: 1.9rem; }
      .v7vid__tag { position: absolute; left: 0.75rem; bottom: 0.75rem; padding: 0.25rem 0.6rem; border-radius: 999px; background: rgb(0 0 0 / 0.55); font-size: 0.7rem; font-weight: 700; }
      .v7gente__nom { margin-top: 0.5rem; font-size: var(--t2); }
      .v7gente__nom strong { font-family: var(--titular); font-weight: 800; font-stretch: 105%; }
      .v7gente__tray { font-size: var(--t1); color: var(--gris-oscuro); }
      .v7gente__ver { justify-self: start; min-height: 44px; padding: 0 1rem; margin-top: 0.25rem; border: 1px solid var(--negro); border-radius: 999px; background: none; color: var(--negro); font: inherit; font-size: var(--t1); font-weight: 700; cursor: pointer; }
      .v7gente__ver:focus-visible { outline: 3px solid var(--negro); outline-offset: 2px; }
      @media (min-width: 48rem) { .v7gente__lista { grid-auto-flow: row; grid-template-columns: repeat(3, 1fr); overflow: visible; margin-inline: 0; padding-inline: 0; gap: 1.5rem; } }

      /* Cierre de la sección: sin caja, solo una línea y el botón */
      .v7como__pie { display: grid; justify-items: center; gap: 2rem; margin-top: clamp(5rem, 4rem + 4vw, 8rem); text-align: center; }
      .v7nopasa { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.5rem 2rem; font-size: var(--t2); color: var(--gris-oscuro); }
      .v7nopasa li::before { content: '✓ '; font-weight: 800; color: var(--negro); }

      /* La uni no es el único camino: sin fondo amarillo */
      .v7uni { background: var(--papel); color: var(--negro); border-top: 1px solid rgb(22 20 18 / 0.1); }
      .v7uni .uni-no__titulo em { box-shadow: none; background: var(--subrayado-claro, var(--subrayado-oscuro)) no-repeat left bottom / 100% 0.28em; padding-bottom: 0.08em; }
      .v7uni .uni-no__rutas li { border-width: 1px; }

      /* Menos amarillo en general: etiquetas en contorno */
      .pastilla { background: none; color: inherit; border: 1px solid currentColor; }

      .v7hero .boton span { margin-left: 0.4em; }
      .v7pant--1 .v7rec { margin-block: auto; }
      .v7que .boton span, .v7como__pie .boton span { margin-left: 0.4em; }

      /* Pantalla 3: el email con consejos y la entrevista */
      .v7mail { display: grid; gap: 0.55rem; margin-block: auto; padding: 0.75rem; border-radius: 14px; background: #f6f1e8; color: var(--negro); }
      .v7mail__de { display: flex; gap: 0.5rem; align-items: center; font-size: 0.62rem; color: var(--gris-oscuro); }
      .v7mail__de b { display: block; font-size: 0.72rem; color: var(--negro); }
      .v7mail__av { display: grid; place-items: center; flex-shrink: 0; width: 1.6rem; height: 1.6rem; border-radius: 50%; background: var(--negro); color: var(--crema); font-weight: 800; font-size: 0.7rem; }
      .v7mail__asunto { font-family: var(--titular); font-weight: 800; font-stretch: 105%; font-size: 0.9rem; line-height: 1.15; }
      .v7mail__lista { display: grid; gap: 0.3rem; padding-left: 1rem; font-size: 0.66rem; line-height: 1.3; }
      .v7mail__video { display: flex; gap: 0.5rem; align-items: center; padding: 0.5rem; border-radius: 10px; background: var(--negro); color: var(--crema); font-size: 0.6rem; }
      .v7mail__video b { display: block; font-size: 0.7rem; }
      .v7mail__play { display: grid; place-items: center; flex-shrink: 0; width: 1.6rem; height: 1.6rem; border-radius: 50%; background: var(--crema); color: var(--negro); font-size: 0.55rem; }

      /* Opción premium: coach */
      .v7premium { display: grid; gap: 2.5rem; align-items: center; margin-top: clamp(5rem, 4rem + 4vw, 8rem); padding-top: clamp(4rem, 3rem + 3vw, 6rem); border-top: 1px solid rgb(22 20 18 / 0.15); }
      .v7premium__texto { display: grid; justify-items: start; gap: 1rem; max-width: 30rem; }
      .v7premium__eti { padding: 0.3rem 0.75rem; border-radius: 999px; border: 1px solid var(--negro); font-size: var(--t1); font-weight: 700; }
      .v7premium h3 { font-family: var(--titular); font-weight: 800; font-stretch: 105%; font-size: var(--t4); line-height: 1.1; letter-spacing: -0.02em; }
      .v7premium p { font-size: var(--t3); line-height: 1.55; color: var(--gris-oscuro); }
      .v7premium__llamada { justify-self: center; rotate: 0deg; }
      .v7premium .llamada__burbuja { background: var(--crema); color: var(--negro); border: 1px solid rgb(22 20 18 / 0.15); }
      @media (min-width: 64rem) { .v7premium { grid-template-columns: 1fr 1fr; gap: 4rem; } }

      /* Pantalla 4: videollamada con el coach */
      .v7llam__silueta { width: 60%; margin-top: 30%; fill: #7a6f64; }

      /* Pantalla 2: de «Tú» salen tres caminos finos hacia tres recorridos en lista */
      .v7cam__intro { margin-top: 0.4rem; font-size: 0.72rem; line-height: 1.3; color: var(--crema); }
      .v7cam { position: relative; display: grid; grid-template-columns: 2.6rem 1fr; grid-template-rows: auto 1fr; margin-block: auto; }
      .v7cam__tu { grid-column: 1; grid-row: 1; display: grid; place-items: center; width: 1.9rem; height: 1.9rem; border-radius: 50%; background: var(--crema); color: var(--negro); font-size: 0.62rem; font-weight: 800; }
      .v7cam__lineas { grid-column: 1; grid-row: 2; width: 100%; height: 100%; overflow: visible; }
      .v7cam__l { fill: none; stroke: rgb(246 241 232 / 0.55); stroke-width: 1.25; vector-effect: non-scaling-stroke; stroke-linecap: round; }
      .v7cam__l--1 { stroke: var(--acento); stroke-width: 1.5; }
      .v7cam__l--3 { stroke-dasharray: 1 5; }
      .v7cam__lista { grid-column: 2; grid-row: 2; display: grid; grid-template-rows: repeat(3, 1fr); gap: 0.5rem; }
      .v7cam__op { display: grid; align-content: center; gap: 0.12rem; padding: 0.55rem 0.65rem; border-radius: 12px; border: 1px solid #3a342e; }
      .v7cam__op--1 { border-color: var(--acento); }
      .v7cam__op--3 { border-style: dashed; }
      .v7cam__op span { font-size: 0.52rem; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; color: var(--gris); }
      .v7cam__op b { font-family: var(--titular); font-weight: 800; font-stretch: 105%; font-size: 0.82rem; line-height: 1.15; }
      .v7cam__op small { font-size: 0.6rem; line-height: 1.3; color: var(--gris); }
      /* Móvil: el texto abajo, sobre un degradado oscuro, para dejar ver la cara y leerse bien */
      @media (max-width: 47.99rem) {
        .v7hero { place-items: end center; }
        .v7hero__texto { padding-block: 0 2.5rem; gap: 1.25rem; }
        .v7hero__video::after { background: linear-gradient(to bottom, rgb(22 20 18 / 0.15) 0%, rgb(22 20 18 / 0.3) 30%, rgb(22 20 18 / 0.86) 55%, var(--negro) 100%); }
      }
      /* Escritorio: el texto también abajo (centrado), sobre un degradado que sube desde el pie */
      @media (min-width: 48rem) {
        .v7hero { place-items: end center; }
        .v7hero__texto { padding-block: 0 clamp(3rem, 2rem + 3vw, 5rem); gap: 1.5rem; }
        .v7hero__video::after { background: linear-gradient(to bottom, rgb(22 20 18 / 0.1) 0%, rgb(22 20 18 / 0.2) 35%, rgb(22 20 18 / 0.78) 62%, var(--negro) 100%); }
      }
      /* Frase más alargada: en escritorio, en una o dos líneas anchas */
      @media (min-width: 48rem) {
        .v7hero__lema { max-width: 26ch; }
        .v7hero__sub { max-width: 40rem; }
        .v7hero__video::after { background: linear-gradient(to bottom, rgb(22 20 18 / 0.1) 0%, rgb(22 20 18 / 0.25) 35%, rgb(22 20 18 / 0.85) 58%, var(--negro) 100%); }
      }
      @media (min-width: 64rem) {
        .v7hero__lema { max-width: none; white-space: nowrap; font-size: min(4.2rem, 4.5vw); }
        .v7hero__sub { max-width: 48rem; }
      }
      /* Degradado más ligero: solo la franja de abajo, donde va el texto */
      .v7hero__video::after { background: linear-gradient(to bottom, rgb(22 20 18 / 0) 0%, rgb(22 20 18 / 0) 45%, rgb(22 20 18 / 0.55) 68%, rgb(22 20 18 / 0.8) 100%); }
      @media (min-width: 48rem) {
        .v7hero__video::after { background: linear-gradient(to bottom, rgb(22 20 18 / 0) 0%, rgb(22 20 18 / 0) 50%, rgb(22 20 18 / 0.55) 72%, rgb(22 20 18 / 0.8) 100%); }
      }
      .v7hero__lema, .v7hero__sub { text-shadow: 0 2px 18px rgb(0 0 0 / 0.35); }
      .v7hero__video::after { background: linear-gradient(to bottom, rgb(22 20 18 / 0) 0%, rgb(22 20 18 / 0) 38%, rgb(22 20 18 / 0.72) 66%, rgb(22 20 18 / 0.9) 100%); }
      @media (min-width: 48rem) {
        .v7hero__video::after { background: linear-gradient(to bottom, rgb(22 20 18 / 0) 0%, rgb(22 20 18 / 0) 42%, rgb(22 20 18 / 0.72) 68%, rgb(22 20 18 / 0.88) 100%); }
      }

      /* Cabecera de «Cómo funciona»: título grande y mapa de pasos con línea fina */
      .v7como__cab { display: grid; gap: clamp(2.5rem, 2rem + 2vw, 3.5rem); max-width: none; }
      .v7como__izq { display: grid; gap: 1rem; }
      .v7como__tit { font-family: var(--titular); font-weight: 800; font-stretch: 105%; font-size: clamp(3rem, 1.5rem + 5.5vw, 6.5rem); line-height: 0.95; letter-spacing: -0.035em; }
      .v7como__sub { max-width: 34rem; font-size: var(--t3); line-height: 1.5; color: var(--gris-oscuro); }
      /* Mapa: «Tú» y cuatro nodos sobre una línea fina (en móvil, en vertical) */
      .v7mapa { position: relative; display: grid; gap: 1.75rem; }
      .v7mapa::before { content: ''; position: absolute; left: 1.4rem; top: 1.4rem; bottom: 1.4rem; width: 1.5px; background: var(--negro); }
      .v7mapa li { position: relative; }
      .v7mapa__nodo { position: relative; z-index: 1; display: grid; place-items: center; flex-shrink: 0; width: 2.8rem; height: 2.8rem; border-radius: 50%; border: 1.5px solid var(--negro); background: var(--papel); color: var(--negro); font-size: var(--t1); font-weight: 800; }
