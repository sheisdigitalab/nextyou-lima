      .movil__home { position: absolute; z-index: 3; bottom: 1rem; left: 50%; width: 6rem; height: 4px; translate: -50% 0; border-radius: 999px; background: rgb(246 241 232 / 0.55); pointer-events: none; }
      /* Botones: volumen a la izquierda y encendido a la derecha */
      .movil__lateral { position: absolute; inset: 0; pointer-events: none; }
      .movil__lateral::before, .movil__lateral::after { content: ''; position: absolute; width: 3px; border-radius: 2px; background: linear-gradient(90deg, #3d3833, #1a1715); }
      .movil__lateral::before { left: -3px; top: 22%; height: 2.4rem; box-shadow: 0 3rem 0 0 #2a2622; }
      .movil__lateral::after { right: -3px; top: 30%; height: 3.8rem; }
      .movil__pantalla { position: relative; display: flex; flex-direction: column; min-height: 0; height: 100%; padding: 3.1rem 0.95rem 2.25rem; gap: 0.5rem; border-radius: 38px;
        background: radial-gradient(120% 55% at 50% 0%, #2b2622 0%, var(--negro) 70%); color: var(--crema); font-size: 0.8125rem; overflow: hidden; }
      /* Reflejo suave sobre el cristal */
