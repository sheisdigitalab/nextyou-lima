      /* Pantalla de móvil */
      /* El móvil: marco metálico con bisel, isla, barra de estado, botones laterales y reflejo. Que se lea como un teléfono, no como una tarjeta */
      /* Proporción de un teléfono real (unos 71,6 × 147,6 mm): alto ≈ 2,06 veces el ancho */
      .movil { position: relative; justify-self: center; display: grid; width: min(100%, 17rem); aspect-ratio: 71.6 / 147.6; padding: 0.55rem; border-radius: 46px;
        background: linear-gradient(145deg, #5b554e 0%, #2b2724 18%, #1a1715 50%, #2b2724 82%, #4d4741 100%);
        box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.22), inset 0 0 0 4px #0b0a09, 0 2px 0 rgb(255 255 255 / 0.04), 0 50px 70px -35px rgb(22 20 18 / 0.75), 0 18px 30px -18px rgb(22 20 18 / 0.5);
        rotate: 2deg; }
      .movil::before { content: ''; position: absolute; z-index: -1; inset: 12% -14% 8%; border-radius: 50%; background: var(--acento); opacity: 0.22; filter: blur(40px); }
      /* Isla */
      .movil::after { content: ''; position: absolute; z-index: 4; top: 1.05rem; left: 50%; width: 5rem; height: 1.35rem; translate: -50% 0; border-radius: 999px; background: #000; box-shadow: inset -0.9rem 0 0 -0.55rem #1c2230; }
