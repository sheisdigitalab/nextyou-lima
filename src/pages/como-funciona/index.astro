        .v7mapa__paso::before { transform-origin: left; }
      }
      .v7como__eti { display: flex; align-items: center; gap: 0.75rem; font-size: var(--t1); font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: var(--gris-oscuro); }
      .v7como__eti span { width: 2.5rem; height: 1px; background: currentColor; }
      .v7como__mail { display: inline-flex; align-items: center; gap: 0.6rem; justify-self: start; font-size: var(--t2); color: var(--gris-oscuro); }
      /* La frase es informativa, no titular: un nivel por debajo (t4) */
