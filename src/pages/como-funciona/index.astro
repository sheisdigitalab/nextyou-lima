      /* Cromo sin foto todavía: inicial grande e icono de la profesión */
      .foto-hueco { position: relative; display: grid; place-items: center; width: 100%; height: 100%; aspect-ratio: 1 / 1; background: radial-gradient(circle at 30% 25%, #3a342e, #1d1a17); color: var(--acento); }
