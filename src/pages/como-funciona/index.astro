      .tt-cams { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.375rem; }
      .tt-cam { display: flex; flex-direction: column; justify-content: space-between; min-height: 3.875rem; padding: 0.5625rem 0.5rem; border-radius: 11px; background: #2a2521; }
      .tt-cam i { font-style: normal; font-size: 0.5625rem; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; color: var(--gris); }
