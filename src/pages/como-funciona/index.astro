      .tcromo__consejo { display: grid; margin: 8px 2px 0; padding: 7px 10px; border-radius: 10px; background: var(--acento); color: var(--acento-txt); font-family: 'Caveat', var(--mano), cursive; font-weight: 700; font-size: 1.2rem; line-height: 1.05; }
      .tcromo__consejo span { font-family: var(--sans); font-size: 0.625rem; font-weight: 800; letter-spacing: 0.14em; line-height: 1.6; text-transform: uppercase; }
      .tcromo__ver { display: flex; align-items: center; justify-content: center; gap: 8px; width: calc(100% - 4px); min-height: 44px; margin: 8px 2px 2px; border: 0; border-radius: 999px; background: var(--negro); color: var(--crema); font: inherit; font-weight: 800; font-size: 0.8125rem; cursor: pointer; }
      .tcromo__ver:focus-visible { outline: 3px solid var(--acento-texto); outline-offset: 2px; }
      .tcromo__play { display: grid; place-items: center; width: 22px; height: 22px; border-radius: 50%; background: var(--acento); color: var(--acento-txt); font-size: 0.5rem; }
      .tambor-pie { display: flex; flex-direction: column; align-items: center; gap: 0.5rem; margin-top: 0.25rem; }
      .tambor-puntos { display: flex; gap: 0.25rem; }
      .tambor-puntos button { display: grid; place-items: center; width: 32px; height: 32px; padding: 0; border: 0; background: none; cursor: pointer; }
      .tambor-puntos button::before { content: ''; width: 8px; height: 8px; border-radius: 8px; background: #a39886; transition: width 250ms ease, background 250ms ease; }
      .tambor-puntos button[aria-current='true']::before { width: 24px; background: var(--negro); }
      .tambor-ayuda { font-size: var(--t1); color: var(--gris-oscuro); }
      .tambor-siguiente { min-height: 44px; padding: 0 1.25rem; border: 0; border-radius: 999px; background: var(--acento); color: var(--acento-txt); font: inherit; font-size: var(--t1); font-weight: 800; cursor: pointer; }
      @media (min-width: 64rem) {
        .cromos { display: block; }
        .tambor-bloque { display: none; }
      }
      /* Escritorio: abanico. Se reparte al llegar; la carta bajo el ratón (o con el foco) sube al frente */
      @media (min-width: 64rem) {
        .cromos { height: 31rem; }
        .cromo { transform-origin: 50% 130%; transition: rotate 600ms cubic-bezier(0.23, 1, 0.32, 1), translate 600ms cubic-bezier(0.23, 1, 0.32, 1), scale 250ms ease; transition-delay: calc(var(--n) * 70ms); }
