      @media (min-width: 64rem) { .v7como__cab { align-items: start; } .v7como__frase { grid-row: 2; } .v7como__mail { grid-column: 1; grid-row: 3; justify-self: start; } .v7mapa { grid-row: 2 / span 2; align-self: center; } }

