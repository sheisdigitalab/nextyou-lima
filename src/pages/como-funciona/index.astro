      .cromo__consejo { display: grid; gap: 0.1rem; margin-block: 0.25rem; padding: 0.5rem 0.625rem; border-radius: 10px; background: var(--acento); color: var(--acento-txt); font-weight: 700; font-size: 0.8125rem; line-height: 1.3; }
      .cromo__consejo span { font-size: 0.625rem; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; }
      .cromo__datos { display: grid; gap: 0.1rem; font-size: 0.75rem; }
      .cromo__datos div { display: flex; gap: 0.5rem; }
      .cromo__datos dt { flex-shrink: 0; width: 3.1rem; color: var(--gris); }
      .cromo__datos dd { font-weight: 700; }
      .cromo__ver { display: inline-flex; align-items: center; justify-content: center; gap: 0.4rem; margin-top: 0.5rem; min-height: 44px; border: 0; border-radius: 999px; background: var(--acento); color: var(--acento-txt); font: inherit; font-weight: 800; font-size: 0.8125rem; cursor: pointer; }
      .cromo__ver:focus-visible { outline: 3px solid var(--crema); outline-offset: 2px; }
      /* Móvil y tableta: tambor 3D. El abanico solo existe en escritorio */
      .cromos { display: none; }
      .tambor-bloque { width: 100%; }
      .tambor-cab { display: flex; justify-content: space-between; align-items: flex-end; gap: 1rem; }
      .tambor-cab p { display: grid; }
      .tambor-cab p span { font-size: 0.625rem; font-weight: 800; letter-spacing: 0.14em; text-transform: uppercase; color: var(--gris-oscuro); }
      .tambor-cab strong { font-family: var(--titular); font-weight: 800; font-stretch: 105%; font-size: var(--t3); }
      .tambor-cnt { font-size: 0.75rem; font-weight: 700; color: var(--gris-oscuro); }
      .tambor { position: relative; height: 24rem; margin-top: 0.375rem; perspective: 900px; touch-action: pan-y; cursor: grab; }
