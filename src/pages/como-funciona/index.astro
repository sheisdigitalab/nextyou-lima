---
// Página solo para comparar «Cómo funciona»: A (la línea) y B (la actual de /v7/).
// B se genera desde la v7 publicada; /v7/ no se toca. Se elige con los botones de arriba o ?op=a / ?op=b.
// Correcciones de la reunión con la clienta (2026-10-08).
// Versión 5: una sola landing. Universidad y familias son bloques de esta página (antes, páginas en la v4).
// Versión 4 de la home (a partir de la v3). Antes, versión 3: identidad de la versión 1 (logo, Archivo, negro cálido y lima, detalles a mano)
// con la estructura de la versión 2 (comentarios de Sara, SEO, demo, vídeos, familias).
// Página independiente, con su propio estilo: no usa global.css ni los componentes de la v1.
// Los textos salen de src/data/home.ts, los mismos que la v1. Personas y fotos DE MUESTRA.
import { Image, Picture, getImage } from 'astro:assets';
import V5 from '../../layouts/V5.astro';
import LogoV3 from '../../components/LogoV3.astro';
import ComoFuncionaLinea from '../../components/ComoFuncionaLinea.astro';
import { SITIO, BASE, ENLACES, CTA_PRINCIPAL } from '../../config';
import caveat from '../../assets/fonts/caveat.woff2?url';
import { hero, losDeDentro, familias, sara, uniNoUnico, queEsV5 } from '../../data/home';
import { queEsV7, comoV7 } from '../../data/v7';
import { unicoV4 as noEresElUnico, queV5 as q, bifurcacion, historiasUni, testDemo } from '../../data/v4';
import { universidad as uni } from '../../data/universidad';
import { familiasPagina } from '../../data/familias';
const modos = familiasPagina.modos;

const reels = await Promise.all(
  losDeDentro.personas.map(async (p) => ({ ...p, grande: (await getImage({ src: p.foto, width: 900, format: 'webp' })).src }))
);
const insider = reels[0];
const heroGrande = (await getImage({ src: hero.foto, width: 900, format: 'webp' })).src;

// Paso 3 de «Cómo funciona»: entrevistas de ejemplo con gente de «Los de dentro»
// Cromos: personas nuevas (no están en «Los de dentro»). Sin foto todavía: inicial + icono, y póster neutro en el visor
const iconosCromo: Record<string, string> = {
  contenido: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" stroke-linecap="round"><rect x="7" y="2.5" width="10" height="19" rx="2.5"/><circle cx="12" cy="11" r="2.6"/><path d="M10.5 18.5h3"/></svg>',
  animacion: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"><path d="M12 2.5l8.5 4.75v9.5L12 21.5l-8.5-4.75v-9.5z"/><path d="M3.5 7.25L12 12l8.5-4.75M12 12v9.5"/></svg>',
  ciber: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" stroke-linecap="round"><path d="M12 2.5l8 3v6c0 5-3.5 8.5-8 10-4.5-1.5-8-5-8-10v-6z"/><rect x="9" y="10.5" width="6" height="5" rx="1"/><path d="M10 10.5V9a2 2 0 0 1 4 0v1.5"/></svg>',
};
const posterCromo = (inicial: string) => `data:image/svg+xml,${encodeURIComponent(`<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 900 600"><rect width="900" height="600" fill="#24201c"/><text x="450" y="370" font-family="Arial,sans-serif" font-size="260" font-weight="700" fill="#c8f53b" text-anchor="middle">${inicial}</text></svg>`)}`;
const cromos = q.pasos[2].cromos!.map((c, n) => ({
  ...c,
  camino: q.pasos[1].ramas![n].tipo,
  i: undefined as number | undefined,
  r: { edad: c.edad, foto: null as null | ImageMetadata, profesion: c.profesion, cita: c.cita, duracion: c.duracion, grande: posterCromo(c.nombre[0]), video: '', subtitulos: '', camino: c.camino, estudios: c.estudios, primerTrabajo: c.primerTrabajo, martes: c.martes },
}));
// Tambor 3D (móvil): 6 posiciones, cada cromo aparece dos veces
const tambor = [0, 1, 2, 3, 4, 5].map((k) => ({ ...cromos[k % 3], k: k % 3, copia: k >= 3 }));
// «La uni no es el único camino»: trayectorias sin foto (no repiten a nadie de la home)
const trayectorias = historiasUni.personas;

// «¿Qué es NextYou?»: collage de profesiones para probar
const collage = [
  { foto: reels[0].foto, eti: '¿Diseño?' },
  { foto: reels[1].foto, eti: '¿Sonido?' },
  { foto: reels[2].foto, eti: '¿Datos?' },
];

// Vídeo de fondo de la portada (public/videos): una versión para móvil y otra para escritorio
const VIDEO = `${BASE}videos/`;

// Iconos de trazo fino del mapa de «Cómo funciona»
const ICONOS_MAPA: Record<string, string> = {
  test: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" stroke-linecap="round"><rect x="6" y="4" width="12" height="16" rx="1.5"/><path d="M9 9h6M9 12h6M9 15h4"/></svg>',
  caminos: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h6M10 12c3 0 4-5 8-5M10 12c3 0 4 5 8 5M10 12h8"/></svg>',
  persona: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"><circle cx="12" cy="9" r="3.2"/><path d="M5.5 19c1.2-3.2 3.7-4.8 6.5-4.8s5.3 1.6 6.5 4.8"/></svg>',
  coach: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" stroke-linecap="round"><path d="M5 6h14v9H10l-4 3.5V15H5z"/><path d="M9 10.5h6"/></svg>',
};

// Paso 2: icono de cada destino del mapa (mismo orden que las ramas)
const iconosRamas = [
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" stroke-linecap="round"><rect x="3" y="8" width="18" height="12" rx="2"/><path d="M3 8l2.5-4h15L18 8M8 4l-2.5 4M13 4l-2.5 4M18 4l-2.5 4"/></svg>',
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" stroke-linecap="round"><rect x="3" y="4" width="18" height="13" rx="2"/><path d="M12 9l4 7-2-.5-1 2.5z"/></svg>',
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" stroke-linecap="round"><path d="M4 15v-3a8 8 0 0 1 16 0v3"/><rect x="3" y="14" width="4" height="6" rx="1.5"/><rect x="17" y="14" width="4" height="6" rx="1.5"/></svg>',
];

// Demo de «¿Qué es NextYou?»: pastillas de tiempo propias de la v3 y la v4 (las de home.ts las usan la v1 y la v2)
const tiempos = ['8 min · 12 preguntas', 'al momento', 'según tus resultados'];
const UNIVERSIDAD = '#universidad';

// Palabra destacada en cursiva dentro de un titular.
const cursiva = (texto: string, palabra: string) => texto.replace(palabra, `<em>${palabra}</em>`);
---

<V5 titulo={SITIO.titulo} descripcion={SITIO.descripcion} actual="bachillerato" soloBachillerato ruta="">
    <main id="contenido">
      <!-- Barra para cambiar de versión (fija arriba) -->
      <div class="comparar" role="group" aria-label="Versión de «Cómo funciona»">
        <span class="comparar__eti">Comparar «Cómo funciona»:</span>
        <button type="button" data-op="a" aria-pressed="true">A · La línea</button>
        <button type="button" data-op="b" aria-pressed="false">B · La actual</button>
        <span class="comparar__sep" aria-hidden="true"></span>
        <button type="button" class="comparar__pal" data-elegir="d" aria-pressed="false" aria-label="Paleta Lima"><i><b style="background:#161412"></b><b style="background:#c8f53b"></b></i></button>
        <button type="button" class="comparar__pal" data-elegir="a" aria-pressed="false" aria-label="Paleta Azul y lima"><i><b style="background:#161412"></b><b style="background:#3b5bff"></b><b style="background:#c8f53b"></b></i></button>
        <button type="button" class="comparar__pal" data-elegir="f" aria-pressed="false" aria-label="Paleta Original (Figma)"><i><b style="background:#1a1512"></b><b style="background:#c93b22"></b><b style="background:#f6f1e8"></b></i></button>
      </div>
      <div class="op op--a" data-version="a">
        <ComoFuncionaLinea />
      </div>
      <div class="op op--b" data-version="b" hidden>
      <section id="como-funciona-b" class="v7como" aria-labelledby="como-titulo">
        <div class="ancho">
          <!-- Cabecera: etiqueta fina, la frase como titular y el mapa de pasos (animado) -->
          <header class="v7como__cab" data-aparece>
            <p class="v7como__eti"><span aria-hidden="true"></span>{comoV7.titulo}</p>
            <h2 id="como-titulo" class="v7como__frase" set:html={cursiva(comoV7.frase, comoV7.resaltado)} />
            <ol class="v7mapa" aria-label="Los cuatro pasos" data-mapa>
              <li class="v7mapa__tu" aria-hidden="true" style="--i: 0"><span class="v7mapa__nodo">Tú</span></li>
              {comoV7.indice.map((p, i) => (
                <li class="v7mapa__paso" style={`--i: ${i + 1}`}>
                  <a href={`#paso-${i + 1}`}>
                    <span class="v7mapa__nodo" aria-hidden="true" set:html={ICONOS_MAPA[p.ic]} />
                    <span class="v7mapa__t">{p.t}</span>
                    <span class="v7mapa__d">{p.d}</span>
                  </a>
                </li>
              ))}
            </ol>
            <p class="v7como__mail"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="M3.5 6.5l8.5 6.5 8.5-6.5" /></svg>{comoV7.email}</p>
          </header>
          <div class="v7demo">
            <ol class="v7pasos" role="list" aria-label="Cómo funciona, en cuatro pasos">
            <li class="v7paso" id="paso-1" data-paso={0}>
              <div class="v7paso__texto" data-aparece>
                <span class="v7paso__n" aria-hidden="true">01</span>
                <h3>{comoV7.pasos[0].titulo}</h3>
                <p class="v7paso__p">{comoV7.pasos[0].texto}</p>
                <span class="v7paso__meta">{comoV7.pasos[0].meta}</span>
              </div>
              <!-- En móvil, cada paso enseña su pantalla; en escritorio se usa el móvil fijo de la derecha -->
              <div class="v7paso__movil"><div class="v7tel v7tel--paso" aria-hidden="true"><span class="v7tel__estado" aria-hidden="true"><span>9:41</span><span class="v7tel__bat"></span></span><div class="v7tel__pant">
                  <div class="v7pant v7pant--0" data-pant="0">
                    <p class="v7pant__cab"><span>Brújula interior</span><span>3 de 12</span></p>
                    <span class="v7pant__barra"><span style="width:25%"></span></span>
                    <p class="v7pant__preg">¿Cómo describirías tu energía natural?</p>
                    <div class="v7pant__ops">
                      <span class="sel"><b>Creador/a</b>Imaginas y construyes cosas nuevas</span>
                      <span><b>Estratega</b>Planificas y resuelves problemas</span>
                      <span><b>Conector/a</b>Unes personas e ideas</span>
                      <span><b>Explorador/a</b>Buscas lo desconocido</span>
                    </div>
                    <span class="v7pant__sig">Siguiente →</span>
                  </div>
                </div></div></div>
            </li>
            <li class="v7paso" id="paso-2" data-paso={1}>
              <div class="v7paso__texto" data-aparece>
                <span class="v7paso__n" aria-hidden="true">02</span>
                <h3>{comoV7.pasos[1].titulo}</h3>
                <p class="v7paso__p">{comoV7.pasos[1].texto}</p>
                <span class="v7paso__meta">{comoV7.pasos[1].meta}</span>
              </div>
              <!-- En móvil, cada paso enseña su pantalla; en escritorio se usa el móvil fijo de la derecha -->
              <div class="v7paso__movil"><div class="v7tel v7tel--paso" aria-hidden="true"><span class="v7tel__estado" aria-hidden="true"><span>9:41</span><span class="v7tel__bat"></span></span><div class="v7tel__pant">
                  <div class="v7pant v7pant--1" data-pant="1">
                    <p class="v7pant__cab"><span>Tus recorridos</span><span>3</span></p>
                    <!-- De «Tú» salen tres caminos finos, uno hacia cada recorrido (el del salto, punteado) -->
                    <p class="v7cam__intro">Según tus respuestas, estos son tus caminos:</p>
                    <div class="v7cam">
                      <span class="v7cam__tu">Tú</span>
                      <svg class="v7cam__lineas" viewBox="0 0 100 300" preserveAspectRatio="none" aria-hidden="true">
                        <path class="v7cam__l v7cam__l--1" d="M36 0 C36 30 50 50 100 50" />
                        <path class="v7cam__l v7cam__l--2" d="M36 0 C36 90 50 150 100 150" />
                        <path class="v7cam__l v7cam__l--3" d="M36 0 C36 150 50 250 100 250" />
                      </svg>
                      <ol class="v7cam__lista">
                        {q.pasos[1].ramas!.map((r, i) => (
                          <li class:list={['v7cam__op', `v7cam__op--${i + 1}`]}><span>{r.tipo}</span><b>{r.ejemplo}</b><small>{r.nota}</small></li>
                        ))}
                      </ol>
                    </div>
                  </div>
                  <!-- Paso 3: un vídeo de «Los de dentro» dentro del móvil (PLACEHOLDER: persona de muestra) -->
                  <div class="v7pant v7pant--2 v7reel" data-pant="2" data-reel>
                    {reels.map((r, n) => (
                      <div class:list={['v7reel__diapo', { activa: n === 0 }]} data-reel-diapo={n}>
                        <Image src={r.foto} alt="" width={540} height={960} quality={65} class="v7reel__foto" loading="lazy" />
                        <div class="v7reel__pie">
                          <p class="v7reel__gancho"><span>«{r.cita}»</span></p>
                          <p class="v7reel__nom">{r.nombre}, {r.edad}</p>
                          <p class="v7reel__camino">{r.camino.join(' → ')}</p>
                          <span class="v7reel__ver">▶ Ver su día · {r.duracion}</span>
                        </div>
                      </div>
                    ))}
                    <div class="v7reel__barras" aria-hidden="true">{reels.map((_, n) => <i data-reel-barra={n}><b></b></i>)}</div>
                    <p class="v7reel__eti">Los de dentro</p>
                  </div>
                </div></div></div>
            </li>
            <li class="v7paso" id="paso-3" data-paso={2}>
              <div class="v7paso__texto" data-aparece>
                <span class="v7paso__n" aria-hidden="true">03</span>
