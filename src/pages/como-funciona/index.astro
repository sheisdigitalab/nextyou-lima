      /* Paso 3: una sesión con el coach, como una videollamada */
      .llamada { display: grid; gap: 0.75rem; width: min(100%, 25rem); padding: 0.75rem; border-radius: 26px; background: color-mix(in srgb, var(--papel) 35%, #ffffff); border: 1px solid rgb(22 20 18 / 0.1); box-shadow: 0 40px 60px -35px rgb(22 20 18 / 0.45); rotate: -1.5deg; }
