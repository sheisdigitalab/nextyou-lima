      .tt-cam b + b { width: 55%; margin-top: 4px; }
      .tt-candado { display: table; margin: 0.5625rem auto 0; padding: 0.375rem 0.6875rem; border-radius: 999px; background: var(--crema); color: var(--negro); font-size: 0.75rem; font-weight: 800; white-space: nowrap; box-shadow: 0 8px 20px -8px rgb(0 0 0 / 0.6); }
