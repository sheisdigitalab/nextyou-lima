      /* Resultado */
      .tt-res__mini { font-size: 0.6875rem; font-weight: 800; letter-spacing: 0.14em; text-transform: uppercase; color: var(--acento-texto); }
      .tt-res__tit { margin-top: 0.375rem; font-family: var(--titular); font-weight: 800; font-stretch: 105%; font-size: 1.875rem; line-height: 1.02; outline: none; }
      .tt-res__frase { margin-top: 0.375rem; font-family: 'Caveat', var(--mano), cursive; font-weight: 700; font-size: 1.5rem; line-height: 1.05; color: var(--acento-texto); }
