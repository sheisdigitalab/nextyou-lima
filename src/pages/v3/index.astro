      // Carrusel de «Los de dentro»: flechas, contador y puntos sobre un scroll nativo.
      const pista = document.querySelector<HTMLElement>('.reels');
      const botones = document.querySelectorAll<HTMLButtonElement>('[data-mover]');
      const actual = document.querySelector('[data-actual]');
      const puntos = document.querySelectorAll('.puntos span');
      if (pista) {
        const items = [...pista.children] as HTMLElement[];
        const paso = () => items[1].offsetLeft - items[0].offsetLeft;
        const indice = () => Math.round(pista.scrollLeft / paso());
        const pintar = () => {
          const i = Math.min(indice(), items.length - 1);
          if (actual) actual.textContent = String(i + 1);
          puntos.forEach((p, n) => p.classList.toggle('activo', n === i));
          const fin = pista.scrollLeft + pista.clientWidth >= pista.scrollWidth - 4;
