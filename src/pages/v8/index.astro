---
// Portada de la web: correcciones de la reunión con la clienta (2026-10-08).
// Versión 5: una sola landing. Universidad y familias son bloques de esta página (antes, páginas en la v4).
// Versión 4 de la home (a partir de la v3). Antes, versión 3: identidad de la versión 1 (logo, Archivo, negro cálido y lima, detalles a mano)
// con la estructura de la versión 2 (comentarios de Sara, SEO, demo, vídeos, familias).
// Página independiente, con su propio estilo: no usa global.css ni los componentes de la v1.
// Los textos salen de src/data/home.ts, los mismos que la v1. Personas y fotos DE MUESTRA.
import { Image, Picture, getImage } from 'astro:assets';
import V5 from '../../layouts/V5.astro';
import LogoV3 from '../../components/LogoV3.astro';
import { SITIO, BASE, ENLACES, CTA_PRINCIPAL } from '../../config';
import caveat from '../../assets/fonts/caveat.woff2?url';
import { hero, losDeDentro, familias, sara, uniNoUnico, queEsV5 } from '../../data/home';
import { queEsV7, comoV7, pasosV7, unicoV7Cambios, hugoV7 } from '../../data/v7';
import { unicoV4 as noEresElUnico, queV5 as q, bifurcacion, historiasUni, testDemo } from '../../data/v4';
import { universidad as uni } from '../../data/universidad';
import { familiasPagina } from '../../data/familias';
const modos = familiasPagina.modos;

const reels = await Promise.all(
  losDeDentro.personas.map(async (p) => ({ ...p, grande: (await getImage({ src: p.foto, width: 900, format: 'webp' })).src }))
);
const insider = reels[0];
const heroGrande = (await getImage({ src: hero.foto, width: 900, format: 'webp' })).src;

// Paso 3 de «Cómo funciona»: entrevistas de ejemplo con gente de «Los de dentro»
// Cromos: personas nuevas (no están en «Los de dentro»). Sin foto todavía: inicial + icono, y póster neutro en el visor
const iconosCromo: Record<string, string> = {
  contenido: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" stroke-linecap="round"><rect x="7" y="2.5" width="10" height="19" rx="2.5"/><circle cx="12" cy="11" r="2.6"/><path d="M10.5 18.5h3"/></svg>',
  animacion: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"><path d="M12 2.5l8.5 4.75v9.5L12 21.5l-8.5-4.75v-9.5z"/><path d="M3.5 7.25L12 12l8.5-4.75M12 12v9.5"/></svg>',
  ciber: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" stroke-linecap="round"><path d="M12 2.5l8 3v6c0 5-3.5 8.5-8 10-4.5-1.5-8-5-8-10v-6z"/><rect x="9" y="10.5" width="6" height="5" rx="1"/><path d="M10 10.5V9a2 2 0 0 1 4 0v1.5"/></svg>',
};
const posterCromo = (inicial: string) => `data:image/svg+xml,${encodeURIComponent(`<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 900 600"><rect width="900" height="600" fill="#24201c"/><text x="450" y="370" font-family="Arial,sans-serif" font-size="260" font-weight="700" fill="#c8f53b" text-anchor="middle">${inicial}</text></svg>`)}`;
// Caras de MUESTRA (banco de imágenes, Unsplash) para Noa, Leo, Aitana y la coach. No son las personas reales: sustituir antes de publicar
import fotoNoa from '../../assets/muestra/noa.jpg';
import fotoLeo from '../../assets/muestra/leo.jpg';
import fotoAitana from '../../assets/muestra/aitana.jpg';
import fotoCoach from '../../assets/muestra/coach.jpg';
import fotoLeoV from '../../assets/muestra/leo-v.jpg';
import fotoCoachV from '../../assets/muestra/coach-v.jpg';
const caraCromo: Record<string, ImageMetadata> = { Noa: fotoNoa, Leo: fotoLeo, Aitana: fotoAitana };
const grandesCromo: Record<string, string> = Object.fromEntries(
  await Promise.all(Object.entries(caraCromo).map(async ([k, v]) => [k, (await getImage({ src: v, width: 900, format: 'webp' })).src]))
);
const cromos = q.pasos[2].cromos!.map((c, n) => ({
  ...c,
  camino: q.pasos[1].ramas![n].tipo,
  img: caraCromo[c.nombre],
  i: undefined as number | undefined,
  r: { edad: c.edad, foto: caraCromo[c.nombre] as ImageMetadata | null, profesion: c.profesion, cita: c.cita, duracion: c.duracion, grande: grandesCromo[c.nombre] ?? posterCromo(c.nombre[0]), video: '', subtitulos: '', camino: c.camino, estudios: c.estudios, primerTrabajo: c.primerTrabajo, martes: c.martes },
}));
// Tambor 3D (móvil): 6 posiciones, cada cromo aparece dos veces
const tambor = [0, 1, 2, 3, 4, 5].map((k) => ({ ...cromos[k % 3], k: k % 3, copia: k >= 3 }));
// «La uni no es el único camino»: trayectorias con foto de muestra (banco de imágenes libre; no repiten a nadie de la home)
import fotoClaudia from '../../assets/muestra/uni-claudia.jpg';
import fotoRuben from '../../assets/muestra/uni-ruben.jpg';
import fotoHugo from '../../assets/muestra/uni-hugo.jpg';
// Sara: foto de MUESTRA de banco de imágenes (Unsplash). No es Sara: sustituir por su foto real antes de publicar
import fotoSara from '../../assets/muestra/sara.jpg';
const fotosUni: Record<string, ImageMetadata> = { Claudia: fotoClaudia, 'Rubén': fotoRuben, Hugo: fotoHugo };
const trayectorias = [hugoV7, ...historiasUni.personas].map((r) => ({ ...r, foto: fotosUni[r.nombre] }));

// «¿Qué es NextYou?»: collage de profesiones para probar
const collage = [
  { foto: reels[0].foto, eti: '¿Diseño?' },
  { foto: reels[1].foto, eti: '¿Sonido?' },
  { foto: reels[2].foto, eti: '¿Datos?' },
];

// Vídeo de fondo de la portada (public/videos): una versión para móvil y otra para escritorio
const VIDEO = `${BASE}videos/`;
const CFA = `${BASE}cfa/`;

// Iconos de trazo fino del mapa de «Cómo funciona»
const ICONOS_MAPA: Record<string, string> = {
  test: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" stroke-linecap="round"><rect x="6" y="4" width="12" height="16" rx="1.5"/><path d="M9 9h6M9 12h6M9 15h4"/></svg>',
  caminos: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h6M10 12c3 0 4-5 8-5M10 12c3 0 4 5 8 5M10 12h8"/></svg>',
  persona: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"><circle cx="12" cy="9" r="3.2"/><path d="M5.5 19c1.2-3.2 3.7-4.8 6.5-4.8s5.3 1.6 6.5 4.8"/></svg>',
  coach: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" stroke-linecap="round"><path d="M5 6h14v9H10l-4 3.5V15H5z"/><path d="M9 10.5h6"/></svg>',
};

// Paso 2: icono de cada destino del mapa (mismo orden que las ramas)
const iconosRamas = [
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" stroke-linecap="round"><rect x="3" y="8" width="18" height="12" rx="2"/><path d="M3 8l2.5-4h15L18 8M8 4l-2.5 4M13 4l-2.5 4M18 4l-2.5 4"/></svg>',
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" stroke-linecap="round"><rect x="3" y="4" width="18" height="13" rx="2"/><path d="M12 9l4 7-2-.5-1 2.5z"/></svg>',
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" stroke-linecap="round"><path d="M4 15v-3a8 8 0 0 1 16 0v3"/><rect x="3" y="14" width="4" height="6" rx="1.5"/><rect x="17" y="14" width="4" height="6" rx="1.5"/></svg>',
];

// Demo de «¿Qué es NextYou?»: pastillas de tiempo propias de la v3 y la v4 (las de home.ts las usan la v1 y la v2)
const tiempos = ['8 min · 12 preguntas', 'al momento', 'según tus resultados'];
const UNIVERSIDAD = '#universidad';

// Palabra destacada en cursiva dentro de un titular.
const cursiva = (texto: string, palabra: string) => texto.replace(palabra, `<em>${palabra}</em>`);
---

<V5 titulo={SITIO.titulo} descripcion={SITIO.descripcion} actual="bachillerato" soloBachillerato ruta="">
    <main id="contenido">
      <!-- ===================== Portada =====================
           Nada más entrar se entiende qué es: título (h1), una frase y el botón del test.
           De fondo, el vídeo (decorativo). -->
      <section class="v7hero" aria-labelledby="hero-titulo" data-placeholder="true">
        <!-- v7: vídeo a pantalla completa (como en la v5) y el texto centrado, con «se explora» a rotulador:
             distinto del titular gigante abajo a la izquierda de Roadtrip Nation. Sin botón de pausa -->
        <div class="v7hero__video" aria-hidden="true">
          <picture>
            <source media="(max-width: 47.99rem)" srcset={`${VIDEO}hero-movil-poster.jpg`} />
            <img class="v7hero__poster" src={`${VIDEO}hero-escritorio-poster.jpg`} alt="" width="1280" height="720" fetchpriority="high" />
          </picture>
          <video class="v7hero__vid" data-hero-video autoplay muted loop playsinline preload="metadata" disablepictureinpicture tabindex="-1">
            <source src={`${VIDEO}hero-movil.mp4`} type="video/mp4" media="(max-width: 47.99rem)" />
            <source src={`${VIDEO}hero-escritorio.mp4`} type="video/mp4" />
          </video>
          <script is:inline>
            // Con «reducir movimiento» no se reproduce: se queda el póster
            (function () {
              var v = document.currentScript.previousElementSibling;
              if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) { v.removeAttribute('autoplay'); v.preload = 'none'; v.pause(); }
            })();
          </script>
        </div>
        <div class="v7hero__texto ancho">
          <h1 id="hero-titulo" class="v7hero__titulo">
            <span class="v7hero__lema">Tu futuro no se adivina, <span class="v7hero__explora">se explora</span>.</span>
          </h1>
        </div>
      </section>

      <!-- Universidad y familias: aparcadas para más adelante (fase 1 solo bachillerato). Siguen en /v4/. -->

      <!-- ===================== No eres el único ===================== -->
      <section class="seccion unico v7unico" aria-labelledby="unico-titulo">
        <div class="ancho">
          <header class="cabecera cabecera--centro" data-aparece>
            <p class="antetitulo">{noEresElUnico.etiqueta}</p>
            <h2 id="unico-titulo" class="titular titular--unico" set:html={cursiva(noEresElUnico.titulo, noEresElUnico.resaltado)} />
          </header>
        </div>
        <!-- Slider horizontal a todo el ancho: se desliza hasta la última tarjeta (flechas, ratón, dedo o trackpad) -->
        <div class="unico__carril" data-aparece>
          <ul class="unico__lista" role="list" aria-label="Testimonios" tabindex="0" data-unico-pista>
            {
              noEresElUnico.personas.map((p0) => ({ ...p0, ...(unicoV7Cambios[p0.nombre] ?? {}), universidad: false })).map((p) => (
                <li class:list={['tarjeta', { 'tarjeta--uni': p.universidad }]} data-placeholder="true">
                  <Fragment set:html="<!-- PLACEHOLDER: sustituir por persona real -->" />
                  <Image src={p.foto} alt={p.alt} width={480} height={420} quality={70} class="tarjeta__foto" />
                  <div class="tarjeta__texto">
                    <p class="tarjeta__cita">«{p.cita}»</p>
                    <p class="tarjeta__firma">— {p.nombre}, {p.edad}</p>
                  </div>
                </li>
              ))
            }
          </ul>
          <div class="ancho unico__ctrl">
            <span class="unico__prog" aria-hidden="true"><i data-unico-barra></i></span>
            <span class="unico__cuenta" aria-live="polite"><span data-unico-actual>1</span> / {noEresElUnico.personas.length}</span>
            <button type="button" class="flecha" data-unico-mover="-1" aria-label="Testimonio anterior" disabled>←</button>
            <button type="button" class="flecha" data-unico-mover="1" aria-label="Testimonio siguiente">→</button>
          </div>
        </div>
      </section>

      <!-- ===================== ¿Qué es NextYou? (v7: fondo negro, párrafo corto y directo) ===================== -->
      <section id="que-es" class="v7que" aria-labelledby="que-titulo">
        <div class="ancho v7que__rejilla">
          <div class="v7que__texto" data-aparece>
            <h2 id="que-titulo" class="v7que__tit">¿Qué es <span class="que__marca"><LogoV3 clase="logo--grande" /><span class="solo-lector">NextYou</span>?</span></h2>
            <p class="v7que__lema" set:html={cursiva(queEsV7.lema, queEsV7.resaltado)} />
            <Fragment set:html="<!-- PENDIENTE CLIENTA: validar el texto -->" />
            <p class="v7que__p">{queEsV7.texto}</p>
          </div>
          <!-- Antes en la portada: la pregunta, el botón del test y el microtexto -->
          <div class="v7que__accion" data-aparece>
            <p class="v7que__pregunta">¿No sabes qué estudiar? Haz el test gratis y descubre <em>3 caminos</em> que encajan contigo.</p>
            <Fragment set:html="<!-- PENDIENTE: CTA a revisar con la propuesta de Elias (comentario #14) -->" />
            <a href={CTA_PRINCIPAL.href} class="boton boton--grande">{hero.boton} <span aria-hidden="true">→</span></a>
            <p class="v7que__micro">{pasosV7.micro}</p>
          </div>
        </div>
      </section>


      <!-- ===================== Cómo funciona (v8) =====================
           Sustituye a la sección de la v7 por la propuesta «NextYou-como-funciona.html»: tres pasos con su pantalla de móvil
           animada (deslizable en móvil, tres columnas en escritorio). Imágenes de muestra en public/cfa/. -->
      <section id="como-funciona" class="cfa" aria-labelledby="como-titulo"><header class="cfa__cab"><p class="cfa__eti"><i aria-hidden="true"></i>Cómo funciona</p><h2 id="como-titulo" class="cfa__tit">De no saber qué estudiar a saber qué <u>quieres probar</u></h2><p class="cfa__sub">Tres pasos. Gratis. Desde el móvil.</p></header><ol class="cfa__pasos" role="list" data-cfa-pasos=""><li class="cfa__paso"><span class="cfa__n" aria-hidden="true">1</span><h3>Haces el test</h3><p>¿Cómo es tu energía? Eliges lo que más se parece a ti y en 8 minutos tienes tu perfil. Solo te pedimos tu email para mandarte los resultados.</p><div class="cfa-app" aria-hidden="true"><div class="cfa-pan" data-cfa-test=""><div class="cfa-est"><span>9:41</span><b></b></div><div class="cfa-t-top"><span class="cfa-x">✕</span><span class="cfa-barra"><i></i></span><small>3/12</small></div><div class="cfa-t-q"><p class="cfa-mini">Brújula interior</p><h4>¿Cómo describirías tu energía natural?</h4></div><div class="cfa-ops"><span class="cfa-sel"><span class="cfa-ic"><svg viewBox="0 0 24 24"><path d="M12 3l2.5 5.5L20 9l-4 4 1 6-5-3-5 3 1-6-4-4 5.5-.5z"></path></svg></span>Creador/a<small>Construyes cosas nuevas</small></span><span><span class="cfa-ic"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="8"></circle><circle cx="12" cy="12" r="3"></circle></svg></span>Estratega<small>Resuelves problemas</small></span><span><span class="cfa-ic"><svg viewBox="0 0 24 24"><circle cx="8" cy="9" r="3"></circle><circle cx="16" cy="9" r="3"></circle><path d="M3 19c1-3 3-4 5-4s4 1 5 4M11 19c1-3 3-4 5-4s4 1 5 4"></path></svg></span>Conector/a<small>Unes personas</small></span><span><span class="cfa-ic"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"></circle><path d="M15.5 8.5l-2 5-5 2 2-5z"></path></svg></span>Explorador/a<small>Buscas lo nuevo</small></span></div><div class="cfa-t-pie"><p>Sin respuestas buenas ni malas</p><span class="cfa-cta">Continuar</span></div></div></div></li><li class="cfa__paso"><span class="cfa__n" aria-hidden="true">2</span><h3>Recibes 3 caminos</h3><p>Al acabar, recibes 3 caminos que encajan contigo: el que más te pega, un puente hacia algo conocido y un salto hacia algo nuevo.</p><div class="cfa-app" aria-hidden="true"><div class="cfa-pan cfa-vivo" data-cfa-caminos=""><div class="cfa-est"><span>9:41</span><b></b></div><div class="cfa-c-top"><small>Hola, Lucía</small><h4>Tus <em>3</em> caminos</h4></div><div class="cfa-c-lista" data-placeholder="true"><div class="cfa-cam" style="--p:40%"><img src={`${CFA}cfa-cam-1.webp`} alt="" loading="eager" decoding="async" width="120" height="120" class="cfa-cam__f"><span class="cfa-cam__tx"><span class="cfa-tag">Lo que más te pega</span><b>Creación de contenido</b><span class="cfa-prog"><i><b></b></i>2/5</span></span><span class="cfa-fl">›</span></div><div class="cfa-cam" style="--p:20%"><img src={`${CFA}cfa-cam-2.webp`} alt="" loading="eager" decoding="async" width="120" height="120" class="cfa-cam__f"><span class="cfa-cam__tx"><span class="cfa-tag">El puente</span><b>Animación 3D</b><span class="cfa-prog"><i><b></b></i>1/5</span></span><span class="cfa-fl">›</span></div><div class="cfa-cam" style="--p:0%"><img src={`${CFA}cfa-cam-3.webp`} alt="" loading="eager" decoding="async" width="120" height="120" class="cfa-cam__f"><span class="cfa-cam__tx"><span class="cfa-tag">El salto</span><b>Ciberseguridad</b><span class="cfa-prog"><i><b></b></i>0/5</span></span><span class="cfa-fl">›</span></div></div><!-- PENDIENTE CLIENTA: los retos (2/5) y «Tu próximo paso» son de ejemplo --><div class="cfa-reto"><small>Tu próximo paso</small>Graba un vídeo de 30 segundos explicando algo que te guste.</div><nav class="cfa-nav"><span><svg viewBox="0 0 24 24"><path d="M4 11l8-7 8 7v9H4z"></path></svg>Inicio</span><span class="cfa-on"><svg viewBox="0 0 24 24"><path d="M5 20c0-6 3-9 7-11M12 9c3 1 6 4 7 11M12 9V3"></path></svg>Caminos</span><span><svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"></circle><path d="M4 21c1-4 4-6 8-6s7 2 8 6"></path></svg>Gente</span><span><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"></circle><circle cx="12" cy="10" r="3"></circle><path d="M7 18c1-2 3-3 5-3s4 1 5 3"></path></svg>Perfil</span></nav></div></div></li><li class="cfa__paso"><span class="cfa__n" aria-hidden="true">3</span><h3>Hablas con gente real</h3><p>Según tus resultados, recibes consejos y acceso a entrevistas con personas que ya se dedican a ello: qué estudiaron, cómo empezaron y cómo es su día a día.</p><div class="cfa-app" aria-hidden="true"><div class="cfa-pan cfa-osc cfa-vivo" data-cfa-gente="" data-placeholder="true"><img src={`${CFA}cfa-leo.webp`} alt="" loading="eager" decoding="async" width="600" height="800" class="cfa-v-img"><div class="cfa-est"><span>9:41</span><b></b></div><div class="cfa-v-top"><div class="cfa-v-bars"><i><b></b></i><i><b></b></i><i><b></b></i></div><div class="cfa-v-who"><img src={`${CFA}cfa-leo-av.webp`} alt="" loading="eager" decoding="async" width="64" height="64" class="cfa-v-av"><span><b>Leo, 26</b><small>Anima personajes 3D</small></span></div></div><div class="cfa-v-bot"><div class="cfa-v-bur"><p class="cfa-yo cfa-ver">¿Qué estudiaste?</p><p class="cfa-ella cfa-ver">Dibujaba cómics y luego hice una FP de Animación 3D.</p></div><div class="cfa-v-chips"><span class="cfa-tap">¿Qué estudiaste?</span><span>¿Cómo empezaste?</span><span>¿Cómo es tu día?</span></div></div></div></div></li></ol><div class="cfa__puntos" aria-hidden="true"><i class="cfa-on"></i><i></i><i></i></div><!-- PENDIENTE CLIENTA: precio y condiciones del coach --><div class="cfa__prem"><span class="cfa__prem-av" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"></circle><path d="M4 21c1-4 4-6 8-6s7 2 8 6"></path><path d="M18 4l1.5 1.5L22 3"></path></svg></span><div><p class="cfa__prem-eti">+ Opción premium</p><p class="cfa__prem-tit">Un coach te acompaña</p><p class="cfa__prem-tx">Para quien quiera ir un paso más allá: sesiones online con un coach para probar tus caminos en la vida real y decidir qué estudiar.</p></div></div><div class="cfa__pie"><!-- PENDIENTE: CTA a revisar con la propuesta de Elias (comentario #14) --><a href="#" class="cfa__boton">Haz el test gratis <span aria-hidden="true">→</span></a><p class="cfa__micro">8 minutos · gratis · te mandamos tus resultados por email</p></div></section>




      <!-- ===================== Los de dentro ===================== -->
      <section id="los-de-dentro" class="seccion dentro" aria-labelledby="dentro-titulo">
        <div class="ancho">
          <header class="cabecera" data-aparece>
            <p class="antetitulo">{losDeDentro.etiqueta}</p>
            <h2 id="dentro-titulo" class="titular titular--dentro rotulador">Así es <em>su día a día</em></h2>
            <p class="cabecera__sub">Sin discursos. Te cuentan cómo entraron, en qué se equivocaron y cómo es su día a día.</p>
          </header>
          <div class="dentro__nav" data-solo-carrusel>
            <button type="button" class="flecha" data-mover="-1" aria-label="Anterior" disabled>←</button>
            <span class="dentro__cuenta" aria-live="polite"><span data-actual>1</span> / {reels.length}</span>
            <button type="button" class="flecha" data-mover="1" aria-label="Siguiente">→</button>
          </div>
        </div>
        <Fragment set:html="<!-- PENDIENTE: clips de noviembre de Sara (comentario #11) -->" />
        <ul class="reels" data-reels role="list" aria-label="Vídeos de profesionales" tabindex="0">
          {
            reels.map((p, i) => (
              <li class="reel" style={`--i: ${i}`} data-placeholder="true">
                <Fragment set:html="<!-- PLACEHOLDER: sustituir por persona real -->" />
                <Image src={p.foto} alt={p.alt} width={540} height={960} loading={i < 2 ? 'eager' : 'lazy'} quality={70} class="reel__foto" />
                <div class="reel__pie">
                  <!-- La frase gancho, como una pegatina: encima del nombre para no tapar la cara -->
                  <p class="reel__gancho"><span>{p.cita}</span></p>
                  <p class="reel__nombre">{p.nombre}, {p.edad}</p>
                  <p class="reel__camino">{p.camino.join(' → ')}</p>
                  <span class="reel__ver">
                    <svg width="10" height="12" viewBox="0 0 12 14" aria-hidden="true"><path d="M1.5 1.2l9 5.8-9 5.8z" fill="currentColor" /></svg>
                    Ver su día · {p.duracion}
                  </span>
                </div>
                <button
                  type="button"
                  class="reel__abrir"
                  data-visor-abrir
                  aria-haspopup="dialog"
                  aria-label={`Ver el vídeo de ${p.nombre}, ${p.profesion}, ${p.duracion}`}
                  data-nombre={`${p.nombre}, ${p.edad}`}
                  data-profesion={p.profesion}
                  data-cita={p.cita}
                  data-duracion={p.duracion}
                  data-img={p.grande}
                  data-video={p.video ?? ''}
                  data-subtitulos={p.subtitulos ?? ''}
                  data-indice={i}
                  data-camino={p.camino.join('|')}
                  data-estudios={p.estudios}
                  data-trabajo={p.primerTrabajo}
                  data-martes={p.martes}
                >
                  <span class="reel__play" aria-hidden="true">
                    <svg width="18" height="20" viewBox="0 0 12 14"><path d="M1.5 1.2l9 5.8-9 5.8z" fill="currentColor" /></svg>
                  </span>
                </button>
              </li>
            ))
          }
        </ul>
        <div class="ancho">
          <div class="puntos" aria-hidden="true">
            {reels.map((_, i) => <span class:list={{ activo: i === 0 }} />)}
          </div>
        </div>
      </section>

      <!-- ===================== La uni no es el único camino (punto 5 de Sara) ===================== -->
      <section id="la-uni-no-es-lo-unico" class="seccion uni-no v7uni" aria-labelledby="uni-no-titulo" data-placeholder="true">
        <Fragment set:html="<!-- PENDIENTE CLIENTA: validar el texto de esta sección -->" />
        <div class="ancho uni-no__rejilla">
          <div class="uni-no__texto" data-aparece>
            <h2 id="uni-no-titulo" class="titular uni-no__titulo" set:html={cursiva(uniNoUnico.titulo, uniNoUnico.resaltado)} />
            <p class="uni-no__lead">{uniNoUnico.texto}</p>
            <ul class="uni-no__rutas" role="list" aria-label="Algunos caminos posibles">
              {uniNoUnico.rutas.map((r) => <li>{r}</li>)}
            </ul>
          </div>
          <!-- Carrusel con parallax: una tarjeta centrada, las de los lados asoman más pequeñas y apagadas -->
          <div class="uni-par" data-uni-par data-aparece>
          <div class="uni-par__pista" data-uni-pista role="region" aria-roledescription="carrusel" aria-label="Gente que cambió de camino" tabindex="0">
            {[0, 1, 2].flatMap((copia) => trayectorias.map((r, n) => (
              <article class:list={['uni-par__it', { act: copia === 1 && n === 0 }]} data-placeholder="true" aria-label={`${r.nombre}, ${r.edad}`} aria-hidden={copia === 1 ? undefined : 'true'}>
                {copia === 1 && n === 0 && <Fragment set:html="<!-- PENDIENTE: foto real (ahora, foto de muestra de banco de imágenes) -->" />}
                <div class="uni-par__marco">
                  <Image src={r.foto} alt={copia === 1 ? `Retrato de muestra de ${r.nombre}` : ''} width={700} height={700} widths={[360, 540, 700]} sizes="(min-width: 64rem) 22rem, 70vw" loading="eager" quality={72} class="uni-par__foto" />
                </div>
                <p class="uni-par__quien">{r.nombre}, {r.edad}</p>
                <p class="uni-par__cita">«{r.cita}»</p>
                <span class="uni-par__ola" aria-hidden="true"></span>
                <p class="uni-par__camino">{r.recorrido.join(' → ')}</p>
              </article>
            )))}
          </div>
          <div class="uni-par__puntos">
            {trayectorias.map((r, n) => (
              <button type="button" class:list={['uni-par__punto', { on: n === 0 }]} data-uni-punto={n} aria-label={`Ver a ${r.nombre}`} aria-current={n === 0 ? 'true' : undefined}></button>
            ))}
          </div>
        </div>
        </div>
      </section>



      <!-- Vídeo en grande. Mientras no haya clip, se ve la foto con un aviso. -->
      <dialog class="visor" aria-labelledby="visor-nombre">
        <div class="visor__caja">
          <button type="button" class="visor__cerrar" aria-label="Cerrar">
            <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M3 3l12 12M15 3L3 15" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
          </button>
          <div class="visor__media">
            <img class="visor__img" alt="" />
            <video class="visor__video" controls playsinline preload="metadata" hidden></video>
            <p class="visor__aviso">Aquí irá el vídeo · <span data-visor="duracion"></span></p>
          </div>
          <div class="visor__texto">
            <p id="visor-nombre" class="visor__nombre" data-visor="nombre"></p>
            <span class="etiqueta-marco" data-visor="profesion"></span>
            <p class="visor__cita">«<span data-visor="cita"></span>»</p>
            <!-- Ficha mientras no haya vídeo (PLACEHOLDER: datos de ejemplo) -->
            <div class="visor__ficha" data-visor="ficha">
              <ol class="visor__camino" data-visor="camino" aria-label="Su camino"></ol>
              <dl class="visor__datos">
                <div><dt>Qué estudió</dt><dd data-visor="estudios"></dd></div>
                <div><dt>Su primer trabajo</dt><dd data-visor="trabajo"></dd></div>
                <div><dt>Cómo es un martes</dt><dd data-visor="martes"></dd></div>
              </dl>
            </div>
            <a href={CTA_PRINCIPAL.href} class="boton visor__cta">¿Te ves aquí? Haz el test</a>
            <div class="visor__nav" data-visor="nav">
              <button type="button" class="flecha" data-visor-mover="-1" aria-label="Profesional anterior">←</button>
              <span class="visor__cuenta" aria-live="polite"><span data-visor="actual"></span> / {reels.length}</span>
              <button type="button" class="flecha" data-visor-mover="1" aria-label="Siguiente profesional">→</button>
            </div>
          </div>
        </div>
      </dialog>

      <!-- ===================== Sara · fondo oscuro (comentario #15). Texto provisional suyo. ===================== -->
      <section id="quien-hay-detras" class="sara" aria-labelledby="sara-titulo">
        <div class="estrecho sara__rejilla">
          <div class="sara__texto" data-aparece>
            <p class="antetitulo">{sara.etiqueta}</p>
            <h2 id="sara-titulo" class="titular titular--sara">{sara.titulo}</h2>
            <p>{sara.texto}</p>
            <p class="firma">{sara.firma}</p>
            <Fragment set:html="<!-- PENDIENTE: botón «Leer su historia» cuando exista la página de Sara -->" />
          </div>
          <Fragment set:html="<!-- PENDIENTE: foto real de Sara. Ahora hay una foto de muestra de banco de imágenes que NO es ella -->" />
          <div class="sara__polaroid" data-placeholder="true">
            <Image src={fotoSara} alt="Foto de muestra, pendiente de la foto real de Sara" width={720} height={720} widths={[360, 540, 720]} sizes="(min-width: 56rem) 19rem, 80vw" loading="lazy" quality={74} class="sara__foto" />
            <p class="sara__pie" aria-hidden="true"><strong>Sara</strong> · {sara.cargo}</p>
          </div>
        </div>
      </section>

      <!-- ===================== Cierre: última llamada antes del pie ===================== -->
      <section class="cierre" aria-labelledby="cierre-titulo">
        <div class="estrecho cierre__caja" data-aparece>
          <p class="nota-mano" aria-hidden="true">tu turno ↓</p>
          <h2 id="cierre-titulo" class="titular rotulador">¿Y tú, a qué te <em>podrías dedicar</em>?</h2>
          <a href={CTA_PRINCIPAL.href} class="boton boton--grande">{hero.boton}</a>
          <p class="cierre__meta">{pasosV7.micro}</p>
        </div>
      </section>
    </main>

  <Fragment slot="antes-del-pie">
    <!-- Botón siempre a mano en el móvil, entre la portada y el pie -->
    <aside class="fijo" aria-label="Acceso rápido al test" aria-hidden="true" inert>
      <a href={CTA_PRINCIPAL.href} class="boton">{hero.boton}</a>
      <span>8 min · gratis</span>
    </aside>
  </Fragment>
</V5>

<script>
      // Visor de «Los de dentro»: vídeo si lo hay; si no, foto y ficha. Flechas para pasar de profesional.
      const visor = document.querySelector<HTMLDialogElement>('.visor');
      if (visor) {
        const img = visor.querySelector<HTMLImageElement>('.visor__img')!;
        const video = visor.querySelector<HTMLVideoElement>('.visor__video')!;
        const aviso = visor.querySelector<HTMLElement>('.visor__aviso')!;
        const campo = (k: string) => visor.querySelector<HTMLElement>(`[data-visor="${k}"]`)!;
        const tarjetas = [...document.querySelectorAll<HTMLButtonElement>('.reel__abrir[data-indice]')];
        let actual = -1;
        const mostrar = (b: HTMLButtonElement) => {
          const d = b.dataset;
          actual = d.indice ? Number(d.indice) : -1;
          campo('nombre').textContent = d.nombre ?? '';
          campo('profesion').textContent = d.profesion ?? '';
          campo('cita').textContent = d.cita ?? '';
          campo('duracion').textContent = d.duracion ?? '';
          img.src = d.img ?? '';
          const hayVideo = Boolean(d.video);
          video.hidden = !hayVideo;
          img.hidden = hayVideo;
          aviso.hidden = hayVideo;
          // Ficha solo para profesionales y mientras no haya vídeo
          const ficha = !hayVideo && Boolean(d.camino);
          campo('ficha').hidden = !ficha;
          if (ficha) {
            campo('camino').replaceChildren(...d.camino!.split('|').map((paso) => Object.assign(document.createElement('li'), { textContent: paso })));
            campo('estudios').textContent = d.estudios ?? '';
            campo('trabajo').textContent = d.trabajo ?? '';
            campo('martes').textContent = d.martes ?? '';
          }
          campo('nav').hidden = actual < 0;
          campo('actual').textContent = String(actual + 1);
          video.pause();
          video.querySelectorAll('track').forEach((tr) => tr.remove());
          if (hayVideo) {
            video.poster = d.img ?? '';
            video.src = d.video!;
            if (d.subtitulos) {
              const pista = document.createElement('track');
              Object.assign(pista, { kind: 'subtitles', srclang: 'es', label: 'Español', src: d.subtitulos, default: true });
              video.append(pista);
            }
            video.play().catch(() => {});
          } else video.removeAttribute('src');
          visor.querySelector('.visor__caja')!.scrollTop = 0;
        };
        document.querySelectorAll<HTMLButtonElement>('[data-visor-abrir]').forEach((b) =>
          b.addEventListener('click', () => { mostrar(b); visor.showModal(); })
        );
        visor.querySelectorAll<HTMLButtonElement>('[data-visor-mover]').forEach((f) =>
          f.addEventListener('click', () => {
            if (actual < 0) return;
            const n = (actual + Number(f.dataset.visorMover) + tarjetas.length) % tarjetas.length;
            mostrar(tarjetas[n]);
          })
        );
        visor.addEventListener('keydown', (e) => {
          if (actual < 0) return;
          if (e.key === 'ArrowRight') mostrar(tarjetas[(actual + 1) % tarjetas.length]);
          if (e.key === 'ArrowLeft') mostrar(tarjetas[(actual - 1 + tarjetas.length) % tarjetas.length]);
        });
        const cerrar = () => visor.close();
        visor.querySelector('.visor__cerrar')!.addEventListener('click', cerrar);
        visor.addEventListener('click', (e) => { if (e.target === visor) cerrar(); });
        // El botón del test cierra el visor antes de abrir el aviso
        visor.querySelector('.visor__cta')!.addEventListener('click', cerrar);
        visor.addEventListener('close', () => { video.pause(); video.removeAttribute('src'); });
      }

      // Vídeo de la portada (sin botón de pausa, a petición de Jenifer): con «reducir movimiento» no se reproduce y queda el póster; si falla, póster
      const portadaV = document.querySelector<HTMLElement>('.v7hero');
      const videoHero = document.querySelector<HTMLVideoElement>('[data-hero-video]');
      if (portadaV && videoHero) {
        const sinVideo = () => portadaV.classList.add('hero--sin-video');
        const fuentes = videoHero.querySelectorAll('source');
        fuentes[fuentes.length - 1].addEventListener('error', sinVideo);
        videoHero.addEventListener('error', sinVideo);
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          videoHero.pause();
          portadaV.classList.add('hero--quieto');
        }
      }

      // Botón fijo en móvil: visible cuando ni la portada ni el pie están en pantalla
      const fijo = document.querySelector<HTMLElement>('.fijo');
      const portada = document.querySelector('.v7hero');
      const pieWeb = document.querySelector('.pie');
      if (fijo && portada && pieWeb && 'IntersectionObserver' in window) {
        const vistos = new Set<Element>();
        const actualizar = () => {
          const mostrar = vistos.size === 0;
          fijo.classList.toggle('visible', mostrar);
          fijo.toggleAttribute('inert', !mostrar);
          fijo.setAttribute('aria-hidden', String(!mostrar));
        };
        const ob = new IntersectionObserver((es) => {
          es.forEach((e) => (e.isIntersecting ? vistos.add(e.target) : vistos.delete(e.target)));
          actualizar();
        });
        ob.observe(portada);
        const intro = document.querySelector('.intro');
        if (intro) ob.observe(intro);
        const tarjetasDentro = document.querySelector('.dentro');
        if (tarjetasDentro) ob.observe(tarjetasDentro);
        const cierre = document.querySelector('.cierre');
        if (cierre) ob.observe(cierre);
        document.querySelectorAll('.cta-grande').forEach((el) => ob.observe(el));
        // Universidad y familias ya llevan su propio botón
        ['universidad', 'familias'].forEach((id) => { const el = document.getElementById(id); if (el) ob.observe(el); });
        ob.observe(pieWeb);
      }

      // Efectos de «Los de dentro»: entrada al llegar, movimiento solo mientras se ve, inclinación con el ratón
      const reelsFx = document.querySelector<HTMLElement>('[data-reels]');
      if (reelsFx && 'IntersectionObserver' in window) {
        new IntersectionObserver((es) => {
          es.forEach((e) => {
            if (e.isIntersecting && !reelsFx.classList.contains('en-vista')) {
              reelsFx.classList.add('en-vista');
              setTimeout(() => reelsFx.classList.add('listo'), 1800);
            }
            reelsFx.classList.toggle('moviendo', e.isIntersecting);
          });
        }, { threshold: 0.2 }).observe(reelsFx);
      } else reelsFx?.classList.add('en-vista', 'listo');
      const quietos = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!quietos && window.matchMedia('(hover: hover)').matches) {
        document.querySelectorAll<HTMLElement>('.reel').forEach((r) => {
          r.addEventListener('pointermove', (e) => {
            const c = r.getBoundingClientRect();
            const x = (e.clientX - c.left) / c.width, y = (e.clientY - c.top) / c.height;
            r.classList.add('inclinada');
            r.style.setProperty('--ry', `${(x - 0.5) * 14}deg`);
            r.style.setProperty('--rx', `${(0.5 - y) * 14}deg`);
            r.style.setProperty('--mx', `${x * 100}%`);
            r.style.setProperty('--my', `${y * 100}%`);
          });
          r.addEventListener('pointerleave', () => {
            r.classList.remove('inclinada');
            r.style.setProperty('--rx', '0deg');
            r.style.setProperty('--ry', '0deg');
          });
        });
      }

      // v7 · móvil continuo: la pantalla del móvil fijo cambia según el paso que cruza el centro de la ventana
      const pasosV7 = document.querySelectorAll<HTMLElement>('.v7paso');
      const capasV7 = document.querySelectorAll<HTMLElement>('.v7tel--fijo .v7pant');
      if (pasosV7.length && capasV7.length && 'IntersectionObserver' in window) {
        const activarV7 = (n: number) => {
          capasV7.forEach((c) => c.classList.toggle('activa', Number(c.dataset.pant) === n));
          pasosV7.forEach((p) => p.classList.toggle('activo', Number(p.dataset.paso) === n));
        };
        activarV7(0);
        const obsV7 = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) activarV7(Number((e.target as HTMLElement).dataset.paso)); }), { rootMargin: '-50% 0px -50% 0px' });
        pasosV7.forEach((p) => obsV7.observe(p));
      }

      // v7 · mapa de «Cómo funciona»: se dibuja al llegar y luego el lima va pasando de paso en paso
      const mapaV7 = document.querySelector<HTMLElement>('[data-mapa]');
      if (mapaV7) {
        const nodos = [...mapaV7.querySelectorAll<HTMLElement>(':scope > li')];
        const quietoM = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        let paso = 0, reloj = 0;
        const marcar = () => nodos.forEach((n, i) => n.classList.toggle('aqui', i === paso));
        if (quietoM || !('IntersectionObserver' in window)) { mapaV7.classList.add('dibujado'); paso = nodos.length - 1; marcar(); }
        else new IntersectionObserver((es) => es.forEach((e) => {
          window.clearInterval(reloj);
          if (!e.isIntersecting) return;
          mapaV7.classList.add('dibujado');
          reloj = window.setInterval(() => { paso = (paso + 1) % nodos.length; marcar(); }, 1600);
          marcar();
        }), { threshold: 0.5 }).observe(mapaV7);
      }

      // v7 · paso 3: las historias de «Los de dentro» pasan solas dentro del móvil
      document.querySelectorAll<HTMLElement>('[data-reel]').forEach((reel) => {
        const diapos = [...reel.querySelectorAll<HTMLElement>('[data-reel-diapo]')];
        const barras = [...reel.querySelectorAll<HTMLElement>('[data-reel-barra]')];
        if (diapos.length < 2) return;
        const quieto = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        let actual = 0, temporizador = 0;
        const pintar = () => {
          diapos.forEach((d, i) => d.classList.toggle('activa', i === actual));
          barras.forEach((b, i) => { b.classList.toggle('hecha', i < actual); b.classList.toggle('ahora', i === actual); });
          // reinicia la animación de la barra activa
          const b = barras[actual].firstElementChild as HTMLElement; b.style.animation = 'none'; void b.offsetWidth; b.style.animation = '';
        };
        const siguiente = () => { actual = (actual + 1) % diapos.length; pintar(); };
        pintar();
        if (quieto || !('IntersectionObserver' in window)) return;
        new IntersectionObserver((es) => es.forEach((e) => {
          window.clearInterval(temporizador);
          if (e.isIntersecting) temporizador = window.setInterval(siguiente, 4000);
        }), { threshold: 0.3 }).observe(reel);
      });

      // Paso 1: demo del test (3 preguntas de muestra → adelanto del perfil)
      const test = document.querySelector<HTMLElement>('[data-test]');
      if (test) {
        const datos = JSON.parse(test.querySelector('[data-test-datos]')!.textContent || '{}');
        const pasosT = [...test.querySelectorAll<HTMLElement>('[data-test-paso]')];
        const barraT = test.querySelector<HTMLElement>('[data-test-barra]')!;
        const cntT2 = test.querySelector('[data-test-cnt]')!;
        const volverT = test.querySelector<HTMLButtonElement>('[data-test-volver]')!;
        const repetirT = test.querySelector<HTMLButtonElement>('[data-test-repetir]')!;
        const quietoTest = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const resp: number[] = [];
        let actualT = 0;
        const irT = (n: number, foco = false) => {
          pasosT.forEach((p, k) => { p.hidden = k !== n; p.classList.toggle('entra', k === n && !quietoTest()); });
          actualT = n;
          barraT.style.width = `${(n / 3) * 100}%`;
          cntT2.textContent = n < 3 ? `${n + 1} de 3` : 'listo';
          volverT.disabled = n === 0;
          volverT.hidden = n === 3;
          repetirT.hidden = n !== 3;
          if (n === 3) {
            const r = datos.energias[resp[0]];
            test.querySelector('[data-test-tit]')!.textContent = r.t;
            test.querySelector('[data-test-frase]')!.textContent = r.f;
            test.querySelector('[data-test-r1]')!.textContent = datos.mueve[resp[1]];
            test.querySelector('[data-test-r2]')!.textContent = datos.arranca[resp[2]];
          } else {
            pasosT[n].querySelectorAll<HTMLButtonElement>('.tt-op').forEach((o) => {
              const sel = resp[n] === Number(o.dataset.v);
              o.classList.toggle('sel', sel);
              o.setAttribute('aria-pressed', String(sel));
            });
          }
          // con teclado, el foco pasa a la pregunta (o al resultado) nueva
          if (foco) pasosT[n].querySelector<HTMLElement>('[tabindex="-1"]')?.focus();
        };
        pasosT.slice(0, 3).forEach((p, n) => p.querySelectorAll<HTMLButtonElement>('.tt-op').forEach((o) => o.addEventListener('click', (e) => {
          p.querySelectorAll('.tt-op').forEach((x) => { x.classList.remove('sel'); x.setAttribute('aria-pressed', 'false'); });
          test.querySelectorAll('.tt-op--pista').forEach((x) => x.classList.remove('tt-op--pista'));
          o.classList.add('sel'); o.setAttribute('aria-pressed', 'true');
          resp[n] = Number(o.dataset.v);
          barraT.style.width = `${((n + 1) / 3) * 100}%`;
          const teclado = (e as MouseEvent).detail === 0;
          window.setTimeout(() => irT(n + 1, teclado), quietoTest() ? 0 : 420);
        })));
        volverT.addEventListener('click', () => { if (actualT > 0) irT(actualT - 1, true); });
        repetirT.addEventListener('click', () => {
          resp.length = 0;
          test.querySelectorAll<HTMLButtonElement>('.tt-op').forEach((o) => { o.classList.remove('sel'); o.setAttribute('aria-pressed', 'false'); });
          irT(0, true);
        });
        irT(0);
      }

      // Paso 3 · escritorio: el abanico de cromos se reparte al entrar en pantalla
      const grupoCromos = document.querySelector<HTMLElement>('[data-cromos]');
      if (grupoCromos) {
        if ('IntersectionObserver' in window) {
          const obsC = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { grupoCromos.classList.add('repartido'); obsC.disconnect(); } }), { threshold: 0.4 });
          obsC.observe(grupoCromos);
        } else grupoCromos.classList.add('repartido');
      }

      // Paso 3 · móvil: tambor 3D. 6 posiciones a 60°; el de delante a tamaño real
      const zonaT = document.querySelector<HTMLElement>('[data-tambor]');
      if (zonaT) {
