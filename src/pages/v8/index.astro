     grano sutil y casi ningún color. Sin tocar textos ni orden de secciones.
     ===================================================================== */
  :root:root {
    --t-seccion: clamp(2.5rem, 1.35rem + 4.4vw, 5.75rem);
    --radio: 2px;
    --fino: rgb(246 241 232 / 0.12);
  }

  /* Grano sutil sobre todo (solo se nota en las zonas oscuras) */
  body::after {
    content: ''; position: fixed; inset: 0; z-index: 55; pointer-events: none; opacity: 0.07; mix-blend-mode: overlay;
