<style is:global>
  /* =====================================================================
     V8 · Premium y minimalista (2026-10-09)
     Menos adornos, tipografía más fina, más aire y color contenido. Sin tocar textos ni orden.
     Referencias: Headspace, Notion, Brilliant, Forage; marcas de lujo sobrias.
     ===================================================================== */
  :root:root {
    --aire: 8rem;                           /* 128 px entre secciones en móvil */
    --radio: 14px;
    --suave: rgb(246 241 232 / 0.68);       /* texto secundario sobre negro */
  }
  @media (min-width: 48rem) { :root:root { --aire: 12.5rem; } }   /* 200 px en escritorio */

  /* ---------- Tipografía: más fina y más tranquila ---------- */
  .unico .cabecera--centro .titular--unico, .v7que__tit, .v7como__frase, .uni-no__titulo, #dentro-titulo, #sara-titulo, #cierre-titulo,
  .cfa__tit {
    font-weight: 600 !important; font-stretch: 100% !important; letter-spacing: -0.035em !important; line-height: 1.04 !important;
