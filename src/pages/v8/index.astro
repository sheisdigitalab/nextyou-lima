  /* ---------- 4 · COLOR: domina el negro ----------
     Solo «Cómo funciona» es crema (para que destaquen los móviles). El resto, en dos tonos de negro que se alternan
     para que no haya dos fondos iguales seguidos:
     hero (vídeo) → No eres el único (negro) → ¿Qué es? (negro 2) → Cómo funciona (CREMA) → Los de dentro (negro)
     → La uni (negro 2) → Sara (negro) → cierre (negro 2) → pie (negro) */
  .v7como { background: var(--crema) !important; color: var(--negro) !important; }
  .v7unico, .dentro, .sara { background: var(--negro) !important; color: var(--crema) !important; }
