  .cfa__tit { font-weight: 700 !important; }
  .v7hero__lema { font-weight: 700; letter-spacing: -0.04em; }
  .cabecera__sub, .v7que__p, .uni-no__lead, .sara__texto > p:not([class]), .v7paso__p { font-weight: 400; line-height: 1.65; }
  .v7que, .dentro, .sara, .v7uni, .v7unico, .cierre { --texto-sec: var(--suave); }
  .cabecera__sub, .v7que__p, .uni-no__lead, .sara__texto > p:not([class]) { color: var(--suave) !important; }
  .v7que__lema, .v7que__pregunta, .tarjeta__cita, .uni-par__cita { font-weight: 600; letter-spacing: -0.015em; }
  .v7paso h3, .cfa__paso h3, .reel__nombre, .v7gente__nom strong { font-weight: 600; }
  .cfa__paso h3 { font-weight: 700; }
  /* etiquetas: finas, muy espaciadas y discretas */
  .antetitulo, .v7como__eti, .v7gente__eti, .nota-mano, .uni-par__quien, .cfa__eti {
    font-weight: 500 !important; letter-spacing: 0.22em !important; opacity: 0.85;
  }

  /* ---------- Sin adornos: nada inclinado, sin cintas ni pegatinas ---------- */
  .tarjeta::before, .sara__polaroid::before { display: none !important; }
  .tarjeta:nth-child(odd), .tarjeta:nth-child(even), .tarjeta { rotate: 0deg !important; }
  .tarjeta { border-radius: var(--radio); padding: 0; box-shadow: none; overflow: hidden; }
  .tarjeta:hover { rotate: 0deg; translate: 0 -3px; box-shadow: none; }
  .tarjeta__foto { border-radius: 0; }
  .sara__polaroid { rotate: 0deg !important; background: none !important; padding: 0 !important; box-shadow: none !important; border-radius: var(--radio); width: min(100%, 22rem); }
  .sara__foto { border-radius: var(--radio) !important; aspect-ratio: 4 / 5; object-position: 50% 25%; }
  .sara__pie { text-align: left; padding: 0.875rem 0 0 !important; color: var(--suave) !important; }
  .sara__polaroid strong { color: var(--crema) !important; font-weight: 600; }
  .reel { border-radius: var(--radio); box-shadow: none; transform: none !important; }
  .js [data-reels]:not(.en-vista) .reel { rotate: 0deg; translate: 0 28px; }
  .reel.inclinada { transform: none !important; }
  .reel__gancho span { background: none !important; color: var(--crema) !important; padding: 0; border-radius: 0; font-weight: 600; box-decoration-break: slice; }
  .uni-par__marco, .v7vid, .trayecto { border-radius: var(--radio); box-shadow: none; }
  /* móviles de «Cómo funciona»: sombra mínima */
  .cfa-app { box-shadow: 0 24px 40px -32px rgb(0 0 0 / 0.35); }

  /* ---------- Botones: más finos, sin saltos ---------- */
  .boton, .boton--grande { min-height: 52px !important; padding-inline: 1.75rem !important; font-size: 0.9375rem !important; font-weight: 600 !important; letter-spacing: 0.01em; box-shadow: none !important; }
  .boton--sm { min-height: 40px !important; padding-inline: 1.25rem !important; font-size: 0.875rem !important; }
  .boton:hover { transform: none !important; box-shadow: none !important; filter: brightness(0.94); }
  .cfa__boton { font-weight: 600; box-shadow: none; }

  /* ---------- Movimiento: más lento y más sobrio ---------- */
  @media (prefers-reduced-motion: no-preference) {
    .js [data-aparece] { translate: 0 10px; transition: opacity 900ms ease, translate 900ms cubic-bezier(0.2, 0.7, 0.2, 1); }
    .js [data-aparece].visible { translate: 0 0; }
  }

  /* «Cómo funciona»: sin caja en «Opción premium» y un único botón principal (lima) */
  .cfa__prem { background: none !important; border: 0 !important; box-shadow: none !important; border-radius: 0 !important; padding-inline: 0 !important; }
  .cfa__boton { background: var(--acento) !important; color: var(--acento-txt) !important; border-radius: 999px; min-height: 52px; }

  /* ---------- Color: negro y crema; el lima, solo en botones y subrayados ---------- */
  .uni-no__rutas li::before { background: var(--crema); opacity: 0.5; width: 4px; height: 4px; }
  .v7paso__n::after { background: var(--acento); }
  .puntos span.activo, .uni-par__punto.on::before { background: var(--crema); }
