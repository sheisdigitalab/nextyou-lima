  /* las palabras clave llevan subrayado lima y el texto en su color */
  .titular em, .uni-no__titulo em, .v7como__frase em, .cierre .titular em {
    color: inherit; background: linear-gradient(var(--acento), var(--acento)) no-repeat left 92% / 100% 0.14em; box-shadow: none; padding-bottom: 0.08em; font-style: normal;
  }
  /* No eres el único: tarjetas con foto (crema sobre negro) */
  .v7unico .tarjeta { background: var(--crema); color: var(--negro); box-shadow: 0 22px 36px -22px rgb(0 0 0 / 0.7); }
  .v7unico .tarjeta__firma { color: var(--gris-oscuro); }
  /* La uni */
  .v7uni .uni-no__lead { color: rgb(246 241 232 / 0.85); }
  .v7uni .uni-par__camino { color: #D9D4CA; font-size: var(--t1); }
  .v7uni .uni-par__marco { background: var(--negro); box-shadow: 0 24px 40px -28px rgb(0 0 0 / 0.8); }
  .v7uni .uni-par__punto::before { background: var(--crema); opacity: 0.25; }
  .v7uni .uni-par__punto.on::before { background: var(--acento); opacity: 1; }
  /* Cierre: sin degradado lima */
  .cierre { background-image: none !important; }
  .cierre__meta { color: var(--gris) !important; }

  /* ---------- 5 · BOTONES: un solo estilo principal ---------- */
  .boton:not(.boton--sm):not(.boton--contorno):not(.boton--contorno-oscuro):not(.boton--pronto), .boton--grande {
    min-height: 56px; padding: 0.75rem 1.75rem; border-radius: 999px; background: var(--acento); color: var(--acento-txt);
    font-size: 1rem; font-weight: 700; box-shadow: none;
  }
  .boton:hover { box-shadow: none; }
  .v7micro { margin: 0; font-size: var(--t1); line-height: 1.4; color: var(--gris-oscuro); text-align: center; }
  .cierre__meta, .v7que__micro { font-size: var(--t1); line-height: 1.4; }

  /* El lima no se usa como color de texto: las palabras clave van en el color del texto con subrayado lima */
  .dentro .titular em, #dentro-titulo em, .v7que__pregunta em, .v7que__lema em, .rotulador em {
    color: inherit !important; background: linear-gradient(var(--acento), var(--acento)) no-repeat left 92% / 100% 0.14em; box-shadow: none; padding-bottom: 0.08em;
  }
  .v7que__pregunta em { font-style: normal; }
  /* números de los pasos: sin bloque lima; solo un subrayado fino */
  .v7paso__n { background: none !important; box-shadow: none !important; min-width: 0 !important; display: inline-block; padding-bottom: 0.2em; position: relative; }
  .v7paso__n::after { content: ''; position: absolute; left: 0; bottom: 0; width: 100%; height: 3px; border-radius: 2px; background: var(--acento); }
  .v7paso__n--premium::after { display: none; }
  /* etiquetas «pronto» del pie: sin caja */
