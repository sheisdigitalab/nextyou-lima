---
// /acompanamiento-crema/: variante en crema de /acompanamiento/. Página aparte, sin enlazar desde el menú ni desde otras páginas, con noindex.
// Referencia: exploracion/acompanamiento-crema-propuesta.html (nextyou-landing); textos, orden de secciones y comportamiento tal cual.
//
// PENDIENTE CLIENTA / SARA: enlaces de reservar y «Escríbenos» (hoy #), perfiles reales de los coaches (hoy de ejemplo, sin vídeo),
// política de cancelación y devolución. Los botones de vídeo de los coaches no hacen nada todavía.
import V5 from '../../layouts/V5.astro';
import AppPantalla from '../../components/AppPantalla.astro';
import { CTA_PRINCIPAL } from '../../config';

const faq = {
 "@context": "https://schema.org",
 "@type": "FAQPage",
 "mainEntity": [
  {
   "@type": "Question",
   "name": "¿Tengo que hacer el test antes?",
   "acceptedAnswer": {
    "@type": "Answer",
    "text": "Sí. El coach parte de tus 3 caminos, así no empezáis de cero. El test es gratis."
   }
  },
  {
   "@type": "Question",
   "name": "¿Me vais a decir qué estudiar?",
   "acceptedAnswer": {
    "@type": "Answer",
    "text": "No. Te ayudamos a comparar con datos y la decisión es tuya."
   }
  },
  {
   "@type": "Question",
   "name": "¿Mis padres se enteran de lo que hablo?",
   "acceptedAnswer": {
    "@type": "Answer",
    "text": "No. Están al principio, pero tus sesiones son confidenciales, salvo que estés en peligro."
   }
  },
  {
   "@type": "Question",
   "name": "¿Qué plan me conviene?",
   "acceptedAnswer": {
    "@type": "Answer",
    "text": "Una duda concreta: «Resolver dudas». Varias opciones: «Comparar caminos». Tienes que elegir pronto: «Decidir con calma»."
   }
  },
  {
   "@type": "Question",
   "name": "¿Por qué pagar si hay orientador en el instituto?",
   "acceptedAnswer": {
    "@type": "Answer",
    "text": "El orientador atiende a muchos alumnos a la vez. Aquí las sesiones son solo para tu hijo o hija y acaban con un plan concreto. Es un complemento, no un sustituto."
   }
  },
  {
   "@type": "Question",
   "name": "¿Y si no puedo ir a una sesión?",
   "acceptedAnswer": {
    "@type": "Answer",
    "text": "Avisas con antelación y buscáis otro día."
   }
  }
 ]
};
---

<V5
  titulo="Coach para decidir qué estudiar · NextYou"
  descripcion="Sesiones por videollamada con un coach para comparar tus 3 caminos con datos reales y decidir qué estudiar. Desde 49 €."
  actual="bachillerato"
  soloBachillerato
  ruta="home-v3/"
  robots="noindex, follow"
>
  <main id="contenido" class="acc">
<div class="ancho">

<div class="acc-hero">
<div><h1>Decide qué estudiar <em class="acc-hl">con un coach</em></h1>
<p class="acc-sub">Comparas tus 3 caminos con datos reales y eliges por dónde empezar.</p>
<div class="acc-ctas"><a class="boton boton--oscuro" href="#planes">Ver planes · desde 49 €</a><a class="acc-tl" href="#familias">Soy madre o padre <span aria-hidden="true">→</span></a></div>
<p class="acc-meta">Por videollamada · Sesiones de 45 min</p></div>
<figure class="acc-chat" aria-label="Ejemplo de conversación en una sesión">
<p class="acc-m acc-y">Me salen Animación 3D y Ciberseguridad. ¿Por cuál tiro?</p>
<p class="acc-m acc-k">Hoy no tienes que decidirlo todo. Buscamos un primer paso que puedas probar.</p>
<figcaption>Así puede ser una sesión</figcaption></figure>
</div>

<section aria-labelledby="t-quien"><div class="acc-head"><h2 id="t-quien">¿Te <em class="acc-hl">suena?</em></h2><p>Para eso está el coach.</p></div>
<ul class="acc-sit" role="region" aria-label="Situaciones frecuentes, desliza para ver más" tabindex="0">
<li>Me salen tres caminos y no sé por cuál empezar.</li>
<li>Me gusta algo creativo, pero en casa no lo ven claro.</li>
<li>Tengo que elegir este curso y me bloqueo.</li>
</ul></section>

<section id="como" aria-labelledby="t-como"><div class="acc-head"><h2 id="t-como">Así <em class="acc-hl">funciona</em></h2></div>
<ol class="acc-steps">
<li><span class="acc-mk" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="9" cy="8" r="3"/><circle cx="17" cy="9" r="2.5"/><path d="M3 20c0-3.3 2.7-6 6-6s6 2.7 6 6"/><path d="M15 14.5c2.8 0 5 2.2 5 5"/></svg></span><h3>Empezáis en familia</h3><p>Qué buscáis y qué queda entre tú y tu coach.</p></li>
<li><span class="acc-mk" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12z"/></svg></span><h3>Sesiones solo para ti</h3><p>Comparáis tus caminos con datos. Todo es confidencial.</p></li>
<li><span class="acc-mk" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M9 3h6"/><path d="M10 3v6L5 18a2 2 0 0 0 1.8 3h10.4A2 2 0 0 0 19 18l-5-9V3"/><path d="M7.5 14h9"/></svg></span><h3>Pruebas entre sesiones</h3><p>Un vídeo, unas puertas abiertas, una pregunta a un estudiante.</p></li>
<li><span class="acc-mk" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5"/><path d="M9 13h6M9 17h4"/></svg></span><h3>Te llevas tu plan</h3><p>Tu primer paso, los plazos y un plan B.</p></li>
</ol>
<p class="acc-note"><b>No decide por ti ni hace terapia.</b> Si necesitas un psicólogo, te lo dice.</p></section>

<section id="planes" aria-labelledby="t-planes"><div class="acc-head"><h2 id="t-planes">Elige tu <em class="acc-hl">plan</em></h2><p>Los tres empiezan con tu familia y acaban con algo por escrito.</p></div>
<div class="acc-plans">
<article class="acc-card acc-plan"><h3>Resolver dudas</h3><p class="acc-for">Tienes una duda concreta.</p><p class="acc-pr">49 €<small>IVA incl.</small></p><p class="acc-per">Sesión suelta</p><ul class="acc-li"><li>1 sesión de 45 min</li><li>10 min con tu familia</li><li>Tu siguiente paso por escrito</li></ul><a class="boton boton--contorno-oscuro" href="#" aria-label="Reservar el plan Resolver dudas, 49 euros">Reservar sesión</a></article>
<article class="acc-card acc-plan acc-rec"><span class="acc-tag">Para comparar tus 3 caminos</span><h3>Comparar caminos</h3><p class="acc-for">Dudas entre varias opciones.</p><p class="acc-pr">149 €<small>IVA incl.</small></p><p class="acc-per">Unos 37 € por sesión</p><ul class="acc-li"><li>4 sesiones (1 con tu familia)</li><li>Comparativa hecha para ti</li><li>Dudas por mensaje entre sesiones</li></ul><a class="boton" href="#" aria-label="Empezar el plan Comparar caminos, 149 euros">Empezar</a></article>
<article class="acc-card acc-plan"><h3>Decidir con calma</h3><p class="acc-for">Tienes que elegir pronto.</p><p class="acc-pr">249 €<small>IVA incl.</small></p><p class="acc-per">Unos 42 € por sesión</p><ul class="acc-li"><li>6 sesiones (2 con tu familia)</li><li>Charla con un Insider de tu camino</li><li>1 mes de dudas por mensaje al acabar</li></ul><a class="boton boton--contorno-oscuro" href="#" aria-label="Empezar el plan Decidir con calma, 249 euros">Empezar</a></article>
</div>
<ul class="acc-book" aria-label="Cómo se reserva">
<li><span class="acc-mi" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4.4 3.6-8 8-8s8 3.6 8 8"/></svg></span>Eliges coach</li><li class="acc-ar" aria-hidden="true">→</li>
<li><span class="acc-mi" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/></svg></span>Día y hora</li><li class="acc-ar" aria-hidden="true">→</li>
<li><span class="acc-mi" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M23 7l-7 5 7 5z"/><rect x="1" y="5" width="15" height="14" rx="2"/></svg></span>Te llega el enlace</li>
</ul>
<p class="acc-small">IVA incluido. Si eres menor, reserva y paga un adulto.</p></section>

<section id="familias" aria-labelledby="t-fam"><div class="acc-fam">
<div class="acc-head"><div><p class="acc-ey">Para madres, padres y tutores</p><h2 id="t-fam">Lo que <em class="acc-hl">tenéis que saber</em></h2></div></div>
<ul class="acc-fg" role="region" aria-label="Lo que tenéis que saber, desliza para ver más" tabindex="0">
<li><span class="acc-mk" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="9" cy="8" r="3"/><circle cx="17" cy="9" r="2.5"/><path d="M3 20c0-3.3 2.7-6 6-6s6 2.7 6 6"/><path d="M15 14.5c2.8 0 5 2.2 5 5"/></svg></span><h3>Estáis al principio</h3><p>La primera sesión es con vosotros.</p></li>
<li><span class="acc-mk" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg></span><h3>Sus sesiones son suyas</h3><p>Confidenciales, salvo que esté en peligro.</p></li>
<li><span class="acc-mk" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5"/><path d="M9 13h6M9 17h4"/></svg></span><h3>Datos, no opiniones</h3><p>Plan y comparativa por escrito.</p></li>
<li><span class="acc-mk" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 3l8 3v6c0 4.5-3.4 8.3-8 9-4.6-.7-8-4.5-8-9V6z"/><path d="M9 12l2 2 4-4"/></svg></span><h3>Nadie cobra por recomendar</h3><p>Cero comisiones de universidades ni centros.</p></li>
</ul>
<a class="boton" href="#planes">Ver planes</a>
</div></section>

<section id="coaches" aria-labelledby="t-co"><div class="acc-head"><h2 id="t-co">Elige a <em class="acc-hl">tu coach</em></h2><p>Cada uno se presenta en un vídeo de un minuto.</p></div>
<ul class="acc-co"><li class="acc-cl"><div class="acc-fo" aria-hidden="true">L</div><div class="acc-pie"><h3>Laura, 38</h3><p>Pedagoga · FP y salidas técnicas</p><button type="button" aria-label="Ver el vídeo de Laura, 1 minuto"><svg width="10" height="12" viewBox="0 0 12 14" aria-hidden="true"><path d="M1.5 1.2l9 5.8-9 5.8z" fill="currentColor"/></svg>1 min</button></div></li><li class="acc-cl"><div class="acc-fo" aria-hidden="true">M</div><div class="acc-pie"><h3>Marc, 41</h3><p>Educador social · Dudas y miedo a equivocarse</p><button type="button" aria-label="Ver el vídeo de Marc, 1 minuto"><svg width="10" height="12" viewBox="0 0 12 14" aria-hidden="true"><path d="M1.5 1.2l9 5.8-9 5.8z" fill="currentColor"/></svg>1 min</button></div></li><li class="acc-cl"><div class="acc-fo" aria-hidden="true">N</div><div class="acc-pie"><h3>Nuria, 35</h3><p>Orientadora · Universidad y notas de corte</p><button type="button" aria-label="Ver el vídeo de Nuria, 1 minuto"><svg width="10" height="12" viewBox="0 0 12 14" aria-hidden="true"><path d="M1.5 1.2l9 5.8-9 5.8z" fill="currentColor"/></svg>1 min</button></div></li><li class="acc-cl"><div class="acc-fo" aria-hidden="true">Á</div><div class="acc-pie"><h3>Álex, 33</h3><p>Coach · Estudios creativos</p><button type="button" aria-label="Ver el vídeo de Álex, 1 minuto"><svg width="10" height="12" viewBox="0 0 12 14" aria-hidden="true"><path d="M1.5 1.2l9 5.8-9 5.8z" fill="currentColor"/></svg>1 min</button></div></li></ul>
<ul class="acc-badges" aria-label="Cómo los elegimos"><li>Mínimo 5 años de experiencia</li><li>Verificados</li><li>Saben cuándo derivar a un psicólogo</li></ul></section>

<section id="faq" aria-labelledby="t-faq"><div class="acc-fq"><div><h2 id="t-faq">Preguntas <em class="acc-hl">frecuentes</em></h2>
<div class="acc-card acc-contact"><p>¿Otra duda?<span>Escríbenos y te respondemos.</span></p><a class="boton boton--contorno-oscuro" href="#">Escríbenos</a></div></div>
<div class="acc-faq"><details open><summary>¿Tengo que hacer el test antes?</summary><p>Sí. El coach parte de tus 3 caminos, así no empezáis de cero. El test es gratis.</p></details><details><summary>¿Me vais a decir qué estudiar?</summary><p>No. Te ayudamos a comparar con datos y la decisión es tuya.</p></details><details><summary>¿Mis padres se enteran de lo que hablo?</summary><p>No. Están al principio, pero tus sesiones son confidenciales, salvo que estés en peligro.</p></details><details><summary>¿Qué plan me conviene?</summary><p>Una duda concreta: «Resolver dudas». Varias opciones: «Comparar caminos». Tienes que elegir pronto: «Decidir con calma».</p></details><details><summary>¿Por qué pagar si hay orientador en el instituto?</summary><p>El orientador atiende a muchos alumnos a la vez. Aquí las sesiones son solo para tu hijo o hija y acaban con un plan concreto. Es un complemento, no un sustituto.</p></details><details><summary>¿Y si no puedo ir a una sesión?</summary><p>Avisas con antelación y buscáis otro día.</p></details></div></div></section>

<section class="acc-end" aria-labelledby="t-end"><div class="acc-endg"><div>
<h2 id="t-end">¿Aún no tienes <em class="acc-hl">tus 3 caminos</em>?</h2>
<p class="acc-sub">El test es gratis. Después decides si quieres un coach.</p>
<div class="acc-ctas"><a class="boton" href={CTA_PRINCIPAL.href}>Hacer el test gratis</a><a class="boton boton--contorno-oscuro" href="#planes">Ver planes</a></div></div>
<div class="acc-tel" aria-hidden="true">
<AppPantalla pantalla="caminos" nombre="Lucía" iconos />
<div class="acc-noti"><i>N</i><span><small>NextYou · ahora</small><b>Tus 3 caminos están listos</b></span></div>
</div>
</div></section>

</div>
  </main>

  <div class="acc-stick" id="acc-stick" aria-hidden="true"><p><b>Desde 49 €</b></p><a class="boton" href="#planes" tabindex="-1">Ver planes</a></div>

  <script type="application/ld+json" set:html={JSON.stringify(faq)} />
</V5>

<style is:global>
.acc a:focus-visible, .acc button:focus-visible, .acc summary:focus-visible, .acc [tabindex]:focus-visible{outline:2px solid var(--ink);outline-offset:3px}
.acc summary:focus{outline:none}
.acc .acc-ey{font-weight:700;font-size:14px;letter-spacing:.14em;text-transform:uppercase;margin:0 0 12px;color:var(--g)}
.acc h1{font-size:clamp(38px,5vw,64px);line-height:1.03;letter-spacing:-.035em;margin:0 0 18px;max-width:16ch;text-wrap:balance}
.acc h2{font-size:clamp(30px,3.6vw,46px);line-height:1.06;letter-spacing:-.03em;margin:0;text-wrap:balance}
.acc .acc-hl{font-style:normal;background:var(--a);padding:0 .14em;border-radius:8px;-webkit-box-decoration-break:clone;box-decoration-break:clone}
.acc .acc-sub{color:var(--g);font-size:19px;max-width:38ch;margin:0 0 26px}
.acc section{padding:72px 0}
.acc .acc-head{display:flex;justify-content:space-between;align-items:flex-end;gap:20px;margin-bottom:30px;flex-wrap:wrap}
.acc .acc-head p{margin:0;color:var(--g);font-size:16.5px;max-width:42ch}
.acc .acc-card{background:var(--w);border:1px solid var(--l);border-radius:22px;padding:24px}
.acc .acc-mk{width:44px;height:44px;border-radius:13px;background:var(--a);display:grid;place-items:center;flex:none}
.acc .acc-mk svg, .acc .acc-mi svg{width:22px;height:22px;fill:none;stroke:var(--ink);stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
.acc .acc-hero{padding:56px 0 72px;display:grid;grid-template-columns:1.2fr 1fr;gap:56px;align-items:center}
.acc .acc-hero h1{font-size:clamp(36px,4.4vw,56px);max-width:13ch;margin-bottom:16px}
.acc .acc-hero .acc-sub{font-size:18px;margin-bottom:28px}
.acc .acc-tl{display:inline-flex;align-items:center;gap:6px;min-height:48px;padding:0 6px;color:var(--ink);font-weight:700;text-decoration:underline;text-underline-offset:4px;text-decoration-thickness:1.5px}
.acc .acc-tl span{transition:transform .2s}
.acc .acc-tl:hover span{transform:translateX(3px)}
.acc .acc-hero .acc-ctas{align-items:center;gap:12px 22px}
.acc .acc-meta{margin:18px 0 0;color:var(--g);font-size:14.5px}
.acc .acc-chat{margin:0;background:var(--w);border:1px solid var(--l);border-radius:24px;padding:22px;box-shadow:0 30px 60px -40px #16141266;max-width:420px;justify-self:end}
.acc .acc-chat p.acc-m{margin:0 0 10px;padding:12px 16px;border-radius:16px;max-width:88%;font-size:15px}
.acc .acc-chat .acc-y{background:#f1eee6;color:var(--ink)}
.acc .acc-chat .acc-k{background:var(--a);color:var(--ink);margin-left:auto;font-weight:600;margin-bottom:0}
.acc .acc-chat figcaption{margin-top:14px;color:var(--g);font-size:14px;text-align:center}
.acc .acc-sit{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin:0;padding:0;list-style:none}
.acc .acc-sit li{background:var(--w);border-radius:22px;padding:26px 24px;font-size:clamp(19px,1.9vw,23px);font-weight:800;line-height:1.25;letter-spacing:-.01em;position:relative;border:1px solid var(--l)}
.acc .acc-sit li:before{content:"\201C";display:grid;place-items:center;width:38px;height:38px;border-radius:50%;background:var(--a);font-size:30px;line-height:1;padding-top:12px;box-sizing:border-box;margin-bottom:14px;font-family:Georgia,serif}
.acc .acc-steps{display:grid;grid-template-columns:repeat(4,1fr);gap:22px;margin:0;padding:0;list-style:none;position:relative}
.acc .acc-steps:before{content:"";position:absolute;left:22px;right:22px;top:21px;height:2px;background:var(--ink);opacity:.15}
.acc .acc-steps li{position:relative}
.acc .acc-steps .acc-mk{position:relative;z-index:1;box-shadow:0 0 0 6px var(--bg)}
.acc .acc-steps h3{margin:16px 0 4px;font-size:18px}
.acc .acc-steps p{margin:0;color:var(--g);font-size:15px}
.acc .acc-note{margin:26px 0 0;font-size:15px;color:var(--g)}
.acc .acc-note b{color:var(--ink)}
.acc .acc-plans{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;align-items:stretch}
.acc .acc-plan{display:flex;flex-direction:column;position:relative;padding:28px}
.acc .acc-plan.acc-rec{background:var(--ink);color:var(--bg);border-color:var(--ink)}
.acc .acc-tag{position:absolute;top:-13px;left:26px;background:var(--a);color:var(--ink);font-size:14px;font-weight:800;padding:5px 12px;border-radius:99px}
.acc .acc-plan h3{font-size:21px;margin:0 0 4px}
.acc .acc-plan .acc-for{color:var(--g);font-size:15px;margin:0 0 20px}
.acc .acc-plan.acc-rec .acc-for{color:#b8b0a3}
.acc .acc-pr{font-size:52px;font-weight:900;letter-spacing:-.04em;line-height:1;margin:0}
.acc .acc-pr small{font-size:14px;font-weight:600;color:var(--g);letter-spacing:0;margin-left:6px}
.acc .acc-plan.acc-rec .acc-pr small{color:#b8b0a3}
.acc .acc-per{font-size:14px;color:var(--g);margin:8px 0 18px}
.acc .acc-plan.acc-rec .acc-per{color:#b8b0a3}
.acc .acc-li{list-style:none;margin:0 0 24px;padding:0;flex:1}
.acc .acc-li li{position:relative;padding:9px 0 9px 28px;border-top:1px solid var(--l);font-size:15.5px}
.acc .acc-plan.acc-rec .acc-li li{border-color:#f6f1e81a}
.acc .acc-li li:before{content:"";position:absolute;left:2px;top:15px;width:12px;height:7px;border-left:2px solid currentColor;border-bottom:2px solid currentColor;transform:rotate(-45deg)}
.acc .acc-plan.acc-rec .acc-li li:before{border-color:var(--a)}
.acc .acc-plan.acc-rec .boton{background:var(--a);border-color:var(--a);color:var(--ink)}
.acc .acc-book{display:flex;align-items:center;justify-content:center;gap:10px 14px;flex-wrap:wrap;margin:26px 0 0;padding:0;list-style:none}
.acc .acc-book li{display:flex;align-items:center;gap:10px;font-weight:700;font-size:15px}
.acc .acc-book .acc-mi{width:36px;height:36px;border-radius:11px;background:var(--w);border:1px solid var(--l);display:grid;place-items:center}
.acc .acc-book .acc-mi svg{width:18px;height:18px}
.acc .acc-book .acc-ar{color:var(--g);font-weight:400}
.acc .acc-small{color:var(--g);font-size:14px;margin:14px 0 0;text-align:center}
.acc .acc-fam{background:var(--ink);color:var(--bg);border-radius:30px;padding:48px}
.acc .acc-fam .acc-ey{color:#b8b0a3}
.acc .acc-fam .acc-head p{color:#d9d2c6}
.acc .acc-fg{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin:0;padding:0;list-style:none}
.acc .acc-fg li{background:#f6f1e80f;border:1px solid #f6f1e81f;border-radius:20px;padding:22px}
.acc .acc-fg h3{margin:14px 0 4px;font-size:17px}
.acc .acc-fg p{margin:0;color:#d9d2c6;font-size:15px}
.acc .acc-fam .boton{background:var(--a);border-color:var(--a);color:var(--ink);margin-top:26px}
.acc .acc-co{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin:0;padding:0;list-style:none}
.acc .acc-cl{position:relative;aspect-ratio:4/5;border-radius:22px;overflow:hidden;background:linear-gradient(170deg,#3a342c,#1f1b17);color:var(--bg)}
.acc .acc-cl:after{content:"";position:absolute;inset:0;background:linear-gradient(#0000 40%,#00000073 58%,#000000eb);pointer-events:none}
.acc .acc-cl .acc-fo{position:absolute;top:34%;left:50%;translate:-50% -50%;font-size:110px;font-weight:800;color:#f6f1e814;line-height:1}
.acc .acc-cl .acc-pie{position:absolute;left:16px;right:16px;bottom:16px;z-index:1;display:flex;flex-direction:column;align-items:flex-start}
.acc .acc-cl h3{margin:0;font-size:22px;font-weight:800;letter-spacing:-.02em}
.acc .acc-cl p{margin:4px 0 0;font-size:14px;color:#e8e2d8;min-height:2.7em}
.acc .acc-cl button{display:inline-flex;align-items:center;gap:7px;margin-top:10px;background:var(--a);color:var(--ink);font:700 14px 'Archivo',sans-serif;border:0;border-radius:99px;padding:8px 16px;min-height:44px;cursor:pointer}
.acc .acc-cl button:after{content:"";position:absolute;inset:0}
.acc .acc-badges{display:flex;flex-wrap:wrap;gap:8px;margin:20px 0 0;padding:0;list-style:none}
.acc .acc-badges li{display:flex;align-items:center;gap:8px;font-size:14.5px;font-weight:700;background:var(--w);border:1px solid var(--l);border-radius:99px;padding:8px 14px}
.acc .acc-badges li:before{content:"";width:8px;height:8px;border-radius:50%;background:var(--a);box-shadow:0 0 0 1.5px var(--ink)}
.acc .acc-fq{display:grid;grid-template-columns:1fr 1.4fr;gap:40px;align-items:start}
.acc .acc-faq details{border-top:1px solid var(--l)}
.acc .acc-faq details:last-child{border-bottom:1px solid var(--l)}
.acc .acc-faq summary{cursor:pointer;font-weight:700;font-size:17px;list-style:none;display:flex;justify-content:space-between;align-items:center;gap:16px;padding:16px 0;min-height:54px}
.acc .acc-faq summary::-webkit-details-marker{display:none}
.acc .acc-faq summary:after{content:"+";font-size:24px;line-height:1;flex:none;transition:transform .2s}
.acc .acc-faq details[open] summary:after{transform:rotate(45deg)}
.acc .acc-faq details p{color:var(--g);margin:0 0 18px;max-width:58ch}
.acc .acc-contact{margin-top:22px;display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap}
.acc .acc-contact p{margin:0;font-weight:700}
.acc .acc-contact span{display:block;font-weight:400;color:var(--g);font-size:14.5px}
.acc .acc-endg{display:grid;grid-template-columns:1.2fr 1fr;gap:40px;align-items:center}
.acc .acc-end .acc-sub{margin:14px 0 24px}
html.acc-js .acc .acc-rv{opacity:0;transform:translateY(18px);transition:opacity .6s ease,transform .6s cubic-bezier(.2,.7,.2,1)}
html.acc-js .acc .acc-rv.acc-in{opacity:1;transform:none}
@media(max-width:900px){
.acc .acc-hero, .acc .acc-endg, .acc .acc-fq{grid-template-columns:1fr}
.acc .acc-hero{gap:30px;padding-top:24px}
.acc .acc-plans{grid-template-columns:1fr;gap:24px}
.acc .acc-plan.acc-rec{order:-1}
.acc .acc-fg, .acc .acc-co{grid-template-columns:1fr 1fr}
.acc .acc-steps{grid-template-columns:1fr 1fr}
.acc .acc-steps:before{display:none}
.acc section{padding:52px 0}
.acc .acc-fam{padding:32px 22px;border-radius:24px}
}
@media(max-width:620px){
.acc .acc-ctas .boton{flex:1}
.acc .acc-sit, .acc .acc-fg{display:grid;grid-auto-flow:column;grid-template-columns:none;grid-auto-columns:80%;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none;margin-right:-16px;padding-right:16px}
.acc .acc-sit::-webkit-scrollbar, .acc .acc-fg::-webkit-scrollbar{display:none}
.acc .acc-sit li, .acc .acc-fg li{scroll-snap-align:start}
.acc .acc-fg{margin-right:-22px;padding-right:22px}
.acc .acc-steps{grid-template-columns:1fr;gap:18px}
.acc .acc-steps li{display:grid;grid-template-columns:44px 1fr;gap:0 14px}
.acc .acc-steps h3{margin:0 0 2px}
.acc .acc-steps .acc-mk{grid-row:span 2}
.acc .acc-co{gap:10px}
.acc .acc-cl h3{font-size:18px}
.acc .acc-cl p{font-size:14px}
.acc .acc-cl .acc-pie{left:12px;right:12px;bottom:12px}
.acc .acc-book .acc-ar{display:none}
.acc .acc-book{justify-content:flex-start}
}

/* ---------- Ajustes a la web: tokens, tipografía, botones, teléfono y barra fija ---------- */
.acc{--bg:#f6f1e8;--bg2:#ebe4d7;--ink:#161412;--g:#5f574e;--l:#1614121f;--a:#c8f53b;--w:#fff;
  background:var(--bg);color:var(--ink);font-family:var(--sans);line-height:1.5;overflow-x:clip}
.acc h1,.acc h2,.acc h3{font-family:var(--titular);font-weight:800;font-stretch:100%;color:var(--ink)}
.acc h3{font-size:inherit}
.acc p{color:inherit}
.acc .acc-sub,.acc .acc-head p,.acc .acc-meta,.acc .acc-small,.acc .acc-note,.acc .acc-for,.acc .acc-per,.acc .acc-steps p{color:var(--g)}
.acc .acc-steps h3{font-size:18px}
.acc .acc-plan h3{font-size:21px}
.acc .acc-fg h3{font-size:17px}
.acc .acc-note b{color:var(--ink)}
.acc .acc-rec .acc-for,.acc .acc-rec .acc-per,.acc .acc-rec .acc-pr small{color:#b8b0a3}
.acc .acc-rec,.acc .acc-rec h3,.acc .acc-rec .acc-pr{color:var(--bg)}
.acc .acc-fam,.acc .acc-fam h2,.acc .acc-fam h3{color:var(--bg)}
.acc .acc-fam .acc-fg p,.acc .acc-fam .acc-head p{color:#d9d2c6}
.acc .acc-fam .acc-ey{color:#b8b0a3}
.acc .acc-fam .acc-hl{color:var(--ink)}
.acc .acc-cl,.acc .acc-cl h3{color:var(--bg)}
.acc .acc-cl h3{font-size:22px}
.acc .acc-cl p{color:#e8e2d8}
.acc .acc-tl:hover{color:var(--ink)}
.acc .acc-ctas{display:flex;flex-wrap:wrap}
.acc .acc-hero .acc-ctas{align-items:center;gap:12px 22px}
.acc .acc-end .acc-sub{margin:14px 0 24px}
.acc .acc-faq summary{color:var(--ink)}
.acc .acc-faq details p{color:var(--g)}
.acc .acc-contact span{display:block;font-weight:400;color:var(--g);font-size:14.5px}
.acc .acc-contact p{margin:0;font-weight:700}
.acc .acc-badges li{color:var(--ink)}
.acc .acc-book li{color:var(--ink)}
.acc .acc-book .acc-ar{color:var(--g)}
.acc .acc-cl button{color:var(--ink)}
.acc section{scroll-margin-top:5rem}
.acc .acc-faq summary{margin:0}
.acc .boton{min-height:48px;padding:14px 24px;font-weight:800;font-size:15.5px;justify-content:center}
.acc .acc-plan .boton{width:100%}
.acc .acc-plan.acc-rec .boton{background:var(--a);color:var(--ink)}
.acc .acc-fam .boton{margin-top:26px}
.acc .boton--contorno-oscuro{border-color:var(--ink);color:var(--ink)}
.acc .boton--contorno-oscuro:hover{background:var(--ink);color:var(--bg)}
.acc .boton--oscuro{background:var(--ink);color:var(--bg)}
.acc a:focus-visible,.acc button:focus-visible,.acc summary:focus-visible,.acc [tabindex]:focus-visible{outline:2px solid var(--ink);outline-offset:3px}
.acc .acc-rec a:focus-visible,.acc .acc-fam a:focus-visible,.acc .acc-cl button:focus-visible{outline-color:var(--a)}
.acc .acc-faq summary{list-style:none}

/* Teléfono del cierre: la pantalla «Tus 3 caminos» de la home, con iconos */
.acc .acc-tel{position:relative;justify-self:center;width:290px;height:600px;border-radius:46px;background:#121212;padding:9px;box-shadow:inset 0 0 0 1.5px #2e2e2e,0 40px 70px -40px #000}
.acc .acc-tel .cfa-pan{width:100%;height:100%}
.acc .acc-noti{position:absolute;z-index:6;bottom:84px;left:-64px;display:flex;gap:9px;align-items:center;width:max-content;max-width:220px;padding:9px 13px 9px 9px;border-radius:16px;background:#fff;color:#141414;box-shadow:0 18px 36px -18px rgb(0 0 0 / .5),0 0 0 1px rgb(0 0 0 / .05)}
.acc .acc-noti>i{flex:none;width:34px;height:34px;border-radius:11px;background:#c8f53b;display:grid;place-items:center;font:900 16px/1 var(--titular);font-style:normal}
