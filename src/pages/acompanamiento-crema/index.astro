/* Tarjetas de coach: sin foto, con inicial */
.acc .acc-cl .acc-fo{color:#f6f1e814}

/* Barra fija en móvil */
.acc-stick{position:fixed;left:0;right:0;bottom:0;z-index:30;display:none;align-items:center;justify-content:space-between;gap:12px;background:#161412f2;color:#f6f1e8;padding:12px max(16px,env(safe-area-inset-left,0px)) calc(12px + env(safe-area-inset-bottom,0px));transform:translateY(110%);transition:transform .25s}
.acc-stick.acc-on{transform:none}
.acc-stick p{margin:0;font-size:15px;color:#d9d2c6}
.acc-stick b{color:#f6f1e8}
.acc-stick .boton{min-height:44px;padding:10px 18px;font-size:15px}
@media (max-width:900px){.acc-stick{display:flex}}
@media (prefers-reduced-motion:reduce){html.acc-js .acc .acc-rv{opacity:1;transform:none;transition:none}.acc-stick{transition:none}}
@media (max-width:620px){.acc .acc-ctas .boton{flex:1 1 100%}}
</style>

<script>
  // Entrada suave de los bloques
  (function () {
    if (!('IntersectionObserver' in window) || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    document.documentElement.classList.add('acc-js');
    var els = document.querySelectorAll('.acc section > .acc-head, .acc .acc-steps li, .acc .acc-plans > article, .acc .acc-fam, .acc .acc-co > li, .acc .acc-faq, .acc .acc-endg > *');
    els.forEach(function (e, i) { e.classList.add('acc-rv'); (e as HTMLElement).style.transitionDelay = (i % 4) * 70 + 'ms'; });
    var io = new IntersectionObserver(function (en) {
      en.forEach(function (x) { if (x.isIntersecting) { x.target.classList.add('acc-in'); io.unobserve(x.target); } });
    }, { rootMargin: '0px 0px -8% 0px' });
    els.forEach(function (e) { io.observe(e); });
  })();
  // Barra fija «Desde 49 €»: visible tras el hero, oculta en planes y en el pie
  (function () {
    var s = document.getElementById('acc-stick'), h = document.querySelector('.acc-hero'), p = document.getElementById('planes'), f = document.querySelector('.pie, footer');
    if (!s || !h || !p || !('IntersectionObserver' in window)) return;
    var vis = { h: true, p: false, f: false };
    function u() { s.classList.toggle('acc-on', !vis.h && !vis.p && !vis.f); }
    var o = new IntersectionObserver(function (e) {
      e.forEach(function (x) { if (x.target === h) vis.h = x.isIntersecting; if (x.target === p) vis.p = x.isIntersecting; if (x.target === f) vis.f = x.isIntersecting; });
      u();
    });
    o.observe(h); o.observe(p); if (f) o.observe(f);
  })();
</script>
