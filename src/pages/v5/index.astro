        .collage { height: 26rem; }
        .pol { width: 13rem; }
        .sello { width: 7.5rem; height: 7.5rem; font-size: 1.3rem; }
      }

      /* ---------- Bifurcación a universidad ---------- */
      .bifurca { background: var(--negro); border-top: 1px solid var(--linea); border-bottom: 1px solid var(--linea); }
      .bifurca__enlace { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.5rem 1.5rem; min-height: 64px; padding-block: 1rem; text-decoration: none; font-size: var(--t2); color: var(--crema); }
      .bifurca__enlace strong { color: var(--acento-texto); font-weight: 800; white-space: nowrap; }
      .bifurca__enlace:hover strong { text-decoration: underline; text-underline-offset: 0.2em; }

      /* ---------- No eres el único ---------- */
      .unico .cabecera { margin-bottom: clamp(2.5rem, 2rem + 2vw, 4.5rem); }
      /* Título en una o dos líneas: más ancho y, en móvil, algo más pequeño */
      .unico .cabecera--centro .titular--unico { max-width: 30ch !important; margin-inline: auto; font-size: clamp(1.5rem, 0.95rem + 2.5vw, 3.5rem); text-wrap: balance; }
      .unico__lista { display: grid; grid-auto-flow: column; grid-auto-columns: 80%; gap: 0.875rem; overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding-inline: var(--margen); margin-inline: calc(-1 * var(--margen)); padding-inline: var(--margen); padding-block: 1.25rem 2rem; scrollbar-width: none; }
      .unico__lista::-webkit-scrollbar { display: none; }
      .unico__lista .tarjeta { scroll-snap-align: start; }
      .tarjeta { position: relative; display: grid; grid-template-rows: auto 1fr; border-radius: 6px; background: var(--crema); color: var(--negro); padding: 0.625rem 0.625rem 0; box-shadow: 0 18px 30px -18px rgb(0 0 0 / 0.7); }
  .tarjeta__enlace { justify-self: start; margin-top: 0.25rem; font-size: var(--t1); font-weight: 800; color: var(--negro); text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 0.2em; }
  .tarjeta__enlace::after { content: ''; position: absolute; inset: 0; z-index: 2; }
  .tarjeta::before { content: ''; position: absolute; z-index: 1; top: -10px; left: 50%; width: 76px; height: 22px; translate: -50% 0; rotate: -3deg; background: var(--acento); opacity: 0.85; }
  .tarjeta:nth-child(odd) { rotate: -1.2deg; }
  .tarjeta:nth-child(even) { rotate: 1.2deg; }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .tarjeta { transition: rotate 300ms cubic-bezier(.2,.7,.2,1), translate 300ms cubic-bezier(.2,.7,.2,1), box-shadow 300ms ease; }
    .tarjeta:hover { rotate: 0deg; translate: 0 -6px; box-shadow: 0 28px 40px -20px rgb(0 0 0 / 0.75); }
  }
  .tarjeta__foto { border-radius: 3px; }
  .tarjeta__firma { color: var(--gris-oscuro) !important; }
      .tarjeta__foto { width: 100%; aspect-ratio: 8 / 7; object-fit: cover; }
      .tarjeta__texto { display: grid; align-content: start; gap: 0.75rem; padding: 1.25rem 1.25rem 1.5rem; }
      .tarjeta__cita { font-family: var(--titular); font-weight: 800; font-stretch: 105%; font-size: var(--t3); line-height: 1.2; }
      .tarjeta__firma { color: var(--gris); font-size: var(--t1); }
      @media (min-width: 40rem) { .unico__lista { grid-auto-flow: row; grid-template-columns: repeat(2, 1fr); gap: 1.25rem; overflow: visible; margin-inline: 0; padding-inline: 0; padding-block: 0.75rem 0; } }
      @media (min-width: 64rem) { .unico__lista { grid-template-columns: repeat(4, 1fr); } }

      /* ---------- ¿Qué es NextYou? ---------- */
      .que { background: var(--papel); color: var(--negro); }
      /* Paso 2: los tres recorridos como un mapa. «Tú» arriba, carreteras que bajan y señales con icono.
         Un punto recorre la carretera del destino elegido; las otras se suavizan */
      .mapa { position: relative; display: grid; justify-items: center; width: 100%; max-width: 28rem; }
      .mapa__tu { position: relative; z-index: 1; display: grid; place-items: center; width: 3rem; height: 3rem; border-radius: 50%; background: var(--negro); color: var(--crema); font-weight: 800; font-size: var(--t2); box-shadow: 0 0 0 5px color-mix(in srgb, var(--acento) 70%, transparent); }
      .mapa__vias { display: block; width: 100%; height: clamp(7.5rem, 6rem + 4vw, 9.5rem); margin-top: -0.25rem; overflow: visible; }
      .via { transition: opacity 300ms ease; }
      .via path, .mapa__gps { fill: none; vector-effect: non-scaling-stroke; stroke-linecap: round; stroke-linejoin: round; }
      .via__firme { stroke: var(--negro); stroke-width: 14; }
      .via__linea { stroke: var(--crema); stroke-width: 2; stroke-dasharray: 7 9; }
      .via--1 .via__firme { stroke: var(--acento); stroke-width: 18; }
      .via--1 .via__linea { stroke: var(--acento-txt); }
      .via__sendero { stroke: var(--negro); stroke-width: 6; stroke-dasharray: 0.1 11; }
      .mapa__gps--borde { stroke: var(--negro); stroke-width: 16; }
      .mapa__gps--centro { stroke: var(--crema); stroke-width: 8; }
      .mapa[data-sel='1'] :is(.via--2, .via--3), .mapa[data-sel='2'] :is(.via--1, .via--3), .mapa[data-sel='3'] :is(.via--1, .via--2) { opacity: 0.35; }
      .mapa__destinos { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.625rem; width: 100%; margin-top: 0.25rem; }
      /* Señal: cartel con una muesca de flecha arriba, hacia la carretera que llega */
      .senal { position: relative; display: grid; align-content: start; justify-items: center; gap: 0.2rem; padding: 1.1rem 0.5rem 0.75rem; border-radius: 12px; border: 1.5px solid var(--negro); background: var(--papel); color: var(--negro); font: inherit; text-align: center; cursor: pointer; transition: opacity 250ms ease, translate 250ms cubic-bezier(0.23, 1, 0.32, 1); }
      .senal::before { content: ''; position: absolute; top: -11px; left: 50%; translate: -50% 0; width: 20px; height: 20px; rotate: 45deg; background: inherit; border-left: inherit; border-top: inherit; border-radius: 3px; }
      .senal--1 { background: var(--acento); color: var(--acento-txt); box-shadow: 0 16px 28px -16px color-mix(in srgb, var(--acento) 70%, var(--negro)); }
      .senal--3 { border-style: dashed; background: color-mix(in srgb, var(--papel) 70%, #e2d9ca); }
      /* Elegida: sube y lleva doble borde. Las demás, más planas, pero con el texto a contraste completo */
      .senal[aria-pressed='true'] { translate: 0 -4px; box-shadow: 0 0 0 2px var(--papel), 0 0 0 4px var(--negro), 0 14px 24px -16px rgb(22 20 18 / 0.5); }
