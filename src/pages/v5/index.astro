  .nota-mano { color: var(--acento-texto); font-size: var(--t1); font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; }
  .dentro { background: var(--negro-2); }
      /* Sin flechas en ningún tamaño: en móvil se desliza y se ven los puntos; en escritorio caben todas */
      [data-solo-carrusel] { display: none !important; }
      .dentro__nav { display: flex; justify-content: flex-end; align-items: center; gap: 1rem; margin-block: 2rem 1.5rem; }
      .dentro__cuenta { color: var(--gris); font-size: var(--t1); min-width: 3rem; text-align: center; }
      .flecha { display: grid; place-items: center; width: 48px; height: 48px; border-radius: 50%; border: 1.5px solid var(--crema); background: none; color: var(--crema); font-size: var(--t3); cursor: pointer; }
      .flecha:disabled { border-color: var(--linea); color: rgb(246 241 232 / 0.3); cursor: default; }
      .reels { display: grid; grid-auto-flow: column; grid-auto-columns: min(72vw, 17.5rem); gap: 0.875rem; overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding-inline: var(--margen); padding-inline: var(--margen); padding-bottom: 0.5rem; scrollbar-width: none; }
      .reels::-webkit-scrollbar { display: none; }
      .reel { position: relative; aspect-ratio: 9 / 16; border-radius: 22px; overflow: hidden; scroll-snap-align: start; background: var(--tarjeta); box-shadow: 0 24px 40px -24px rgb(0 0 0 / 0.8); }
      .reel__foto { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: scale 500ms cubic-bezier(.2,.7,.2,1); }
      .reel__abrir { position: absolute; inset: 0; z-index: 3; border: 0; background: none; color: var(--crema); cursor: pointer; border-radius: inherit; }
      .reel__abrir:focus-visible { outline: 3px solid var(--acento-texto); outline-offset: -3px; }
