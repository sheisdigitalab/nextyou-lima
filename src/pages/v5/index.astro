        .senal__tipo { font-size: 0.625rem; letter-spacing: 0.05em; }
        .senal__ejemplo { font-size: 0.875rem; hyphens: auto; overflow-wrap: anywhere; }
        .senal__nota { display: none; }
      }
      /* Entrada: las carreteras se dibujan de arriba abajo desde «Tú» y aparecen las señales */
      @media (prefers-reduced-motion: no-preference) {
