      .reel__pie { position: absolute; z-index: 1; left: 1rem; right: 1rem; bottom: 1rem; display: grid; justify-items: start; gap: 0.25rem; }
      .reel__nombre { font-family: var(--titular); font-weight: 800; font-stretch: 105%; font-size: var(--t4); letter-spacing: -0.02em; line-height: 1.05; }
      .reel__camino { font-size: var(--t2); font-weight: 600; line-height: 1.35; color: var(--crema); text-shadow: 0 1px 8px rgb(0 0 0 / 0.6); }
      .reel__ver { display: inline-flex; align-items: center; gap: 0.45rem; margin-top: 0.625rem; min-height: 40px; padding: 0.4rem 1rem; border-radius: 999px; background: var(--acento); color: var(--acento-txt); font-weight: 600; font-size: var(--t1); transition: transform 200ms ease; }
