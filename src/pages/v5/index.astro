              <div class="paso3__texto" data-aparece>
                <span class="paso3__n" aria-hidden="true">04</span>
                <h3>{q.pasos[3].titulo}</h3>
                <p class="paso3__lead">{q.pasos[3].texto}</p>
                <p class="paso3__llevas"><strong>Te llevas:</strong> {q.pasos[3].llevas}</p>
                <span class="pastilla pastilla--contorno">opción premium</span>
                <Fragment set:html="<!-- PENDIENTE CLIENTA: duración y frecuencia de las sesiones -->" />
                <Fragment set:html="<!-- PENDIENTE CLIENTA: precio del acompañamiento con coach -->" />
              </div>
              <div class="paso3__visual" data-aparece>
                <Fragment set:html="<!-- PLACEHOLDER: coach de muestra. PENDIENTE: foto real del coach -->" />
                <div class="llamada" aria-hidden="true">
                  <div class="llamada__barra"><span class="llamada__punto"></span>Sesión online con tu coach</div>
                  <div class="llamada__video">
                    <svg class="llamada__silueta" viewBox="0 0 200 170"><circle cx="100" cy="66" r="36" /><path d="M24 170c0-46 34-72 76-72s76 26 76 72z" /></svg>
                    <span class="llamada__nombre">{q.pasos[3].coach!.nombre} · coach</span>
                    <span class="llamada__tu">Tú</span>
                  </div>
                  <p class="llamada__burbuja">«{q.pasos[3].coach!.pregunta}»</p>
                  <div class="llamada__reto"><span>Reto para probar</span><strong>{q.pasos[3].coach!.reto}</strong></div>
                  <div class="llamada__controles">
                    <span><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="9" y="3" width="6" height="11" rx="3" /><path d="M5 11a7 7 0 0 0 14 0M12 18v3" /></svg></span>
                    <span><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"><rect x="3" y="6" width="13" height="12" rx="2" /><path d="M16 10l5-3v10l-5-3z" /></svg></span>
                    <span class="llamada__colgar"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M3 14.5c5-4.6 13-4.6 18 0l-2.4 2.4-3.3-1.6v-2.2a10 10 0 0 0-6.6 0v2.2l-3.3 1.6z" /></svg></span>
                  </div>
                </div>
