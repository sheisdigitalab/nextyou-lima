---
// Versión 5: una sola landing. Universidad y familias son bloques de esta página (antes, páginas en la v4).
// Versión 4 de la home (a partir de la v3). Antes, versión 3: identidad de la versión 1 (logo, Archivo, negro cálido y lima, detalles a mano)
// con la estructura de la versión 2 (comentarios de Sara, SEO, demo, vídeos, familias).
// Página independiente, con su propio estilo: no usa global.css ni los componentes de la v1.
// Los textos salen de src/data/home.ts, los mismos que la v1. Personas y fotos DE MUESTRA.
import { Image, Picture, getImage } from 'astro:assets';
import V5 from '../../layouts/V5.astro';
import LogoV3 from '../../components/LogoV3.astro';
import { SITIO, BASE, ENLACES, CTA_PRINCIPAL } from '../../config';
import caveat from '../../assets/fonts/caveat.woff2?url';
import { hero, losDeDentro, familias, sara, uniNoUnico, queEsV5 } from '../../data/home';
import { unicoV4 as noEresElUnico, queV5 as q, bifurcacion, historiasUni, testDemo } from '../../data/v4';
import { universidad as uni } from '../../data/universidad';
import { familiasPagina } from '../../data/familias';
const modos = familiasPagina.modos;

const reels = await Promise.all(
  losDeDentro.personas.map(async (p) => ({ ...p, grande: (await getImage({ src: p.foto, width: 900, format: 'webp' })).src }))
);
const insider = reels[0];
const heroGrande = (await getImage({ src: hero.foto, width: 900, format: 'webp' })).src;

// Paso 3 de «Cómo funciona»: entrevistas de ejemplo con gente de «Los de dentro»
// Cromos: personas nuevas (no están en «Los de dentro»). Sin foto todavía: inicial + icono, y póster neutro en el visor
const iconosCromo: Record<string, string> = {
  contenido: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" stroke-linecap="round"><rect x="7" y="2.5" width="10" height="19" rx="2.5"/><circle cx="12" cy="11" r="2.6"/><path d="M10.5 18.5h3"/></svg>',
  animacion: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"><path d="M12 2.5l8.5 4.75v9.5L12 21.5l-8.5-4.75v-9.5z"/><path d="M3.5 7.25L12 12l8.5-4.75M12 12v9.5"/></svg>',
  ciber: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" stroke-linecap="round"><path d="M12 2.5l8 3v6c0 5-3.5 8.5-8 10-4.5-1.5-8-5-8-10v-6z"/><rect x="9" y="10.5" width="6" height="5" rx="1"/><path d="M10 10.5V9a2 2 0 0 1 4 0v1.5"/></svg>',
};
const posterCromo = (inicial: string) => `data:image/svg+xml,${encodeURIComponent(`<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 900 600"><rect width="900" height="600" fill="#24201c"/><text x="450" y="370" font-family="Arial,sans-serif" font-size="260" font-weight="700" fill="#c8f53b" text-anchor="middle">${inicial}</text></svg>`)}`;
const cromos = q.pasos[2].cromos!.map((c, n) => ({
  ...c,
  camino: q.pasos[1].ramas![n].tipo,
  i: undefined as number | undefined,
  r: { edad: c.edad, foto: null as null | ImageMetadata, profesion: c.profesion, cita: c.cita, duracion: c.duracion, grande: posterCromo(c.nombre[0]), video: '', subtitulos: '', camino: c.camino, estudios: c.estudios, primerTrabajo: c.primerTrabajo, martes: c.martes },
}));
// Tambor 3D (móvil): 6 posiciones, cada cromo aparece dos veces
const tambor = [0, 1, 2, 3, 4, 5].map((k) => ({ ...cromos[k % 3], k: k % 3, copia: k >= 3 }));
// «La uni no es el único camino»: trayectorias sin foto (no repiten a nadie de la home)
const trayectorias = historiasUni.personas;

// «¿Qué es NextYou?»: collage de profesiones para probar
const collage = [
  { foto: reels[0].foto, eti: '¿Diseño?' },
  { foto: reels[1].foto, eti: '¿Sonido?' },
  { foto: reels[2].foto, eti: '¿Datos?' },
];

// Vídeo de fondo de la portada (public/videos): una versión para móvil y otra para escritorio
const VIDEO = `${BASE}videos/`;

// Paso 2: icono de cada destino del mapa (mismo orden que las ramas)
const iconosRamas = [
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" stroke-linecap="round"><rect x="3" y="8" width="18" height="12" rx="2"/><path d="M3 8l2.5-4h15L18 8M8 4l-2.5 4M13 4l-2.5 4M18 4l-2.5 4"/></svg>',
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" stroke-linecap="round"><rect x="3" y="4" width="18" height="13" rx="2"/><path d="M12 9l4 7-2-.5-1 2.5z"/></svg>',
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" stroke-linecap="round"><path d="M4 15v-3a8 8 0 0 1 16 0v3"/><rect x="3" y="14" width="4" height="6" rx="1.5"/><rect x="17" y="14" width="4" height="6" rx="1.5"/></svg>',
];

// Demo de «¿Qué es NextYou?»: pastillas de tiempo propias de la v3 y la v4 (las de home.ts las usan la v1 y la v2)
const tiempos = ['8 min · 12 preguntas', 'al momento', 'según tus resultados'];
const UNIVERSIDAD = '#universidad';

// Palabra destacada en cursiva dentro de un titular.
const cursiva = (texto: string, palabra: string) => texto.replace(palabra, `<em>${palabra}</em>`);
---

<V5 titulo={SITIO.titulo} descripcion={SITIO.descripcion} actual="bachillerato" soloBachillerato>
    <main id="contenido">
      <!-- ===================== Portada =====================
           Nada más entrar se entiende qué es: título (h1), una frase y el botón del test.
           De fondo, el vídeo (decorativo). -->
      <section class="hero" aria-labelledby="hero-titulo" data-placeholder="true">
        <!-- Apertura propia: desde «Tú» salen los tres recorridos (carretera lima, carretera crema y sendero)
             y el vídeo se abre en círculo desde ese punto hasta llenar la pantalla -->
        <svg class="hero__rutas hero__rutas--escritorio" viewBox="0 0 1440 900" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
          <g class="ruta ruta--1"><path class="ruta__firme" d="M720 450 C 600 380 520 250 380 200 S 120 120 -40 60" /><path class="ruta__linea" d="M720 450 C 600 380 520 250 380 200 S 120 120 -40 60" /></g>
          <g class="ruta ruta--2"><path class="ruta__firme" d="M720 450 C 860 470 960 380 1100 400 S 1340 470 1480 430" /><path class="ruta__linea" d="M720 450 C 860 470 960 380 1100 400 S 1340 470 1480 430" /></g>
          <g class="ruta ruta--3"><path class="ruta__sendero" d="M720 450 C 700 560 820 640 760 760 S 640 900 700 960" /></g>
        </svg>
        <!-- Trazado en vertical para móvil: las tres rutas salen de «Tú» hacia arriba, a la derecha y hacia abajo -->
        <svg class="hero__rutas hero__rutas--movil" viewBox="0 0 400 800" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
          <g class="ruta ruta--1"><path class="ruta__firme" d="M200 400 C 160 320 60 300 70 200 S 150 60 110 -40" /><path class="ruta__linea" d="M200 400 C 160 320 60 300 70 200 S 150 60 110 -40" /></g>
          <g class="ruta ruta--2"><path class="ruta__firme" d="M200 400 C 260 410 300 360 340 380 S 400 450 440 430" /><path class="ruta__linea" d="M200 400 C 260 410 300 360 340 380 S 400 450 440 430" /></g>
          <g class="ruta ruta--3"><path class="ruta__sendero" d="M200 400 C 190 500 280 560 240 660 S 170 780 210 860" /></g>
        </svg>
        <span class="hero__tu" aria-hidden="true">Tú</span>
        <div class="hero__fondo" aria-hidden="true">
          <picture>
            <source media="(max-width: 47.99rem)" srcset={`${VIDEO}hero-movil-poster.jpg`} />
            <img class="hero__poster" src={`${VIDEO}hero-escritorio-poster.jpg`} alt="" width="1280" height="720" fetchpriority="high" />
          </picture>
          <video class="hero__video" data-hero-video autoplay muted loop playsinline preload="metadata" disablepictureinpicture tabindex="-1">
            <source src={`${VIDEO}hero-movil.mp4`} type="video/mp4" media="(max-width: 47.99rem)" />
            <source src={`${VIDEO}hero-escritorio.mp4`} type="video/mp4" />
          </video>
          <script is:inline>
            // Con «reducir movimiento» no se reproduce: se queda el póster
            (function () {
              var v = document.currentScript.previousElementSibling;
              if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) { v.removeAttribute('autoplay'); v.preload = 'none'; v.pause(); }
            })();
          </script>
        </div>
        <div class="hero__marco ancho">
          <!-- Poco texto: el titular de Elías (opción 2) y una frase con las palabras que busca la gente -->
          <h1 id="hero-titulo" class="hero__titulo">
            <span class="hero__pregunta"><span class="hero__linea">{hero.lema.inicio}</span> <span class="hero__explora">{hero.lema.fin}</span></span>
            <span class="hero__resto">¿No sabes qué estudiar? Haz el <b>test gratis</b> y descubre <b>a qué te podrías dedicar</b>.</span>
          </h1>
          <div class="hero__accion">
            <Fragment set:html="<!-- PENDIENTE: CTA a revisar con la propuesta de Elias (comentario #14) -->" />
            <a href={CTA_PRINCIPAL.href} class="boton boton--grande hero__boton">{hero.boton} <span aria-hidden="true">→</span></a>
          </div>
        </div>
      </section>

      <!-- Universidad y familias: aparcadas para más adelante (fase 1 solo bachillerato). Siguen en /v4/. -->

      <!-- ===================== No eres el único ===================== -->
      <section class="seccion unico" aria-labelledby="unico-titulo">
        <div class="ancho">
          <header class="cabecera cabecera--centro" data-aparece>
            <p class="antetitulo">{noEresElUnico.etiqueta}</p>
            <h2 id="unico-titulo" class="titular titular--unico" set:html={cursiva(noEresElUnico.titulo, noEresElUnico.resaltado)} />
          </header>
          <ul data-aparece class="unico__lista" role="list" aria-label="Testimonios" tabindex="0">
            {
              noEresElUnico.personas.map((p) => (
                <li class:list={['tarjeta', { 'tarjeta--uni': p.universidad }]} data-placeholder="true">
                  <Fragment set:html="<!-- PLACEHOLDER: sustituir por persona real -->" />
                  <Image src={p.foto} alt={p.alt} width={480} height={420} quality={70} class="tarjeta__foto" />
                  <div class="tarjeta__texto">
                    <p class="tarjeta__cita">«{p.cita}»</p>
                    <p class="tarjeta__firma">— {p.nombre}, {p.edad}</p>
                  </div>
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <!-- ===================== ¿Qué es NextYou? =====================
           Qué es, en una idea (titular de Sara, #8) y la tarjeta del test con su botón. -->
      <section id="que-es" class="intro que sobre-claro" aria-labelledby="que-titulo">
        <div class="estrecho quees">
          <h2 id="que-titulo" class="que__pregunta">¿Qué es <span class="que__marca"><LogoV3 clase="logo--grande" /><span class="solo-lector">NextYou</span>?</span></h2>
          <div class="quees__rejilla">
            <div class="quees__texto" data-aparece>
              <p class="quees__lema" set:html={cursiva(queEsV5.lema, queEsV5.resaltado)} />
              <p class="quees__no">{queEsV5.no}</p>
              <p class="quees__si">{queEsV5.si.split(queEsV5.siResaltado)[0]}<span class="quees__pegatina">{queEsV5.siResaltado}</span>{queEsV5.si.split(queEsV5.siResaltado)[1]}</p>
              <a href={CTA_PRINCIPAL.href} class="boton boton--grande quees__boton">{hero.boton} <span aria-hidden="true">→</span></a>
            </div>
            <!-- Collage: profesiones para probar (PLACEHOLDER: fotos de muestra de «Los de dentro», mismo papel) -->
            <div class="collage" aria-hidden="true" data-aparece>
              {collage.map((c, n) => (
                <figure class:list={['pol', `pol--${n + 1}`]}>
                  <Image src={c.foto} alt="" width={420} height={420} quality={65} class="pol__img" />
                  <figcaption>{c.eti}</figcaption>
                </figure>
              ))}
              <span class="sello">¿y si<br />pruebas?</span>
            </div>
          </div>
        </div>
      </section>

      <!-- ===================== Cómo funciona =====================
           Cuatro pasos con el móvil (demo del producto, #9 y #12). Al final, «Lo que no va a pasar» y el botón. -->
      <section id="como-funciona" class="seccion que sobre-claro" aria-labelledby="como-titulo">
        <div class="estrecho">
          <header class="cabecera como__cabecera" data-aparece>
            <h2 id="como-titulo" class="titular">Cómo funciona</h2>
            <p class="como__sub">De no tenerlo claro a saber qué quieres probar, en cuatro pasos.</p>
          </header>

          <!-- Tres pasos, cada uno con su imagen: el test (móvil), los tres caminos (esquema) y el coach (videollamada) -->
          <ol class="pasos3" role="list" aria-label="Cómo funciona, en cuatro pasos">
            <!-- 01 · El test se prueba en la propia página: 3 preguntas de muestra, adelanto del perfil y caminos bloqueados.
                 Móvil: tarjeta oscura sin marco. Escritorio (container query): dentro de una ventana de navegador -->
            <li class="paso3 paso3--test" data-paso={0}>
              <div class="paso3__texto" data-aparece>
                <span class="paso3__n" aria-hidden="true">01</span>
                <h3>{q.pasos[0].titulo}</h3>
                <p class="paso3__lead">{q.pasos[0].texto}</p>
                <p class="tt-prueba"><svg width="34" height="22" viewBox="0 0 34 22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M2 8c9-6 20-6 28 4" /><path d="M24 13l6-1-1-6" /></svg>{q.pasos[0].nota}</p>
                <span class="pastilla">{tiempos[0]}</span>
              </div>
              <div class="tt-marco" data-test>
                <Fragment set:html="<!-- PENDIENTE: dirección real del test -->" />
                <div class="tt-nav" aria-hidden="true"><i></i><i></i><i></i><span class="tt-url">nextyou.academy/<b>test</b></span></div>
                <div class="tt-pant" aria-live="polite">
                  <div class="tt-cab"><span>Brújula interior</span><span class="tt-demo"><span data-test-cnt>1 de 3</span> · muestra</span></div>
                  <div class="tt-barra" aria-hidden="true"><span data-test-barra></span></div>
                  {testDemo.preguntas.map((pr, n) => (
                    <>
                      {pr.placeholder && <Fragment set:html="<!-- PENDIENTE CLIENTA: sustituir por preguntas reales -->" />}
                      <div class="tt-paso" data-test-paso={n} hidden={n > 0} data-placeholder={pr.placeholder ? 'true' : undefined}>
                        <p class="tt-preg" tabindex="-1">{pr.texto}</p>
                        <div class="tt-ops" role="group" aria-label={pr.texto}>
                          {pr.opciones.map((o, v) => (
                            <button type="button" class:list={['tt-op', { 'tt-op--pista': n === 0 && v === 0 }]} data-v={v} aria-pressed="false"><b>{o.t}</b><span>{o.d}</span></button>
                          ))}
                        </div>
                        {n === 0 && <p class="tt-nota">Sin respuestas correctas ni incorrectas. Solo tú.</p>}
                      </div>
                    </>
                  ))}
                  <Fragment set:html="<!-- PLACEHOLDER: textos del resultado pendientes de validar con Sara -->" />
                  <div class="tt-paso tt-res" data-test-paso="3" hidden data-placeholder="true">
                    <p class="tt-res__mini">Adelanto de tu perfil</p>
                    <p class="tt-res__tit" tabindex="-1" data-test-tit></p>
                    <p class="tt-res__frase" data-test-frase></p>
                    <dl class="tt-rasgos">
                      <div><dt>Lo que te mueve</dt><dd data-test-r1></dd></div>
                      <div><dt>Cómo arrancas</dt><dd data-test-r2></dd></div>
                    </dl>
                    <div class="tt-caminos">
                      <p class="tt-caminos__eti">Tus tres caminos</p>
                      <div class="tt-cams" aria-hidden="true">
                        <div class="tt-cam"><i>Lo que más te pega</i><div><b></b><b></b></div></div>
                        <div class="tt-cam"><i>El puente</i><div><b></b><b></b></div></div>
                        <div class="tt-cam"><i>El salto</i><div><b></b><b></b></div></div>
                      </div>
                      <span class="tt-candado"><span aria-hidden="true">🔒</span> Salen con el test completo</span>
                    </div>
                    <a class="tt-cta cta-grande" href={CTA_PRINCIPAL.href} data-abrir-aviso={CTA_PRINCIPAL.href === '#' ? '' : undefined}>Hacer el test completo <span aria-hidden="true">→</span></a>
                  </div>
                  <div class="tt-pie">
                    <button type="button" class="tt-volver" data-test-volver disabled>← Volver</button>
                    <button type="button" class="tt-repetir" data-test-repetir hidden>Volver a probar</button>
                  </div>
                </div>
                <script is:inline type="application/json" data-test-datos set:html={JSON.stringify(testDemo.resultado)} />
              </div>
            </li>
            <li class="paso3" data-paso={1}>
              <div class="paso3__texto" data-aparece>
                <span class="paso3__n" aria-hidden="true">02</span>
                <h3>{q.pasos[1].titulo}</h3>
                <p class="paso3__lead">{q.pasos[1].texto}</p>
                <p class="paso3__llevas"><strong>Te llevas:</strong> {q.pasos[1].llevas}</p>
                <span class="pastilla">{tiempos[1]}</span>
              </div>
              <div class="paso3__visual">
                <!-- Los tres recorridos como un mapa: desde «Tú» (arriba) bajan tres carreteras hasta tres señales.
                     Un punto recorre la carretera del destino elegido (por defecto, «Lo que más te pega»). -->
                <div class="mapa" data-ramas data-sel="1">
                  <span class="mapa__tu" aria-hidden="true">Tú</span>
                  <svg class="mapa__vias" viewBox="0 0 560 330" preserveAspectRatio="none" aria-hidden="true">
                    <g class="via via--3"><path class="via__sendero" data-via="3" d="M280 6 L280 70 C280 170 467 180 467 318" /></g>
                    <g class="via via--2"><path class="via__firme" data-via="2" d="M280 6 L280 70 C280 130 252 180 268 235 S 280 290 280 318" /><path class="via__linea" d="M280 6 L280 70 C280 130 252 180 268 235 S 280 290 280 318" /></g>
                    <g class="via via--1"><path class="via__firme" data-via="1" d="M280 6 L280 70 C280 170 93 180 93 318" /><path class="via__linea" d="M280 6 L280 70 C280 170 93 180 93 318" /></g>
                    <path class="mapa__gps mapa__gps--borde" d="M93 318 l0 0.01" />
                    <path class="mapa__gps mapa__gps--centro" d="M93 318 l0 0.01" />
                  </svg>
                  <div class="mapa__destinos" role="group" aria-label="Ejemplo de tres recorridos: elige uno para ver su camino">
                    {q.pasos[1].ramas!.map((r, i) => (
                      <button type="button" class:list={['senal', `senal--${i + 1}`]} data-ruta={i + 1} aria-pressed={i === 0 ? 'true' : 'false'} style={`--d: ${i}`}>
                        <span class="senal__icono" aria-hidden="true" set:html={iconosRamas[i]} />
                        <span class="senal__tipo">{r.tipo}</span>
                        <strong class="senal__ejemplo">{r.ejemplo}</strong>
                        <span class="senal__nota">{r.nota}</span>
                      </button>
                    ))}
                  </div>
                </div>
              </div>
            </li>
            <li class="paso3" data-paso={2}>
              <div class="paso3__texto" data-aparece>
                <span class="paso3__n" aria-hidden="true">03</span>
                <h3>{q.pasos[2].titulo}</h3>
                <p class="paso3__lead">{q.pasos[2].texto}</p>
                <p class="paso3__llevas"><strong>Te llevas:</strong> {q.pasos[2].llevas}</p>
                <span class="pastilla">{tiempos[2]}</span>
              </div>
              <div class="paso3__visual" data-aparece>
                <!-- Cromos: en móvil, un mazo que se pasa deslizando; en escritorio, un abanico que se reparte al llegar.
                     «Ver su día» abre el mismo visor que «Los de dentro». PLACEHOLDER: personas y consejos de muestra -->
                <div class="cromos" data-cromos>
                  {cromos.map((c, n) => (
                    <article class="cromo" style={`--n: ${n}`} aria-label={`${c.nombre}, ${c.r.edad}, ${c.prof}`}>
                      <div class="cromo__foto">{c.r.foto ? <Image src={c.r.foto} alt="" width={360} height={360} quality={65} class="cromo__img" draggable="false" /> : <div class="foto-hueco" data-k={n}><span class="foto-hueco__ic" set:html={iconosCromo[c.icono]} /><span class="foto-hueco__ini">{c.nombre[0]}</span></div>}</div>
                      <div class="cromo__info">
                        <p class="cromo__cab"><strong>{c.nombre}</strong><span class="cromo__edad">{c.r.edad}</span></p>
                        <p class="cromo__prof">{c.prof}</p>
                        <p class="cromo__consejo"><span>Su consejo</span>{c.consejo}</p>
                        <dl class="cromo__datos"><div><dt>Estudió</dt><dd>{c.estudio}</dd></div><div><dt>Empezó</dt><dd>{c.empezo}</dd></div></dl>
                        <button
                          type="button"
                          class="cromo__ver"
                          data-visor-abrir
                          aria-haspopup="dialog"
                          aria-label={`Ver el día de ${c.nombre}, ${c.r.duracion}`}
                          data-nombre={`${c.nombre}, ${c.r.edad}`}
                          data-profesion={c.r.profesion}
                          data-cita={c.r.cita}
                          data-duracion={c.r.duracion}
                          data-img={c.r.grande}
                          data-video={c.r.video ?? ''}
                          data-subtitulos={c.r.subtitulos ?? ''}
                          data-indice={c.i}
                          data-camino={c.r.camino.join('|')}
                          data-estudios={c.r.estudios}
                          data-trabajo={c.r.primerTrabajo}
                          data-martes={c.r.martes}
                        ><svg width="10" height="12" viewBox="0 0 12 14" aria-hidden="true"><path d="M1.5 1.2l9 5.8-9 5.8z" fill="currentColor" /></svg> Ver su día · {c.r.duracion}</button>
                      </div>
                    </article>
                  ))}
                </div>
                <!-- Móvil: tambor 3D (referencia: exploracion/consejos-cromos-tambor.html).
                     Gira solo al llegar y se para en el primer cromo; luego se arrastra con inercia, con los puntos,
                     con «Siguiente», tocando un cromo de los lados o con las flechas del teclado -->
                <Fragment set:html={`<style>@font-face { font-family: 'Caveat'; font-weight: 400 700; font-display: swap; src: url('${caveat}') format('woff2'); }</style>`} />
                <div class="tambor-bloque">
                  <div class="tambor-cab">
                    <p><span>Tus cromos</span><strong>Uno por recorrido</strong></p>
                    <span class="tambor-cnt" data-tambor-cnt>1 / 3</span>
                  </div>
                  <div class="tambor" data-tambor tabindex="0" role="group" aria-roledescription="carrusel" aria-label="Cromos de quien ya está ahí. Usa las flechas para girar">
                    <div class="tambor__anillo">
                      {tambor.map((c) => (
                        <article class="tcromo" data-k={c.k} aria-hidden={c.copia ? 'true' : undefined} inert={c.copia} aria-label={c.copia ? undefined : `${c.nombre}, ${c.r.edad}, ${c.prof}`}>
                          <div class="tcromo__foto">
                            {c.r.foto ? <Image src={c.r.foto} alt="" width={448} height={448} quality={65} class="tcromo__img" draggable="false" /> : <div class="foto-hueco" data-k={c.k}><span class="foto-hueco__ic" set:html={iconosCromo[c.icono]} /><span class="foto-hueco__ini">{c.nombre[0]}</span></div>}
                            <span class="tcromo__camino">{c.camino}</span>
                            <span class="tcromo__edad">{c.r.edad}</span>
                            <p class="tcromo__nombre"><strong>{c.nombre}</strong><span>{c.prof}</span></p>
                          </div>
                          <p class="tcromo__consejo"><span>Su consejo</span>«{c.consejo}»</p>
                          <button
                            type="button"
                            class="tcromo__ver"
                            data-visor-abrir
                            aria-haspopup="dialog"
                            aria-label={`Ver el día de ${c.nombre}, ${c.r.duracion}`}
                            data-nombre={`${c.nombre}, ${c.r.edad}`}
                            data-profesion={c.r.profesion}
                            data-cita={c.r.cita}
                            data-duracion={c.r.duracion}
                            data-img={c.r.grande}
                            data-video={c.r.video ?? ''}
                            data-subtitulos={c.r.subtitulos ?? ''}
                            data-indice={c.i}
                            data-camino={c.r.camino.join('|')}
                            data-estudios={c.r.estudios}
                            data-trabajo={c.r.primerTrabajo}
                            data-martes={c.r.martes}
                          ><span class="tcromo__play" aria-hidden="true">▶</span>Ver su día · {c.r.duracion}</button>
                        </article>
                      ))}
                    </div>
                  </div>
                  <div class="tambor-pie">
                    <div class="tambor-puntos">
                      {cromos.map((c, n) => <button type="button" data-tambor-ir={n} aria-label={`Ver el cromo de ${c.nombre}`} aria-current={n === 0 ? 'true' : undefined} />)}
                    </div>
                    <span class="tambor-ayuda" aria-hidden="true">Desliza para girar</span>
                    <button type="button" class="tambor-siguiente" data-tambor-siguiente>Siguiente <span aria-hidden="true">→</span></button>
                  </div>
                </div>
              </div>
            </li>
