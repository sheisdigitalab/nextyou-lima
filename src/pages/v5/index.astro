      .visor__datos dd { margin: 0.2rem 0 0; color: rgb(246 241 232 / 0.88); line-height: 1.5; }
      .visor__cta { margin-top: 0.25rem; }
      .visor__nav { display: flex; align-items: center; gap: 0.875rem; margin-top: 0.25rem; }
      .visor__cuenta { font-size: var(--t1); color: var(--gris); min-width: 3rem; text-align: center; }
      .visor__cerrar { position: absolute; z-index: 1; top: 0.75rem; right: 0.75rem; display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%; border: 1px solid var(--linea); background: rgb(0 0 0 / 0.6); color: var(--crema); cursor: pointer; }
