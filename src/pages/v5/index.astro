      .quees__texto { display: grid; justify-items: start; gap: 0.5rem; }
      .quees__lema { font-family: var(--titular); font-weight: 800; font-stretch: 105%; font-size: var(--t4); line-height: 1.2; letter-spacing: -0.015em; max-width: 20ch; text-wrap: balance; margin-bottom: 1.25rem; }
      .quees__no { font-size: var(--t2); color: var(--gris-oscuro); text-decoration: line-through; text-decoration-color: var(--negro); text-decoration-thickness: 2px; }
      .quees__si { font-family: var(--titular); font-weight: 800; font-stretch: 105%; font-size: var(--t4); line-height: 1.3; letter-spacing: -0.015em; text-wrap: balance; max-width: 20ch; }
      .quees__pegatina { display: inline-block; margin-inline: 0.1em; padding: 0 0.3em 0.05em; border-radius: 6px; background: var(--acento); color: var(--acento-txt); font-family: var(--mano); font-weight: 400; font-size: 0.9em; rotate: -3deg; box-shadow: 2px 2px 0 var(--negro); }
      .quees__boton { margin-top: 1.25rem; }
      .quees__boton span { margin-left: 0.4em; }
      /* Collage de polaroids */
      .collage { position: relative; height: 23rem; }
      .pol { position: absolute; width: 9.5rem; margin: 0; padding: 7px 7px 28px; background: #fff; box-shadow: 0 18px 30px -18px rgb(0 0 0 / 0.55); }
      .pol__img { display: block; width: 100%; height: auto; aspect-ratio: 1; object-fit: cover; }
      .pol figcaption { position: absolute; left: 0; right: 0; bottom: 3px; text-align: center; font-family: var(--mano); font-size: 1.05rem; color: var(--negro); }
      .pol--1 { left: 0; top: 1rem; rotate: -8deg; }
      .pol--2 { left: 50%; top: 4rem; translate: -45% 0; rotate: 5deg; z-index: 2; }
      .pol--3 { right: 0; top: 0; rotate: 9deg; }
      .sello { position: absolute; z-index: 3; left: 12%; bottom: 0.75rem; display: grid; place-items: center; width: 6.5rem; height: 6.5rem; border-radius: 50%; background: var(--acento); color: var(--acento-txt); font-family: var(--mano); font-size: 1.15rem; line-height: 1; text-align: center; rotate: -12deg; box-shadow: 4px 4px 0 var(--negro); }
      @media (min-width: 64rem) {
