        /* La frase aparece con un barrido, como un subrayador */
        .reel__gancho span { background: linear-gradient(var(--crema), var(--crema)) no-repeat 0 0 / 100% 100%; transition: background-size 550ms cubic-bezier(.6,0,.2,1), color 200ms ease; transition-delay: calc(var(--i) * 110ms + 550ms), calc(var(--i) * 110ms + 950ms); }
        .js [data-reels]:not(.en-vista) .reel__gancho span { background-size: 0% 100%; color: transparent; }
