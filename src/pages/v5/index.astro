      /* ---------- Los de dentro ---------- */
      .boton--pronto { gap: 0.5rem; cursor: default; opacity: 0.8; }
  .boton--pronto:hover { transform: none; box-shadow: none; filter: none; background: none; color: var(--crema); }
  .boton--pronto small { padding: 0.1rem 0.45rem; border-radius: 999px; border: 1px solid currentColor; font-size: var(--t1); text-transform: none; letter-spacing: 0.04em; }
  .cierre { background: radial-gradient(60% 90% at 50% 100%, color-mix(in srgb, var(--acento) 16%, transparent), transparent 70%), var(--negro); color: var(--crema); padding-block: var(--aire); border-block: 1px solid var(--linea); }
  .cierre__caja { display: grid; justify-items: center; gap: 1.5rem; text-align: center; }
