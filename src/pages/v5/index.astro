          <!-- Lo que no va a pasar: cierre de la sección en un panel propio, con título y botón -->
          <div class="promesa" data-aparece>
            <div class="promesa__texto">
              <h3 class="promesa__titulo">Lo que no va a pasar</h3>
              <ul class="promesa__lista" role="list">
                {q.noVaAPasar.map((t) => (
