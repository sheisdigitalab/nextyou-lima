      .reel::after { content: ''; position: absolute; inset: 0; background: linear-gradient(to bottom, transparent 40%, rgb(0 0 0 / 0.45) 58%, rgb(0 0 0 / 0.92)); }
      /* Frase gancho: texto sobre cajita clara, como los subtítulos de TikTok */
      .reel__gancho { justify-self: start; margin-bottom: 0.75rem; text-align: left; font-family: var(--titular); font-weight: 800; font-stretch: 105%; font-size: var(--t2); line-height: 1.6; letter-spacing: -0.01em; rotate: -2deg; transform-origin: left bottom; }
