---
// Página para madres, padres y tutores, con el estilo de la versión 2.
// Registro más sereno que la home: más fondo crema (lectura cómoda, confianza)
// y bloques en negro cálido para respirar. Textos de src/data/familias.ts, los mismos que la v1.
import V2 from '../../layouts/V2.astro';
import { CTA_PRINCIPAL } from '../../config';
import { familiasPagina as f } from '../../data/familias';

const cursiva = (texto: string, palabra: string) => texto.replace(palabra, `<em>${palabra}</em>`);
const n = (i: number) => String(i + 1).padStart(2, '0');
---

<V2 titulo={f.titulo} descripcion={f.descripcion} actual="familias">
  <main id="contenido" class="fam">
    <!-- ===================== Portada ===================== -->
    <section class="fam-hero sobre-claro" aria-labelledby="fam-titulo">
      <div class="estrecho fam-hero__rejilla">
        <div class="fam-hero__texto" data-aparece>
          <p class="antetitulo antetitulo--claro">{f.hero.etiqueta}</p>
          <h1 id="fam-titulo" set:html={cursiva(f.hero.titulo, f.hero.resaltado)} />
          <p class="fam-lead">{f.hero.texto}</p>
          <div class="fam-hero__acciones">
            <Fragment set:html="<!-- PENDIENTE: destino de los botones (enlace para enviar / hacerlo juntos) -->" />
            <a href={CTA_PRINCIPAL.href} class="boton">{f.hero.principal}</a>
            <a href={CTA_PRINCIPAL.href} class="boton boton--contorno-oscuro">{f.hero.secundario}</a>
          </div>
          <ul class="fam-meta" role="list">
            {f.hero.meta.map((m) => <li class="pastilla">{m}</li>)}
          </ul>
        </div>

        <!-- Muestra de la pantalla en la que el joven elige qué comparte -->
        <figure class="fam-pantalla" aria-labelledby="fam-pantalla-titulo" data-aparece>
          <p id="fam-pantalla-titulo" class="fam-pantalla__titulo">¿Qué quieres compartir?</p>
          <ul class="fam-pantalla__opciones" role="list">
            {f.compartir.niveles.map((nivel, i) => (
              <li class:list={{ sel: i === 1 }}>
                <span class="fam-radio" aria-hidden="true" />
                {nivel.nombre}
              </li>
            ))}
          </ul>
          <figcaption>Ejemplo de la pantalla que ve al terminar. Esto lo decide él o ella.</figcaption>
        </figure>
      </div>
    </section>

    <!-- ===================== Por qué funciona así ===================== -->
    <section class="fam-bloque fam-oscuro" aria-labelledby="fam-porque">
      <div class="estrecho">
        <header class="fam-cabecera" data-aparece>
          <p class="antetitulo">{f.porque.etiqueta}</p>
          <h2 id="fam-porque">{f.porque.titulo}</h2>
          <p class="fam-lead">{f.porque.texto}</p>
        </header>
        <ol class="fam-ideas" role="list">
          {f.porque.ideas.map((idea, i) => (
            <li data-aparece>
              <span class="fam-n" aria-hidden="true">{n(i)}</span>
              <h3>{idea.titulo}</h3>
              <p>{idea.texto}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- ===================== Dos formas de empezar ===================== -->
    <section class="fam-bloque sobre-claro" aria-labelledby="fam-modos">
      <div class="estrecho">
        <header class="fam-cabecera" data-aparece>
          <p class="antetitulo antetitulo--claro">{f.modos.etiqueta}</p>
          <h2 id="fam-modos">{f.modos.titulo}</h2>
        </header>
        <ul class="fam-modos" role="list">
          {f.modos.opciones.map((o) => (
            <li class="fam-modo" data-aparece>
              <h3>{o.nombre}</h3>
              <p>{o.texto}</p>
              <ul class="fam-chips" role="list">
                {o.puntos.map((pt) => <li class="pastilla">{pt}</li>)}
              </ul>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ===================== Qué ves tú y qué no ===================== -->
    <section class="fam-bloque fam-oscuro" aria-labelledby="fam-compartir">
      <div class="estrecho fam-dos">
        <header class="fam-cabecera" data-aparece>
          <p class="antetitulo">{f.compartir.etiqueta}</p>
          <h2 id="fam-compartir">{f.compartir.titulo}</h2>
          <p class="fam-lead">{f.compartir.nota}</p>
        </header>
        <div class="fam-compartir" data-aparece>
          <ol class="fam-niveles" role="list">
            {f.compartir.niveles.map((nivel, i) => (
              <li>
                <span class="fam-n fam-n--peq" aria-hidden="true">{n(i)}</span>
                <div>
                  <h3>{nivel.nombre}</h3>
                  <p>{nivel.texto}</p>
                </div>
              </li>
            ))}
          </ol>
          <div class="fam-nunca">
            <h3>Lo que no vas a ver</h3>
            <ul role="list">
              {f.compartir.nunca.map((t) => (
                <li>
                  <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M2 2l10 10M12 2L2 12" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
                  {t}
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- ===================== La guía para hablarlo ===================== -->
    <section class="fam-bloque sobre-claro" aria-labelledby="fam-guia">
      <div class="estrecho">
        <header class="fam-cabecera" data-aparece>
          <p class="antetitulo antetitulo--claro">{f.guia.etiqueta}</p>
          <h2 id="fam-guia">{f.guia.titulo}</h2>
        </header>
        <ul class="fam-guia" role="list">
          {f.guia.puntos.map((pt) => (
            <li data-aparece>
              <h3>{pt.titulo}</h3>
              <p>{pt.texto}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ===================== Coach ===================== -->
    <section class="fam-bloque fam-oscuro" aria-labelledby="fam-coach">
      <div class="estrecho">
        <header class="fam-cabecera" data-aparece>
          <p class="antetitulo">{f.coach.etiqueta}</p>
          <h2 id="fam-coach">{f.coach.titulo}</h2>
        </header>
        <Fragment set:html="<!-- PENDIENTE: precio del acompañamiento con coach -->" />
        <ol class="fam-pasos" role="list">
          {f.coach.pasos.map((p, i) => (
            <li data-aparece>
              <span class="fam-n" aria-hidden="true">{n(i)}</span>
              <div>
                <h3>{p.titulo}</h3>
                <p>{p.texto}</p>
              </div>
            </li>
          ))}
        </ol>
        <div class="fam-nohace" data-aparece>
          <ul role="list" aria-label="Lo que un coach no hace">
            {f.coach.noHace.map((t) => (
              <li>
                <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M2 2l10 10M12 2L2 12" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
                {t}
              </li>
            ))}
          </ul>
          <p>{f.coach.nota}</p>
        </div>
      </div>
    </section>

    <!-- ===================== Datos ===================== -->
    <section class="fam-bloque sobre-claro fam-datos" aria-labelledby="fam-datos">
      <div class="estrecho fam-dos">
        <header class="fam-cabecera" data-aparece>
          <p class="antetitulo antetitulo--claro">{f.datos.etiqueta}</p>
          <h2 id="fam-datos">{f.datos.titulo}</h2>
        </header>
        <ul class="fam-candados" role="list" data-aparece>
          {f.datos.puntos.map((t) => (
            <li>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="10.5" width="14" height="10" rx="2" /><path d="M8.5 10.5V7.5a3.5 3.5 0 017 0v3" /></svg>
              {t}
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ===================== Preguntas ===================== -->
    <section class="fam-bloque sobre-claro fam-preguntas" aria-labelledby="fam-preguntas">
      <div class="estrecho fam-dos">
        <header class="fam-cabecera" data-aparece>
          <p class="antetitulo antetitulo--claro">{f.preguntas.etiqueta}</p>
          <h2 id="fam-preguntas">{f.preguntas.titulo}</h2>
        </header>
        <div class="fam-faq" data-aparece>
          {f.preguntas.lista.map((item, i) => (
            <details open={i === 0}>
              <summary>{item.p}</summary>
              <p>{item.r}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- ===================== Cierre ===================== -->
    <section class="fam-cierre" aria-labelledby="fam-cierre">
      <div class="estrecho fam-cierre__caja" data-aparece>
        <h2 id="fam-cierre">{f.cierre.titulo}</h2>
        <a href={CTA_PRINCIPAL.href} class="boton boton--grande">{f.cierre.boton}</a>
      </div>
    </section>
  </main>
</V2>

<style is:global>
  .fam-hero { background: var(--papel); color: var(--negro); padding-block: clamp(3rem, 2rem + 4vw, 6rem); }
  .fam-hero__rejilla { display: grid; gap: 3rem; align-items: center; }
  .fam-hero__texto { display: grid; justify-items: start; gap: 1.25rem; }
  .fam-hero h1 { font-family: var(--serif); font-weight: 600; font-size: clamp(2.5rem, 1.5rem + 4vw, 4.5rem); line-height: 1; letter-spacing: -0.03em; max-width: 13ch; text-wrap: balance; }
  .antetitulo--claro { color: var(--gris-oscuro); }
  .fam-lead { font-size: clamp(1.0625rem, 1rem + 0.3vw, 1.25rem); line-height: 1.55; max-width: 36rem; }
  .sobre-claro .fam-lead, .sobre-claro p { color: var(--gris-oscuro); }
  .fam-hero__acciones { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 0.25rem; }
  .fam-meta, .fam-chips { display: flex; flex-wrap: wrap; gap: 0.5rem; }

  .fam-pantalla { justify-self: center; width: min(100%, 24rem); display: grid; gap: 0.625rem; padding: 1.25rem; border-radius: 20px; background: var(--negro); color: var(--crema); box-shadow: 0 30px 50px -30px rgb(0 0 0 / 0.6); rotate: -1.5deg; }
  .fam-pantalla .fam-pantalla__titulo { color: var(--crema); }
  .fam-pantalla__titulo { font-family: var(--serif); font-weight: 600; font-size: 1.375rem; margin-bottom: 0.25rem; }
  .fam-pantalla__opciones { display: grid; gap: 0.5rem; }
  .fam-pantalla__opciones li { display: flex; align-items: center; gap: 0.75rem; padding: 0.875rem 1rem; border-radius: 12px; background: var(--tarjeta); border: 1px solid var(--linea); font-weight: 600; }
  .fam-pantalla__opciones li.sel { border-color: var(--acento-texto); }
  .fam-radio { width: 18px; height: 18px; flex-shrink: 0; border-radius: 50%; border: 2px solid var(--gris); }
  .sel .fam-radio { border-color: var(--acento-texto); background: radial-gradient(circle, var(--acento-texto) 0 45%, transparent 50%); }
  .fam-pantalla figcaption { font-size: 0.8125rem; color: var(--gris); margin-top: 0.25rem; }

  .fam-bloque { padding-block: clamp(4rem, 3rem + 4vw, 7rem); }
  .fam-bloque.sobre-claro { background: var(--papel); color: var(--negro); }
  .fam-bloque.sobre-claro + .fam-bloque.sobre-claro { padding-top: 0; }
  .fam-oscuro { background: var(--negro); color: var(--crema); }
  .fam-oscuro .fam-lead, .fam-oscuro p { color: var(--gris); }
  .fam-cabecera { display: grid; gap: 1rem; margin-bottom: clamp(2rem, 1.5rem + 2vw, 3.5rem); }
  .fam-cabecera h2 { font-family: var(--serif); font-weight: 600; font-size: clamp(2rem, 1.4rem + 2.4vw, 3.25rem); line-height: 1.05; letter-spacing: -0.025em; max-width: 20ch; text-wrap: balance; }
  .fam h3 { font-family: var(--serif); font-weight: 600; font-size: 1.375rem; line-height: 1.2; }

  .fam-n { display: block; font-family: var(--serif); font-weight: 600; font-size: 3rem; line-height: 1; letter-spacing: -0.04em; color: var(--acento-texto); margin-bottom: 0.75rem; }
  .fam-n--peq { font-size: 2rem; margin: 0; min-width: 2.5rem; }
  .fam-ideas, .fam-guia { display: grid; gap: 2rem; }
  .fam-ideas li, .fam-guia li { display: grid; align-content: start; gap: 0.5rem; padding-top: 1.5rem; border-top: 1px solid var(--linea); }
  .fam-guia li { border-color: rgb(22 20 18 / 0.15); }

  .fam-modos { display: grid; gap: 1.25rem; }
  .fam-modo { display: grid; align-content: start; gap: 0.875rem; padding: clamp(1.5rem, 1rem + 2vw, 2.5rem); border-radius: 18px; background: #fff; border: 1px solid rgb(22 20 18 / 0.1); }

  .fam-dos { display: grid; gap: 2rem; }
  .fam-dos .fam-cabecera { margin-bottom: 0; }
  .fam-compartir { display: grid; gap: 2rem; }
  .fam-niveles { display: grid; gap: 1.25rem; }
  .fam-niveles li { display: flex; gap: 1rem; align-items: start; }
  .fam-niveles h3 { margin-bottom: 0.25rem; }
  .fam-nunca { padding: 1.5rem; border-radius: 16px; border: 1px solid var(--linea); background: var(--tarjeta); }
  .fam-nunca h3 { margin-bottom: 1rem; }
  .fam-nunca ul, .fam-nohace ul { display: grid; gap: 0.75rem; }
  .fam-nunca li, .fam-nohace li { display: flex; gap: 0.625rem; align-items: baseline; font-weight: 600; color: var(--crema); }
  .fam-nunca svg, .fam-nohace svg { flex-shrink: 0; color: var(--acento-texto); translate: 0 1px; }

  .fam-pasos { display: grid; gap: 1.75rem; }
  .fam-pasos li { display: grid; grid-template-columns: auto 1fr; gap: 1.25rem; align-items: start; padding-top: 1.5rem; border-top: 1px solid var(--linea); }
  .fam-pasos .fam-n { margin: 0; min-width: 2.2em; }
  .fam-pasos h3 { margin-bottom: 0.375rem; }
  .fam-nohace { display: grid; gap: 1rem; margin-top: 2.5rem; padding-top: 2rem; border-top: 1px dashed var(--linea); }
  .fam-nohace > p { font-size: 0.875rem; }

  .fam-candados { display: grid; gap: 1rem; }
  .fam-candados li { display: flex; gap: 0.875rem; align-items: center; padding: 1rem 1.25rem; border-radius: 14px; background: #fff; border: 1px solid rgb(22 20 18 / 0.1); font-weight: 600; color: var(--negro); }
  .fam-candados svg { flex-shrink: 0; color: var(--acento-oscuro); }
  [data-paleta='d'] .fam-candados svg { color: var(--negro); }

  .fam-faq { display: grid; gap: 0.75rem; }
  .fam-faq details { border-radius: 14px; background: #fff; border: 1px solid rgb(22 20 18 / 0.1); }
  .fam-faq summary { display: flex; justify-content: space-between; align-items: center; gap: 1rem; min-height: 56px; padding: 1rem 1.25rem; cursor: pointer; list-style: none; font-family: var(--serif); font-weight: 600; font-size: 1.1875rem; color: var(--negro); }
  .fam-faq summary::-webkit-details-marker { display: none; }
  .fam-faq summary::after { content: '+'; flex-shrink: 0; font-family: var(--sans); font-size: 1.5rem; font-weight: 400; transition: rotate 200ms ease; }
  .fam-faq details[open] summary::after { rotate: 45deg; }
  .fam-faq details p { padding: 0 1.25rem 1.25rem; line-height: 1.6; }

  .fam-cierre { background: var(--negro-2); color: var(--crema); border-bottom: 1px solid var(--linea); padding-block: clamp(4rem, 3rem + 4vw, 6.5rem); }
  .fam-cierre__caja { display: grid; justify-items: center; gap: 2rem; text-align: center; }
  .fam-cierre h2 { font-family: var(--serif); font-weight: 600; font-size: clamp(2rem, 1.4rem + 2.6vw, 3.5rem); line-height: 1.05; letter-spacing: -0.025em; max-width: 18ch; text-wrap: balance; }

  @media (min-width: 48rem) {
    .fam-modos { grid-template-columns: 1fr 1fr; }
    .fam-ideas, .fam-guia { grid-template-columns: repeat(3, 1fr); }
  }
  @media (min-width: 60rem) {
    .fam-hero__rejilla { grid-template-columns: 1.2fr 1fr; gap: 4rem; }
    .fam-dos { grid-template-columns: 1fr 1.25fr; gap: 4rem; align-items: start; }
    .fam-compartir { grid-template-columns: 1fr; }
    .fam-pasos { grid-template-columns: repeat(3, 1fr); gap: 2rem; }
    .fam-pasos li { grid-template-columns: 1fr; }
  }
</style>
